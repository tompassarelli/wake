              "            navigate(_navFields[attr]);\n"
              "          });\n"
              "          if (node.parentNode) node.parentNode.insertBefore(_ni, node.nextSibling);\n"
              "        }\n")
            "")
          (if fram?
            (str "        const fieldMeta = wakeFramFieldMeta["
                 (q (.-name ge)) "][attr];\n"
                 "        if (!fieldMeta || fieldMeta.identity || fieldMeta.write !== 'set') continue;\n")
            "")
          "        node.style.cursor = 'pointer';\n"
          "        node.addEventListener('click', () => {\n"
          (if fram?
            (str
              "          const checkbox = fieldMeta.cardinality === 'single' && (fieldMeta.type === 'Bool' || fieldMeta.type === 'Boolean');\n"
              "          const input = document.createElement('input');\n"
              "          const currentValue = " store-name ".get(selectedEid)?.[attr];\n"
              "          if (checkbox) { input.type = 'checkbox'; input.checked = currentValue === true; }\n"
              "          else input.value = wakeFramInputValue(currentValue, fieldMeta);\n"
              "          input.className = 'px-3 py-2 border border-input rounded-md bg-background text-foreground text-sm w-full';\n"
              "          node.replaceWith(input);\n"
              "          input.focus();\n"
              "          if (!checkbox) input.select();\n")
            (str
              "          const input = document.createElement('input');\n"
              "          input.value = " store-name ".get(selectedEid)?.[attr] || '';\n"
              "          input.className = 'px-3 py-2 border border-input rounded-md bg-background text-foreground text-sm w-full';\n"
              "          node.replaceWith(input);\n"
              "          input.focus();\n"
              "          input.select();\n"))
          "          let done = false;\n"
          (if fram?
            (str
              "          let saving = false;\n"
              "          const commit = async () => {\n"
              "            if (done || saving) return;\n"
              "            saving = true;\n"
              "            input.disabled = true;\n"
              "            try {\n"
              "              const value = wakeFramReadInput(input, fieldMeta);\n"
              "              await " store-name
              ".update(selectedEid, attr, value);\n"
              "              done = true;\n"
              "              input.replaceWith(node);\n"
              "            } catch (error) {\n"
              "              " store-name ".commandFailed(error);\n"
              "              input.disabled = false;\n"
              "              saving = false;\n"
              "              input.focus();\n"
              "              return;\n"
              "            }\n"
              "            saving = false;\n"
              "          };\n")
            (str
              "          const commit = () => {\n"
              "            if (done) return;\n"
              "            done = true;\n"
              "            input.replaceWith(node);\n"
              "            " store-name
              ".update(selectedEid, attr, input.value.trim());\n"
              "          };\n"))
          "          input.addEventListener('blur', commit);\n"
          "          input.addEventListener('keydown', (e) => {\n"
          "            if (e.key === 'Enter') { e.preventDefault(); commit(); }\n"
          (if fram?
            "            if (e.key === 'Escape' && !saving) { done = true; input.replaceWith(node); }\n"
            "            if (e.key === 'Escape') { done = true; input.replaceWith(node); }\n")
          "          });\n"
          "        });\n"
          "      }\n")

        select-item-close #r#"
      const inst = instances.get(eid);
      if (inst) { inst.el.classList.add('bg-muted'); selectedRowEl = inst.el; }
    }

"#

        no-select-layout #r#"
    viewEl.appendChild(searchBar);
    viewEl.appendChild(colHeader);
    viewEl.appendChild(listEl);

"#

        watcher-add #r#"
    const instances = new Map();
"#

        watcher-add-tail (str
          "        inst.el.className = (inst.el.className || '') + ' cursor-pointer hover:bg-muted/50 transition-colors';\n"
          "        inst.el.style.display = 'grid';\n"
          "        inst.el.style.gridTemplateColumns = '" grid-tpl-sel "';\n"
          "        for (const ch of inst.el.children) { ch.style.width = 'auto'; ch.style.minWidth = '0'; }\n")

        watcher-update #r#"
        listEl.appendChild(inst.el);
        instances.set(evt.eid, inst);
        filterRows();
      }
      if (evt.type === 'update') {
        const inst = instances.get(evt.eid);
        if (inst && inst.update[evt.attr]) inst.update[evt.attr](evt.new || '');
"#

        watcher-remove #r#"
      }
      if (evt.type === 'remove') {
        const inst = instances.get(evt.eid);
        if (inst) { inst.destroy(); instances.delete(evt.eid); }
        filterRows();
"#

        watcher-load #r#"
      }
      if (evt.type === 'load') {
        listEl.innerHTML = '';
        instances.clear();
"#

        watcher-load-body (str
          "          inst.el.className = (inst.el.className || '') + ' cursor-pointer hover:bg-muted/50 transition-colors';\n"
          "          inst.el.style.display = 'grid';\n"
          "          inst.el.style.gridTemplateColumns = '" grid-tpl-sel "';\n"
          "          for (const ch of inst.el.children) { ch.style.width = 'auto'; ch.style.minWidth = '0'; }\n")

        watcher-load-tail #r#"
          listEl.appendChild(inst.el);
          instances.set(entity.eid, inst);
        }
        filterRows();
      }
    });

"#

        pagination-bar ""

        view-close #r#"
  })();
"#
      ]
    (str
      "  // ── View: " view-name " ──\n"
      view-open
      "    titleEl.textContent = " (q title) ";\n"
      "    toolbar.appendChild(titleEl);\n"
      (if has-form (str add-toggle-js) "")
      export-btn-js
      "    viewEl.appendChild(toolbar);\n"

      ;; Collapsible form
      (if has-form
        (let [first-field (nth add-fields 0)
              first-fid (str "form_" (id->ref first-field))
              first-checkbox?
              (and fram?
                   (field-checkbox? (graph-field-named ge first-field)))]
          (str form-chrome form-fields form-actions
            (if first-checkbox? ""
              (str "      const first = " first-fid ".value.trim();\n"
                   "      if (!first) return;\n"))
            "      " (if fram? "await " "") store-name
            ".add({ " add-obj " });\n"
            clear-lines "\n"
            form-submit-tail))
        "")

      ;; Search + filter
      search-setup
      (str "        const entity = " store-name ".get(eid);\n")
      filter-fn-bottom

      ;; Column header
      col-header-js
      select-all-cb

      ;; Layout: split pane or stacked
      (if has-select
        (str split-pane-setup
          "      const entity = " store-name ".get(eid);\n"
          "      if (!entity) return;\n"
          "      detailInst = " select-fn-name "(entity, " store-name ");\n"
          inline-edit-all
          tab-code
          select-item-close)
        no-select-layout)

      ;; Store watcher
      selection-setup
      watcher-add
      "    " store-name ".watch((evt) => {\n"
      "      if (evt.type === 'add') {\n"
      "        const inst = " fn-name "(evt.entity, " store-name ");\n"
      watcher-add-tail
      row-cb-add
      (if has-select "        inst.el.addEventListener('click', () => selectItem(evt.eid));\n" "")
      watcher-update
      (if has-select "        if (selectedEid === evt.eid && detailInst && detailInst.update[evt.attr]) detailInst.update[evt.attr](evt.new || '');\n" "")
      watcher-remove
      (if has-select "        if (selectedEid === evt.eid) selectItem(null);\n" "")
      watcher-load
      (if has-select "        if (selectedEid) selectItem(null);\n" "")
      "        for (const entity of " store-name ".all()) {\n"
      "          const inst = " fn-name "(entity, " store-name ");\n"
      watcher-load-body
      row-cb-load
      (if has-select "          inst.el.addEventListener('click', () => selectItem(entity.eid));\n" "")
      watcher-load-tail

      "    viewContainers[" (q view-name) "] = viewEl;\n"
      "    main.appendChild(viewEl);\n"
      view-close)))

(defn query-route? [(route Any)] Bool
  (or (> (count (or (.-parameters route) [])) 0)
      (> (count (or (.-required-props route) [])) 0)
      (> (count (or (.-queries route) [])) 0)))

(defn route-browser-definition
  [(route Any) (queries Any) (views Any) (dynamic Bool)] String
  (let [view
        (first
          (filterv (fn [candidate] Bool (= (.-name candidate) (.-view-name route))) views))
        query-definitions
        (.join
          (mapv
            (fn [query-reference] String
              (let [query
                    (first
                      (filterv
                        (fn [candidate] Bool
                          (= (.-name candidate) (.-name query-reference)))
                        queries))
                    public-column-names
                    (mapv
                      (fn [column] String (.-name column))
                      (filterv
                        (fn [column] Bool (not (.-internal column)))
                        (.-columns query)))
                    provider-result-names
                    (mapv
                      (fn [provider] String (.-name provider))
                      (or (.-result-providers query) []))
                    output-names
                    (into public-column-names provider-result-names)]
                (str "{ name: " (q (.-name query-reference))
                     ", prefix: "
                     (if (nil? (.-prefix query-reference))
                       "null"
                       (q (.-prefix query-reference)))
                     ", kind: " (q (.-result-kind query))
                     ", defaultLimit: "
                     (if (nil? (.-default-limit query)) "null" (str (.-default-limit query)))
                     ", maxLimit: "
                     (if (nil? (.-max-limit query)) "null" (str (.-max-limit query)))
                     ", columns: ["
                     (.join
                       (mapv q output-names)
                       ", ")
                     "]"
                     " }")))
            (.-queries route))
          ", ")
        strings
        (fn [items] String
          (str "[" (.join (mapv q (or items [])) ", ") "]"))]
    (str "{ path: " (q (.-path route))
         ", view: " (q (.-view-name route))
         ", dynamic: " (if dynamic "true" "false")
         ", component: " (id->ref (.-component view)) "_create"
         ", parameters: " (strings (.-parameters route))
         ", inputParameters: " (strings (.-input-parameters route))
         ", requiredProps: " (strings (.-required-props route))
         ", queries: [" query-definitions "] }")))

(defn gen-query-route-section [(route Any)] String
  (str
    "  (function() {\n"
    "    const viewEl = document.createElement('section');\n"
    "    viewEl.className = 'view-card wake-query-route';\n"
    "    viewEl.setAttribute('aria-live', 'polite');\n"
    "    viewEl.tabIndex = -1;\n"
    "    viewContainers[" (q (.-view-name route)) "] = viewEl;\n"
    "    main.appendChild(viewEl);\n"
    "  })();"))

(defn gen-routed-program [(g Any)] String
  (let [components (or (.-components g) [])
        views (or (.-views g) [])
        router (.-router g)
        routes (.-routes router)
        query-routes (filterv query-route? routes)
        query-route-views (mapv (fn [route] String (.-view-name route)) query-routes)
        static-views
        (filterv
          (fn [view] Bool (not (.includes query-route-views (.-name view)))) views)
        static-view-names (mapv (fn [view] String (.-name view)) static-views)
        default-route (.-default-route router)
        is-fram (fram-graph? g)
        persist (.-persist g)
        raw-persist-key (if (nil? persist) nil (.-key persist))
        persist-key (if is-fram nil raw-persist-key)
        src-name (.-ns g)
        layout (.-layout g)
        layout-title (if (and (some? layout) (some? (.-title layout)))
                       (.-title layout)
                       (titlecase src-name))
        nav-groups (if (and (some? layout) (> (count (.-groups layout)) 0))
                     (.-groups layout)
                     nil)

        view-entities (reduce
          (fn [acc v] (Vec Any)
            (let [en (.-entity-name v)]
              (if (some? (first (filterv (fn [e] Bool (= (.-name e) en)) acc)))
                acc
                (let [ge (first (filterv (fn [e] Bool (= (.-name e) en)) (.-entities g)))]
                  (conj acc ge)))))
          [] static-views)
        unique-entities (publication-entities g view-entities)
        all-stores (mapv (fn [e] String (store-ref (.-store-name e))) unique-entities)

        unique-comp-names (reduce
          (fn [acc v] (Vec String)
            (let [names (filterv some? [(.-component v) (.-select-component v)])]
              (reduce (fn [a n] (Vec String) (if (.includes a n) a (conj a n))) acc names)))
          [] views)

        gen-nav-btn (fn [vname] String
          (let [v (first (filterv (fn [vi] Bool (= (.-name vi) vname)) views))
                label (if (some? v) (or (.-title v) (titlecase vname)) (titlecase vname))]
            (str "    const nav_" (id->ref vname) " = document.createElement('button');\n"
                 "    nav_" (id->ref vname) ".className = 'sidebar-item';\n"
                 "    nav_" (id->ref vname) ".textContent = " (q label) ";\n"
                 "    nav_" (id->ref vname) ".addEventListener('click', () => navigate(" (q vname) "));\n"
                 "    sidebarContent.appendChild(nav_" (id->ref vname) ");\n"
                 "    navButtons[" (q vname) "] = nav_" (id->ref vname) ";\n")))

        nav-buttons (if (some? nav-groups)
          (.join
            (mapv (fn [grp] String
              (str "    const grpLabel_" (id->ref (.-label grp)) " = document.createElement('div');\n"
                   "    grpLabel_" (id->ref (.-label grp)) ".className = 'sidebar-group-label';\n"
                   "    grpLabel_" (id->ref (.-label grp)) ".textContent = " (q (.-label grp)) ";\n"
                   "    sidebarContent.appendChild(grpLabel_" (id->ref (.-label grp)) ");\n"
                   (.join (mapv gen-nav-btn (.-items grp)) "\n")))
              nav-groups) "\n")
          (.join
            (mapv (fn [r] String (gen-nav-btn (.-view-name r))) routes) "\n"))

        view-sections (.join
          (mapv (fn [v] String
            (let [en (.-entity-name v)
                  ge (first (filterv (fn [e] Bool (= (.-name e) en)) (.-entities g)))
                  store-name (store-ref (.-store-name ge))]
              (gen-view-section
                v components ge store-name (.-entities g) views
                (.-publications g) is-fram)))
            static-views) "\n")

        query-route-sections
        (.join (mapv gen-query-route-section query-routes) "\n")

        browser-route-definitions
        (.join
          (mapv
            (fn [route] String
              (route-browser-definition
                route
                (or (.-queries g) [])
                views
                (query-route? route)))
            routes)
          ",\n  ")

        undo-watchers
        (if is-fram ""
          (.join
            (mapv (fn [sn] String
              (let [save (cond (not (nil? persist-key)) "    saveDb();\n"
                               :else "")]
                (str sn ".watch((evt) => {\n"
                     "  if (evt.type === 'add') {\n"
                     "    recordUndo({ type: 'add', store: " sn
                     ", eid: evt.eid, entity: evt.entity });\n"
                     save
                     "  }\n"
                     "  if (evt.type === 'update') {\n"
                     "    recordUndo({ type: 'update', store: " sn
                     ", eid: evt.eid, attr: evt.attr, old: evt.old, 'new': evt.new });\n"
                     save
                     "  }\n"
                     "  if (evt.type === 'remove') {\n"
                     "    recordUndo({ type: 'remove', store: " sn
                     ", eid: evt.eid, entity: evt.entity });\n"
                     save
                     "  }\n"
                     "});\n")))
              all-stores) "\n"))

        navigate-fn #r#"
  let currentView = '';
  function navigate(name, updateHash = true) {
    for (const [n, el] of Object.entries(viewContainers)) {
      el.style.display = n !== name ? 'none' : '';
    }
    currentView = name;
    if (updateHash) location.hash = '#' + name;
    for (const [n, btn] of Object.entries(navButtons)) {
      btn.classList.toggle('active', n === name);
    }
  }
"#
]

    (str
      "// Generated by wake — semantic UI compiler\n"
      "// Source: " (q src-name) "\n"
      "// This file is a build artifact. Edit the application input, not this file.\n\n"
      "(function() {\n"
      "'use strict';\n\n"

      ;; Inlined value-equality runtime (backs the store change-gate).
      (gen-equiv-runtime) "\n"

      "// ── Stores ────────────────────────────────────────\n"
      (.join
        (mapv (fn [e] String (gen-store-for e [] is-fram)) unique-entities)
        "\n\n")
      "\n\n"

      (if is-fram
        (str "// ── FRAM gateway connector ────────────────────────────\n"
             (gen-fram-connector
               unique-entities
               (.-entities g)
               (.-publications g)
               (.-semantic-fingerprint g)) "\n")
        "")

      "// ── Components ──────────────────────────────────────\n"
      (.join
        (mapv (fn [cn] String
          (gen-component-fn!
            (first (filterv (fn [c] Bool (= (.-name c) cn)) components))
            ""
            (not is-fram)))
          unique-comp-names) "\n")
      "\n"

      (if is-fram ""
        (str "// ── Undo / Redo ─────────────────────────────────────\n"
             (gen-undo-redo) "\n"))

      (cond
        (not (nil? persist-key))
          (str "// ── Persistence ──────────────────────────────────────\n"
               (gen-persistence persist-key all-stores) "\n")
        :else "")

      (if is-fram ""
        (str "// ── Undo watchers ───────────────────────────────────\n"
             undo-watchers "\n"))

      "// ── Init ─────────────────────────────────────────────\n"
      "function init() {\n"
      #r#"
  const root = document.getElementById(window.WAKE_MOUNT_ID || 'app');
  const app = document.createElement('div');
  app.className = 'sidebar-layout';

  const sidebar = document.createElement('aside');
  sidebar.className = 'sidebar';
  const sidebarHeader = document.createElement('div');
  sidebarHeader.className = 'sidebar-header';
  sidebarHeader.textContent =
"#
      " " (q layout-title) ";\n"
      #r#"
  sidebar.appendChild(sidebarHeader);
  const sidebarContent = document.createElement('div');
  sidebarContent.className = 'sidebar-content';
  const navButtons = Object.create(null);
"#
      "\n" nav-buttons "\n"
      #r#"
  sidebar.appendChild(sidebarContent);

  const sidebarFooter = document.createElement('div');
  sidebarFooter.className = 'sidebar-footer';
  const darkToggle = document.createElement('button');
  darkToggle.className = 'sidebar-item';
  darkToggle.textContent = document.documentElement.classList.contains('dark') ? '☀ Light' : '☾ Dark';
  darkToggle.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    darkToggle.textContent = isDark ? '☀ Light' : '☾ Dark';
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
  if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
  darkToggle.textContent = document.documentElement.classList.contains('dark') ? '☀ Light' : '☾ Dark';

  const collapseToggle = document.createElement('button');
  collapseToggle.className = 'sidebar-item';
  collapseToggle.textContent = '« Collapse';
  collapseToggle.addEventListener('click', () => {
    sidebar.classList.toggle('collapsed');
    collapseToggle.textContent = sidebar.classList.contains('collapsed') ? '»' : '« Collapse';
  });
  sidebarFooter.appendChild(darkToggle);
  sidebarFooter.appendChild(collapseToggle);
  sidebar.appendChild(sidebarFooter);

  app.appendChild(sidebar);

  const main = document.createElement('main');
  main.className = 'sidebar-main';
  const viewContainers = Object.create(null);
"#
      "\n" view-sections "\n" query-route-sections "\n\n"
      #r#"
  app.appendChild(main);
  root.appendChild(app);
"#
      "\n" navigate-fn "\n"
      "  const wakeStaticViews = new Set(["
      (.join (mapv q static-view-names) ", ")
      "]);\n"
      "  const wakeBrowserRoutes = [\n  " browser-route-definitions "\n  ];\n"
      #r#"
  let wakeRouteGeneration = 0;
  function wakeRouteErrorKind(error) {
    const status = error && typeof error.message === 'string'
      ? /^Wake gateway ([0-9]{3}):/.exec(error.message)
      : null;
    if (status && (status[1] === '401' || status[1] === '403')) return 'denied';
    return 'network';
  }
  function wakeRouteStatus(container, kind) {
    container.replaceChildren();
    const status = document.createElement('p');
    status.className = 'wake-route-state wake-route-state--' + kind;
    status.setAttribute('role', kind === 'loading' ? 'status' : 'alert');
    status.textContent = kind === 'loading'
      ? 'Loading…'
      : kind === 'empty'
        ? 'Nothing to show.'
        : kind === 'denied'
          ? 'You do not have access to this page.'
          : 'This page could not be loaded.';
    container.appendChild(status);
  }
  function wakeDecodePathSegment(segment) {
    try { return decodeURIComponent(segment); } catch { return null; }
  }
  function wakeMatchRoute(pathname) {
    for (const route of wakeBrowserRoutes) {
      const expected = route.path === '/' ? [] : route.path.slice(1).split('/');
      const actual = pathname === '/' ? [] : pathname.slice(1).split('/');
      if (expected.length !== actual.length) continue;
      const parameters = Object.create(null);
      let matched = true;
      let parameterIndex = 0;
      for (let index = 0; index < expected.length; index += 1) {
        if (expected[index].startsWith(':')) {
          const value = wakeDecodePathSegment(actual[index]);
          if (value == null || value === '' || value.includes('/')) { matched = false; break; }
          parameters[route.inputParameters[parameterIndex]] = value;
          parameterIndex += 1;
        } else if (expected[index] !== actual[index]) {
          matched = false;
          break;
        }
      }
      if (matched) return { route, parameters };
    }
    return null;
  }
  async function wakeRenderMatchedRoute(match) {
    const generation = ++wakeRouteGeneration;
    const { route, parameters } = match;
    const container = viewContainers[route.view];
    navigate(route.view, false);
    wakeRouteStatus(container, 'loading');
    try {
      const results = [];
      let servedVersion = null;
      for (let index = 0; index < route.queries.length; index += 1) {
        const descriptor = route.queries[index];
        const options = Object.create(null);
        if (descriptor.kind === 'page') options.limit = descriptor.defaultLimit;
        if (servedVersion !== null) options.asOf = servedVersion;
        const result = await wakeFramPost('/api/wake/query', {
          op: 'execute',
          query: descriptor.name,
          input: parameters,
          ...(Object.keys(options).length > 0 ? { options } : {}),
        });
        if (generation !== wakeRouteGeneration) return;
        if (servedVersion === null) servedVersion = result.servedVersion;
        else if (String(result.servedVersion) !== String(servedVersion)) {
          throw new Error('Wake route queries were served at different snapshots');
        }
        results.push(result);
      }
      if (generation !== wakeRouteGeneration) return;
      const primary = results[0] || null;
      const rows = primary == null
        ? [{}]
        : Array.isArray(primary.rows)
          ? primary.rows
          : primary.row == null
            ? []
            : [primary.row];
      container.replaceChildren();
      if (rows.length === 0) { wakeRouteStatus(container, 'empty'); return; }
      for (const row of rows) {
        const props = Object.create(null);
        function wakeMergeRouteRow(source, prefix) {
          for (const [name, value] of Object.entries(source)) {
            const target = prefix == null ? name : prefix + '-' + name;
            if (Object.prototype.hasOwnProperty.call(props, target)) {
              throw new Error(`Wake route result repeats component prop ${target}`);
            }
            props[target] = value;
          }
        }
        wakeMergeRouteRow(row, route.queries[0] ? route.queries[0].prefix : null);
        for (let index = 1; index < results.length; index += 1) {
          const result = results[index];
          if (result && result.row) wakeMergeRouteRow(result.row, route.queries[index].prefix);
          else if (result && Array.isArray(result.rows)) {
            for (const auxiliary of result.rows) {
              wakeMergeRouteRow(auxiliary, route.queries[index].prefix);
            }
          } else {
            for (const name of route.queries[index].columns) {
              const target = route.queries[index].prefix == null
                ? name
                : route.queries[index].prefix + '-' + name;
              if (Object.prototype.hasOwnProperty.call(props, target)) {
                throw new Error(`Wake route result repeats component prop ${target}`);
              }
              props[target] = null;
            }
          }
        }
        for (const prop of route.requiredProps) {
          if (!Object.prototype.hasOwnProperty.call(props, prop)) {
            throw new Error(`Wake route result omitted component prop ${prop}`);
          }
        }
        const instance = route.component(props, null);
        container.appendChild(instance.el);
      }
      container.focus({ preventScroll: true });
    } catch (error) {
      if (generation !== wakeRouteGeneration) return;
      console.error('Wake route load failed:', error);
      wakeRouteStatus(container, wakeRouteErrorKind(error));
    }
  }
  function wakeRenderLocation() {
    const match = wakeMatchRoute(location.pathname);
    if (!match) return false;
    if (match.route.dynamic) void wakeRenderMatchedRoute(match);
    else {
      wakeRouteGeneration += 1;
      navigate(match.route.view, false);
    }
    return true;
  }
  function wakeRenderStaticLocation() {
    if (!location.hash.startsWith('#')) return false;
    let name;
    try { name = decodeURIComponent(location.hash.slice(1)); } catch { return false; }
    if (!wakeStaticViews.has(name)) return false;
    navigate(name, false);
    return true;
  }
  function wakeRenderBrowserLocation() {
    return wakeRenderStaticLocation() || wakeRenderLocation();
  }
  function wakeNavigatePath(path) {
    history.pushState(null, '', path);
    if (!wakeRenderLocation()) throw new Error(`Wake generated no route for ${path}`);
  }
"#
      "  if (!wakeRenderBrowserLocation()) navigate(" (q default-route) ", false);\n"
      #r#"
  window.addEventListener('popstate', () => {
"#
      "    if (!wakeRenderBrowserLocation()) navigate(" (q default-route) ", false);\n"
      #r#"
  });
  window.addEventListener('hashchange', () => {
"#
      "    if (!wakeRenderBrowserLocation()) navigate(" (q default-route) ", false);\n"
      #r#"
  });
"#
      (if is-fram "" #r#"
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'z' && !e.shiftKey) { e.preventDefault(); undo(); }
    if ((e.ctrlKey || e.metaKey) && e.key === 'z' && e.shiftKey) { e.preventDefault(); redo(); }
  });
"#)
      (cond (not (nil? persist-key)) "  restoreDb();\n"
            is-fram "  void wakeFramStart();\n"
            :else "")
      "}\n\n"
      "init();\n"
      "})();\n")))

;; --- Main entry point ---

(defn gen-program! [(g Any)] String
  (if (and (= (count (or (.-views g) [])) 0)
           (= (count (or (.-list-details g) [])) 0))
    (throw
      (ex-info
        "wake: browser generation requires one view or one list detail"
        {}))
    nil)
  (if (and (not (nil? (.-views g))) (> (count (.-views g)) 0))
    (if (not (nil? (.-router g)))
      (gen-routed-program g)
      (gen-view-program! g))
  (let [;; Expand list-detail into UI graph
        ld (first (.-list-details g))
        sf (first (.-forms g))
        ug (ui/expand-list-detail g ld sf)

        ;; Read from UI graph — no CRM-specific derivation here
        en (.-entity ug)
        primary-ge
        (first (filterv (fn [e] Bool (= (.-name e) en)) (.-entities g)))
        store-name (store-ref (.-store-name ug))
        columns (.-columns ug)
        search-cols (.-search-cols ug)
        overview-fields (.-overview-fields ug)
        title (.-title ug)
        related-info (.-related ug)
        related-tab-keys (mapv (fn [ri] String (.-key ri)) related-info)

        derived-attrs (.-derived ug)

        ;; Persist
        is-fram (fram-graph? g)
        persist (.-persist ug)
        raw-persist-key (if (nil? persist) nil (.-key persist))
        persist-key (if is-fram nil raw-persist-key)
        all-stores
        (into [store-name]
          (mapv (fn [ri] String (store-ref (.-store ri))) related-info))
        related-entities
        (mapv
          (fn [ri] Any
            (first
              (filterv
                (fn [e] Bool (= (.-name e) (.-entity ri)))
                (.-entities g))))
          related-info)
        generated-entities (into [primary-ge] related-entities)
        publication-generated-entities
        (publication-entities g generated-entities)
        primary-has-publications
        (and is-fram
             (> (count
                  (filterv
                    (fn [publication] Bool
                      (= (.-revision-entity publication) en))
                    (.-publications g)))
                0))
        publication-extra-entities
        (filterv
          (fn [entity] Bool
            (nil?
              (first
                (filterv
                  (fn [generated] Bool
                    (= (.-name generated) (.-name entity)))
                  generated-entities))))
          publication-generated-entities)

        subtitle-field (if (> (count overview-fields) 1) (nth overview-fields 1) nil)

        layout-result (gen-layout en (.-form ug) title primary-ge is-fram)

        src-name (.-ns g)]

    (str
      "// Generated by wake — semantic UI compiler\n"
      "// Source: " (q src-name) "\n"
      "// This file is a build artifact. Edit the application input, not this file.\n\n"
      "(function() {\n"
      "'use strict';\n\n"

      ;; Inlined value-equality runtime (backs the store change-gate).
      (gen-equiv-runtime) "\n"

      ;; Stores
      "// ── Stores ─────────────────────────────────────────\n"
      (gen-store-for primary-ge [] is-fram) "\n"
      "\n"
      (.join
        (mapv (fn [ri] String
          (let [related-ge
                (first
                  (filterv
                    (fn [e] Bool (= (.-name e) (.-entity ri)))
                    (.-entities g)))]
            (gen-store-for related-ge [(.-fk-field ri)] is-fram)))
          related-info)
        "\n")
      (if is-fram
        (str "\n"
             (.join
               (mapv
                 (fn [entity] String (gen-store-for entity [] true))
                 publication-extra-entities)
               "\n"))
        "")

      (if is-fram
        (str "\n// ── FRAM gateway connector ────────────────────────────\n"
             (gen-fram-connector
               publication-generated-entities
               (.-entities g)
               (.-publications g)
               (.-semantic-fingerprint g)) "\n")
        "")

      ;; Ref declarations
      "\n// ── DOM refs ──────────────────────────────────────\n"
      (gen-ref-decls (.-refs layout-result)) "\n\n"

      ;; Detail panel
      "// ── Detail panel ────────────────────────────────────\n"
      (gen-detail
        en
        store-name
        overview-fields
        derived-attrs
        related-info
        (.-all-field-info ug)
        g
        (if is-fram (entity-identity-name primary-ge) nil)
        is-fram
        (not is-fram)) "\n"

      ;; List view
      "\n// ── List view ──────────────────────────────────────\n"
      (gen-list-fns
        en store-name columns search-cols derived-attrs
        primary-has-publications) "\n"

      ;; Stats
      "\n// ── Stats ────────────────────────────────────────────\n"
      (gen-stats en store-name) "\n"

      ;; Form
      "\n// ── Form ─────────────────────────────────────────────\n"
      (if (some? (.-form ug))
        (gen-form-handler en (.-form ug) primary-ge is-fram)
        "") "\n"

      ;; Persistence
      (cond
        (not (nil? persist-key))
          (str "\n// ── Persistence ──────────────────────────────────────\n"
               (gen-persistence persist-key all-stores) "\n")
        :else "")

      ;; Compiled update paths
      "\n// ── Compiled update paths ────────────────────────────\n"
      (gen-update-fns columns search-cols overview-fields subtitle-field
                      persist-key related-tab-keys derived-attrs store-name) "\n"

      ;; Undo/redo is local because FRAM commands are authoritative.
      (if is-fram ""
        (str "\n// ── Undo / Redo ─────────────────────────────────────\n"
             (gen-undo-redo) "\n"))

      ;; Init
      "// ── Init ─────────────────────────────────────────────\n"
      (gen-init-fn
        en
        (if (some? (.-form ug)) (.-name (.-form ug)) nil)
        store-name
        related-info
        persist-key
        layout-result
        (not is-fram)
        is-fram) "\n"

      "init();\n"
      "})();\n"))))
