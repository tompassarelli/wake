#lang beagle/js
(ns wake.codegen)
(require wake.graph :as graph)
(require wake.ui :as ui)

;; Codegen: Checked Entity Graph → self-contained JavaScript IIFE.
;; Produces direct-DOM code: entity stores, compiled update paths,
;; list-detail view, form handler, local undo/redo, persistence.

;; --- Typed records ---

(defrecord RenderResult [(code String) (vname String) (bindings Any)])
(defrecord Binding [(prop String) (vname String) (dom-prop String)])
(defrecord LayoutRef [(id String) (vname String)])
(defrecord LayoutResult [(code String) (refs (Vec LayoutRef))])

;; --- JS AST (inline, typed) ---

(defrecord JsIdent [(name String)])
(defrecord JsLiteral [(value Any)])
(defrecord JsRawExpr [(code String)])
(defrecord JsCall [(callee JsExpr) (args (Vec JsExpr))])
(defrecord JsMember [(obj JsExpr) (prop String)])
(defrecord JsBinary [(op String) (left JsExpr) (right JsExpr)])
(defrecord JsAwait [(expr JsExpr)])
(defrecord JsArrowBlock [(params (Vec String)) (body (Vec JsStmt))])
(defrecord JsArray [(items (Vec JsExpr))])
(defrecord JsSpread [(expr JsExpr)])

(defunion JsExpr JsIdent JsLiteral JsRawExpr JsCall JsMember JsBinary JsAwait JsArrowBlock JsArray JsSpread)

(defrecord JsRawStmt [(code String)])
(defrecord JsConst [(name String) (value JsExpr)])
(defrecord JsAssign [(target JsExpr) (value JsExpr)])
(defrecord JsReturn [(expr JsExpr)])
(defrecord JsIf [(test JsExpr) (then (Vec JsStmt)) (else-branch (Vec JsStmt))])
(defrecord JsBlock [(stmts (Vec JsStmt))])
(defrecord JsExprStmt [(expr JsExpr)])

(defunion JsStmt JsRawStmt JsConst JsAssign JsReturn JsIf JsBlock JsExprStmt)

;; JSON produces a JavaScript string literal with correct quote, slash, and
;; control-character escaping. Escape the two ECMAScript line separators too:
;; they terminate // comments, including the generated source-name comment.
(defn q [(s String)] String
  (let [serialized (JSON/stringify s)]
    (loop [(i Int) 0 (out String) ""]
      (if (>= i (count serialized))
        out
        (let [code (.charCodeAt serialized i)]
          (cond
            (= code 8232) (recur (+ i 1) (str out "\\u2028"))
            (= code 8233) (recur (+ i 1) (str out "\\u2029"))
            :else (recur (+ i 1) (str out (subs serialized i (+ i 1))))))))))

;; --- JS AST emitter ---

(defn emit-expr [(node JsExpr)] String
  (match node
    [(JsIdent name) name]
    [(JsLiteral value) (if (string? value) (q value) (str value))]
    [(JsRawExpr code) code]
    [(JsCall callee args) (str (emit-expr callee) "(" (.join (mapv emit-expr args) ", ") ")")]
    [(JsMember obj prop) (str (emit-expr obj) "." prop)]
    [(JsBinary op left right) (str (emit-expr left) " " op " " (emit-expr right))]
    [(JsAwait expr) (str "await " (emit-expr expr))]
    [(JsArrowBlock params body) (str "(" (.join params ", ") ") => {\n" (emit-stmts body 1) "\n}")]
    [(JsArray items) (str "[" (.join (mapv emit-expr items) ", ") "]")]
    [(JsSpread expr) (str "..." (emit-expr expr))]))

(defn indent [(depth Int)] String
  (loop [i 0 acc ""]
    (if (>= i depth) acc (recur (+ i 1) (str acc "  ")))))

(defn emit-stmt [(node JsStmt) (depth Int)] String
  (let [pad (indent depth)]
    (match node
      [(JsRawStmt code) (str pad code)]
      [(JsConst name value) (str pad "const " name " = " (emit-expr value) ";")]
      [(JsAssign target value) (str pad (emit-expr target) " = " (emit-expr value) ";")]
      [(JsReturn expr) (str pad "return " (emit-expr expr) ";")]
      [(JsExprStmt expr) (str pad (emit-expr expr) ";")]
      [(JsIf test then else-branch)
       (let [then-str (str " {\n" (emit-stmts then (+ depth 1)) "\n" pad "}")
             else-str (if (= (count else-branch) 0) ""
                        (str " else {\n" (emit-stmts else-branch (+ depth 1)) "\n" pad "}"))]
         (str pad "if (" (emit-expr test) ")" then-str else-str))]
      [(JsBlock stmts) (emit-stmts stmts depth)])))

(defn emit-stmts [(stmts (Vec JsStmt)) (depth Int)] String
  (.join (mapv (fn [s] String (emit-stmt s depth)) stmts) "\n"))

;; --- DOM AST helpers ---

(defn dom-create [(tag String)] JsExpr
  (->JsCall (->JsMember (->JsIdent "document") "createElement") [(->JsLiteral tag)]))

(defn dom-set-prop [(target JsExpr) (prop String) (value JsExpr)] JsStmt
  (->JsAssign (->JsMember target prop) value))

(defn dom-append [(parent JsExpr) (child JsExpr)] JsStmt
  (->JsExprStmt (->JsCall (->JsMember parent "appendChild") [child])))

(defn dom-add-listener [(target JsExpr) (event String) (handler JsExpr)] JsStmt
  (->JsExprStmt (->JsCall (->JsMember target "addEventListener") [(->JsLiteral event) handler])))

;; --- Helpers ---

(defn id->ref [(s String)] String
  ;; Encode every UTF-16 code unit. The fixed non-keyword prefix makes the
  ;; result a valid JavaScript binding even when the source starts with a
  ;; digit or is itself a JavaScript keyword; delimiters make it injective.
  (loop [(i Int) 0 (out String) "wake$"]
    (if (>= i (count s))
      out
      (recur (+ i 1) (str out (.charCodeAt s i) "$")))))

(defn store-ref [(store-name String)] String
  (id->ref (str "store/" store-name)))

(defn titlecase [(s String)] String
  (if (= (count s) 0) s
    (.join
      (mapv (fn [w] String (if (= (count w) 0) w (str (.toUpperCase (subs w 0 1)) (subs w 1))))
            (.split s " "))
      " ")))

(defn sym? [(x Any)] Bool
  (if (nil? x) false (= (.-_tag x) "Sym")))

(defn sym-name [(x Any)] String
  (.-name x))

(defn fram-graph? [(g Any)] Bool
  (let [backend (.-backend g)]
    (and (not (nil? backend)) (= (.-kind backend) "fram"))))

(defn entity-identity-name [(ge Any)] Any
  (let [identity-field (.-identity-field ge)]
    (if (nil? identity-field) nil (.-name identity-field))))

(defn graph-entity-named [(entities Any) (name String)] Any
  (first (filterv (fn [entity] Bool (= (.-name entity) name)) entities)))

(defn graph-field-named [(entity Any) (name String)] Any
  (if (nil? entity) nil
    (first
      (filterv (fn [field] Bool (= (.-name field) name)) (.-fields entity)))))

(defn field-wire-type [(field Any) (entities Any)] String
  (if (nil? field) "String"
    (if (= (.-value-kind field) "ref")
      (let [target (graph-entity-named entities (or (.-target-entity field) ""))
            target-identity (if (nil? target) nil (.-identity-field target))]
        (if (nil? target-identity) "String" (.-type target-identity)))
      (.-type field))))

(defn field-checkbox? [(field Any)] Bool
  (if (nil? field) false
    (and (= (.-cardinality field) "single")
         (or (= (.-type field) "Bool") (= (.-type field) "Boolean")))))

(defn fram-field-meta-expr [(field Any) (entities Any)] String
  (if (nil? field)
    "{ type: 'String', cardinality: 'single', write: 'set', identity: false }"
    (str "{ type: " (q (field-wire-type field entities))
         ", cardinality: " (q (.-cardinality field))
         ", write: " (q (.-write-policy field))
         ", identity: " (if (.-identity field) "true" "false") " }")))

(defn add-entity-by-name [(entities Any) (selected Any) (name String)] Any
  (if (some? (first (filterv (fn [entity] Bool (= (.-name entity) name)) selected)))
    selected
    (let [entity (graph-entity-named entities name)]
      (if (nil? entity) selected (conj selected entity)))))

(defn publication-entities [(g Any) (selected Any)] Any
  (reduce
    (fn [result publication] (Vec Any)
      (add-entity-by-name
        (.-entities g)
        (add-entity-by-name
          (.-entities g) result (.-owner-entity publication))
        (.-revision-entity publication)))
    selected
    (or (.-publications g) [])))

(defn state-machine-field?
  [(g Any) (entity-name String) (field-name String)] Bool
  (some?
    (first
      (filterv
        (fn [machine] Bool
          (and (= (.-entity machine) entity-name)
               (= (.-field machine) field-name)))
        (.-state-machines g)))))

(defn fram-related-add-fields
  [(g Any) (entity Any) (automatic-field String)] Any
  (filterv
    (fn [field] Bool
      (and (not (= (.-name field) automatic-field))
           (not (= (.-write-policy field) "command"))
           (not
             (state-machine-field?
               g (.-name entity) (.-name field)))))
    (.-stored-fields entity)))

(defn fram-publication-meta-expr [(publication Any)] String
  (str "{ owner: { entity: " (q (.-owner-entity publication))
       ", pointer: " (q (.-pointer-field publication))
       " }, revision: { entity: " (q (.-revision-entity publication))
       ", ownerField: " (q (.-owner-field publication))
       ", stateField: " (q (.-state-field publication))
       " }, states: { draft: " (q (.-draft-state publication))
       ", published: " (q (.-published-state publication))
       ", retired: " (q (.-retired-state publication)) " } }"))


(defn compile-derived-expr [(expr Any) (subst Any)] String
  (let [kind (.-kind expr)]
    (cond
      (= kind "field")
        (let [name (.-field expr)]
          (if (and (not (nil? subst)) (not (nil? (get subst name))))
            (get subst name)
            (str "(entity[" (q name) "] || '')")))
      (= kind "string") (q (.-value expr))
      (= kind "concat")
        (.join
          (mapv (fn [part] String (compile-derived-expr part subst)) (.-parts expr))
          " + ")
      :else
        (throw (ex-info "wake: invalid checked derived expression" {})))))

;; --- Inlined value-equality runtime (change-gating) ---

;; gen-equiv-runtime — emit equiv/hash/mix as PLAIN (non-exported) function
;; declarations, copied VERBATIM from beagle core.js (lib/beagle/core.js), so
;; each generated app is self-contained (ZERO imports). These back the store
;; change-gate: a write whose value is structurally EQUAL to the current value
;; becomes a true no-op (no mutation and no notification).
(defn gen-equiv-runtime [] String
  (.join
    ["// ── Value equality (Clojure = semantics) ─────────────"
     "function equiv(a, b) {"
     "  // nil: both null and undefined represent Clojure nil."
     "  if (a == null || b == null) return a == null && b == null;"
     "  // identical refs are trivially equal."
     "  if (a === b) return true;"
     "  const ta = typeof a, tb = typeof b;"
     "  // scalars: numbers, strings (keywords emit as bare strings), booleans."
     "  if (ta !== \"object\" || tb !== \"object\") return a === b;"
     "  // both are objects (arrays, plain objects/records, Sets, ...)."
     "  const aArr = Array.isArray(a), bArr = Array.isArray(b);"
     "  if (aArr || bArr) {"
     "    if (!aArr || !bArr) return false;"
     "    if (a.length !== b.length) return false;"
     "    for (let i = 0; i < a.length; i++) if (!equiv(a[i], b[i])) return false;"
     "    return true;"
     "  }"
     "  const aSet = a instanceof Set, bSet = b instanceof Set;"
     "  if (aSet || bSet) {"
     "    if (!aSet || !bSet) return false;"
     "    if (a.size !== b.size) return false;"
     "    const bItems = [...b];"
     "    const used = new Array(bItems.length).fill(false);"
     "    outer: for (const x of a) {"
     "      for (let i = 0; i < bItems.length; i++) {"
     "        if (!used[i] && equiv(x, bItems[i])) { used[i] = true; continue outer; }"
     "      }"
     "      return false;"
     "    }"
     "    return true;"
     "  }"
     "  // plain objects: maps AND records — same own keys, recursive equiv."
     "  const ak = Object.keys(a), bk = Object.keys(b);"
     "  if (ak.length !== bk.length) return false;"
     "  for (const k of ak) {"
     "    if (!Object.prototype.hasOwnProperty.call(b, k)) return false;"
     "    if (!equiv(a[k], b[k])) return false;"
     "  }"
     "  return true;"
     "}"
     "function mix(h, c) {"
     "  return ((h << 5) - h + c) | 0;"
     "}"
     "function hash(x) {"
     "  if (x == null) return 0;"
     "  const t = typeof x;"
     "  if (t === \"number\") {"
     "    return mix(1, x | 0) ^ ((x * 2654435761) | 0);"
     "  }"
     "  if (t === \"string\") {"
     "    let h = 2;"
     "    for (let i = 0; i < x.length; i++) h = mix(h, x.charCodeAt(i));"
     "    return h | 0;"
     "  }"
     "  if (t === \"boolean\") return x ? 3 : 4;"
     "  if (Array.isArray(x)) {"
     "    let h = 5;"
     "    for (let i = 0; i < x.length; i++) h = mix(h, hash(x[i]));"
     "    return h | 0;"
     "  }"
     "  if (x instanceof Set) {"
     "    let acc = 0;"
     "    for (const e of x) acc = (acc + hash(e)) | 0;"
     "    return mix(6, acc);"
     "  }"
     "  if (t === \"object\") {"
     "    let acc = 0;"
     "    for (const k of Object.keys(x)) {"
     "      acc = (acc + mix(hash(k), hash(x[k]))) | 0;"
     "    }"
     "    return mix(7, acc);"
     "  }"
     "  return mix(8, hash(String(x)));"
     "}"
     ""]
    "\n"))

;; --- Entity store ---

(defn gen-store [(name String) (fk-methods Any)] String
  (let [ref-name (store-ref name)]
    (.join
      (.concat
        [(str "const " ref-name " = (() => {")
         "  let nextEid = 1;"
         "  const entities = new Map();"
         "  const watchers = [];"
         "  function notify(evt) { for (const fn of watchers) fn(evt); }"
         "  function materialize(source, eid) { return Object.assign(Object.create(null), source, { eid }); }"
         "  return {"
         "    add(fields) {"
         "      const eid = nextEid++;"
         "      const entity = materialize(fields, eid);"
         "      entities.set(eid, entity);"
         "      notify({ type: 'add', eid, entity });"
         "      return entity;"
         "    },"
         "    get(eid) { return entities.get(eid); },"
         "    update(eid, attr, value) {"
         "      const entity = entities.get(eid);"
         "      if (!entity) return false;"
         "      const old = entity[attr];"
         "      if (equiv(old, value)) return false;"
         "      entity[attr] = value;"
         "      notify({ type: 'update', eid, entity, attr, old, 'new': value });"
         "      return true;"
         "    },"
         "    all() { return Array.from(entities.values()); },"
         "    remove(eid) {"
         "      const entity = entities.get(eid);"
         "      if (!entity) return;"
         "      entities.delete(eid);"
         "      notify({ type: 'remove', eid, entity });"
         "    },"
         "    addBack(entity) {"
         "      const restored = materialize(entity, entity.eid);"
         "      entities.set(restored.eid, restored);"
         "      if (restored.eid >= nextEid) nextEid = restored.eid + 1;"
         "      notify({ type: 'add', eid: restored.eid, entity: restored });"
         "    },"]
        [(if (> (count fk-methods) 0)
           "    by(field, value) { return Array.from(entities.values()).filter(entity => equiv(entity[field], value)); },"
           "")
         "    watch(fn) { watchers.push(fn); },"
         "    load(items) {"
         "      entities.clear();"
         "      let maxEid = 0;"
         "      for (const item of items) { const entity = materialize(item, item.eid); entities.set(entity.eid, entity); if (entity.eid > maxEid) maxEid = entity.eid; }"
         "      nextEid = maxEid + 1;"
         "      notify({ type: 'load' });"
         "    },"
         "    snapshot() { return Array.from(entities.values()); }"
         "  };"
         "})();"])
      "\n")))

;; FRAM stores expose the same read/watch surface as local stores. Their eid is
;; only a stable browser-cache key; every command is addressed by the declared
;; entity identity.
(defn gen-fram-store [(ge Any) (fk-methods Any)] String
  (let [name (store-ref (.-store-name ge))
        entity-name (.-name ge)
        identity-field (.-identity-field ge)
        identity-name (if (nil? identity-field) "" (.-name identity-field))]
    (.join
      (.concat
        [(str "const " name " = (() => {")
         "  let nextEid = 1;"
         "  const entities = new Map();"
         "  const identityIndex = new Map();"
         "  const watchers = [];"
         (str "  const identityField = " (q identity-name) ";")
         "  const commandErrorMessage = 'Could not save changes. Try again.';"
         "  function identityKey(value) { return typeof value + ':' + JSON.stringify(value); }"
         "  function materialize(source, eid) { return Object.assign(Object.create(null), source, { eid }); }"
         "  function notify(evt) { for (const fn of watchers) fn(evt); }"
         "  function clearCommandError() {"
         "    const alert = document.querySelector('[data-wake-command-error]');"
         "    if (!alert) return;"
         "    alert.hidden = true;"
         "    alert.textContent = '';"
         "  }"
         "  function reportCommandError(_error) {"
         "    let alert = document.querySelector('[data-wake-command-error]');"
         "    if (!alert) {"
         "      alert = document.createElement('div');"
         "      alert.dataset.wakeCommandError = '';"
         "      alert.setAttribute('role', 'alert');"
         "      alert.style.position = 'fixed';"
         "      alert.style.right = '1rem';"
         "      alert.style.bottom = '1rem';"
         "      alert.style.zIndex = '1000';"
         "      alert.style.maxWidth = '24rem';"
         "      alert.style.padding = '0.75rem 1rem';"
         "      alert.style.border = '1px solid #b91c1c';"
         "      alert.style.borderRadius = '0.375rem';"
         "      alert.style.background = 'Canvas';"
         "      alert.style.color = '#b91c1c';"
         "      document.body.appendChild(alert);"
         "    }"
         "    alert.textContent = commandErrorMessage;"
         "    alert.hidden = false;"
         "  }"
         "  return {"
         "    add(fields) {"
         "      clearCommandError();"
         (str "      return wakeFramCreate(" (q entity-name) ", fields);")
         "    },"
         "    get(eid) { return entities.get(eid); },"
         "    update(eid, attr, value) {"
         "      const entity = entities.get(eid);"
         "      if (!entity || equiv(entity[attr], value)) return Promise.resolve(false);"
         "      const identity = entity[identityField];"
         "      if (identity == null) return Promise.resolve(false);"
         "      clearCommandError();"
         (str "      return wakeFramSet(" (q entity-name)
              ", identity, attr, value).then(() => true);")
         "    },"
         "    commandFailed(error) { reportCommandError(error); },"
         "    commandStarted() { clearCommandError(); },"
         "    all() { return Array.from(entities.values()); },"]
        [(if (> (count fk-methods) 0)
           "    by(field, value) { return Array.from(entities.values()).filter(entity => equiv(entity[field], value)); },"
           "")
         "    watch(fn) { watchers.push(fn); },"
         "    load(items) {"
         "      const nextEntities = new Map();"
         "      const nextIdentityIndex = new Map();"
         "      for (const row of items) {"
         "        const identity = row[identityField];"
         "        if (identity == null) { console.error('FRAM row is missing identity field', identityField); continue; }"
         "        const key = identityKey(identity);"
         "        const cachedEid = identityIndex.get(key);"
         "        const eid = cachedEid == null ? nextEid++ : cachedEid;"
         "        nextIdentityIndex.set(key, eid);"
         "        nextEntities.set(eid, materialize(row, eid));"
         "      }"
         "      entities.clear();"
         "      for (const [eid, entity] of nextEntities) entities.set(eid, entity);"
         "      identityIndex.clear();"
         "      for (const [identity, eid] of nextIdentityIndex) identityIndex.set(identity, eid);"
         "      notify({ type: 'load' });"
         "    }"
         "  };"
         "})();"])
      "\n")))

(defn gen-store-for [(ge Any) (fk-methods Any) (fram? Bool)] String
  (if fram?
    (gen-fram-store ge fk-methods)
    (gen-store (.-store-name ge) fk-methods)))

(defn gen-fram-connector
  [(entities Any)
   (all-entities Any)
   (publications Any)
   (semantic-fingerprint String)]
  String
  (let [bindings (.join
        (mapv (fn [ge] String
            (let [identity-field (.-identity-field ge)]
              (str "  [" (q (.-name ge)) ", { store: "
                   (store-ref (.-store-name ge))
                   ", identityField: "
                   (if (nil? identity-field) "null" (q (.-name identity-field)))
                   ", loadedVersion: '0' }]")))
            entities)
          ",\n")
        field-metas (.join
          (mapv (fn [ge] String
            (let [fields (.join
                           (mapv
                             (fn [field] String
                               (str "    [" (q (.-name field)) "]: "
                                    (fram-field-meta-expr field all-entities)))
                             (.-stored-fields ge))
                           ",\n")]
              (str "  [" (q (.-name ge)) "]: Object.assign(Object.create(null), {\n"
                   fields "\n  })")))
            entities)
          ",\n")
        publication-metas (.join
          (mapv
            (fn [publication] String
              (str "  [" (q (.-name publication)) "]: "
                   (fram-publication-meta-expr publication)))
            publications)
          ",\n")]
    (str "const wakeApplicationFingerprint = " (q semantic-fingerprint) ";\n"
         #r#"const wakeFramFieldMeta = Object.assign(Object.create(null), {
"#
         field-metas
         #r#"
});

function wakeFramCoerceScalar(raw, type) {
  if (type === 'Bool' || type === 'Boolean') {
    if (typeof raw === 'boolean') return raw;
    const booleanText = String(raw == null ? '' : raw).trim().toLowerCase();
    if (booleanText === 'true') return true;
    if (booleanText === 'false') return false;
    throw new Error(`Expected Bool input, received ${String(raw)}`);
  }

  const text = String(raw == null ? '' : raw).trim();
  if (type === 'Int' || type === 'Integer') {
    if (!/^(?:0|-[1-9][0-9]*|[1-9][0-9]*)$/.test(text)) {
      throw new Error(`Expected exact Int input, received ${text}`);
    }
    return text;
  }
  if (type === 'Float' || type === 'Double' || type === 'Number') {
    if (text === '') throw new Error('Expected numeric input');
    const number = Number(text);
    if (Object.is(raw, -0) || !Number.isFinite(number) || Object.is(number, -0)) {
      throw new Error(`Expected JSON-exact numeric input, received ${text}`);
    }
    return number;
  }
  if (type === 'Instant') {
    if (raw && typeof raw === 'object' && !Array.isArray(raw)) {
      return {
        epochSeconds: String(raw.epochSeconds).trim(),
        nanos: String(raw.nanos).trim(),
      };
    }
    const exact = /^(-?(?:0|[1-9][0-9]*)):(0|[1-9][0-9]*)$/.exec(text);
    if (exact) return { epochSeconds: exact[1], nanos: exact[2] };
    const millis = Date.parse(text);
    if (!Number.isFinite(millis)) {
      throw new Error(`Expected Instant as epochSeconds:nanos or ISO-8601, received ${text}`);
    }
    const epochSeconds = Math.floor(millis / 1000);
    const nanos = (millis - epochSeconds * 1000) * 1000000;
    return { epochSeconds: String(epochSeconds), nanos: String(nanos) };
  }
  return text;
}

function wakeFramCoerceValue(raw, meta) {
  if (!meta) throw new Error('Wake generated no field metadata for this mutation');
  if (meta.cardinality === 'multi') {
    const pieces = Array.isArray(raw)
      ? raw
      : String(raw == null ? '' : raw).split(',').map(piece => piece.trim()).filter(piece => piece.length > 0);
    return pieces.map(piece => wakeFramCoerceScalar(piece, meta.type));
  }
  return wakeFramCoerceScalar(raw, meta.type);
}

function wakeFramReadInput(input, meta) {
  const raw = input.type === 'checkbox' ? input.checked : input.value;
  return wakeFramCoerceValue(raw, meta);
}

function wakeFramInputValue(value, meta) {
  if (Array.isArray(value)) {
    return value.map(item => wakeFramInputValue(item, { ...meta, cardinality: 'single' })).join(', ');
  }
  if (meta && meta.type === 'Instant' && value && typeof value === 'object') {
    return `${String(value.epochSeconds)}:${String(value.nanos)}`;
  }
  return value == null ? '' : String(value);
}

function wakeFramCoerceValues(entity, rawValues) {
  const fields = wakeFramFieldMeta[entity];
  if (!fields) throw new Error(`Wake generated no metadata for entity ${entity}`);
  const values = Object.create(null);
  for (const [field, raw] of Object.entries(rawValues)) {
    values[field] = wakeFramCoerceValue(raw, fields[field]);
  }
  return values;
}

const wakeFramBindings = new Map([
"#
         bindings
         #r#"
]);
const wakeFramPublications = Object.assign(Object.create(null), {
"#
         publication-metas
         #r#"
});
const wakeFramHttpTimeoutMs = 10000;
let wakeFramServedVersion = '0';
let wakeFramPollTimer = null;
let wakeFramPolling = false;

function wakeFramCompareVersion(left, right) {
  const a = String(left == null ? '0' : left).replace(/^0+(?=\d)/, '');
  const b = String(right == null ? '0' : right).replace(/^0+(?=\d)/, '');
  if (a.length !== b.length) return a.length < b.length ? -1 : 1;
  return a === b ? 0 : (a < b ? -1 : 1);
}

function wakeFramAdvanceVersion(version) {
  if (wakeFramCompareVersion(version, wakeFramServedVersion) > 0) {
    wakeFramServedVersion = String(version);
  }
}

async function wakeFramPost(path, body) {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), wakeFramHttpTimeoutMs);
  try {
    const response = await fetch(path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...body, fingerprint: wakeApplicationFingerprint }),
      signal: controller.signal,
    });
    if (!response.ok) {
      const detail = await response.text();
      throw new Error(`Wake gateway ${response.status}: ${detail}`);
    }
    return await response.json();
  } finally {
    clearTimeout(timeout);
  }
}

async function wakeFramReload(entity) {
  const binding = wakeFramBindings.get(entity);
  if (!binding) return;
  const result = await wakeFramPost('/api/wake/query', { op: 'list', entity });
  if (!result || !Array.isArray(result.rows) || result.servedVersion == null) {
    throw new Error('Wake gateway returned an invalid list response');
  }
  const version = String(result.servedVersion);
  if (wakeFramCompareVersion(version, binding.loadedVersion) >= 0) {
    binding.store.load(result.rows);
    binding.loadedVersion = version;
  }
  return version;
}

async function wakeFramReloadAll() {
  const versions = await Promise.all(
    Array.from(wakeFramBindings.keys(), wakeFramReload),
  );
  if (versions.length === 0) return null;
  return versions.reduce((oldest, version) =>
    wakeFramCompareVersion(version, oldest) < 0 ? version : oldest
  );
}

async function wakeFramRefreshAfterCommand(entities) {
  try {
    await Promise.all(entities.map(wakeFramReload));
  } catch (error) {
    console.warn('FRAM command committed; refresh deferred to change polling:', error);
    if (!wakeFramPolling) wakeFramSchedulePoll(0);
  }
}

async function wakeFramCreate(entity, values) {
  const coercedValues = wakeFramCoerceValues(entity, values);
  const result = await wakeFramPost('/api/wake/command', {
    op: 'create', entity, values: coercedValues,
  });
  if (!result || result.servedVersion == null) {
    throw new Error('Wake gateway returned an invalid create response');
  }
  await wakeFramRefreshAfterCommand([entity]);
  return result;
}

async function wakeFramSet(entity, identity, field, value) {
  const fields = wakeFramFieldMeta[entity];
  const coercedValue = wakeFramCoerceValue(value, fields && fields[field]);
  const result = await wakeFramPost('/api/wake/command', {
    op: 'set', entity, identity, field, value: coercedValue,
  });
  if (!result || result.servedVersion == null) {
    throw new Error('Wake gateway returned an invalid set response');
  }
  await wakeFramRefreshAfterCommand([entity]);
  return result;
}

async function wakeFramPublish(name, row) {
  const publication = wakeFramPublications[name];
  if (!publication) throw new Error(`Wake generated no publication policy named ${name}`);
  const ownerBinding = wakeFramBindings.get(publication.owner.entity);
  const revisionBinding = wakeFramBindings.get(publication.revision.entity);
  if (!ownerBinding || !revisionBinding) {
    throw new Error(`Wake generated incomplete publication bindings for ${name}`);
  }
  const owner = row[publication.revision.ownerField];
  const revision = row[revisionBinding.identityField];
  if (owner == null || revision == null) {
    throw new Error(`Publication ${name} row is missing its owner or identity`);
  }

  await wakeFramReload(publication.owner.entity);
  const ownerRow = ownerBinding.store.all().find(candidate =>
    equiv(candidate[ownerBinding.identityField], owner)
  );
  if (!ownerRow) throw new Error(`Publication ${name} owner is not loaded`);
  const currentPointer = ownerRow[publication.owner.pointer];
  const result = await wakeFramPost('/api/wake/command', {
    op: 'publish',
    publication: name,
    owner,
    revision,
    expectedPointer: currentPointer == null ? null : currentPointer,
  });
  if (!result || result.servedVersion == null) {
    throw new Error('Wake gateway returned an invalid publish response');
  }
  await wakeFramRefreshAfterCommand([
    publication.owner.entity,
    publication.revision.entity,
  ]);
  return result;
}

function wakeFramAttachPublicationActions(entityName, row, inst, store) {
  const actions = document.createElement('div');
  actions.className = 'flex items-center justify-end gap-2 px-2';
  for (const [name, publication] of Object.entries(wakeFramPublications)) {
    if (publication.revision.entity !== entityName
        || row[publication.revision.stateField] !== publication.states.draft) continue;
    const revisionBinding = wakeFramBindings.get(publication.revision.entity);
    if (!revisionBinding) continue;
    const revision = row[revisionBinding.identityField];
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'px-3 py-1 text-sm font-medium bg-primary text-primary-foreground rounded-md hover:opacity-90 disabled:opacity-50';
    button.textContent = 'Publish';
    button.setAttribute('aria-label', `Publish ${String(revision)}`);
    button.dataset.wakePublication = name;
    let pending = false;
    let accepted = false;
    button.addEventListener('click', async event => {
      event.stopPropagation();
      if (pending) return;
      pending = true;
      button.disabled = true;
      store.commandStarted();
      try {
        await wakeFramPublish(name, row);
        accepted = true;
      } catch (error) {
        store.commandFailed(error);
      } finally {
        pending = false;
        if (!accepted && button.isConnected) button.disabled = false;
      }
    });
    actions.appendChild(button);
  }
  if (actions.childElementCount > 0) inst.el.appendChild(actions);
}

function wakeFramSchedulePoll(delayMs = 1000) {
  if (wakeFramPollTimer != null) clearTimeout(wakeFramPollTimer);
  wakeFramPollTimer = setTimeout(wakeFramPollChanges, delayMs);
}

async function wakeFramPollChanges() {
  if (wakeFramPolling) return;
  wakeFramPolling = true;
  if (wakeFramPollTimer != null) clearTimeout(wakeFramPollTimer);
  wakeFramPollTimer = null;
  const sinceVersion = wakeFramServedVersion;
  try {
    const result = await wakeFramPost('/api/wake/changes', {
      sinceVersion,
    });
    if (!result || result.servedVersion == null
        || (result.resync !== true && !Array.isArray(result.changes))) {
      throw new Error('Wake gateway returned an invalid changes response');
    }
    if (result.resync === true) {
      const loadedVersion = await wakeFramReloadAll();
      wakeFramAdvanceVersion(
        loadedVersion == null ? result.servedVersion : loadedVersion,
      );
    } else {
      const affected = new Set();
      for (const change of result.changes) {
        if (change && wakeFramBindings.has(change.entity)) affected.add(change.entity);
      }
      await Promise.all(Array.from(affected, wakeFramReload));
      wakeFramAdvanceVersion(result.servedVersion);
    }
  } catch (err) {
    wakeFramServedVersion = sinceVersion;
    console.error('FRAM change poll failed:', err);
  } finally {
    wakeFramPolling = false;
    wakeFramSchedulePoll();
  }
}

async function wakeFramStart() {
  try {
    const loadedVersion = await wakeFramReloadAll();
    if (loadedVersion != null) wakeFramServedVersion = loadedVersion;
  } catch (err) {
    console.error('FRAM initial load failed:', err);
  } finally {
    wakeFramSchedulePoll();
  }
}
"#)))

;; --- Detail panel ---

(defn gen-detail
  [(en String)
   (store-name String)
   (overview-fields Any)
   (derived-attrs Any)
   (related-info Any)
   (field-info Any)
   (g Any)
   (identity-name Any)
   (fram? Bool)
   (allow-delete Bool)]
  String
  (let [tab-active-cls "px-4 py-2 text-sm font-medium border-b-2 border-primary text-foreground"
        tab-inactive-cls "px-4 py-2 text-sm font-medium text-muted-foreground"
        delete-svg "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 6h18\"></path><path d=\"M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6\"></path><path d=\"M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2\"></path></svg>"
        close-svg "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>"
        container-ref (id->ref (str "ld-" en "-detail"))
        selected-reference
        (if (nil? identity-name)
          "selectedContact"
          (str store-name ".get(selectedContact)?.[" (q identity-name) "]"))

        ;; Delete cascade lines
        delete-lines
        (if allow-delete
          (.join
            (mapv (fn [ri] String
              (let [rel-store (store-ref (.-store ri))]
                (str "    for (const r of " rel-store ".by("
                     (q (.-fk-field ri)) ", selectedContact)) "
                     rel-store ".remove(r.eid);")))
              related-info)
            "\n")
          "")

        ;; Tab bar construction
        tab-bar-lines (str
          "  detailNodes.tabOverview = document.createElement('button');\n"
          "  detailNodes.tabOverview.textContent = 'Overview';\n"
          "  detailNodes.tabOverview.className = '" tab-active-cls "';\n"
          "  detailNodes.tabOverview.addEventListener('click', () => { activeTab = 'overview'; renderDetail(); });\n"
          "  tabBar.appendChild(detailNodes.tabOverview);\n"
          (.join
            (mapv (fn [ri] String
              (let [key (.-key ri)
                    key-ref (id->ref key)]
                (str "  detailNodes.tab_" key-ref " = document.createElement('button');\n"
                     "  detailNodes.tab_" key-ref ".textContent = " (q (titlecase key)) ";\n"
                     "  detailNodes.tab_" key-ref ".className = '" tab-inactive-cls "';\n"
                     "  detailNodes.tab_" key-ref ".addEventListener('click', () => { activeTab = " (q key) "; renderDetail(); });\n"
                     "  tabBar.appendChild(detailNodes.tab_" key-ref ");")))
              related-info)
            "\n"))

        ;; Overview field grid
        field-grid-lines (.join
          (mapv (fn [f] String
            (let [field-ref (id->ref f)]
              (str "  const " field-ref "Label = document.createElement('span');\n"
                   "  " field-ref "Label.className = 'text-xs font-medium uppercase text-muted-foreground';\n"
                   "  " field-ref "Label.textContent = " (q (titlecase f)) ";\n"
                   "  grid.appendChild(" field-ref "Label);\n"
                   "  detailNodes.field_" field-ref " = document.createElement('span');\n"
                   "  detailNodes.field_" field-ref ".className = 'text-sm';\n"
                   "  grid.appendChild(detailNodes.field_" field-ref ");\n"
                   "  makeEditable(detailNodes.field_" field-ref ", " (q f) ");")))
            overview-fields)
          "\n")

        ;; Derived field grid entries (non-editable)
        derived-grid-lines (.join
          (mapv (fn [da] String
            (let [dname (id->ref (.-name da))
                  label (titlecase (.replaceAll (.-name da) "-" " "))]
              (str "  const " dname "Label = document.createElement('span');\n"
                   "  " dname "Label.className = 'text-xs font-medium uppercase text-muted-foreground';\n"
                   "  " dname "Label.textContent = " (q label) ";\n"
                   "  grid.appendChild(" dname "Label);\n"
                   "  detailNodes.field_" dname " = document.createElement('span');\n"
                   "  detailNodes.field_" dname ".className = 'text-sm italic text-muted-foreground';\n"
                   "  grid.appendChild(detailNodes.field_" dname ");")))
            derived-attrs)
          "\n")

        ;; Related tab content areas
        related-content-lines (.join
          (mapv (fn [ri] String
            (let [key (.-key ri)
                  key-ref (id->ref key)
                  rel-en (.-entity ri)
                  rel-store (store-ref (.-store ri))
                  fk-field (.-fk-field ri)
                  rel-ge (graph-entity-named (.-entities g) rel-en)
                  add-fields
                  (if fram?
                    (fram-related-add-fields g rel-ge fk-field)
                    [])
                  identity-field (if (nil? rel-ge) nil (.-identity-field rel-ge))
                  related-identity-name
                  (if (nil? identity-field) "" (.-name identity-field))
                  content-prop (str key-ref "Content")
                  header-prop (str key-ref "Header")
                  list-prop (str key-ref "List")
                  input-prop (str key-ref "Input")
                  form-ref (id->ref (str "related/" key "/form"))
                  button-ref (id->ref (str "related/" key "/add"))
                  fram-inputs
                  (.join
                    (mapv
                      (fn [field] String
                        (let [field-name (.-name field)
                              input-ref
                              (id->ref
                                (str "related/" key "/" field-name "/input"))
                              label-ref (str input-ref "$label")
                              checkbox? (field-checkbox? field)]
                          (str "  const " label-ref
                               " = document.createElement('label');\n"
                               "  " label-ref ".className = 'text-xs font-medium uppercase text-muted-foreground';\n"
                               "  " label-ref ".textContent = "
                               (q (titlecase field-name)) ";\n"
                               "  " form-ref ".appendChild(" label-ref ");\n"
                               "  const " input-ref
                               " = document.createElement('input');\n"
                               (if checkbox?
                                 (str "  " input-ref ".type = 'checkbox';\n")
                                 (str "  " input-ref ".placeholder = "
                                      (q (titlecase field-name)) ";\n"))
                               "  " input-ref ".className = 'px-3 py-2 border border-input rounded-md bg-background text-foreground text-sm';\n"
                               "  " form-ref ".appendChild(" input-ref ");\n")))
                      add-fields)
                    "")
                  fram-values
                  (.join
                    (mapv
                      (fn [field] String
                        (let [field-name (.-name field)
                              input-ref
                              (id->ref
                                (str "related/" key "/" field-name "/input"))]
                          (str "      values[" (q field-name)
                               "] = wakeFramReadInput(" input-ref
                               ", wakeFramFieldMeta[" (q rel-en) "]["
                               (q field-name) "]);\n")))
                      add-fields)
                    "")
                  fram-clears
                  (.join
                    (mapv
                      (fn [field] String
                        (let [input-ref
                              (id->ref
                                (str "related/" key "/"
                                     (.-name field) "/input"))]
                          (if (field-checkbox? field)
                            (str "      " input-ref ".checked = false;\n")
                            (str "      " input-ref ".value = '';\n"))))
                      add-fields)
                    "")]
              (str
                "  detailNodes." content-prop " = document.createElement('div');\n"
                "  detailNodes." content-prop ".className = 'p-4 flex-1 overflow-y-auto flex flex-col';\n"
                "  detailNodes." content-prop ".style.display = 'none';\n"
                "  detailNodes." header-prop " = document.createElement('h3');\n"
                "  detailNodes." header-prop ".className = 'text-sm font-medium mb-2';\n"
                "  detailNodes." content-prop ".appendChild(detailNodes."
                header-prop ");\n"
                "  detailNodes." list-prop " = document.createElement('div');\n"
                "  detailNodes." list-prop ".className = 'flex-1 space-y-2 mb-3';\n"
                "  detailNodes." content-prop ".appendChild(detailNodes."
                list-prop ");\n"
                "  const " form-ref " = document.createElement('div');\n"
                "  " form-ref ".className = 'flex flex-col gap-2';\n"
                (if fram?
                  (str
                    fram-inputs
                    "  const " button-ref " = document.createElement('button');\n"
                    "  " button-ref ".type = 'button';\n"
                    "  " button-ref ".className = 'px-3 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:opacity-90 self-end';\n"
                    "  " button-ref ".textContent = 'Add';\n"
                    "  " button-ref ".addEventListener('click', async () => {\n"
                    "    if (!selectedContact) return;\n"
                    "    " button-ref ".disabled = true;\n"
                    "    try {\n"
                    "      const values = Object.create(null);\n"
                    fram-values
                    "      values[" (q fk-field) "] = " selected-reference ";\n"
                    "      if (String(values[" (q related-identity-name)
                    "] == null ? '' : values[" (q related-identity-name)
                    "]).trim() === '') return;\n"
                    "      await " rel-store ".add(values);\n"
                    fram-clears
                    "    } catch (error) {\n"
                    "      " rel-store ".commandFailed(error);\n"
                    "    } finally {\n"
                    "      " button-ref ".disabled = false;\n"
                    "    }\n"
                    "  });\n")
                  (str
                    "  detailNodes." input-prop
                    " = document.createElement('textarea');\n"
                    "  detailNodes." input-prop
                    ".className = 'flex-1 px-3 py-2 border border-input rounded-md bg-background text-foreground text-sm resize-none';\n"
                    "  detailNodes." input-prop ".placeholder = "
                    (q (str "Add a " rel-en "...")) ";\n"
                    "  detailNodes." input-prop ".rows = 2;\n"
                    "  " form-ref ".appendChild(detailNodes." input-prop ");\n"
                    "  const " button-ref " = document.createElement('button');\n"
                    "  " button-ref ".type = 'button';\n"
                    "  " button-ref ".className = 'px-3 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:opacity-90 self-end';\n"
                    "  " button-ref ".textContent = 'Add';\n"
                    "  " button-ref ".addEventListener('click', () => {\n"
                    "    const content = detailNodes." input-prop
                    ".value.trim();\n"
                    "    if (!content || !selectedContact) return;\n"
                    "    " rel-store ".add({ [" (q "content") "]: content, ["
                    (q fk-field) "]: selectedContact, [" (q "created-at")
                    "]: new Date().toISOString() });\n"
                    "    detailNodes." input-prop ".value = '';\n"
                    "  });\n"))
                "  " form-ref ".appendChild(" button-ref ");\n"
                "  detailNodes." content-prop ".appendChild(" form-ref ");\n"
                "  detailNodes.wrapper.appendChild(detailNodes."
                content-prop ");")))
            related-info)
          "\n")

        ;; Related tab render functions
        render-related-fns (.join
          (mapv (fn [ri] String
            (let [key (.-key ri)
                  key-ref (id->ref key)
                  rel-store (store-ref (.-store ri))
                  fk-field (.-fk-field ri)
                  display (or (.-display ri) [])
                  list-prop (str key-ref "List")
                  header-prop (str key-ref "Header")
                  render-fn (id->ref (str "render-related/" key))]
              (str "function " render-fn "() {\n"
