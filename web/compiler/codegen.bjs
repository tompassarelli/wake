                   "  if (!selectedContact) return;\n"
                   "  detailNodes." header-prop ".textContent = "
                   (q (str (titlecase key) " for ")) " + (" store-name
                   ".get(selectedContact)?.[" (q "name") "] || '');\n"
                   "  const items = " rel-store ".by(" (q fk-field) ", "
                   selected-reference ")"
                   (if fram?
                     ";\n"
                     (str ".sort((a, b) => (b[" (q "created-at")
                          "] || '').localeCompare(a[" (q "created-at")
                          "] || ''));\n"))
                   "  if (items.length === 0) {\n"
                   "    const empty = document.createElement('div');\n"
                   "    empty.className = 'text-sm text-muted-foreground';\n"
                   "    empty.textContent = " (q (str "No " key " yet")) ";\n"
                   "    detailNodes." list-prop ".appendChild(empty);\n"
                   "    return;\n"
