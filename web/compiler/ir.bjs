#lang beagle/js
(ns wake.ir)

;; IR data structures for the Wake compiler.
;; Produced by the reader, consumed by codegen.

(defrecord SourceSpan
  [source-id: String
   start-offset: Int
   end-offset: Int
   start-line: Int
   start-column: Int
   end-line: Int
   end-column: Int])
(defrecord IrSourceUnit
  [source-id: String
   path: String
   package-id: String
   package-version: String])
(defrecord IrProvenance [source: IrSourceUnit span: SourceSpan])
(defrecord IrDeclarationProvenance
  [kind: String
   name: String
   provenance: IrProvenance])

(defrecord IrEntityRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrFieldRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrStateRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrStateValueRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrValueTypeRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrProviderPortRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrRendererRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrCapabilityRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrQueryRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrCommandRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrComponentRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrViewRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrRouteTemplateRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrEntityFieldsPortRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrComponentSlotRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrRouteSlotRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrPluginUseRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrIntRoleRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrStringRoleRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrBoolRoleRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrKeywordRoleRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrEntityNameRoleRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrFieldNameRoleRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrStateNameRoleRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrStateValueNameRoleRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrExternalEntityRoleRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrValueRoleRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedIntRoleRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedStringRoleRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedBoolRoleRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedKeywordRoleRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedEntityNameRoleRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedFieldNameRoleRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedStateNameRoleRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedStateValueNameRoleRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedExternalEntityRoleRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedValueRoleRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedProviderPortRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedEntityFieldsPortRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedComponentSlotRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrImportedRouteSlotRef
  [use: IrPluginUseRef
   declaration-id: String
   name: String
   provenance-token: String])

(defunion IrAuthoritySpec
  (IrFramAuthority [service: String])
  (IrLocalStorageAuthority [namespace: String])
  (IrMemoryAuthority [namespace: String]))

(defrecord IrStorageSpec [entity: IrEntityRef storage-id: String])
(defrecord IrIdentitySpec [entity: IrEntityRef field: IrFieldRef])
(defunion IrEntityReferenceTarget
  (IrDeclaredEntityTarget [entity: IrEntityRef])
  (IrExternalEntityTarget [role: IrExternalEntityRoleRef]))
(defunion IrFieldCardinality
  (IrSingleField [unit: Nil])
  (IrManyField [unit: Nil]))
(defunion IrFieldWriteMode
  (IrIdentityWrite [unit: Nil])
  (IrCreateWrite [unit: Nil])
  (IrCommandWrite [unit: Nil])
  (IrServerWrite [unit: Nil]))
(defunion IrFieldValueType
  (IrStringField [unit: Nil])
  (IrIntField [unit: Nil])
  (IrBoolField [unit: Nil])
  (IrKeywordField [unit: Nil])
  (IrInstantField [unit: Nil])
  (IrDigestField [unit: Nil])
  (IrStateField [state: IrStateRef])
  (IrRefField [target: IrEntityReferenceTarget])
  (IrValueField [value-type: IrValueTypeRef]))
(defrecord IrFieldSpec
  [ref: IrFieldRef
   owner: IrEntityRef
   value-type: IrFieldValueType
   cardinality: IrFieldCardinality
   write: IrFieldWriteMode
   storage-id: String?
   required: Bool])
(defrecord IrEntityDeclarationSpec
  [ref: IrEntityRef
   record-name: String
   fields: (Vec IrFieldSpec)
   storage-id: String?])
(defrecord IrStateValueSpec
  [ref: IrStateValueRef
   state: IrStateRef
   value: String])
(defrecord IrStateTransitionSpec
  [from: IrStateValueRef
   to: (Vec IrStateValueRef)])
(defrecord IrStateDeclarationSpec
  [ref: IrStateRef
   values: (Vec IrStateValueSpec)
   initial: IrStateValueRef
   transitions: (Vec IrStateTransitionSpec)])

(defrecord IrConfigProjection [role: IrValueRoleRef path: (Vec String)])

(defunion IrCommandExpr
  (IrCommandInputExpr [name: String])
  (IrCommandInjectedExpr [name: String])
  (IrCommandStringExpr [value: String])
  (IrCommandIntExpr [value: Int])
  (IrCommandBoolExpr [value: Bool])
  (IrCommandKeywordExpr [value: String])
  (IrCommandNilExpr [unit: Nil])
  (IrCommandActorExpr [field: String])
  (IrCommandReceiptTimeExpr [unit: Nil])
  (IrCommandRecordExpr [fields: (Vec IrCommandRecordField)])
  (IrCommandExtensionExpr [port: IrEntityFieldsPortRef input: String])
  (IrCommandConfiguredExpr [projection: IrConfigProjection])
  (IrCommandStateValueExpr [value: IrStateValueRef]))
(defrecord IrCommandRecordField [name: String value: IrCommandExpr])
(defunion IrCommandPredicate
  (IrEqualPredicate [left: IrCommandExpr right: IrCommandExpr])
  (IrNonNullPredicate [value: IrCommandExpr])
  (IrNotContainsPredicate [collection: IrCommandExpr value: IrCommandExpr]))
(defrecord IrCommandGuardSpec
  [entity: IrEntityRef
   id: IrCommandExpr
   field: IrFieldRef
   expected: IrCommandExpr
   when: IrCommandPredicate?])
(defrecord IrCommandWrite
  [field: IrFieldRef
   value: IrCommandExpr
   allowed-current: IrCommandExpr?
   omit-if-null: Bool])
(defunion IrCommandStep
  (IrAssertStep [predicate: IrCommandPredicate])
  (IrRequireStep
    [entity: IrEntityRef
     id: IrCommandExpr
     when: IrCommandPredicate?])
  (IrRequireEachStep [entity: IrEntityRef ids: IrCommandExpr])
  (IrGuardStep [guard: IrCommandGuardSpec])
  (IrCreateStep
    [entity: IrEntityRef
     id: IrCommandExpr
     fields: (Vec IrCommandWrite)])
  (IrUpdateStep
    [entity: IrEntityRef
     id: IrCommandExpr
     fields: (Vec IrCommandWrite)
     when: IrCommandPredicate?]))
(defunion IrInputNormalization
  (IrSortUniqueInput [unit: Nil]))
(defrecord IrCommandInputField
  [name: String
   value-type: IrValueTypeSpec
   normalization: IrInputNormalization?])
(defunion IrCommandInjection
  (IrGeneratedIdInjection [name: String])
  (IrProviderInjection
    [name: String
     port: IrProviderPortRef
     input: IrCommandExpr
     output: IrValueTypeSpec])
  (IrValidateWithInjection [port: IrProviderPortRef input: IrCommandExpr])
  (IrCanonicalDigestInjection [name: String input: IrCommandExpr]))
(defrecord IrCommandResultField
  [name: String
   value-type: IrValueTypeSpec
   value: IrCommandExpr])
(defrecord IrReceiptResultField
  [name: String
   field: IrFieldRef
   value-type: IrValueTypeSpec
   target: IrEntityRef?])
(defrecord IrReceiptSpec
  [results: (Vec IrReceiptResultField)
   extensions: (Vec IrEntityFieldsPortRef)])
(defrecord IrCommandSpec
  [ref: IrCommandRef
   capabilities: (Vec IrCapabilityRef)
   normalizer-version: Int
   input: (Vec IrCommandInputField)
   injections: (Vec IrCommandInjection)
   steps: (Vec IrCommandStep)
   result: (Vec IrCommandResultField)
   receipt: IrReceiptSpec])
(defrecord IrCapabilitySpec
  [ref: IrCapabilityRef
   guards: (Vec IrCommandGuardSpec)])

(defrecord IrValueRecordEntry [name: String value: IrValueExpr])
(defunion IrValueExpr
  (IrLiteralStringValue [value: String])
  (IrLiteralIntegerValue [value: Int])
  (IrLiteralBooleanValue [value: Bool])
  (IrLiteralKeywordValue [value: String])
  (IrLiteralNilValue [unit: Nil])
  (IrRecordValue [fields: (Vec IrValueRecordEntry)])
  (IrListValue [items: (Vec IrValueExpr)])
  (IrBoundFieldValue [field: IrFieldRef])
  (IrConfigValue [role: IrValueRoleRef])
  (IrConfigProjectionValue [projection: IrConfigProjection]))

(defrecord IrValueRecordField
  [name: String
   value-type: IrValueTypeSpec
   required: Bool])
(defrecord IrValueTaggedVariant [tag: String fields: (Vec IrValueRecordField)])
(defunion IrValueLiteral
  (IrStringLiteral [value: String])
  (IrIntegerLiteral [value: Int])
  (IrBooleanLiteral [value: Bool])
  (IrKeywordLiteral [value: String])
  (IrNilLiteral [unit: Nil]))
(defunion IrValueTypeSpec
  (IrStringValueType
    [minimum-scalars: IrBoundInt?
     maximum-scalars: IrBoundInt?
     maximum-bytes: IrBoundInt?])
  (IrIntegerValueType [minimum: IrBoundInt? maximum: IrBoundInt?])
  (IrBooleanValueType [unit: Nil])
  (IrDigestValueType [unit: Nil])
  (IrInstantValueType [unit: Nil])
  (IrKeywordValueType [allowed: (Vec String)])
  (IrEntityReferenceValueType [entity: IrEntityRef])
  (IrStateValueType [state: IrStateRef])
  (IrRecordValueType [fields: (Vec IrValueRecordField)])
  (IrTaggedValueType [tag-field: String variants: (Vec IrValueTaggedVariant)])
  (IrListValueType
    [item: IrValueTypeSpec
     minimum-items: IrBoundInt?
     maximum-items: IrBoundInt?])
  (IrExtensionValueType [port: IrEntityFieldsPortRef])
  (IrNullableValueType [value-type: IrValueTypeSpec])
  (IrNamedValueType [value-type: IrValueTypeRef])
  (IrLiteralValueType [literal: IrValueLiteral]))

(defrecord IrValueTypeDefinition [ref: IrValueTypeRef spec: IrValueTypeSpec])
(defrecord IrValueEnvelopeSpec
  [maximum-bytes: IrBoundInt
   maximum-depth: IrBoundInt
   maximum-nodes: IrBoundInt])
(defrecord IrValueTypeDeclarationSpec
  [root: IrValueTypeRef
   definitions: (Vec IrValueTypeDefinition)
   envelope: IrValueEnvelopeSpec?])

(defrecord IrQueryParameterSpec [name: String value-type: IrValueTypeSpec])
(defrecord IrQueryBindingSpec [name: String entity: IrEntityRef])
(defunion IrQueryValueExpr
  (IrQueryFieldValue [binding: String field: IrFieldRef])
  (IrQueryParameterValue [name: String])
  (IrQueryBindingValue [name: String])
  (IrQueryStringValue [value: String])
  (IrQueryIntegerValue [value: Int])
  (IrQueryBooleanValue [value: Bool])
  (IrQueryKeywordValue [value: String])
  (IrQueryNilValue [unit: Nil])
  (IrQueryRecordValue [fields: (Vec IrQueryRecordField)])
  (IrQueryListValue [items: (Vec IrQueryValueExpr)])
  (IrQueryConfiguredValue [projection: IrConfigProjection])
  (IrQueryStateValue [value: IrStateValueRef]))
(defrecord IrQueryRecordField [name: String value: IrQueryValueExpr])
(defunion IrQueryPredicateSpec
  (IrQueryEqualPredicate [left: IrQueryValueExpr right: IrQueryValueExpr])
  (IrQueryContainsPredicate
    [collection: IrQueryValueExpr
     value: IrQueryValueExpr])
  (IrQueryNonNullPredicate [value: IrQueryValueExpr]))
(defunion IrQuerySelectionSpec
  (IrQueryValueSelection [name: String value: IrQueryValueExpr])
  (IrQueryProviderSelection
    [name: String
     provider: IrProviderPortRef
     input: IrQueryValueExpr
     output: IrValueTypeSpec])
  (IrQueryExtensionSelection [port: IrEntityFieldsPortRef binding: String]))
(defunion IrQueryResultSpec
  (IrQueryPageResult [default-limit: IrBoundInt max-limit: IrBoundInt])
  (IrQueryOptionalResult [unit: Nil])
  (IrQueryOneResult [unit: Nil]))
(defrecord IrQueryDeclarationSpec
  [ref: IrQueryRef
   capabilities: (Vec IrCapabilityRef)
   parameters: (Vec IrQueryParameterSpec)
   bindings: (Vec IrQueryBindingSpec)
   predicates: (Vec IrQueryPredicateSpec)
   selection: (Vec IrQuerySelectionSpec)
   result: IrQueryResultSpec])

(defrecord IrProviderPortSpec
  [ref: IrProviderPortRef
   input-type: IrValueTypeSpec
   output-type: IrValueTypeSpec
   capability: IrCapabilityRef?])
(defrecord IrRendererSpec
  [ref: IrRendererRef
   input-type: IrValueTypeSpec
   component: IrComponentRef])

(defrecord IrFieldRequirement
  [name: String
   value-type: IrFieldValueType
   cardinality: IrFieldCardinality
   write: IrFieldWriteMode])
(defunion IrEntityFieldsPortPolicy
  (IrClosedEntityFieldsPort [unit: Nil])
  (IrOpenManyEntityFields [write: IrFieldWriteMode require-storage-id: Bool]))
(defrecord IrEntityFieldsPortSpec
  [ref: IrEntityFieldsPortRef
   target: IrEntityRef
   requirements: (Vec IrFieldRequirement)
   policy: IrEntityFieldsPortPolicy])
(defrecord IrComponentSlotSpec [ref: IrComponentSlotRef target: IrComponentRef])
(defrecord IrRouteSlotSpec [ref: IrRouteSlotRef target: IrRouteTemplateRef])

(defrecord IrPluginIdentity
  [package-id: String
   version: String
   compatible-wake: String
   plugin-abi-version: Int
   durable-schema-version: Int
   provenance-token: String])

(defrecord IrIntRoleSpec
  [ref: IrIntRoleRef
   minimum: Int?
   maximum: Int?])
(defrecord IrStringRoleSpec
  [ref: IrStringRoleRef
   min-scalars: Int?
   max-scalars: Int?
   max-bytes: Int?])
(defrecord IrBoolRoleSpec [ref: IrBoolRoleRef])
(defrecord IrKeywordRoleSpec [ref: IrKeywordRoleRef allowed: (Vec String)])
(defrecord IrEntityNameRoleSpec [ref: IrEntityNameRoleRef target: IrEntityRef])
(defrecord IrFieldNameRoleSpec [ref: IrFieldNameRoleRef target: IrFieldRef])
(defrecord IrStateNameRoleSpec [ref: IrStateNameRoleRef target: IrStateRef])
(defrecord IrStateValueNameRoleSpec
  [ref: IrStateValueNameRoleRef
   target: IrStateValueRef])
(defrecord IrExternalEntityRoleSpec [ref: IrExternalEntityRoleRef])
(defrecord IrValueRoleSpec [ref: IrValueRoleRef value-type: IrValueTypeSpec])
(defrecord IrPluginConfigurationSchema
  [ints: (Vec IrIntRoleSpec)
   strings: (Vec IrStringRoleSpec)
   bools: (Vec IrBoolRoleSpec)
   keywords: (Vec IrKeywordRoleSpec)
   entity-names: (Vec IrEntityNameRoleSpec)
   field-names: (Vec IrFieldNameRoleSpec)
   state-names: (Vec IrStateNameRoleSpec)
   state-value-names: (Vec IrStateValueNameRoleSpec)
   external-entities: (Vec IrExternalEntityRoleSpec)
   values: (Vec IrValueRoleSpec)])
(defunion IrBoundInt
  (IrLiteralBound [value: Int])
  (IrConfiguredBound [role: IrIntRoleRef])
  (IrConfiguredProjectionBound [projection: IrConfigProjection]))
(defrecord IrIntBinding [role: IrImportedIntRoleRef value: Int])
(defrecord IrStringBinding [role: IrImportedStringRoleRef value: String])
(defrecord IrBoolBinding [role: IrImportedBoolRoleRef value: Bool])
(defrecord IrKeywordBinding [role: IrImportedKeywordRoleRef value: String])
(defrecord IrEntityNameBinding
  [role: IrImportedEntityNameRoleRef
   value: IrEntityRef])
(defrecord IrFieldNameBinding
  [role: IrImportedFieldNameRoleRef
   value: IrFieldRef])
(defrecord IrStateNameBinding
  [role: IrImportedStateNameRoleRef
   value: IrStateRef])
(defrecord IrStateValueNameBinding
  [role: IrImportedStateValueNameRoleRef
   value: IrStateValueRef])
(defrecord IrExternalEntityBinding
  [role: IrImportedExternalEntityRoleRef
   value: IrEntityRef])
(defrecord IrValueBinding [role: IrImportedValueRoleRef value: IrValueExpr])
(defrecord IrPluginBindings
  [ints: (Vec IrIntBinding)
   strings: (Vec IrStringBinding)
   bools: (Vec IrBoolBinding)
   keywords: (Vec IrKeywordBinding)
   entity-names: (Vec IrEntityNameBinding)
   field-names: (Vec IrFieldNameBinding)
   state-names: (Vec IrStateNameBinding)
   state-value-names: (Vec IrStateValueNameBinding)
   external-entities: (Vec IrExternalEntityBinding)
   values: (Vec IrValueBinding)])

(defunion IrContributionKind
  (IrSchemaContribution [unit: Nil])
  (IrQueryContribution [unit: Nil])
  (IrCommandContribution [unit: Nil])
  (IrCapabilityContribution [unit: Nil])
  (IrUiContribution [unit: Nil])
  (IrRouteContribution [unit: Nil]))
(defrecord IrMigrationSpec
  [from-version: Int
   to-version: Int
   ordinal: Int
   command: IrCommandRef])

(defrecord IrPluginExports
  [entities: (Vec IrEntityRef)
   fields: (Vec IrFieldRef)
   states: (Vec IrStateRef)
   state-values: (Vec IrStateValueRef)
   value-types: (Vec IrValueTypeRef)
   provider-ports: (Vec IrProviderPortRef)
   renderers: (Vec IrRendererRef)
   capabilities: (Vec IrCapabilityRef)
   queries: (Vec IrQueryRef)
   commands: (Vec IrCommandRef)
   components: (Vec IrComponentRef)
   views: (Vec IrViewRef)
   route-templates: (Vec IrRouteTemplateRef)
   entity-fields-ports: (Vec IrEntityFieldsPortRef)
   component-slots: (Vec IrComponentSlotRef)
   route-slots: (Vec IrRouteSlotRef)])

(defrecord IrPluginSpec
  [identity: IrPluginIdentity
   contributions: (Vec IrContributionKind)
   configuration: IrPluginConfigurationSchema
   exports: IrPluginExports
   required-providers: (Vec IrProviderPortRef)
   migrations: (Vec IrMigrationSpec)])

(defrecord IrPluginUseSpec
  [ref: IrPluginUseRef
   package-id: String
   version: String
   allow: (Vec IrContributionKind)
   bindings: IrPluginBindings])
(defrecord IrProviderBindingSpec [name: String port: IrImportedProviderPortRef])
(defrecord IrNamedFieldSupply [name: String field: IrFieldRef])
(defrecord IrExtendSpec
  [port: IrImportedEntityFieldsPortRef
   fields: (Vec IrNamedFieldSupply)])
(defrecord IrFillSpec
  [slot: IrImportedComponentSlotRef
   component: IrComponentRef])
(defrecord IrMountSpec [slot: IrImportedRouteSlotRef path: String])

(defrecord IrPluginComposition
  [use: IrPluginUseSpec
   providers: (Vec IrProviderBindingSpec)
   extensions: (Vec IrExtendSpec)
   fills: (Vec IrFillSpec)
   mounts: (Vec IrMountSpec)])
(defunion IrDefaultRouteTarget
  (IrLocalDefaultRoute [route: IrRouteTemplateRef])
  (IrMountedDefaultRoute [slot: IrImportedRouteSlotRef]))
(defrecord IrApplicationRootSpec
  [id: String
   authority: IrAuthoritySpec
   storage: (Vec IrStorageSpec)
   identities: (Vec IrIdentitySpec)
   plugins: (Vec IrPluginComposition)
   default-route: IrDefaultRouteTarget?])

(defunion IrUiAttrSpec
  (IrStaticUiAttr [value: String])
  (IrBoundUiAttr [property: String]))
(defunion IrUiConditionSpec
  (IrUiPropertyPresent [property: String])
  (IrUiQueryPredicate [predicate: IrQueryPredicateSpec]))
(defunion IrDeclarationUiNode
  (IrDeclarationElement
    [tag: String
     attrs: (Map String IrUiAttrSpec)
     children: (Vec IrDeclarationUiNode)])
  (IrDeclarationWhen
    [condition: IrUiConditionSpec
     children: (Vec IrDeclarationUiNode)]))
(defrecord IrComponentPropertySpec [name: String value-type: IrValueTypeSpec])
(defrecord IrComponentDeclarationSpec
  [ref: IrComponentRef
   properties: (Vec IrComponentPropertySpec)
   body: (Vec IrDeclarationUiNode)])
(defrecord IrViewDeclarationSpec
  [ref: IrViewRef
   entity: IrEntityRef
   component: IrComponentRef
   title: String])
(defrecord IrRouteQuerySpec [query: IrQueryRef alias: String?])
(defrecord IrRouteParameterSpec [name: String value-type: IrValueTypeSpec])
(defrecord IrRouteTemplateSpec
  [ref: IrRouteTemplateRef
   view: IrViewRef
   queries: (Vec IrRouteQuerySpec)
   parameters: (Vec IrRouteParameterSpec)])

(defunion IrDeclarationRoot
  (IrPluginDeclarationRoot [plugin: IrPluginSpec])
  (IrApplicationDeclarationRoot [application: IrApplicationRootSpec]))

(defrecord IrDeclarationProgram
  [source-unit: IrSourceUnit
   ns: String
   root: IrDeclarationRoot
   entities: (Vec IrEntityDeclarationSpec)
   states: (Vec IrStateDeclarationSpec)
   value-types: (Vec IrValueTypeDeclarationSpec)
   provider-ports: (Vec IrProviderPortSpec)
   renderers: (Vec IrRendererSpec)
   capabilities: (Vec IrCapabilitySpec)
   queries: (Vec IrQueryDeclarationSpec)
   commands: (Vec IrCommandSpec)
   components: (Vec IrComponentDeclarationSpec)
   views: (Vec IrViewDeclarationSpec)
   route-templates: (Vec IrRouteTemplateSpec)
   entity-fields-ports: (Vec IrEntityFieldsPortSpec)
   component-slots: (Vec IrComponentSlotSpec)
   route-slots: (Vec IrRouteSlotSpec)])

(defrecord IrApplication [id: String span: SourceSpan])
(defrecord IrUseConfig [key: String value: Any])
(defrecord IrUse
  [package-id: String
   alias: String
   version: String
   allow: (Vec String)
   config: (Vec IrUseConfig)
   span: SourceSpan])
(defrecord IrProvider
  [name: String
   port: String
   package-id: String
   port-name: String
   span: SourceSpan])
(defrecord IrFill
  [port: String
   component: String
   span: SourceSpan])
(defrecord IrMount
  [port: String
   path: String
   parameters: (Vec String)
   span: SourceSpan])
(defrecord IrAttr
  [name: String
   storage-id: String?
   type: String
   opts: Any])
(defrecord IrDerivedExpr
  [kind: String
   field: String?
   value: String?
   parts: (Vec IrDerivedExpr)])
(defrecord IrExtend
  [port: String
   fields: (Vec IrAttr)
   span: SourceSpan])
(defrecord IrEntity
  [name: String
   storage-id: String?
   attrs: (Vec IrAttr)])
(defrecord IrBackend [kind: String])
(defrecord IrPersist [storage: String key: String])
(defrecord IrDefstate
  [name: String
   transitions: (Map String (Vec String))
   initial: String])
(defrecord IrPublication
  [name: String
   owner-entity: String
   pointer-field: String
   revision-entity: String
   owner-field: String
   state-field: String
   draft-state: String
   published-state: String
   retired-state: String])
(defrecord IrQueryParam [name: String type: String])
(defrecord IrQueryBinding [name: String entity-name: String])
(defrecord IrQueryOperand
  [kind: String
   name: String?
   binding: String?
   field: String?
   value: Any])
(defrecord IrQueryPredicate
  [op: String
   left: IrQueryOperand
   right: IrQueryOperand])
(defrecord IrQuerySelect
  [name: String
   binding: String
   field: String])
(defrecord IrQueryFieldSplice [port: String binding: String])
(defrecord IrQueryProvided
  [name: String
   provider: String
   input: Any])
(defrecord IrQueryPage [default-limit: Int max-limit: Int])
(defrecord IrQuery
  [name: String
   capabilities: (Vec String)
   params: (Vec IrQueryParam)
   bindings: (Vec IrQueryBinding)
   predicates: (Vec IrQueryPredicate)
   selection: (Vec Any)
   result-kind: String
   page: IrQueryPage?])
(defrecord IrDetailTab
  [label: String
   content-type: String
   fields: (Vec String)
   entity-name: String?
   relation-field: String?
   infer-relation: Bool
   display-fields: (Vec String)])
(defrecord IrListDetail
  [entity-name: String
   title: String
   columns: (Vec String)
   search-cols: (Vec String)
   detail-tabs: (Vec IrDetailTab)])
(defrecord IrSmartForm
  [name: String
   entity-name: String
   fields: (Vec String)
   required: (Vec String)
   submit-label: String
   on-success: String])
(defrecord IrTheme [colors: (Map String String)])
;; An event handler effect: checked verb plus arguments.
;; Rides inside an element's attrs map under an "on-<event>" key.
(defrecord IrAction [verb: String args: Any])
;; Fields repeated inline (not just member names): the cross-module defunion
;; interface only carries constructor arity when fields ride on the member
;; form itself, not via a separate same-name defrecord.
(defunion IrNode
  (IrElement
    [tag: String
     attrs: Any
     children: Any])
  (IrWhen [prop: String children: Any]))
(defrecord IrComponent
  [name: String
   props: (Vec String)
   body: (Vec IrElement)])
(defrecord IrRelatedTab
  [label: String
   entity-name: String
   ref-field: String
   filter: String?
   display-fields: (Vec String)])
(defrecord IrView
  [name: String
   entity-name: String
   component: String
   add-fields: (Vec String)
   title: String
   select-component: String?
   tabs: (Vec IrRelatedTab)
   filters: (Vec String)
   date-filters: (Vec String)])
(defrecord IrRouteQuery [name: String prefix: String?])
(defrecord IrRoute
  [path: String
   view-name: String
   queries: (Vec IrRouteQuery)
   parameters: (Vec String)
   input-parameters: (Vec String)
   required-props: (Vec String)])
(defrecord IrRouter [default-route: String routes: (Vec IrRoute)])
(defrecord IrNavGroup [label: String items: (Vec String)])
(defrecord IrLayout
  [style: String
   title: String?
   groups: (Vec IrNavGroup)])
(defrecord IrProgram
  [source-unit: IrSourceUnit
   application: IrApplication?
   uses: (Vec IrUse)
   providers: (Vec IrProvider)
   value-types: (Vec Any)
   provider-ports: (Vec Any)
   extends: (Vec IrExtend)
   fills: (Vec IrFill)
   mounts: (Vec IrMount)
   declaration-provenance: (Vec IrDeclarationProvenance)
   ns: String
   backend: IrBackend?
   entities: (Vec IrEntity)
   persist: IrPersist?
   defstates: (Vec IrDefstate)
   publications: (Vec IrPublication)
   queries: (Vec IrQuery)
   commands: (Vec Any)
   list-details: (Vec IrListDetail)
   forms: (Vec IrSmartForm)
   theme: IrTheme?
   components: (Vec IrComponent)
   views: (Vec IrView)
   router: IrRouter?
   layout: IrLayout?])
