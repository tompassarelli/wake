#lang beagle/js
(ns wake.ir)

;; IR data structures for the Wake compiler.
;; Produced by the reader, consumed by codegen.

(defrecord SourceSpan
  [source-id: String
   start-offset: Int
   end-offset: Int
   start-line: Int
   start-column: Int
   end-line: Int
   end-column: Int])
(defrecord IrSourceUnit
  [source-id: String
   path: String
   package-id: String
   package-version: String])
(defrecord IrProvenance [source: IrSourceUnit span: SourceSpan])
(defrecord IrDeclarationProvenance
  [kind: String
   name: String
   provenance: IrProvenance])

(defrecord IrEntityRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrFieldRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrStateRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrStateValueRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrValueTypeRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrProviderPortRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrRendererRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrCapabilityRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrQueryRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrCommandRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrComponentRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrViewRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrRouteTemplateRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrEntityFieldsPortRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrComponentSlotRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrRouteSlotRef
  [declaration-id: String
   name: String
   provenance-token: String])
(defrecord IrPluginUseRef
  [declaration-id: String
   name: String
   provenance-token: String])

(defunion IrAuthoritySpec
  (IrFramAuthority [service: String])
  (IrLocalStorageAuthority [namespace: String])
  (IrMemoryAuthority [namespace: String]))

(defrecord IrStorageSpec [entity: IrEntityRef storage-id: String])
(defrecord IrIdentitySpec [entity: IrEntityRef field: IrFieldRef])
(defrecord IrApplicationRootSpec
  [id: String
   authority: IrAuthoritySpec
   storage: (Vec IrStorageSpec)
   identities: (Vec IrIdentitySpec)])

(defunion IrValueExpr
  (IrLiteralStringValue [value: String])
  (IrLiteralIntegerValue [value: Int])
  (IrLiteralBooleanValue [value: Bool])
  (IrLiteralKeywordValue [value: String])
  (IrBoundFieldValue [field: IrFieldRef])
  (IrConfigValue [key: String value-type: IrValueTypeRef]))

(defunion IrValueTypeSpec
  (IrStringValueType [unit: Nil])
  (IrIntegerValueType [unit: Nil])
  (IrBooleanValueType [unit: Nil])
  (IrKeywordValueType [unit: Nil])
  (IrEntityReferenceValueType [entity: IrEntityRef])
  (IrOptionalValueType [value-type: IrValueTypeRef])
  (IrManyValueType [value-type: IrValueTypeRef]))

(defrecord IrProviderPortSpec
  [ref: IrProviderPortRef
   input-type: IrValueTypeRef
   output-type: IrValueTypeRef
   capability: IrCapabilityRef])
(defrecord IrRendererSpec
  [ref: IrRendererRef
   input-type: IrValueTypeRef
   component: IrComponentRef])

(defrecord IrPluginIdentity
  [package-id: String
   version: String
   provenance-token: String])

(defunion IrPluginConfigRole
  (IrIntConfigRole [unit: Nil])
  (IrStringConfigRole [unit: Nil])
  (IrBoolConfigRole [unit: Nil])
  (IrKeywordConfigRole [unit: Nil])
  (IrEntityConfigRole [unit: Nil])
  (IrFieldConfigRole [unit: Nil])
  (IrStateConfigRole [unit: Nil])
  (IrStateValueConfigRole [unit: Nil])
  (IrExternalEntityConfigRole [unit: Nil]))

(defunion IrPluginConfigValue
  (IrIntConfigValue [value: Int])
  (IrStringConfigValue [value: String])
  (IrBoolConfigValue [value: Bool])
  (IrKeywordConfigValue [value: String])
  (IrEntityConfigValue [value: IrEntityRef])
  (IrFieldConfigValue [value: IrFieldRef])
  (IrStateConfigValue [value: IrStateRef])
  (IrStateValueConfigValue [value: IrStateValueRef])
  (IrExternalEntityConfigValue [value: IrEntityRef]))

(defrecord IrPluginConfigurationField
  [key: String
   role: IrPluginConfigRole
   required: Bool])
(defrecord IrPluginConfigurationSchema
  [fields: (Vec IrPluginConfigurationField)])
(defrecord IrPluginConfigurationBinding [key: String value: IrPluginConfigValue])

(defrecord IrPluginExports
  [entities: (Vec IrEntityRef)
   fields: (Vec IrFieldRef)
   states: (Vec IrStateRef)
   state-values: (Vec IrStateValueRef)
   value-types: (Vec IrValueTypeRef)
   provider-ports: (Vec IrProviderPortRef)
   renderers: (Vec IrRendererRef)
   capabilities: (Vec IrCapabilityRef)
   queries: (Vec IrQueryRef)
   commands: (Vec IrCommandRef)
   components: (Vec IrComponentRef)
   views: (Vec IrViewRef)
   route-templates: (Vec IrRouteTemplateRef)
   entity-fields-ports: (Vec IrEntityFieldsPortRef)
   component-slots: (Vec IrComponentSlotRef)
   route-slots: (Vec IrRouteSlotRef)])

(defrecord IrPluginSpec
  [identity: IrPluginIdentity
   configuration: IrPluginConfigurationSchema
   exports: IrPluginExports])

(defunion IrPluginContribution
  (IrEntityFieldsContribution
    [port: IrEntityFieldsPortRef
     fields: (Vec IrFieldRef)])
  (IrComponentSlotContribution
    [slot: IrComponentSlotRef
     component: IrComponentRef])
  (IrRouteSlotContribution [slot: IrRouteSlotRef route: IrRouteTemplateRef]))

(defrecord IrPluginComposition
  [use: IrPluginUseRef
   configuration: (Vec IrPluginConfigurationBinding)
   contributions: (Vec IrPluginContribution)])

(defrecord IrApplication [id: String span: SourceSpan])
(defrecord IrUseConfig [key: String value: Any])
(defrecord IrUse
  [package-id: String
   alias: String
   version: String
   allow: (Vec String)
   config: (Vec IrUseConfig)
   span: SourceSpan])
(defrecord IrProvider
  [name: String
   port: String
   package-id: String
   port-name: String
   span: SourceSpan])
(defrecord IrFill
  [port: String
   component: String
   span: SourceSpan])
(defrecord IrMount
  [port: String
   path: String
   parameters: (Vec String)
   span: SourceSpan])
(defrecord IrAttr
  [name: String
   storage-id: String?
   type: String
   opts: Any])
(defrecord IrDerivedExpr
  [kind: String
   field: String?
   value: String?
   parts: (Vec IrDerivedExpr)])
(defrecord IrExtend
  [port: String
   fields: (Vec IrAttr)
   span: SourceSpan])
(defrecord IrEntity
  [name: String
   storage-id: String?
   attrs: (Vec IrAttr)])
(defrecord IrBackend [kind: String])
(defrecord IrPersist [storage: String key: String])
(defrecord IrDefstate
  [name: String
   transitions: (Map String (Vec String))
   initial: String])
(defrecord IrPublication
  [name: String
   owner-entity: String
   pointer-field: String
   revision-entity: String
   owner-field: String
   state-field: String
   draft-state: String
   published-state: String
   retired-state: String])
(defrecord IrQueryParam [name: String type: String])
(defrecord IrQueryBinding [name: String entity-name: String])
(defrecord IrQueryOperand
  [kind: String
   name: String?
   binding: String?
   field: String?
   value: Any])
(defrecord IrQueryPredicate
  [op: String
   left: IrQueryOperand
   right: IrQueryOperand])
(defrecord IrQuerySelect
  [name: String
   binding: String
   field: String])
(defrecord IrQueryFieldSplice [port: String binding: String])
(defrecord IrQueryProvided
  [name: String
   provider: String
   input: Any])
(defrecord IrQueryPage [default-limit: Int max-limit: Int])
(defrecord IrQuery
  [name: String
   capabilities: (Vec String)
   params: (Vec IrQueryParam)
   bindings: (Vec IrQueryBinding)
   predicates: (Vec IrQueryPredicate)
   selection: (Vec Any)
   result-kind: String
   page: IrQueryPage?])
(defrecord IrDetailTab
  [label: String
   content-type: String
   fields: (Vec String)
   entity-name: String?
   relation-field: String?
   infer-relation: Bool
   display-fields: (Vec String)])
(defrecord IrListDetail
  [entity-name: String
   title: String
   columns: (Vec String)
   search-cols: (Vec String)
   detail-tabs: (Vec IrDetailTab)])
(defrecord IrSmartForm
  [name: String
   entity-name: String
   fields: (Vec String)
   required: (Vec String)
   submit-label: String
   on-success: String])
(defrecord IrTheme [colors: (Map String String)])
;; An event handler effect: checked verb plus arguments.
;; Rides inside an element's attrs map under an "on-<event>" key.
(defrecord IrAction [verb: String args: Any])
;; Fields repeated inline (not just member names): the cross-module defunion
;; interface only carries constructor arity when fields ride on the member
;; form itself, not via a separate same-name defrecord.
(defunion IrNode
  (IrElement
    [tag: String
     attrs: Any
     children: Any])
  (IrWhen [prop: String children: Any]))
(defrecord IrComponent
  [name: String
   props: (Vec String)
   body: (Vec IrElement)])
(defrecord IrRelatedTab
  [label: String
   entity-name: String
   ref-field: String
   filter: String?
   display-fields: (Vec String)])
(defrecord IrView
  [name: String
   entity-name: String
   component: String
   add-fields: (Vec String)
   title: String
   select-component: String?
   tabs: (Vec IrRelatedTab)
   filters: (Vec String)
   date-filters: (Vec String)])
(defrecord IrRouteQuery [name: String prefix: String?])
(defrecord IrRoute
  [path: String
   view-name: String
   queries: (Vec IrRouteQuery)
   parameters: (Vec String)
   input-parameters: (Vec String)
   required-props: (Vec String)])
(defrecord IrRouter [default-route: String routes: (Vec IrRoute)])
(defrecord IrNavGroup [label: String items: (Vec String)])
(defrecord IrLayout
  [style: String
   title: String?
   groups: (Vec IrNavGroup)])
(defrecord IrProgram
  [source-unit: IrSourceUnit
   application: IrApplication?
   uses: (Vec IrUse)
   providers: (Vec IrProvider)
   value-types: (Vec Any)
   provider-ports: (Vec Any)
   extends: (Vec IrExtend)
   fills: (Vec IrFill)
   mounts: (Vec IrMount)
   declaration-provenance: (Vec IrDeclarationProvenance)
   ns: String
   backend: IrBackend?
   entities: (Vec IrEntity)
   persist: IrPersist?
   defstates: (Vec IrDefstate)
   publications: (Vec IrPublication)
   queries: (Vec IrQuery)
   commands: (Vec Any)
   list-details: (Vec IrListDetail)
   forms: (Vec IrSmartForm)
   theme: IrTheme?
   components: (Vec IrComponent)
   views: (Vec IrView)
   router: IrRouter?
   layout: IrLayout?])
