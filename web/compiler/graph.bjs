#lang beagle/js
(ns wake.graph)
(require wake.ir :as ir)

;; Checked Entity Graph
;;
;; Takes raw IrProgram from the reader and produces an analyzed graph.
;; Every emitter reads this graph instead of re-deriving relationships.

;; --- Graph records ---

(defrecord GField
  [name: String
   storage-id: String
   type: String
   identity: Bool
   cardinality: String
   value-kind: String
   target-entity: String?
   write-policy: String
   derived: Bool
   deps: (Vec String)
   expr: IrDerivedExpr?])

(defrecord GEntity
  [name: String
   storage-id: String
   fields: (Vec GField)
   stored-fields: (Vec GField)
   derived-fields: (Vec GField)
   ref-fields: (Vec GField)
   identity-field: GField?
   store-name: String])

(defrecord FkEdge
  [from-entity: String
   from-field: String
   to-entity: String])

(defrecord StateMachine
  [entity: String
   field: String
   state-type: String
   transitions: (Map String (Vec String))
   initial: String])

(defrecord PublicationPolicy
  [name: String
   owner-entity: String
   pointer-field: String
   revision-entity: String
   owner-field: String
   state-field: String
   draft-state: String
   published-state: String
   retired-state: String])

(defrecord GQueryParam [name: String type: String])
(defrecord GQueryBinding [name: String entity: String])
(defrecord GQueryOperand
  [kind: String
   type: String
   target-entity: String?
   binding: String?
   entity: String?
   field: String?
   parameter: String?
   value: Any])
(defrecord GQueryPredicate
  [op: String
   left: GQueryOperand
   right: GQueryOperand])
(defrecord GQueryColumn
  [name: String
   binding: String
   entity: String
   field: String
   type: String
   cardinality: String
   value-kind: String
   target-entity: String?
   internal: Bool])
(defrecord GQueryResultProvider
  [name: String
   provider: String
   input: Any
   input-type: Any
   output-type: Any])
(defrecord GQueryDependency [entity: String field: String])
(defrecord GQuery
  [name: String
   capabilities: (Vec String)
   params: (Vec GQueryParam)
   bindings: (Vec GQueryBinding)
   predicates: (Vec GQueryPredicate)
   columns: (Vec GQueryColumn)
   result-providers: (Vec GQueryResultProvider)
   result-kind: String
   default-limit: Int?
   max-limit: Int?
   dependencies: (Vec GQueryDependency)])

(defrecord GDetailTab
  [label: String
   content-type: String
   fields: (Vec String)
   entity-name: String?
   relation-field: String?
   display-fields: (Vec String)])

(defrecord GListDetail
  [entity-name: String
   title: String
   columns: (Vec String)
   search-cols: (Vec String)
   detail-tabs: (Vec GDetailTab)])

(defrecord CheckedApplication
  [schema-version: Int
   application-id: String
   source-units: (Vec IrSourceUnit)
   plugin-closure: (Vec Any)
   semantic-fingerprint: String?
   providers: (Vec IrProvider)
   value-types: (Vec Any)
   provider-ports: (Vec Any)
   extensions: (Vec IrExtend)
   fills: (Vec IrFill)
   mounts: (Vec IrMount)
   route-templates: (Vec IrRoute)
   ns: String
   backend: IrBackend?
   entities: (Vec GEntity)
   fk-edges: (Vec FkEdge)
   state-machines: (Vec StateMachine)
   publications: (Vec PublicationPolicy)
   queries: (Vec GQuery)
   commands: (Vec Any)
   persist: IrPersist?
   defstates: (Vec IrDefstate)
   list-details: (Vec GListDetail)
   forms: (Vec IrSmartForm)
   theme: IrTheme?
   components: (Vec IrComponent)
   views: (Vec IrView)
   router: IrRouter?
   layout: IrLayout?])

;; --- Shared utilities ---

(defn strip-colon [s: String] -> String
  (if (.startsWith s ":") (subs s 1) s))

(defn capitalize [s: String] -> String
  (str (.toUpperCase (subs s 0 1)) (subs s 1)))

(defn titlecase [s: String] -> String
  (str (.toUpperCase (subs s 0 1)) (subs s 1)))

;; --- Field analysis ---

(defn graph-error [message: String] -> Any
  (throw (ex-info (str "wake: " message) {})))

(def reserved-generated-names: (Vec String)
  ["__proto__" "prototype" "constructor"])

(defn validate-generated-name [kind: String name: String] -> Any
  (if (.includes reserved-generated-names (strip-colon name))
    (graph-error
      (str kind " name '" name
           "' is reserved for generated JavaScript"))
    nil))

(defn validate-generated-names
  [prog: IrProgram
   entities: (Vec GEntity)
   defstates: (Vec IrDefstate)] -> Any
  (doseq [entity entities]
    (validate-generated-name "entity" (.-name entity))
    (doseq [field (.-fields entity)]
      (validate-generated-name "field" (.-name field))))
  (doseq [defstate defstates]
    (validate-generated-name "state type" (.-name defstate))
    (doseq [state (keys (.-transitions defstate))]
      (validate-generated-name "state" state)))
  (doseq [component (or (.-components prog) [])]
    (validate-generated-name "component" (.-name component))
    (doseq [prop (.-props component)]
      (validate-generated-name "component prop" prop)))
  (doseq [view (or (.-views prog) [])]
    (validate-generated-name "view" (.-name view)))
  (doseq [publication (or (.-publications prog) [])]
    (validate-generated-name "publication" (.-name publication)))
  (doseq [form (or (.-forms prog) [])]
    (validate-generated-name "form" (.-name form)))
  (let [router (.-router prog)]
    (if (some? router)
      (do
        (validate-generated-name "default route" (.-default-route router))
        (doseq [route (.-routes router)]
          (validate-generated-name "route" (.-path route))
          (validate-generated-name "route view" (.-view-name route))))
      nil)))

(defn validate-unique-declaration-names
  [names: (Vec String)
   label: String] -> Any
  (reduce
    (fn [seen name]
      (if (.includes seen name)
        (graph-error (str label " '" name "' is duplicated"))
        (conj seen name)))
    []
    names))

(defn validate-declaration-uniqueness
  [prog: IrProgram
   entities: (Vec GEntity)] -> Any
  (validate-unique-declaration-names
    (mapv (fn [entity] (.-name entity)) entities)
    "entity")
  (validate-unique-declaration-names
    (mapv (fn [component] (.-name component)) (or (.-components prog) []))
    "component")
  (validate-unique-declaration-names
    (mapv (fn [view] (.-name view)) (or (.-views prog) []))
    "view"))

(defn validate-ui-references [prog: IrProgram entities: (Vec GEntity)] -> Any
  (let [components (or (.-components prog) [])
        views (or (.-views prog) [])
        entity-names (mapv (fn [entity] (.-name entity)) entities)
        component-names (mapv (fn [component] (.-name component)) components)
        view-names (mapv (fn [view] (.-name view)) views)]
    (doseq [view views]
      (let [name (.-name view)
            entity-name (.-entity-name view)
            component-name (.-component view)
            select-component (.-select-component view)]
        (if (and (some? entity-name)
                 (not (.includes entity-names entity-name)))
          (graph-error
            (str "view '" name "' names unknown entity '" entity-name "'"))
          nil)
        (if (and (some? component-name)
                 (not (.includes component-names component-name)))
          (graph-error
            (str "view '" name "' names unknown component '"
                 component-name "'"))
          nil)
        (if (and (some? select-component)
                 (not (.includes component-names select-component)))
          (graph-error
            (str "view '" name "' names unknown select component '"
                 select-component "'"))
          nil)))
    (let [router (.-router prog)]
      (if (some? router)
        (let [routes (or (.-routes router) [])
              route-paths (mapv (fn [route] (.-path route)) routes)
              route-views (mapv (fn [route] (.-view-name route)) routes)
              default-route (.-default-route router)]
          (reduce
            (fn [seen path]
              (if (.includes seen path)
                (graph-error (str "route path '" path "' is duplicated"))
                (conj seen path)))
            []
            route-paths)
          (doseq [route routes]
            (let [view-name (.-view-name route)]
              (if (not (.includes view-names view-name))
                (graph-error
                  (str "route '" (.-path route) "' names unknown view '"
                       view-name "'"))
                nil)))
          (if (not (.includes route-views default-route))
            (graph-error
              (str "routes default '" default-route
                   "' does not name a routed view"))
            nil))
        nil))))

(defn nonempty-string? [value: Any] -> Bool
  (and (string? value) (> (count value) 0)))

(defn declaration-local?
  [prog: Any
   kind: String
   name: String] -> Bool
  (let [plugin-closure (or (.-plugin-closure prog) [])
        root-source (.-source-unit prog)
        declarations (or (.-declaration-provenance prog) [])
        declaration
        (first
          (filterv
            (fn [entry]
              (and (= (.-kind entry) kind)
                   (= (.-name entry) name)))
            declarations))]
    (if (= (count plugin-closure) 0)
      true
      (and
        (some? root-source)
        (some? declaration)
        (= (.-source-id root-source)
           (.-source-id (.-source (.-provenance declaration))))))))

(defn required-storage-id
  [value: Any
   label: String
   fallback: String
   local: Bool] -> String
  (if (nonempty-string? value)
    value
    (if local
      fallback
      (graph-error
        (str "plugin " label " requires a nonempty fixed storage ID")))))

(defn analyze-field
  [attr: Any
   entity-name: String
   entity-local: Bool
   application-id: String] -> GField
  (let [name (.-name attr)
        storage-id
        (required-storage-id
          (.-storage-id attr)
          (str "field '" entity-name "." name "'")
          (str "app:" application-id "/entity:" entity-name "/field:" name)
          entity-local)
        type (.-type attr)
        opts (.-opts attr)
        identity (= true (get opts "identity"))
        cardinality (if (= true (get opts "many")) "multi" "single")
        value-kind (if (= type "Ref") "ref" "literal")
        target-entity (get opts "target-entity")
        write-policy (or (get opts "write") "set")
        derived (= type "Derived")]
    (if (and derived (= cardinality "multi"))
      (graph-error (str "Derived field '" name "' cannot declare :many"))
      nil)
    (if (and (not (= type "Ref")) (some? target-entity))
      (graph-error (str "only Ref field '" name "' may declare :to"))
      nil)
    (if (and identity
             (or derived
                 (not (= cardinality "single"))
                 (not (= value-kind "literal"))))
      (graph-error
        (str "identity field '" name
             "' must be stored, single-cardinality, and literal"))
      nil)
    (if (and identity (some? (get opts "write")))
      (graph-error
        (str "identity field '" name "' is immutable and cannot declare :write"))
      nil)
    (->GField
      name
      storage-id
      type
      identity
      cardinality
      value-kind
      target-entity
      write-policy
      derived
      (if derived (or (get opts "deps") []) [])
      (if derived (get opts "expr") nil))))

(def derived-expr-keys: (Vec String)
  ["_tag" "kind" "field" "value" "parts"])

(defn require-derived-expr-shape [expr: Any label: String] -> Any
  (if (nil? expr)
    (graph-error (str label " requires a closed derived expression"))
    nil)
  (let [actual (Object/keys expr)]
    (if (not (= (count actual) (count derived-expr-keys)))
      (graph-error (str label " derived expression has unsupported fields"))
      nil)
    (doseq [key derived-expr-keys]
      (if (not (.includes actual key))
        (graph-error (str label " derived expression has unsupported fields"))
        nil)))
  (if (not (= (.-_tag expr) "IrDerivedExpr"))
    (graph-error (str label " must use an IrDerivedExpr value"))
    nil))

(defn append-unique-derived-deps
  [deps: (Vec String)
   additions: (Vec String)] -> (Vec String)
  (reduce
    (fn [result dependency]
      (if (.includes result dependency)
        result
        (conj result dependency)))
    deps
    additions))

(defn validate-derived-expression [expr: Any label: String] -> (Vec String)
  (require-derived-expr-shape expr label)
  (let [kind (.-kind expr)
        field (.-field expr)
        value (.-value expr)
        parts (.-parts expr)]
    (if (not (vector? parts))
      (graph-error (str label " derived expression parts must be a vector"))
      nil)
    (cond
      (= kind "field")
        (do
          (if (or (not (nonempty-string? field))
                  (some? value)
                  (not (= (count parts) 0)))
            (graph-error (str label " has an invalid field derived expression"))
            nil)
          [(or field "")])
      (= kind "string")
        (do
          (if (or (some? field)
                  (not (string? value))
                  (not (= (count parts) 0)))
            (graph-error (str label " has an invalid string derived expression"))
            nil)
          [])
      (= kind "concat")
        (do
          (if (or (some? field)
                  (some? value)
                  (= (count parts) 0))
            (graph-error (str label " has an invalid concat derived expression"))
            nil)
          (reduce
            (fn [deps part]
              (append-unique-derived-deps
                deps
                (validate-derived-expression part label)))
            []
            parts))
      :else
        (graph-error
          (str label " has unknown derived expression kind '" kind "'")))))

(defn validate-derived-fields [entity-name: String fields: (Vec GField)] -> Any
  (doseq [field fields]
    (if (.-derived field)
      (let [label (str "derived field '" entity-name "." (.-name field) "'")
            declared (.-deps field)
            actual (validate-derived-expression (.-expr field) label)]
        (if (not (vector? declared))
          (graph-error (str label " dependencies must be a vector"))
          nil)
        (if (not (= declared actual))
          (graph-error
            (str label " dependencies do not exactly match its expression"))
          nil)
        (doseq [dependency actual]
          (let [resolved
                (first
                  (filterv
                    (fn [candidate]
                      (= (.-name candidate) dependency))
                    fields))]
            (if (nil? resolved)
              (graph-error
                (str label " references unknown field '" dependency "'"))
              nil)
            (if (and (some? resolved) (.-derived resolved))
              (graph-error
                (str label " cannot reference derived field '" dependency "'"))
              nil)
            (if (and (some? resolved)
                     (or (not (= (.-type resolved) "String"))
                         (not (= (.-cardinality resolved) "single"))
                         (not (= (.-value-kind resolved) "literal"))))
              (graph-error
                (str label " dependency '" dependency
                     "' must be a single stored String field"))
              nil))))
      nil))
  nil)

;; --- Entity analysis ---

(defn analyze-entity
  [prog: Any
   entity: Any
   application-id: String] -> GEntity
  (let [name (.-name entity)
        local (declaration-local? prog "entity" name)
        storage-id
        (required-storage-id
          (.-storage-id entity)
          (str "entity '" name "'")
          (str "app:" application-id "/entity:" name)
          local)
        fields
        (mapv
          (fn [attr]
            (analyze-field attr name local application-id))
          (.-attrs entity))
        validated-derived (validate-derived-fields name fields)
        stored-fields (filterv (fn [f] (not (.-derived f))) fields)
        derived-fields (filterv (fn [f] (.-derived f)) fields)
        ref-fields (filterv (fn [f] (= (.-type f) "Ref")) fields)
        identity-fields (filterv (fn [f] (.-identity f)) stored-fields)
        identity-field (if (= (count identity-fields) 1)
                         (first identity-fields)
                         nil)]
    (->GEntity name storage-id fields stored-fields derived-fields ref-fields
               identity-field (str name "s"))))

(defn validate-storage-id-uniqueness [entities: (Vec GEntity)] -> Any
  (reduce
    (fn [seen entry]
      (let [storage-id (nth entry 0)
            label (nth entry 1)
            prior (get seen storage-id)]
        (if (some? prior)
          (graph-error
            (str "storage ID '" storage-id "' is shared by " prior
                 " and " label))
          (assoc seen storage-id label))))
    {}
    (reduce
      (fn [entries entity]
        (reduce
          (fn [acc field]
            (conj
              acc
              [(.-storage-id field)
               (str "field '" (.-name entity) "." (.-name field) "'")]))
          (conj
            entries
            [(.-storage-id entity) (str "entity '" (.-name entity) "'")])
          (.-fields entity)))
      []
      entities))
  nil)

;; --- FK edge resolution ---

(defn resolve-fk-edges [entities: (Vec GEntity)] -> (Vec FkEdge)
  (let [entity-names (mapv (fn [entity] (.-name entity)) entities)]
    (reduce
      (fn [edges entity]
        (reduce
          (fn [acc ref-field]
            (let [target (.-target-entity ref-field)]
              (if (nil? target)
                (graph-error
                  (str "Ref field '" (.-name entity) "."
                       (.-name ref-field) "' requires :to ENTITY"))
                nil)
              (if (not (.includes entity-names target))
                (graph-error
                  (str "Ref field '" (.-name entity) "."
                       (.-name ref-field) "' targets unknown entity '"
                       target "'"))
                nil)
              (conj acc
                    (->FkEdge (.-name entity)
                              (.-name ref-field)
                              (or target "")))))
          edges
          (.-ref-fields entity)))
      []
      entities)))

;; --- Backend invariants ---

(defn fram-literal-type? [type: String] -> Bool
  (or (= type "String")
      (= type "Digest")
      (= type "Int")
      (= type "Integer")
      (= type "Float")
      (= type "Double")
      (= type "Number")
      (= type "Bool")
      (= type "Boolean")
      (= type "Keyword")
      (= type "Instant")))

(defn fram-stored-field-type?
  [field: GField
   defstates: (Vec IrDefstate)] -> Bool
  (let [type (.-type field)]
    (or (fram-literal-type? type)
        (= type "Ref")
        (some?
          (first
            (filterv (fn [state] (= (.-name state) type)) defstates))))))

(defn validate-backend [prog: IrProgram entities: (Vec GEntity)] -> Any
  (let [backend (.-backend prog)
        defstates (or (.-defstates prog) [])]
    (if (and (some? backend) (not (= (.-kind backend) "fram")))
      (graph-error (str "unsupported backend '" (.-kind backend) "'"))
      nil)
    (if (and (some? backend) (some? (.-persist prog)))
      (graph-error "FRAM-backed applications cannot declare local persistence")
      nil)
    (if (some? backend)
      (doseq [entity entities]
        (let [identity-fields
              (filterv (fn [field] (.-identity field))
                       (.-stored-fields entity))]
          (doseq [field (.-stored-fields entity)]
            (if (not (fram-stored-field-type? field defstates))
              (graph-error
                (str "FRAM-backed field '" (.-name entity) "."
                     (.-name field) "' has unsupported type '"
                     (.-type field) "'"))
              nil))
          (if (= (count identity-fields) 0)
            (graph-error
              (str "FRAM-backed entity '" (.-name entity)
                   "' requires exactly one :identity field"))
            nil)
          (if (> (count identity-fields) 1)
            (graph-error
              (str "FRAM-backed entity '" (.-name entity)
                   "' has multiple :identity fields"))
            nil)))
      nil)))

;; --- State machine resolution ---

(defn validate-defstate [defstate: IrDefstate] -> Any
  (let [name (.-name defstate)
        transitions (.-transitions defstate)
        source-names (keys transitions)
        states (mapv strip-colon source-names)
        initial (strip-colon (.-initial defstate))]
    (if (= (count states) 0)
      (graph-error (str "defstate '" name "' must declare at least one state"))
      nil)
    (reduce
      (fn [seen state]
        (if (= state "")
          (graph-error (str "defstate '" name "' declares an empty state"))
          nil)
        (if (.includes seen state)
          (graph-error
            (str "defstate '" name "' declares state '" state
                 "' more than once after keyword normalization"))
          (conj seen state)))
      []
      states)
    (if (not (.includes states initial))
      (graph-error
        (str "defstate '" name "' initial state '" initial
             "' is not declared"))
      nil)
    (doseq [source-name source-names]
      (let [source (strip-colon source-name)
            targets (or (get transitions source-name) [])
            normalized-targets (mapv strip-colon targets)]
        (reduce
          (fn [seen target]
            (if (.includes seen target)
              (graph-error
                (str "defstate '" name "' transition from '" source
                     "' repeats target '" target "'"))
              (conj seen target)))
          []
          normalized-targets)
        (doseq [target normalized-targets]
          (if (not (.includes states target))
            (graph-error
              (str "defstate '" name "' transition from '" source
                   "' targets undeclared state '" target "'"))
            nil))))))

(defn validate-defstates [defstates: (Vec IrDefstate)] -> Any
  (doseq [defstate defstates]
    (validate-defstate defstate)))

(defn resolve-state-machines
  [entities: (Vec GEntity)
   defstates: (Vec IrDefstate)] -> (Vec StateMachine)
  (reduce
    (fn [machines entity]
      (let [status-fields (filterv
              (fn [f]
                (and (not (= (.-type f) "String"))
                     (not (= (.-type f) "Ref"))
                     (not (= (.-type f) "Derived"))
                     (some? (first (filterv (fn [ds] (= (.-name ds) (.-type f))) defstates)))))
              (.-fields entity))]
        (reduce
          (fn [acc sf]
            (let [ds (first (filterv (fn [d] (= (.-name d) (.-type sf))) defstates))]
              (if (not (= (.-cardinality sf) "single"))
                (graph-error
                  (str "state field '" (.-name entity) "." (.-name sf)
                       "' must be single-cardinality"))
                nil)
              (conj acc (->StateMachine (.-name entity)
                                        (.-name sf)
                                        (.-type sf)
                                        (.-transitions ds)
                                        (.-initial ds)))))
          machines status-fields)))
    [] entities))

;; --- Publication policy resolution ---

(defn entity-named [entities: (Vec GEntity) name: String] -> GEntity?
  (first (filterv (fn [entity] (= (.-name entity) name)) entities)))

(defn field-named [entity: GEntity name: String] -> GField?
  (first (filterv (fn [field] (= (.-name field) name)) (.-fields entity))))

(defn validate-distinct-names [names: (Vec String) label: String] -> Any
  (reduce
    (fn [seen name]
      (if (.includes seen name)
        (graph-error (str label " repeats '" name "'"))
        (conj seen name)))
    []
    names)
  nil)

(defn required-list-field
  [entity: GEntity
   name: String
   label: String] -> GField
  (let [field (field-named entity name)]
    (if (nil? field)
      (graph-error
        (str label " names unknown field '" (.-name entity) "." name "'"))
      nil)
    (or field (first (.-fields entity)))))

(defn resolve-list-detail-tab
  [entities: (Vec GEntity)
   owner: GEntity
   tab: IrDetailTab
   label: String] -> GDetailTab
  (let [content-type (.-content-type tab)]
    (if (= content-type "fields")
      (let [fields (or (.-fields tab) [])]
        (validate-distinct-names fields (str label " field"))
        (doseq [field fields]
          (required-list-field owner field label))
        (->GDetailTab (.-label tab) "fields" fields nil nil []))
      (if (= content-type "related")
        (let [entity-name (or (.-entity-name tab) "")
              related (entity-named entities entity-name)]
          (if (nil? related)
            (graph-error (str label " names unknown related entity '" entity-name "'"))
            nil)
          (let [child (or related owner)
                candidates
                (filterv
                  (fn [field]
                    (and (= (.-type field) "Ref")
                         (= (.-cardinality field) "single")
                         (= (.-target-entity field) (.-name owner))))
                  (.-fields child))
                requested (.-relation-field tab)
                relation
                (if (= true (.-infer-relation tab))
                  (do
                    (if (not (= (count candidates) 1))
                      (graph-error
                        (str label " cannot infer one relation from '" entity-name
                             "' to '" (.-name owner) "'"))
                      nil)
                    (first candidates))
                  (let [field (field-named child (or requested ""))]
                    (if (or (nil? field)
                            (not (= (.-type field) "Ref"))
                            (not (= (.-cardinality field) "single"))
                            (not (= (.-target-entity field) (.-name owner))))
                      (graph-error
                        (str label " relation must name a single Ref field on '"
                             entity-name "' targeting '" (.-name owner) "'"))
                      nil)
                    field))
                display (or (.-display-fields tab) [])]
            (validate-distinct-names display (str label " display field"))
            (doseq [field display]
              (required-list-field child field label))
            (->GDetailTab
              (.-label tab) "related" [] entity-name
              (.-name (or relation (first (.-fields child)))) display)))
        (graph-error (str label " has unknown content type '" content-type "'"))))))

(defn resolve-list-details
  [prog: IrProgram
   entities: (Vec GEntity)] -> (Vec GListDetail)
  (let [details (or (.-list-details prog) [])]
    (if (> (count details) 1)
      (graph-error "program may declare at most one list detail")
      nil)
    (validate-distinct-names
      (mapv (fn [detail] (.-entity-name detail)) details)
      "list detail entity")
    (mapv
      (fn [detail]
        (let [entity-name (.-entity-name detail)
              owner (entity-named entities entity-name)
              label (str "list detail '" entity-name "'")]
          (if (nil? owner)
            (graph-error (str label " names unknown entity '" entity-name "'"))
            nil)
          (let [entity (or owner (first entities))
                columns (or (.-columns detail) [])
                search (or (.-search-cols detail) [])
                tabs (or (.-detail-tabs detail) [])]
            (if (not (nonempty-string? (.-title detail)))
              (graph-error (str label " title must be nonempty"))
              nil)
            (validate-distinct-names columns (str label " column"))
            (doseq [name columns]
              (let [field (required-list-field entity name label)]
                (if (.-derived field)
                  (graph-error (str label " column cannot name derived field '"
                                    entity-name "." name "'"))
                  nil)))
            (validate-distinct-names search (str label " search field"))
            (doseq [name search]
              (let [field (required-list-field entity name label)]
                (if (or (.-derived field)
                        (not (= (.-cardinality field) "single"))
                        (not (= (.-value-kind field) "literal")))
                  (graph-error
                    (str label " search field '" entity-name "." name
                         "' must be a single stored literal"))
                  nil)))
            (validate-distinct-names
              (mapv (fn [tab] (.-label tab)) tabs)
              (str label " tab label"))
            (if (> (count (filterv
                            (fn [tab] (= (.-content-type tab) "fields"))
                            tabs)) 1)
              (graph-error (str label " may declare at most one fields tab"))
              nil)
            (let [resolved-tabs
                  (mapv
                    (fn [tab]
                      (resolve-list-detail-tab
                        entities entity tab
                        (str label " tab '" (.-label tab) "'")))
                    tabs)]
              (reduce
                (fn [seen tab]
                  (let [folded (.toLowerCase (.-label tab))]
                    (if (and (= (.-content-type tab) "related")
                             (= folded "overview"))
                      (graph-error
                        (str label " related tab label '" (.-label tab)
                             "' conflicts with the built-in overview tab"))
                      nil)
                    (if (.includes seen folded)
                      (graph-error
                        (str label " tab labels collide case-insensitively at '"
                             (.-label tab) "'"))
                      (conj seen folded))))
                []
                resolved-tabs)
              (reduce
                (fn [seen tab]
                  (if (= (.-content-type tab) "related")
                    (let [child (.-entity-name tab)]
                      (if (.includes seen child)
                        (graph-error
                          (str label " repeats related entity '" child "'"))
                        (conj seen child)))
                    seen))
                [entity-name]
                resolved-tabs)
              (->GListDetail
                entity-name
                (.-title detail)
                columns
                search
                resolved-tabs)))))
      details)))

(defn validate-create-fields
  [label: String
   entity-name: String
   field-names: (Vec String)
   entities: (Vec GEntity)] -> Any
  (let [entity (entity-named entities entity-name)]
    (if (nil? entity)
      (graph-error
        (str label " names unknown entity '" entity-name "'"))
      nil)
    (let [resolved (or entity (first entities))
          identity (.-identity-field resolved)]
      (if (or (nil? identity)
              (not (.includes field-names (.-name identity))))
        (graph-error
          (str label " must include identity field '" entity-name "."
               (if (nil? identity) "<missing>" (.-name identity)) "'"))
        nil)
      (doseq [field-name field-names]
        (let [field (field-named resolved field-name)]
          (if (nil? field)
            (graph-error
              (str label " names unknown field '" entity-name "."
                   field-name "'"))
            nil)
          (if (and (some? field) (= (.-write-policy field) "command"))
            (graph-error
              (str label " cannot include command-only field '" entity-name "."
                   field-name "'"))
            nil))))))

(defn validate-fram-create-forms
  [prog: IrProgram
   entities: (Vec GEntity)] -> Any
  (if (some? (.-backend prog))
    (do
      (doseq [view (or (.-views prog) [])]
        (let [fields (or (.-add-fields view) [])]
          (if (> (count fields) 0)
            (validate-create-fields
              (str "view '" (.-name view) "' add form")
              (.-entity-name view)
              fields
              entities)
            nil)))
      (doseq [form (or (.-forms prog) [])]
        (validate-create-fields
          (str "form '" (.-name form) "'")
          (.-entity-name form)
          (or (.-fields form) [])
          entities)))
    nil))

(defn machine-named
  [machines: (Vec StateMachine)
   entity-name: String
   field-name: String] -> StateMachine?
  (first
    (filterv
      (fn [machine]
        (and (= (.-entity machine) entity-name)
             (= (.-field machine) field-name)))
      machines)))

(defn require-write-policy
  [entity-name: String
   field: GField
   expected: String] -> Any
  (if (not (= (.-write-policy field) expected))
    (graph-error
      (str "publication field '" entity-name "." (.-name field)
           "' must declare :write :" expected))
    nil))

(defn validate-publication-states
  [publication-name: String
   machine: StateMachine
   draft-state: String
   published-state: String
   retired-state: String] -> Any
  (let [transitions (.-transitions machine)
        states [draft-state published-state retired-state]]
    (if (not (= (count (distinct states)) 3))
      (graph-error
        (str "publication '" publication-name
             "' draft, published, and retired states must be distinct"))
      nil)
    (doseq [state states]
      (if (nil? (get transitions state))
        (graph-error
          (str "publication '" publication-name "' names unknown state " state))
        nil))
    (if (not (= (.-initial machine) draft-state))
      (graph-error
        (str "publication '" publication-name
             "' draft state must be the state machine initial state"))
      nil)
    (if (not (.includes (or (get transitions draft-state) []) published-state))
      (graph-error
        (str "publication '" publication-name
             "' requires its draft -> published transition"))
      nil)
    (if (not (.includes (or (get transitions published-state) []) retired-state))
      (graph-error
        (str "publication '" publication-name
             "' requires its published -> retired transition"))
      nil)))

(defn resolve-publication
  [source: IrPublication
   entities: (Vec GEntity)
   machines: (Vec StateMachine)] -> PublicationPolicy
  (let [name (.-name source)
        owner-name (.-owner-entity source)
        revision-name (.-revision-entity source)
        owner (entity-named entities owner-name)
        revision (entity-named entities revision-name)]
    (if (nil? owner)
      (graph-error
        (str "publication '" name "' names unknown owner entity '"
             owner-name "'"))
      nil)
    (if (nil? revision)
      (graph-error
        (str "publication '" name "' names unknown revision entity '"
             revision-name "'"))
      nil)
    (let [resolved-owner (or owner (first entities))
          resolved-revision (or revision (first entities))
          pointer (field-named resolved-owner (.-pointer-field source))
          owner-field (field-named resolved-revision (.-owner-field source))
          state-field (field-named resolved-revision (.-state-field source))]
      (if (nil? pointer)
        (graph-error
          (str "publication '" name "' names unknown pointer field '"
               owner-name "." (.-pointer-field source) "'"))
        nil)
      (if (nil? owner-field)
        (graph-error
          (str "publication '" name "' names unknown revision owner field '"
               revision-name "." (.-owner-field source) "'"))
        nil)
      (if (nil? state-field)
        (graph-error
          (str "publication '" name "' names unknown revision state field '"
               revision-name "." (.-state-field source) "'"))
        nil)
      (let [resolved-pointer (or pointer (first (.-fields resolved-owner)))
            resolved-owner-field
            (or owner-field (first (.-fields resolved-revision)))
            resolved-state-field
            (or state-field (first (.-fields resolved-revision)))
            machine
            (machine-named
              machines revision-name (.-state-field source))]
        (if (or (not (= (.-value-kind resolved-pointer) "ref"))
                (not (= (.-cardinality resolved-pointer) "single"))
                (not (= (.-target-entity resolved-pointer) revision-name)))
          (graph-error
            (str "publication pointer '" owner-name "."
                 (.-pointer-field source)
                 "' must be a single Ref to '" revision-name "'"))
          nil)
        (if (or (not (= (.-value-kind resolved-owner-field) "ref"))
                (not (= (.-cardinality resolved-owner-field) "single"))
                (not (= (.-target-entity resolved-owner-field) owner-name)))
          (graph-error
            (str "publication owner field '" revision-name "."
                 (.-owner-field source)
                 "' must be a single Ref to '" owner-name "'"))
          nil)
        (if (or (not (= (.-value-kind resolved-state-field) "literal"))
                (not (= (.-cardinality resolved-state-field) "single")))
          (graph-error
            (str "publication state field '" revision-name "."
                 (.-state-field source) "' must be a single literal"))
          nil)
        (require-write-policy owner-name resolved-pointer "command")
        (require-write-policy revision-name resolved-owner-field "create")
        (require-write-policy revision-name resolved-state-field "command")
        (if (nil? machine)
          (graph-error
            (str "publication state field '" revision-name "."
                 (.-state-field source) "' requires a state machine"))
          nil)
        (let [draft-state (.-draft-state source)
              published-state (.-published-state source)
              retired-state (.-retired-state source)]
          (validate-publication-states
            name (or machine (first machines))
            draft-state published-state retired-state)
          (->PublicationPolicy
            name owner-name (.-pointer-field source)
            revision-name (.-owner-field source) (.-state-field source)
            (strip-colon draft-state)
            (strip-colon published-state)
            (strip-colon retired-state)))))))

(defn resolve-publications
  [prog: IrProgram
   entities: (Vec GEntity)
   machines: (Vec StateMachine)] -> (Vec PublicationPolicy)
  (let [sources (or (.-publications prog) [])]
    (if (and (> (count sources) 0) (nil? (.-backend prog)))
      (graph-error "publication policies require (backend :fram)")
      nil)
    (reduce
      (fn [seen source]
        (let [name (.-name source)]
          (if (.includes seen name)
            (graph-error (str "duplicate publication '" name "'"))
            (conj seen name))))
      [] sources)
    (let [policies
          (mapv (fn [source] (resolve-publication source entities machines))
                sources)]
      (reduce
        (fn [seen policy]
          (let [target (str (.-owner-entity policy) "."
                            (.-pointer-field policy))]
            (if (.includes seen target)
              (graph-error
                (str "publication pointer '" target "' is declared twice"))
              (conj seen target))))
        [] policies)
      policies)))


;; --- Main: build checked application ---

(defn application-id [prog: Any] -> String
  (let [application (.-application prog)
        application-id (if (nil? application) nil (.-id application))]
    (if (nonempty-string? application-id)
      (or application-id "")
      (do
        (graph-error "linked program requires (application :id \"ID\")")
        ""))))

(defn checked-source-units [prog: Any] -> (Vec IrSourceUnit)
  (let [linked (.-source-units prog)
        root (.-source-unit prog)]
    (if (some? linked)
      linked
      (if (some? root) [root] []))))

;; --- Named query analysis ---

(defn query-name-map
  [items: Any
   name-fn: Any
   label: String] -> Any
  (reduce
    (fn [result item]
      (let [name (name-fn item)]
        (if (some? (get result name))
          (graph-error (str label " '" name "' is duplicated"))
          (assoc result name item))))
    {}
    items))

(defn query-field
  [entity: GEntity
   name: String
   label: String] -> GField
  (let [field
        (first
          (filterv
            (fn [candidate] (= (.-name candidate) name))
            (.-fields entity)))]
    (if (nil? field)
      (graph-error
        (str label " names unknown field '" (.-name entity) "." name "'"))
      nil)
    (if (.-derived field)
      (graph-error
        (str label " cannot read derived field '" (.-name entity) "." name
             "' from FRAM"))
      nil)
    field))

(defn query-type-family [type: String] -> String
  (cond
    (or (= type "Int") (= type "Integer")) "integer"
    (or (= type "Float") (= type "Double") (= type "Number")) "float"
    (or (= type "Bool") (= type "Boolean")) "boolean"
    :else type))

(defn query-types-compatible? [left: String right: String] -> Bool
  (= (query-type-family left) (query-type-family right)))

(defn resolve-query-operand
  [raw: IrQueryOperand
   bindings: Any
   parameters: Any
   label: String] -> GQueryOperand
  (let [kind (.-kind raw)]
    (cond
      (= kind "parameter")
        (let [name (or (.-name raw) "")
              parameter (get parameters name)]
          (if (nil? parameter)
            (graph-error (str label " names unknown parameter '$" name "'"))
            nil)
          (->GQueryOperand
            "parameter" (.-type parameter) nil nil nil nil name nil))
      (= kind "binding")
        (let [name (or (.-binding raw) "")
              entity (get bindings name)]
          (if (nil? entity)
            (graph-error (str label " names unknown binding '" name "'"))
            nil)
          (->GQueryOperand
            "binding" "Ref" (.-name entity) name (.-name entity) nil nil nil))
      (= kind "field")
        (let [binding (or (.-binding raw) "")
              entity (get bindings binding)]
          (if (nil? entity)
            (graph-error (str label " names unknown binding '" binding "'"))
            nil)
          (let [field (query-field entity (or (.-field raw) "") label)]
            (->GQueryOperand
              "field" (.-type field) (.-target-entity field) binding (.-name entity)
              (.-name field) nil nil)))
      (= kind "literal")
        (->GQueryOperand
          "literal" (or (.-name raw) "") nil nil nil nil nil (.-value raw))
      :else (graph-error (str label " has unknown operand kind '" kind "'")))))

(defn query-state [defstates: Any type: String] -> Any
  (first (filterv (fn [state] (= (.-name state) type)) defstates)))

(defn coerce-query-literal
  [operand: GQueryOperand
   expected-type: String
   defstates: Any
   label: String] -> GQueryOperand
  (if (not (= (.-kind operand) "literal"))
    operand
    (let [literal-type (.-type operand)
          value (.-value operand)
          state (query-state defstates expected-type)]
      (if (= literal-type "Keyword")
        (if (some? state)
          (do
            (if (not (some? (get (.-transitions state) value)))
              (graph-error
                (str label " names unknown " expected-type " value '" value "'"))
              nil)
            (->GQueryOperand
              "literal" expected-type nil nil nil nil nil (strip-colon value)))
          (if (= expected-type "Keyword")
            (->GQueryOperand
              "literal" "Keyword" nil nil nil nil nil (strip-colon value))
            operand))
        operand))))

(defn query-operand-bindings [operand: GQueryOperand] -> (Vec String)
  (if (some? (.-binding operand)) [(or (.-binding operand) "")] []))

(defn analyze-query-predicate
  [raw: IrQueryPredicate
   bindings: Any
   parameters: Any
   defstates: Any
   label: String] -> GQueryPredicate
  (let [left0 (resolve-query-operand (.-left raw) bindings parameters label)
        right0 (resolve-query-operand (.-right raw) bindings parameters label)
        left
        (if (= (.-kind left0) "literal")
          (coerce-query-literal left0 (.-type right0) defstates label)
          left0)
        right
        (if (= (.-kind right0) "literal")
          (coerce-query-literal right0 (.-type left0) defstates label)
          right0)]
    (if (and (= (.-type left) "Ref")
             (= (.-type right) "Ref")
             (not (= (.-target-entity left) (.-target-entity right))))
      (graph-error
        (str label " compares references to different entity targets '"
             (or (.-target-entity left) "unknown") "' and '"
             (or (.-target-entity right) "unknown") "'"))
      nil)
    (if (and (= (.-kind left) "binding") (= (.-kind right) "field"))
      (let [field-entity (get bindings (or (.-binding right) ""))
            field (query-field field-entity (or (.-field right) "") label)]
        (if (or (not (= (.-value-kind field) "ref"))
                (not (= (.-target-entity field) (.-entity left))))
          (graph-error (str label " compares an entity binding to an incompatible field"))
          nil))
      (if (and (= (.-kind right) "binding") (= (.-kind left) "field"))
        (let [field-entity (get bindings (or (.-binding left) ""))
              field (query-field field-entity (or (.-field left) "") label)]
          (if (or (not (= (.-value-kind field) "ref"))
                  (not (= (.-target-entity field) (.-entity right))))
            (graph-error (str label " compares an entity binding to an incompatible field"))
            nil))
        (if (or (= (.-kind left) "binding") (= (.-kind right) "binding"))
          (if (not (and (= (.-kind left) "binding")
                        (= (.-kind right) "binding")
                        (= (.-entity left) (.-entity right))))
            (graph-error (str label " compares incompatible entity bindings"))
            nil)
          (if (not (query-types-compatible? (.-type left) (.-type right)))
            (graph-error
              (str label " compares incompatible types '" (.-type left)
                   "' and '" (.-type right) "'"))
            nil))))
    (->GQueryPredicate "eq" left right)))

(defn query-binding-connected?
  [binding: String
   earlier: (Vec String)
   predicates: (Vec GQueryPredicate)] -> Bool
  (some?
    (first
      (filterv
        (fn [predicate]
          (let [names
                (into
                  (query-operand-bindings (.-left predicate))
                  (query-operand-bindings (.-right predicate)))]
            (and (.includes names binding)
                 (some?
                   (first
                     (filterv (fn [name] (.includes names name)) earlier))))))
        predicates))))

(defn query-root-identity-constrained?
  [root: String
   identity-field: String
   predicates: (Vec GQueryPredicate)] -> Bool
  (some?
    (first
      (filterv
        (fn [predicate]
          (let [left (.-left predicate)
                right (.-right predicate)
                identity?
                (fn [operand]
                  (and (= (.-kind operand) "field")
                       (= (.-binding operand) root)
                       (= (.-field operand) identity-field)))
                bound?
                (fn [operand]
                  (or (= (.-kind operand) "parameter")
                      (= (.-kind operand) "literal")))]
            (or (and (identity? left) (bound? right))
                (and (identity? right) (bound? left)))))
        predicates))))

(defn query-dependencies
  [bindings: (Vec IrQueryBinding)
   binding-entities: Any
   predicates: (Vec GQueryPredicate)
   columns: (Vec GQueryColumn)] -> (Vec GQueryDependency)
  (let [entries
        (reduce
          (fn [result binding]
            (let [entity (get binding-entities (.-name binding))]
              (conj result [(.-name entity) (.-name (.-identity-field entity))])))
          [] bindings)
        entries
        (reduce
          (fn [result predicate]
            (reduce
              (fn [acc operand]
                (if (= (.-kind operand) "field")
                  (conj acc [(or (.-entity operand) "") (or (.-field operand) "")])
                  acc))
              result [(.-left predicate) (.-right predicate)]))
          entries predicates)
        entries
        (into
          entries
          (mapv (fn [column] [(.-entity column) (.-field column)]) columns))]
    (mapv
      (fn [entry] (->GQueryDependency (nth entry 0) (nth entry 1)))
      (reduce
        (fn [unique entry]
          (if (.includes
                (mapv (fn [candidate] (str (nth candidate 0) "." (nth candidate 1))) unique)
                (str (nth entry 0) "." (nth entry 1)))
            unique
            (conj unique entry)))
        [] entries))))

(defn provider-named [providers: Any name: String] -> Any
  (first (filterv (fn [provider] (= (.-name provider) name)) providers)))

(defn descriptor-field [descriptor: Any name: String] -> Any
  (first
    (filterv
      (fn [field] (= (get field "name") name))
      (or (get descriptor "fields") []))))

(defn provider-field-type-compatible? [field: GField descriptor: Any] -> Bool
  (let [checked-descriptor
        (if (= (.-cardinality field) "multi")
          (get descriptor "items")
          descriptor)
        kind (if (nil? checked-descriptor) "" (get checked-descriptor "kind"))
        scalar
        (cond
          (= (.-type field) "String") (= kind "string")
          (or (= (.-type field) "Int") (= (.-type field) "Integer"))
            (= kind "integer")
          (or (= (.-type field) "Float")
              (= (.-type field) "Double")
              (= (.-type field) "Number"))
            (= kind "number")
          (or (= (.-type field) "Bool") (= (.-type field) "Boolean"))
            (= kind "boolean")
          :else (or (= kind "string") (= kind "enum")))]
    (if (= (.-cardinality field) "multi")
      (and (= (get descriptor "kind") "list") scalar)
      scalar)))

(defn provider-literal-compatible? [value: Any descriptor: Any] -> Bool
  (let [kind (get descriptor "kind")]
    (cond
      (= kind "nullable")
        (or (nil? value)
            (provider-literal-compatible? value (get descriptor "value")))
      (= kind "literal") (js/Object.is value (get descriptor "value"))
      (= kind "enum")
        (some?
          (first
            (filterv
              (fn [candidate] (js/Object.is candidate value))
              (or (get descriptor "values") []))))
      (= kind "string") (string? value)
      (= kind "integer")
        (and (number? value)
             (js/Number.isSafeInteger value)
             (not (js/Object.is value -0))
             (or (nil? (get descriptor "minimum"))
                 (>= value (get descriptor "minimum")))
             (or (nil? (get descriptor "maximum"))
                 (<= value (get descriptor "maximum"))))
      (= kind "number")
        (and (number? value) (js/Number.isFinite value)
             (not (js/Object.is value -0)))
      (= kind "boolean") (boolean? value)
      :else false)))

(defn analyze-provider-input
  [raw: Any
   expected: Any
   binding-entities: Any
   provider-index: Int
   next-column: Int
   label: String] -> Any
  (let [kind (get raw "kind")]
    (cond
      (= kind "column")
        (let [binding (get raw "binding")
              entity (get binding-entities binding)]
          (if (nil? entity)
            (graph-error (str label " names unknown binding '" binding "'"))
            nil)
          (let [field (query-field entity (get raw "field") label)]
            (if (not (provider-field-type-compatible? field expected))
              (graph-error
                (str label " field '" (.-name entity) "." (.-name field)
                     "' is incompatible with provider input type '"
                     (get expected "kind") "'"))
              nil)
            (let [internal-name
                  (str "wake$provided$" provider-index "$" next-column)
                  column
                  (->GQueryColumn
                    internal-name binding (.-name entity) (.-name field)
                    (.-type field) (.-cardinality field) (.-value-kind field)
                    (.-target-entity field) true)]
              [{"kind" "column" "name" internal-name}
               [column]
               (+ next-column 1)])))
      (= kind "literal")
        (do
          (if (not (provider-literal-compatible? (get raw "value") expected))
            (graph-error (str label " literal is incompatible with provider input type"))
            nil)
          [{"kind" "literal" "value" (get raw "value")} [] next-column])
      (= kind "record")
        (do
          (if (not (= (get expected "kind") "record"))
            (graph-error (str label " record is incompatible with provider input type"))
            nil)
          (let [raw-fields (or (get raw "fields") [])
                expected-fields (or (get expected "fields") [])]
            (doseq [field raw-fields]
              (if (nil? (descriptor-field expected (get field "name")))
                (graph-error
                  (str label " contains unknown provider input field '"
                       (get field "name") "'"))
                nil))
            (doseq [field expected-fields]
              (if (and (= (get field "required") true)
                       (nil?
                         (first
                           (filterv
                             (fn [candidate]
                               (= (get candidate "name") (get field "name")))
                             raw-fields))))
                (graph-error
                  (str label " requires provider input field '"
                       (get field "name") "'"))
                nil))
            (loop [remaining: Any raw-fields
                   fields: Any []
                   columns: Any []
                   next: Int next-column]
              (if (= (count remaining) 0)
                [{"kind" "record" "fields" fields} columns next]
                (let [field (first remaining)
                      field-name (get field "name")
                      checked
                      (analyze-provider-input
                        (get field "value")
                        (get (descriptor-field expected field-name) "value")
                        binding-entities provider-index next
                        (str label "." field-name))]
                  (recur
                    (rest remaining)
                    (conj fields {"name" field-name "value" (nth checked 0)})
                    (into columns (nth checked 1))
                    (nth checked 2)))))))
      :else (graph-error (str label " has unknown provider input expression '" kind "'")))))

(defn analyze-query-column
  [selection: Any
   binding-entities: Any
   label: String
   internal: Bool] -> GQueryColumn
  (let [entity (get binding-entities (.-binding selection))]
    (if (nil? entity)
      (graph-error
        (str label " output '" (.-name selection)
             "' names unknown binding '" (.-binding selection) "'"))
      nil)
    (let [field (query-field entity (.-field selection) label)]
      (->GQueryColumn
        (.-name selection) (.-binding selection) (.-name entity)
        (.-name field) (.-type field) (.-cardinality field)
        (.-value-kind field) (.-target-entity field) internal))))

(defn analyze-query-selections
  [selections: Any
   binding-entities: Any
   providers: Any
   label: String] -> Any
  (loop [remaining: Any selections
         provider-index: Int 0
         columns: Any []
         public-columns: Any []
         result-providers: Any []
         output-names: (Vec String) []]
    (if (= (count remaining) 0)
      [columns public-columns result-providers]
      (let [selection (first remaining)
            tag (.-_tag selection)
            output-name (.-name selection)]
        (if (.includes output-names output-name)
          (graph-error (str label " output '" output-name "' is duplicated"))
          nil)
        (if (= tag "IrQueryProvided")
          (let [provider-name (.-provider selection)
                provider (provider-named providers provider-name)]
            (if (nil? provider)
              (graph-error
                (str label " output '" output-name
                     "' names unbound provider '" provider-name "'"))
              nil)
            (if (>= provider-index 16)
              (graph-error (str label " supports at most 16 provider results"))
              nil)
            (if (not (= (get (.-output-type provider) "kind") "bounded"))
              (graph-error
                (str label " provider '" provider-name
                     "' output must be a bounded checked value"))
              nil)
            (let [checked
                  (analyze-provider-input
                    (.-input selection)
                    (.-input-type provider)
                    binding-entities provider-index 0
                    (str label " provider output '" output-name "' input"))
                  internal-columns (nth checked 1)
                  result-provider
                  (->GQueryResultProvider
                    output-name provider-name (nth checked 0)
                    (.-input-type provider) (.-output-type provider))]
              (recur
                (rest remaining)
                (+ provider-index 1)
                (into columns internal-columns)
                public-columns
                (conj result-providers result-provider)
                (conj output-names output-name))))
          (if (= tag "IrQuerySelect")
            (let [column
                  (analyze-query-column selection binding-entities label false)]
              (recur
                (rest remaining)
                provider-index
                (conj columns column)
                (conj public-columns column)
                result-providers
                (conj output-names output-name)))
            (graph-error (str label " contains an unexpanded query projection"))))))))

(defn analyze-query
  [raw: IrQuery
   entities: (Vec GEntity)
   defstates: (Vec IrDefstate)
   providers: Any] -> GQuery
  (let [name (.-name raw)
        label (str "query '" name "'")
        entities-by-name
        (query-name-map entities (fn [entity] (.-name entity)) "entity")
        capabilities (or (.-capabilities raw) [])
        raw-bindings (.-bindings raw)
        raw-params (.-params raw)
        binding-names
        (query-name-map raw-bindings (fn [binding] (.-name binding))
                        (str label " binding"))
        parameters
        (query-name-map raw-params (fn [parameter] (.-name parameter))
                        (str label " parameter"))
        binding-entities
        (reduce
          (fn [result binding]
            (let [entity (get entities-by-name (.-entity-name binding))]
              (if (nil? entity)
                (graph-error
                  (str label " binding '" (.-name binding)
                       "' names unknown entity '" (.-entity-name binding) "'"))
                nil)
              (assoc result (.-name binding) entity)))
          {} raw-bindings)]
    (if (or (= (count capabilities) 0) (> (count capabilities) 16))
      (graph-error
        (str label " requires from 1 through 16 capabilities"))
      nil)
    (reduce
      (fn [seen capability]
        (if (or (not (string? capability)) (= (count capability) 0))
          (graph-error (str label " contains an invalid capability"))
          nil)
        (if (.includes seen capability)
          (graph-error
            (str label " repeats capability '" capability "'"))
          (conj seen capability)))
      [] capabilities)
    (doseq [selection (.-selection raw)]
      (if (= (.-_tag selection) "IrQueryFieldSplice")
        (graph-error
          (str label " contains an unexpanded extension-field projection"))
        nil))
    (doseq [parameter raw-params]
      (let [type (.-type parameter)]
        (if (= type "Ref")
          (graph-error
            (str label " parameter '" (.-name parameter)
                 "' cannot use Ref without a target entity"))
          nil)
        (if (not
              (or (fram-literal-type? type)
                  (some? (query-state defstates type))))
          (graph-error
            (str label " parameter '" (.-name parameter)
                 "' has unsupported type '" type "'"))
          nil)))
    (if (= (count raw-bindings) 0)
      (graph-error (str label " requires at least one entity binding"))
      nil)
    (if (= (count (.-selection raw)) 0)
      (graph-error (str label " requires at least one output projection"))
      nil)
    (let [predicates
          (mapv
            (fn [predicate]
              (analyze-query-predicate
                predicate binding-entities parameters defstates label))
            (.-predicates raw))
          checked-bindings
          (mapv
            (fn [binding]
              (->GQueryBinding (.-name binding) (.-entity-name binding)))
            raw-bindings)
          analyzed-selection
          (analyze-query-selections
            (.-selection raw) binding-entities providers label)
          columns (nth analyzed-selection 0)
          public-columns (nth analyzed-selection 1)
          result-providers (nth analyzed-selection 2)
          root-binding (first raw-bindings)
          root-entity (get binding-entities (.-name root-binding))
          first-column
          (if (> (count public-columns) 0)
            (first public-columns)
            (graph-error (str label " must expose at least one ordinary field output")))
          result-kind (.-result-kind raw)
          page (.-page raw)]
      (doseq [parameter raw-params]
        (if (not
              (some?
                (first
                  (filterv
                    (fn [predicate]
                      (or (= (.-parameter (.-left predicate)) (.-name parameter))
                          (= (.-parameter (.-right predicate)) (.-name parameter))))
                    predicates))))
          (graph-error
            (str label " parameter '" (.-name parameter) "' is unused"))
          nil))
      (loop [index: Int 1]
        (if (< index (count raw-bindings))
          (let [binding (.-name (nth raw-bindings index))
                earlier
                (mapv (fn [item] (.-name item)) (subvec raw-bindings 0 index))]
            (if (not (query-binding-connected? binding earlier predicates))
              (graph-error
                (str label " binding '" binding "' is disconnected"))
              nil)
            (recur (+ index 1)))
          nil))
      (if (or (not (= (.-binding first-column) (.-name root-binding)))
              (not (= (.-field first-column)
                      (.-name (.-identity-field root-entity)))))
        (graph-error
          (str label " must project its root identity as the first output"))
        nil)
      (if (and (not (= result-kind "page"))
               (not
                 (query-root-identity-constrained?
                   (.-name root-binding)
                   (.-name (.-identity-field root-entity))
                   predicates)))
        (graph-error (str label " singular result must constrain its root identity"))
        nil)
      (if (and (= result-kind "page") (> (count result-providers) 0))
        (graph-error (str label " paged results cannot derive provider outputs"))
        nil)
      (if (and (= result-kind "page")
               (some?
                 (first
                   (filterv
                     (fn [column] (= (.-cardinality column) "multi"))
                     columns))))
        (graph-error (str label " paged results cannot project multi fields"))
        nil)
      (->GQuery
        name
        capabilities
        (mapv
          (fn [parameter]
            (->GQueryParam (.-name parameter) (.-type parameter)))
          raw-params)
        checked-bindings
        predicates
        columns
        result-providers
        result-kind
        (if (some? page) (.-default-limit page) nil)
        (if (some? page) (.-max-limit page) nil)
        (query-dependencies raw-bindings binding-entities predicates columns)))))

(defn resolve-queries
  [prog: IrProgram
   entities: (Vec GEntity)
   defstates: (Vec IrDefstate)] -> (Vec GQuery)
  (let [queries (or (.-queries prog) [])]
    (if (and (> (count queries) 0) (nil? (.-backend prog)))
      (graph-error "named queries require (backend :fram)")
      nil)
    (query-name-map queries (fn [query] (.-name query)) "query")
    (mapv
      (fn [query]
        (analyze-query query entities defstates (or (.-providers prog) [])))
      queries)))

(defn query-named [queries: (Vec GQuery) name: String] -> GQuery?
  (first (filterv (fn [query] (= (.-name query) name)) queries)))

(defn view-named [views: Any name: String] -> Any
  (first (filterv (fn [view] (= (.-name view) name)) views)))

(defn component-named [components: Any name: String] -> Any
  (first (filterv (fn [component] (= (.-name component) name)) components)))

(defn checked-query-route
  [prog: IrProgram
   queries: (Vec GQuery)
   route: IrRoute
   label: String] -> IrRoute
  (let [view (view-named (or (.-views prog) []) (.-view-name route))
        parameters (or (.-parameters route) [])
        input-parameters (or (.-input-parameters route) parameters)
        query-names (or (.-queries route) [])]
    (if (nil? view)
      (graph-error
        (str label " names unknown view '" (.-view-name route) "'"))
      nil)
    (let [resolved-view (or view (first (or (.-views prog) [])))
          component
          (component-named
            (or (.-components prog) []) (.-component resolved-view))
          resolved-queries
          (mapv
            (fn [reference]
              (let [query (query-named queries (.-name reference))]
                (if (nil? query)
                  (graph-error
                    (str label " names unknown query '"
                         (.-name reference) "'"))
                  nil)
                {:query (or query (first queries))
                 :reference reference}))
            query-names)]
      (if (nil? component)
        (graph-error
          (str label " view names unknown component '"
               (.-component resolved-view) "'"))
        nil)
      (doseq [resolved resolved-queries]
        (let [query (get resolved :query)
              query-params
              (mapv (fn [parameter] (.-name parameter)) (.-params query))]
          (if (not (= query-params input-parameters))
            (graph-error
              (str label " input parameters must exactly match query '"
                   (.-name query) "' parameters"))
            nil)))
      (let [columns
            (reduce
              (fn [result resolved]
                (let [query (get resolved :query)
                      public-column-names
                      (mapv
                        (fn [column] (.-name column))
                        (filterv
                          (fn [column] (not (.-internal column)))
                          (.-columns query)))
                      provider-result-names
                      (mapv
                        (fn [provider] (.-name provider))
                        (or (.-result-providers query) []))]
                  (reduce
                    (fn [names output-name]
                      (let [prefix (.-prefix (get resolved :reference))
                          projected-name
                          (if (nil? prefix)
                            output-name
                            (str prefix "-" output-name))]
                        (if (.includes names projected-name)
                          (graph-error
                            (str label " query projections collide on '"
                                 projected-name "'"))
                          (conj names projected-name))))
                    result
                    (into public-column-names provider-result-names))))
              [] resolved-queries)
            checked-component
            (or component (first (or (.-components prog) [])))
            missing
            (filterv
              (fn [prop] (not (.includes columns prop)))
              (.-props checked-component))]
        (if (> (count missing) 0)
          (graph-error
            (str label " queries do not provide component props: "
                 (.join missing ", ")))
          nil)
        (ir/->IrRoute
          (.-path route)
          (.-view-name route)
          query-names
          parameters
          input-parameters
          (.-props checked-component))))))

(defn checked-route-templates
  [prog: IrProgram
   queries: (Vec GQuery)] -> (Vec IrRoute)
  (mapv
    (fn [route]
      (checked-query-route
        prog queries route (str "route template '" (.-path route) "'")))
    (or (.-route-templates prog) [])))

(defn checked-router [prog: IrProgram queries: (Vec GQuery)] -> IrRouter?
  (let [router (.-router prog)]
    (if (nil? router)
      nil
      (ir/->IrRouter
        (.-default-route router)
        (mapv
          (fn [route]
            (if (> (count (or (.-queries route) [])) 0)
              (checked-query-route
                prog queries route (str "route '" (.-path route) "'"))
              route))
          (or (.-routes router) []))))))

(defn check-composition [prog: Any] -> Any
  (let [providers (or (.-providers prog) [])
        extensions (or (.-extends prog) [])
        fills (or (.-fills prog) [])
        mounts (or (.-mounts prog) [])]
    (reduce
      (fn [seen provider]
        (let [name (.-name provider)]
          (validate-generated-name "provider" name)
          (if (.includes seen name)
            (graph-error (str "duplicate provider '" name "'"))
            (conj seen name))))
      [] providers)
    (reduce
      (fn [seen extension]
        (let [port (.-port extension)]
          (if (.includes seen port)
            (graph-error (str "extension port '" port "' is supplied twice"))
            (conj seen port))))
      [] extensions)
    (reduce
      (fn [seen fill]
        (let [port (.-port fill)]
          (if (.includes seen port)
            (graph-error (str "component port '" port "' is filled twice"))
            (conj seen port))))
      [] fills)
    (reduce
      (fn [seen mount]
        (let [path (.-path mount)]
          (if (.includes seen path)
            (graph-error (str "route path '" path "' is mounted twice"))
            (conj seen path))))
      [] mounts)
    nil))

(defn check-program [prog: Any] -> CheckedApplication
  (let [app-id (application-id prog)
        entities
        (mapv
          (fn [entity]
            (analyze-entity prog entity app-id))
          (.-entities prog))
        defstates (or (.-defstates prog) [])
        validated-names (validate-generated-names prog entities defstates)
        validated-declarations (validate-declaration-uniqueness prog entities)
        validated-storage-ids (validate-storage-id-uniqueness entities)
        validated (validate-backend prog entities)
        validated-create-forms (validate-fram-create-forms prog entities)
        validated-ui (validate-ui-references prog entities)
        validated-defstates (validate-defstates defstates)
        validated-composition (check-composition prog)
        fk-edges (resolve-fk-edges entities)
        state-machines
        (resolve-state-machines entities defstates)
        publications (resolve-publications prog entities state-machines)
        queries (resolve-queries prog entities defstates)
        list-details (resolve-list-details prog entities)
        route-templates (checked-route-templates prog queries)
        router (checked-router prog queries)]
    (->CheckedApplication
      1
      app-id
      (checked-source-units prog)
      (or (.-plugin-closure prog) [])
      (.-semantic-fingerprint prog)
      (or (.-providers prog) [])
      (or (.-value-types prog) [])
      (or (.-provider-ports prog) [])
      (or (.-extends prog) [])
      (or (.-fills prog) [])
      (or (.-mounts prog) [])
      route-templates
      (or (.-ns prog) "wake.app")
      (.-backend prog)
      entities
      fk-edges
      state-machines
      publications
      queries
      (or (.-commands prog) [])
      (.-persist prog)
      defstates
      list-details
      (or (.-forms prog) [])
      (.-theme prog)
      (or (.-components prog) [])
      (or (.-views prog) [])
      router
      (.-layout prog))))
