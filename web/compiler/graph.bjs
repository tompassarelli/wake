#lang beagle/js
(ns wake.graph)
(require wake.ir :as ir)

;; Checked Entity Graph
;;
;; Resolves a linked typed declaration program into one analyzed graph.
;; Every emitter reads this graph instead of re-deriving relationships.

;; --- Graph records ---

(defrecord GField
  [(name String)
   (storage-id String)
   (type String)
   (identity Bool)
   (cardinality String)
   (value-kind String)
   (target-entity String?)
   (write-policy String)
   (derived Bool)
   (deps (Vec String))
   (expr IrDerivedExpr?)])

(defrecord GEntity
  [(name String)
   (storage-id String)
   (fields (Vec GField))
   (stored-fields (Vec GField))
   (derived-fields (Vec GField))
   (ref-fields (Vec GField))
   (identity-field GField?)
   (store-name String)])

(defrecord FkEdge [(from-entity String) (from-field String) (to-entity String)])

(defrecord StateMachine
  [(entity String)
   (field String)
   (state-type String)
   (transitions (Map String (Vec String)))
   (initial String)])

(defrecord PublicationPolicy
  [(name String)
   (owner-entity String)
   (pointer-field String)
   (revision-entity String)
   (owner-field String)
   (state-field String)
   (draft-state String)
   (published-state String)
   (retired-state String)])

(defrecord GQueryParam [(name String) (type String)])
(defrecord GQueryBinding [(name String) (entity String)])
(defrecord GQueryOperand
  [(kind String)
   (type String)
   (target-entity String?)
   (binding String?)
   (entity String?)
   (field String?)
   (parameter String?)
   (value Any)])
(defrecord GQueryPredicate
  [(op String) (left GQueryOperand) (right GQueryOperand)])
(defrecord GQueryColumn
  [(name String)
   (binding String)
   (entity String)
   (field String)
   (type String)
   (cardinality String)
   (value-kind String)
   (target-entity String?)
   (internal Bool)])
(defrecord GQueryResultProvider
  [(name String)
   (provider String)
   (input Any)
   (input-type Any)
   (output-type Any)])
(defrecord GQueryDependency [(entity String) (field String)])
(defrecord GQuery
  [(name String)
   (capabilities (Vec String))
   (params (Vec GQueryParam))
   (bindings (Vec GQueryBinding))
   (predicates (Vec GQueryPredicate))
   (columns (Vec GQueryColumn))
   (result-providers (Vec GQueryResultProvider))
   (result-kind String)
   (default-limit Int?)
   (max-limit Int?)
   (dependencies (Vec GQueryDependency))])

(defrecord GProviderPort [(name String) (input Any) (output Any)])

(defrecord GProvider
  [(name String)
   (port String)
   (package-id String)
   (port-name String)
   (input-type Any)
   (output-type Any)
   (span SourceSpan)])

(defrecord GExtension
  [(kind String)
   (package-id String)
   (port String)
   (target String)
   (fields (Vec IrAttr))])

(defrecord GFill
  [(port String)
   (component String)
   (package-id String)
   (target-component String)])

(defrecord GMount
  [(input-parameters (Vec String))
   (package-id String)
   (parameters (Vec String))
   (path String)
   (pattern String)
   (port String)
   (queries (Vec IrRouteQuery))
   (required-props (Vec String))
   (target-route String)
   (view-name String)])

(defrecord ResolvedPluginExtension
  [(instance IrLinkedPluginInstance)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (source IrExtendSpec)
   (port IrEntityFieldsPortSpec)
   (target String)
   (extension IrExtend)])

(defrecord LoweredPlugin
  [(instance IrLinkedPluginInstance)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (source-unit IrSourceUnit)
   (provenance (Vec IrDeclarationProvenance))
   (evidence Any)
   (entities (Vec GEntity))
   (states (Vec IrDefstate))
   (publications (Vec IrPublication))
   (queries (Vec IrQuery))
   (commands (Vec Any))
   (forms (Vec IrSmartForm))
   (list-details (Vec IrListDetail))
   (value-types (Vec Any))
   (provider-ports (Vec GProviderPort))
   (providers (Vec GProvider))
   (extensions (Vec ResolvedPluginExtension))
   (fills (Vec GFill))
   (mounts (Vec GMount))
   (components (Vec IrComponent))
   (views (Vec IrView))
   (route-templates (Vec IrRoute))
   (mounted-routes (Vec IrRoute))])

(defrecord GDetailTab
  [(label String)
   (content-type String)
   (fields (Vec String))
   (entity-name String?)
   (relation-field String?)
   (display-fields (Vec String))])

(defrecord GListDetail
  [(entity-name String)
   (title String)
   (columns (Vec String))
   (search-cols (Vec String))
   (detail-tabs (Vec GDetailTab))])

(defrecord CheckedApplication
  [(schema-version Int)
   (application-id String)
   (source-units (Vec IrSourceUnit))
   (plugin-closure (Vec Any))
   (linked-declarations IrLinkedDeclarationProgram)
   (semantic-fingerprint String?)
   (providers (Vec GProvider))
   (value-types (Vec Any))
   (provider-ports (Vec Any))
   (extensions (Vec GExtension))
   (fills (Vec GFill))
   (mounts (Vec GMount))
   (route-templates (Vec IrRoute))
   (ns String)
   (backend IrBackend?)
   (entities (Vec GEntity))
   (fk-edges (Vec FkEdge))
   (state-machines (Vec StateMachine))
   (publications (Vec PublicationPolicy))
   (queries (Vec GQuery))
   (commands (Vec Any))
   (persist IrPersist?)
   (defstates (Vec IrDefstate))
   (list-details (Vec GListDetail))
   (forms (Vec IrSmartForm))
   (theme IrTheme?)
   (components (Vec IrComponent))
   (views (Vec IrView))
   (router IrRouter?)
   (layout IrLayout?)])

;; Exact nominal resolution happens before the existing graph analyses.  This
;; is a graph input, not a public/source IR: its linked declaration sidecar is
;; retained and every string name below has already been resolved from a
;; concrete nominal reference.
(defrecord ResolvedDeclarationProgram
  [(linked-declarations IrLinkedDeclarationProgram)
   (application-id String)
   (source-unit IrSourceUnit)
   (source-units (Vec IrSourceUnit))
   (plugin-closure (Vec Any))
   (declaration-provenance (Vec IrDeclarationProvenance))
   (ns String)
   (backend IrBackend?)
   (entities (Vec GEntity))
   (persist IrPersist?)
   (defstates (Vec IrDefstate))
   (publications (Vec IrPublication))
   (queries (Vec IrQuery))
   (commands (Vec Any))
   (list-details (Vec IrListDetail))
   (forms (Vec IrSmartForm))
   (theme IrTheme?)
   (components (Vec IrComponent))
   (views (Vec IrView))
   (router IrRouter?)
   (providers (Vec GProvider))
   (value-types (Vec Any))
   (provider-ports (Vec Any))
   (extends (Vec GExtension))
   (fills (Vec GFill))
   (mounts (Vec GMount))
   (route-templates (Vec IrRoute))
   (layout IrLayout?)])

;; --- Checked declaration lowering ---

(defn require-ir-tag [(value Any) (tag String) (label String)] Any
  (if (or (nil? value) (not (= (js/get value ._tag) tag)))
    (graph-error
      (str label " must be " tag ", got "
           (if (nil? value) "nil" (or (js/get value ._tag) "untagged"))))
    value))

(defn same-nominal? [(left Any) (right Any)] Bool
  (and
    (some? left)
    (some? right)
    (= (js/get left ._tag) (js/get right ._tag))
    (= (js/get left .declaration_id) (js/get right .declaration_id))))

(defrecord DeclarationResolver
  [(prefix String)
   (package-id String)
   (bindings IrPluginBindings?)
   (entity-names Any)
   (field-names Any)
   (state-names Any)
   (state-values Any)
   (receipt-field-names Any)
   (value-bindings Any)
   (provider-bindings Any)])

(defn empty-resolver [] DeclarationResolver
  (->DeclarationResolver "" "application" nil {} {} {} {} {} {} {}))

(defn ref-key [(ref Any)] String
  (or (js/get ref .declaration_id) ""))

(defn resolved-local-name
  [(resolver DeclarationResolver) (kind String) (ref Any)] String
  (let [renames
        (cond
          (= kind "entity") (js/get resolver .entity_names)
          (= kind "field") (js/get resolver .field_names)
          (= kind "state") (js/get resolver .state_names)
          (= kind "state-value") (js/get resolver .state_values)
          (= kind "receipt-field") (js/get resolver .receipt_field_names)
          :else {})]
    (or (get renames (ref-key ref)) (js/get ref .name))))

(defn resolved-name
  [(resolver DeclarationResolver) (kind String) (ref Any)] String
  (let [name (resolved-local-name resolver kind ref)]
    (if (or (= (js/get resolver .prefix) "")
            (= kind "field")
            (= kind "state-value")
            (= kind "receipt-field"))
      name
      (str (js/get resolver .prefix) "." name))))

(defn resolved-capability-name
  [(resolver DeclarationResolver) (ref IrCapabilityRef)] String
  (if (= (js/get resolver .prefix) "")
    (js/get ref .name)
    (str (js/get resolver .package_id) "/cap/" (js/get ref .name))))

(defn binding-for-role [(items Any) (role Any) (label String)] Any
  (let [matches
        (filterv
          (fn [(binding Any)] Bool
            (= (ref-key (js/get binding .role)) (ref-key role)))
          (or items []))]
    (if (not (= (count matches) 1))
      (graph-error
        (str label " requires exactly one binding for role '" (ref-key role) "'"))
      (first matches))))

(defn role-renames
  [(specs Any) (bindings Any) (target-fn Any) (value-fn Any) (label String)] Any
  (reduce
    (fn [result spec] Any
      (let [binding (binding-for-role bindings (js/get spec .ref) label)
            target (target-fn spec)
            key (ref-key target)]
        (if (some? (get result key))
          (graph-error (str label " repeats target '" key "'"))
          (assoc result key (value-fn binding)))))
    {}
    (or specs [])))

(defn plugin-resolver
  [(instance IrLinkedPluginInstance)
   (program IrDeclarationProgram)]
  DeclarationResolver
  (let [plugin (js/get (js/get program .root) .plugin)
        schema (js/get plugin .configuration)
        bindings (js/get (js/get instance .use) .bindings)
        entity-names
        (role-renames
          (js/get schema .entity_names) (js/get bindings .entity_names)
          (fn [(spec IrEntityNameRoleSpec)] Any (js/get spec .target))
          (fn [(binding IrEntityNameBinding)] String (js/get (js/get binding .value) .value))
          "plugin entity-name configuration")
        field-names
        (role-renames
          (filterv
            (fn [(spec IrFieldNameRoleSpec)] Bool
              (= (js/get (js/get spec .target) ._tag) "IrEntityFieldNameRoleTarget"))
            (js/get schema .field_names))
          (js/get bindings .field_names)
          (fn [(spec IrFieldNameRoleSpec)] Any (js/get (js/get spec .target) .field))
          (fn [(binding IrFieldNameBinding)] String
            (js/get (js/get (js/get binding .value) .name) .value))
          "plugin field-name configuration")
        receipt-field-names
        (role-renames
          (filterv
            (fn [(spec IrFieldNameRoleSpec)] Bool
              (= (js/get (js/get spec .target) ._tag) "IrReceiptFieldNameRoleTarget"))
            (js/get schema .field_names))
          (js/get bindings .field_names)
          (fn [(spec IrFieldNameRoleSpec)] Any (js/get (js/get spec .target) .field))
          (fn [(binding IrFieldNameBinding)] String
            (js/get (js/get (js/get binding .value) .name) .value))
          "plugin receipt-field-name configuration")
        state-names
        (role-renames
          (js/get schema .state_names) (js/get bindings .state_names)
          (fn [(spec IrStateNameRoleSpec)] Any (js/get spec .target))
          (fn [(binding IrStateNameBinding)] String (js/get (js/get binding .value) .value))
          "plugin state-name configuration")
        state-values
        (role-renames
          (js/get schema .state_value_names) (js/get bindings .state_value_names)
          (fn [(spec IrStateValueNameRoleSpec)] Any (js/get spec .target))
          (fn [(binding IrStateValueNameBinding)] String
            (strip-colon (js/get (js/get binding .value) .value)))
          "plugin state-value-name configuration")
        values
        (reduce
          (fn [result binding] Any
            (assoc result (ref-key (js/get binding .role)) (js/get binding .value)))
          {}
          (js/get bindings .values))
        providers
        (reduce
          (fn [result binding] Any
            (assoc result (ref-key (js/get binding .port)) (js/get binding .name)))
          {}
          (js/get (js/get instance .composition) .providers))]
    (->DeclarationResolver
      (js/get instance .alias)
      (js/get (js/get instance .evidence) .package_id)
      bindings
      entity-names field-names state-names state-values receipt-field-names
      values providers)))

(defn value-expression-literal
  [(expr IrValueExpr) (resolver DeclarationResolver) (label String)] Any
  (let [tag (js/get expr ._tag)]
    (cond
      (= tag "IrLiteralStringValue") (js/get expr .value)
      (= tag "IrLiteralIntegerValue") (js/get expr .value)
      (= tag "IrLiteralBooleanValue") (js/get expr .value)
      (= tag "IrLiteralKeywordValue") (strip-colon (js/get expr .value))
      (= tag "IrLiteralNilValue") nil
      (= tag "IrRecordValue")
        (reduce
          (fn [result field] Any
            (assoc result (strip-colon (js/get field .name))
                   (value-expression-literal (js/get field .value) resolver label)))
          {}
          (js/get expr .fields))
      (= tag "IrListValue")
        (mapv
          (fn [(item IrValueExpr)] Any
            (value-expression-literal item resolver label))
          (js/get expr .items))
      (= tag "IrConfigValue")
        (let [bound (get (js/get resolver .value_bindings) (ref-key (js/get expr .role)))]
          (if (nil? bound)
            (graph-error (str label " names an unbound configured value"))
            (value-expression-literal bound resolver label)))
      (= tag "IrConfigProjectionValue")
        (configured-projection-literal
          (js/get expr .projection) resolver label)
      (= tag "IrBoundFieldValue")
        (graph-error (str label " cannot use a bound field as a constant"))
      :else
        (graph-error (str label " uses unsupported value expression '" tag "'")))))

(defn configured-projection-literal
  [(projection IrConfigProjection)
   (resolver DeclarationResolver)
   (label String)]
  Any
  (let [bound
        (get (js/get resolver .value_bindings) (ref-key (js/get projection .role)))
        root
        (if (nil? bound)
          (graph-error (str label " names an unbound configured projection"))
          (value-expression-literal bound resolver label))]
    (reduce
      (fn [value part] Any
        (let [next (if (nil? value) nil (get value part))]
          (if (nil? next)
            (graph-error
              (str label " configuration projection misses '" part "'"))
            next)))
      root
      (js/get projection .path))))

(defn resolved-bound-int
  [(bound IrBoundInt) (resolver DeclarationResolver) (label String)] Int
  (let [tag (js/get bound ._tag)
        value
        (cond
          (= tag "IrLiteralBound") (js/get bound .value)
          (= tag "IrConfiguredBound")
            (let [binding
                  (binding-for-role
                    (js/get (js/get resolver .bindings) .ints) (js/get bound .role) label)]
              (js/get binding .value))
          (= tag "IrConfiguredProjectionBound")
            (configured-projection-literal
              (js/get bound .projection) resolver label)
          :else (graph-error (str label " uses unsupported bound '" tag "'")))]
    (if (or (not (number? value)) (not (js/Number.isSafeInteger value)))
      (graph-error (str label " must resolve to a safe integer"))
      value)))

(defn value-type-literal [(literal IrValueLiteral) (label String)] Any
  (let [tag (js/get literal ._tag)]
    (cond
      (= tag "IrStringLiteral") (js/get literal .value)
      (= tag "IrIntegerLiteral") (js/get literal .value)
      (= tag "IrBooleanLiteral") (js/get literal .value)
      (= tag "IrKeywordLiteral") (strip-colon (js/get literal .value))
      (= tag "IrNilLiteral") nil
      :else
        (graph-error (str label " uses unsupported literal '" tag "'")))))

(defn value-type-definition
  [(program IrDeclarationProgram)
   (ref IrValueTypeRef)
   (label String)]
  IrValueTypeDefinition
  (let [matches
        (reduce
          (fn [result declaration] (Vec IrValueTypeDefinition)
            (into result
              (filterv
                (fn [(definition IrValueTypeDefinition)] Bool
                  (same-nominal? (js/get definition .ref) ref))
                (js/get declaration .definitions))))
          []
          (js/get program .value_types))]
    (if (not (= (count matches) 1))
      (graph-error (str label " must resolve one value-type definition"))
      (first matches))))

(defn value-type-declaration
  [(program IrDeclarationProgram)
   (ref IrValueTypeRef)
   (label String)]
  IrValueTypeDeclarationSpec
  (let [matches
        (filterv
          (fn [(declaration IrValueTypeDeclarationSpec)] Bool
            (some?
              (first
                (filterv
                  (fn [(definition IrValueTypeDefinition)] Bool
                    (same-nominal? (js/get definition .ref) ref))
                  (js/get declaration .definitions)))))
          (js/get program .value_types))]
    (if (not (= (count matches) 1))
      (graph-error (str label " must resolve one value-type declaration"))
      (first matches))))

(defn lower-value-descriptor
  [(source IrValueTypeSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (label String)]
  Any
  (let [tag (js/get source ._tag)]
    (cond
      (= tag "IrStringValueType")
        (let [minimum
              (if (nil? (js/get source .minimum_scalars)) nil
                  (resolved-bound-int (js/get source .minimum_scalars) resolver label))
              maximum
              (if (nil? (js/get source .maximum_scalars)) nil
                  (resolved-bound-int (js/get source .maximum_scalars) resolver label))
              bytes
              (if (nil? (js/get source .maximum_bytes)) nil
                  (resolved-bound-int (js/get source .maximum_bytes) resolver label))]
          (cond
            (and (some? minimum) (some? maximum) (some? bytes))
              {"kind" "string" "minLength" minimum
               "maxLength" maximum "maxBytes" bytes}
            (and (some? minimum) (some? maximum))
              {"kind" "string" "minLength" minimum "maxLength" maximum}
            (and (some? minimum) (some? bytes))
              {"kind" "string" "minLength" minimum "maxBytes" bytes}
            (and (some? maximum) (some? bytes))
              {"kind" "string" "maxLength" maximum "maxBytes" bytes}
            (some? minimum) {"kind" "string" "minLength" minimum}
            (some? maximum) {"kind" "string" "maxLength" maximum}
            (some? bytes) {"kind" "string" "maxBytes" bytes}
            :else {"kind" "string"}))
      (= tag "IrIntegerValueType")
        (let [minimum
              (if (nil? (js/get source .minimum)) nil
                  (resolved-bound-int (js/get source .minimum) resolver label))
              maximum
              (if (nil? (js/get source .maximum)) nil
                  (resolved-bound-int (js/get source .maximum) resolver label))]
          (cond
            (and (some? minimum) (some? maximum))
              {"kind" "integer" "minimum" minimum "maximum" maximum}
            (some? minimum) {"kind" "integer" "minimum" minimum}
            (some? maximum) {"kind" "integer" "maximum" maximum}
            :else {"kind" "integer"}))
      (= tag "IrBooleanValueType") {"kind" "boolean"}
      (= tag "IrDigestValueType") {"kind" "digest"}
      (= tag "IrInstantValueType") {"kind" "instant"}
      (= tag "IrKeywordValueType") {"kind" "keyword"}
      (= tag "IrEnumValueType")
        {"kind" "enum"
         "values"
         (mapv
           (fn [(literal IrValueLiteral)] Any
             (value-type-literal literal label))
           (js/get source .allowed))}
      (= tag "IrEntityReferenceValueType")
        {"kind" "string"}
      (= tag "IrStateValueType") {"kind" "keyword"}
      (= tag "IrRecordValueType")
        {"kind" "record"
         "fields"
         (mapv
           (fn [(field IrValueRecordField)] Any
             {"name" (js/get field .name)
              "required" (js/get field .required)
              "value"
              (lower-value-descriptor
                (js/get field .value_type) program resolver
                (str label "." (js/get field .name)))})
           (js/get source .fields))}
      (= tag "IrTaggedValueType")
        {"kind" "tagged"
         "tag" (js/get source .tag_field)
         "variants"
         (mapv
           (fn [(variant IrValueTaggedVariant)] Any
             {"tag" (js/get variant .tag)
              "fields"
              (mapv
                (fn [(field IrValueRecordField)] Any
                  {"name" (js/get field .name)
                   "required" (js/get field .required)
                   "value"
                   (lower-value-descriptor
                     (js/get field .value_type) program resolver
                     (str label "." (js/get field .name)))})
                (js/get variant .fields))})
           (js/get source .variants))}
      (= tag "IrListValueType")
        (let [maximum
              (if (nil? (js/get source .maximum_items))
                (graph-error (str label " list requires a maximum bound"))
                (resolved-bound-int (js/get source .maximum_items) resolver label))]
          (if (some? (js/get source .minimum_items))
            (graph-error (str label " list minimum is not representable"))
            nil)
          (if (nil? (js/get source .normalization))
            {"kind" "list"
             "items"
             (lower-value-descriptor
               (js/get source .item) program resolver (str label " item"))
             "maxItems" maximum}
            (if (= (js/get (js/get source .normalization) ._tag) "IrSortUniqueList")
              {"kind" "list"
               "items"
               (lower-value-descriptor
                 (js/get source .item) program resolver (str label " item"))
               "maxItems" maximum
               "normalizer" "sort-unique"}
              (graph-error (str label " uses unsupported list normalization")))))
      (= tag "IrNullableValueType")
        {"kind" "nullable"
         "value"
         (lower-value-descriptor
           (js/get source .value_type) program resolver (str label " nullable value"))}
      (= tag "IrNamedValueType")
        {"kind" "ref" "name" (js/get (js/get source .value_type) .name)}
      (= tag "IrLiteralValueType")
        {"kind" "literal" "value" (value-type-literal (js/get source .literal) label)}
      (= tag "IrExtensionValueType")
        {"kind" "extension"
         "port" (imported-port-name (js/get resolver .prefix) (js/get source .port))}
      :else
        (graph-error (str label " uses unsupported value type '" tag "'")))))

(defn lower-value-type-declaration
  [(source IrValueTypeDeclarationSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)]
  Any
  (let [name (resolved-name resolver "value-type" (js/get source .root))
        envelope (js/get source .envelope)]
    (if (nil? envelope)
      (graph-error (str "value type '" name "' requires a bounded envelope"))
      nil)
    {"name" name
     "descriptor"
     {"kind" "bounded"
      "definitions"
      (mapv
        (fn [(definition IrValueTypeDefinition)] Any
          {"name" (js/get (js/get definition .ref) .name)
           "value"
           (lower-value-descriptor
             (js/get definition .spec) program resolver
             (str "value type '" name "'"))})
        (js/get source .definitions))
      "maxBytes"
      (resolved-bound-int (js/get envelope .maximum_bytes) resolver name)
      "maxDepth"
      (resolved-bound-int (js/get envelope .maximum_depth) resolver name)
      "maxNodes"
      (resolved-bound-int (js/get envelope .maximum_nodes) resolver name)
      "value" {"kind" "ref" "name" (js/get (js/get source .root) .name)}}}))

(defn resolved-value-type-descriptor
  [(source IrValueTypeSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (label String)]
  Any
  (if (= (js/get source ._tag) "IrNamedValueType")
    (js/get
      (lower-value-type-declaration
        (value-type-declaration program (js/get source .value_type) label)
        program resolver) .descriptor)
    (lower-value-descriptor source program resolver label)))

(defn declaration-with-ref [(items Any) (ref Any) (label String)] Any
  (let [matches
        (filterv
          (fn [(item Any)] Bool
            (same-nominal? (or (js/get item .ref) (js/get item .root)) ref))
          items)]
    (if (not (= (count matches) 1))
      (graph-error
        (str label " must resolve to exactly one declaration, found "
             (count matches)))
      (first matches))))

(defn root-storage-id
  [(root IrApplicationRootSpec) (entity IrEntityRef)] String?
  (let [matches
        (filterv
          (fn [(storage IrStorageSpec)] Bool
            (same-nominal? (js/get storage .entity) entity))
          (js/get root .storage))]
    (if (> (count matches) 1)
      (graph-error
        (str "application storage repeats entity '" (js/get entity .name) "'"))
      nil)
    (if (= (count matches) 0) nil (js/get (first matches) .storage_id))))

(defn root-identity-field
  [(root IrApplicationRootSpec) (entity IrEntityRef)] IrFieldRef?
  (let [matches
        (filterv
          (fn [(identity IrIdentitySpec)] Bool
            (same-nominal? (js/get identity .entity) entity))
          (js/get root .identities))]
    (if (> (count matches) 1)
      (graph-error
        (str "application identities repeat entity '" (js/get entity .name) "'"))
      nil)
    (if (= (count matches) 0) nil (js/get (first matches) .field))))

(defn field-cardinality-name [(cardinality IrFieldCardinality)] String
  (let [tag (js/get cardinality ._tag)]
    (cond
      (= tag "IrSingleField") "single"
      (= tag "IrManyField") "multi"
      :else
        (graph-error
          (str "field cardinality uses unsupported constructor '" tag "'")))))

(defn field-write-name [(write IrFieldWriteMode)] String
  (let [tag (js/get write ._tag)]
    (cond
      (= tag "IrIdentityWrite") "identity"
      (= tag "IrCreateWrite") "create"
      (= tag "IrSetWrite") "set"
      (= tag "IrCommandFieldWrite") "command"
      (= tag "IrServerWrite") "server"
      :else
        (graph-error
          (str "field write mode uses unsupported constructor '" tag "'")))))

(defn external-entity-binding
  [(bindings IrPluginBindings) (role IrExternalEntityRoleRef)] IrEntityRef
  (let [matches
        (filterv
          (fn [(binding IrExternalEntityBinding)] Bool
            (= (js/get (js/get binding .role) .declaration_id) (js/get role .declaration_id)))
          (js/get bindings .external_entities))]
    (if (not (= (count matches) 1))
      (graph-error
        (str "external entity role '" (js/get role .declaration_id)
             "' must have exactly one checked binding"))
      (js/get (first matches) .value))))

(defn field-type-shape
  [(value-type IrFieldValueType) (resolver DeclarationResolver)] Any
  (let [tag (js/get value-type ._tag)]
    (cond
      (= tag "IrStringField") ["String" "literal" nil]
      (= tag "IrIntField") ["Int" "literal" nil]
      (= tag "IrBoolField") ["Bool" "literal" nil]
      (= tag "IrKeywordField") ["Keyword" "literal" nil]
      (= tag "IrInstantField") ["Instant" "literal" nil]
      (= tag "IrDigestField") ["Digest" "literal" nil]
      (= tag "IrStateField")
        [(resolved-name resolver "state" (js/get value-type .state)) "literal" nil]
      (= tag "IrValueField")
        [(resolved-name resolver "value-type" (js/get value-type .value_type)) "literal" nil]
      (= tag "IrRefField")
        (let [target (js/get value-type .target)
              target-tag (js/get target ._tag)]
          (cond
            (= target-tag "IrDeclaredEntityTarget")
              ["Ref" "ref" (resolved-name resolver "entity" (js/get target .entity))]
            (= target-tag "IrExternalEntityTarget")
              (if (nil? (js/get resolver .bindings))
                (graph-error "application field cannot use an unbound external entity role")
                ["Ref" "ref"
                 (js/get
                   (external-entity-binding
                     (js/get resolver .bindings) (js/get target .role)) .name)])
            :else
              (graph-error
                (str "reference field uses unsupported target '" target-tag "'"))))
      :else
        (graph-error
          (str "field uses unsupported value type '" tag "'")))))

(defn lower-stored-field
  [(field IrFieldSpec)
   (entity IrEntityDeclarationSpec)
   (resolver DeclarationResolver)
   (application-id String)
   (entity-local Bool)
   (entity-name String)]
  GField
  (if (not (same-nominal? (js/get field .owner) (js/get entity .ref)))
    (graph-error
      (str "field '" (js/get (js/get field .ref) .name) "' has a foreign entity owner"))
    nil)
  (let [name (resolved-name resolver "field" (js/get field .ref))
        shape (field-type-shape (js/get field .value_type) resolver)
        write (field-write-name (js/get field .write))
        storage-id
        (required-storage-id
          (js/get field .storage_id)
          (str "field '" entity-name "." name "'")
          (str "app:" application-id "/entity:" entity-name "/field:" name)
          entity-local)]
    (->GField
      name
      storage-id
      (nth shape 0)
      (= write "identity")
      (field-cardinality-name (js/get field .cardinality))
      (nth shape 1)
      (nth shape 2)
      (if (= write "identity") "set" write)
      false
      []
      nil)))

(defn derived-expression-dependencies [(expr IrDerivedExpr)] (Vec String)
  (let [tag (js/get expr ._tag)]
    (cond
      (= tag "IrFieldDerivedExpr") [(js/get (js/get expr .field) .name)]
      (= tag "IrStringDerivedExpr") []
      (= tag "IrConcatDerivedExpr")
        (reduce
          (fn [(result (Vec String)) (part IrDerivedExpr)] (Vec String)
            (append-unique-derived-deps
              result (derived-expression-dependencies part)))
          []
          (js/get expr .parts))
      :else
        (graph-error
          (str "derived expression uses unsupported constructor '" tag "'")))))

(defn lower-derived-field
  [(field IrDerivedFieldSpec)
   (entity IrEntityDeclarationSpec)
   (application-id String)
   (entity-name String)]
  GField
  (if (not (same-nominal? (js/get field .owner) (js/get entity .ref)))
    (graph-error
      (str "derived field '" (js/get (js/get field .ref) .name)
           "' has a foreign entity owner"))
    nil)
  (let [name (js/get (js/get field .ref) .name)
        declared (mapv (fn [(ref IrFieldRef)] String (js/get ref .name))
                       (js/get field .dependencies))
        actual (derived-expression-dependencies (js/get field .expression))]
    (if (not (= declared actual))
      (graph-error
        (str "derived field '" entity-name "." name
             "' dependencies do not exactly match its expression"))
      nil)
    (->GField
      name
      (str "app:" application-id "/entity:" entity-name "/derived:" name)
      "Derived"
      false
      "single"
      "literal"
      nil
      "set"
      true
      declared
      (js/get field .expression))))

(defn lower-entity-declaration
  [(entity IrEntityDeclarationSpec)
   (root IrApplicationRootSpec?)
   (resolver DeclarationResolver)
   (application-id String)
   (entity-local Bool)]
  GEntity
  (let [name (resolved-name resolver "entity" (js/get entity .ref))
        root-storage (if (nil? root) nil (root-storage-id root (js/get entity .ref)))
        declared-storage (js/get entity .storage_id)
        storage-id
        (do
          (if (and (some? root-storage) (some? declared-storage)
                   (not (= root-storage declared-storage)))
            (graph-error
              (str "entity '" name "' has conflicting fixed storage IDs"))
            nil)
          (required-storage-id
            (or root-storage declared-storage)
            (str "entity '" name "'")
            (str "app:" application-id "/entity:" name)
            entity-local))
        stored
        (mapv
          (fn [(field IrFieldSpec)] GField
            (lower-stored-field
              field entity resolver application-id entity-local name))
          (js/get entity .fields))
        derived
        (mapv
          (fn [(field IrDerivedFieldSpec)] GField
            (lower-derived-field field entity application-id name))
          (js/get entity .derived_fields))
        fields (into stored derived)
        field-names (mapv (fn [(field GField)] String (js/get field .name)) fields)
        identity-fields (filterv (fn [(field GField)] Bool (js/get field .identity)) stored)
        root-identity (if (nil? root) nil (root-identity-field root (js/get entity .ref)))]
    (validate-distinct-names field-names (str "entity '" name "' field"))
    (if (some? root-identity)
      (let [resolved
            (filterv
              (fn [(field IrFieldSpec)] Bool
                (same-nominal? (js/get field .ref) root-identity))
              (js/get entity .fields))]
        (if (not (= (count resolved) 1))
          (graph-error
            (str "entity '" name "' identity names a foreign field"))
          nil)
        (if (not (= (field-write-name (js/get (first resolved) .write)) "identity"))
          (graph-error
            (str "entity '" name
                 "' identity field must use IdentityWrite"))
          nil))
      nil)
    (if (and (some? root) (= (count identity-fields) 1)
             (nil? root-identity))
      (graph-error
        (str "application entity '" name
             "' has IdentityWrite but no matching IdentitySpec"))
      nil)
    (validate-derived-fields name fields)
    (->GEntity
      name
      storage-id
      fields
      stored
      derived
      (filterv (fn [(field GField)] Bool (= (js/get field .value_kind) "ref")) fields)
      (if (= (count identity-fields) 1) (first identity-fields) nil)
      (str name "s"))))

(defn state-value-spec
  [(program IrDeclarationProgram)
   (ref IrStateValueRef)
   (label String)]
  IrStateValueSpec
  (let [matches
        (reduce
          (fn [result state] (Vec IrStateValueSpec)
            (into result
              (filterv
                (fn [(value IrStateValueSpec)] Bool
                  (same-nominal? (js/get value .ref) ref))
                (js/get state .values))))
          []
          (js/get program .states))]
    (if (not (= (count matches) 1))
      (graph-error (str label " must resolve one state value"))
      (first matches))))

(defn resolved-state-value
  [(program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (ref IrStateValueRef)
   (label String)]
  String
  (let [renamed (get (js/get resolver .state_values) (ref-key ref))]
    (if (some? renamed)
      renamed
      (strip-colon (js/get (state-value-spec program ref label) .value)))))

(defn lower-state-declaration
  [(state IrStateDeclarationSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)]
  IrDefstate
  (let [name (resolved-name resolver "state" (js/get state .ref))
        transitions
        (reduce
          (fn [result transition] Any
            (assoc result
              (resolved-state-value
                program resolver (js/get transition .from) (str "state '" name "'"))
              (mapv
                (fn [(target IrStateValueRef)] String
                  (resolved-state-value
                    program resolver target (str "state '" name "'")))
                (js/get transition .to))))
          {}
          (js/get state .transitions))
        initial
        (resolved-state-value
          program resolver (js/get state .initial) (str "state '" name "' initial"))]
    (ir/->IrDefstate name transitions initial)))

(defn authority-shape [(authority IrAuthoritySpec)] Any
  (let [tag (js/get authority ._tag)]
    (cond
      (= tag "IrFramAuthority") [(ir/->IrBackend "fram") nil]
      (= tag "IrLocalStorageAuthority")
        [nil (ir/->IrPersist "local-storage" (js/get authority .namespace))]
      (= tag "IrMemoryAuthority") [nil nil]
      :else
        (graph-error (str "application uses unsupported authority '" tag "'")))))

(defn lower-publication
  [(source IrPublicationDeclarationSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)]
  IrPublication
  (ir/->IrPublication
    (resolved-name resolver "publication" (js/get source .ref))
    (resolved-name resolver "entity" (js/get source .owner))
    (resolved-name resolver "field" (js/get source .pointer))
    (resolved-name resolver "entity" (js/get source .revision))
    (resolved-name resolver "field" (js/get source .owner_field))
    (resolved-name resolver "field" (js/get source .state_field))
    (resolved-state-value program resolver (js/get source .draft) "publication draft")
    (resolved-state-value program resolver (js/get source .published) "publication published")
    (resolved-state-value program resolver (js/get source .retired) "publication retired")))

(defn lower-form
  [(source IrFormDeclarationSpec) (resolver DeclarationResolver)] IrSmartForm
  (let [success (js/get (js/get source .on_success) ._tag)]
    (if (not (= success "IrClearFormSuccess"))
      (graph-error (str "form uses unsupported success action '" success "'"))
      (ir/->IrSmartForm
        (resolved-name resolver "form" (js/get source .ref))
        (resolved-name resolver "entity" (js/get source .entity))
        (mapv
          (fn [(field IrFieldRef)] String (resolved-name resolver "field" field))
          (js/get source .fields))
        (mapv
          (fn [(field IrFieldRef)] String (resolved-name resolver "field" field))
          (js/get source .required))
        (js/get source .submit_label)
        "clear"))))

(defn lower-list-detail
  [(source IrListDetailDeclarationSpec)
   (resolver DeclarationResolver)]
  IrListDetail
  (let [entity (resolved-name resolver "entity" (js/get source .entity))
        field-names
        (fn [fields] (Vec String)
          (mapv
            (fn [(field IrFieldRef)] String (resolved-name resolver "field" field))
            fields))
        tabs
        (mapv
          (fn [tab] IrDetailTab
            (let [tag (js/get tab ._tag)]
              (cond
                (= tag "IrFieldsDetailTab")
                  (ir/->IrDetailTab
                    (js/get tab .label) "fields" (field-names (js/get tab .fields))
                    nil nil false [])
                (= tag "IrRelatedDetailTab")
                  (ir/->IrDetailTab
                    (js/get tab .label) "related" []
                    (resolved-name resolver "entity" (js/get tab .entity))
                    (resolved-name resolver "field" (js/get tab .relation))
                    false
                    (field-names (js/get tab .display)))
                :else
                  (graph-error
                    (str "list detail uses unsupported tab '" tag "'")))))
          (js/get source .detail_tabs))]
    (ir/->IrListDetail
      entity (js/get source .title)
      (field-names (js/get source .columns))
      (field-names (js/get source .search))
      tabs)))

(defn lower-ui-value
  [(value IrValueExpr) (resolver DeclarationResolver) (label String)] Any
  (if (= (js/get value ._tag) "IrBoundFieldValue")
    {"kind" "prop" "name" (resolved-name resolver "field" (js/get value .field))}
    {"kind" "literal" "value" (value-expression-literal value resolver label)}))

(defn lower-ui-action
  [(action IrUiAction) (resolver DeclarationResolver) (label String)] IrAction
  (let [tag (js/get action ._tag)]
    (if (= tag "IrSetFieldAction")
      (ir/->IrAction
        "set"
        [{"kind" "tag"
          "name" (resolved-name resolver "field" (js/get action .field))}
         (lower-ui-value (js/get action .value) resolver label)])
      (graph-error (str label " uses unsupported UI action '" tag "'")))))

(defn lower-ui-node
  [(node IrDeclarationUiNode) (resolver DeclarationResolver) (label String)] Any
  (let [tag (js/get node ._tag)]
    (cond
      (= tag "IrDeclarationElement")
        (let [attrs
              (reduce
                (fn [result name] Any
                  (let [attr (get (js/get node .attrs) name)
                        attr-tag (js/get attr ._tag)
                        lowered
                        (cond
                          (= attr-tag "IrStaticUiAttr")
                            {"type" "static" "value" (js/get attr .value)}
                          (= attr-tag "IrBoundUiAttr")
                            {"type" "bind" "prop" (js/get attr .prop)}
                          (= attr-tag "IrActionAttr")
                            (if (js/call name .startsWith "on-")
                              {"type" "action"
                               "event" (subs name 3)
                               "action"
                               (lower-ui-action (js/get attr .action) resolver label)}
                              (graph-error
                                (str label " action attribute '" name
                                     "' must begin on-")))
                          :else
                            (graph-error
                              (str label " uses unsupported UI attribute '"
                                   attr-tag "'")))]
                    (assoc result name lowered)))
                {}
                (keys (js/get node .attrs)))]
          (ir/->IrElement
            (js/get node .tag)
            attrs
            (mapv
              (fn [(child IrDeclarationUiNode)] IrNode
                (lower-ui-node child resolver label))
              (js/get node .children))))
      (= tag "IrDeclarationWhen")
        (let [condition (js/get node .condition)
              condition-tag (js/get condition ._tag)]
          (if (not (= condition-tag "IrUiPropertyPresent"))
            (graph-error
              (str label " uses unsupported UI condition '" condition-tag "'"))
            (ir/->IrWhen
              (js/get condition .prop)
              (mapv
                (fn [(child IrDeclarationUiNode)] IrNode
                  (lower-ui-node child resolver label))
                (js/get node .children)))))
      :else (graph-error (str label " uses unsupported UI node '" tag "'")))))

(defn lower-component
  [(source IrComponentDeclarationSpec)
   (resolver DeclarationResolver)]
  IrComponent
  (let [name (resolved-name resolver "component" (js/get source .ref))]
    (ir/->IrComponent
      name
      (mapv (fn [(prop IrComponentPropertySpec)] String (js/get prop .name))
            (js/get source .properties))
      (mapv
        (fn [(node IrDeclarationUiNode)] IrElement
          (lower-ui-node node resolver (str "component '" name "'")))
        (js/get source .body)))))

(defn form-by-ref [(forms Any) (ref IrFormRef)] IrFormDeclarationSpec
  (declaration-with-ref forms ref "view create form"))

(defn lower-view
  [(source IrViewDeclarationSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)]
  IrView
  (let [form (if (nil? (js/get source .create_form))
               nil
               (form-by-ref (js/get program .forms) (js/get source .create_form)))]
    (ir/->IrView
      (resolved-name resolver "view" (js/get source .ref))
      (resolved-name resolver "entity" (js/get source .entity))
      (resolved-name resolver "component" (js/get source .component))
      (if (nil? form)
        []
        (mapv
          (fn [(field IrFieldRef)] String (resolved-name resolver "field" field))
          (js/get form .fields)))
      (js/get source .title)
      (if (nil? (js/get source .select_component))
        nil
        (resolved-name resolver "component" (js/get source .select_component)))
      [] [] [])))

(defn value-type-name-for-query
  [(value-type IrValueTypeSpec)
   (resolver DeclarationResolver)
   (label String)]
  String
  (let [tag (js/get value-type ._tag)]
    (cond
      (= tag "IrStringValueType") "String"
      (= tag "IrIntegerValueType") "Int"
      (= tag "IrBooleanValueType") "Bool"
      (= tag "IrDigestValueType") "Digest"
      (= tag "IrInstantValueType") "Instant"
      (= tag "IrKeywordValueType") "Keyword"
      (= tag "IrStateValueType")
        (resolved-name resolver "state" (js/get value-type .state))
      (= tag "IrNamedValueType")
        (resolved-name resolver "value-type" (js/get value-type .value_type))
      :else
        (graph-error
          (str label " uses unsupported query value type '" tag "'")))))

(defn query-expression
  [(expr IrQueryValueExpr)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (label String)]
  IrQueryOperand
  (let [tag (js/get expr ._tag)]
    (cond
      (= tag "IrQueryFieldValue")
        (ir/->IrQueryOperand
          "field" nil (js/get expr .binding)
          (resolved-name resolver "field" (js/get expr .field)) nil)
      (= tag "IrQueryParameterValue")
        (ir/->IrQueryOperand "parameter" (js/get expr .name) nil nil nil)
      (= tag "IrQueryBindingValue")
        (ir/->IrQueryOperand "binding" nil (js/get expr .name) nil nil)
      (= tag "IrQueryStringValue")
        (ir/->IrQueryOperand "literal" "String" nil nil (js/get expr .value))
      (= tag "IrQueryIntegerValue")
        (ir/->IrQueryOperand "literal" "Int" nil nil (js/get expr .value))
      (= tag "IrQueryBooleanValue")
        (ir/->IrQueryOperand "literal" "Bool" nil nil (js/get expr .value))
      (= tag "IrQueryKeywordValue")
        (ir/->IrQueryOperand
          "literal" "Keyword" nil nil (strip-colon (js/get expr .value)))
      (= tag "IrQueryNilValue")
        (ir/->IrQueryOperand "literal" "String" nil nil nil)
      (= tag "IrQueryStateValue")
        (ir/->IrQueryOperand
          "literal" "Keyword" nil nil
          (resolved-state-value program resolver (js/get expr .value) label))
      (= tag "IrQueryConfiguredValue")
        (let [value
              (configured-projection-literal
                (js/get expr .projection) resolver label)
              type
              (cond
                (string? value) "String"
                (boolean? value) "Bool"
                (number? value) "Int"
                :else
                  (graph-error
                    (str label " configured query value must be scalar")))]
          (ir/->IrQueryOperand "literal" type nil nil value))
      :else
        (graph-error
          (str label " uses unsupported query expression '" tag "'")))))

(defn query-provider-input
  [(expr IrQueryValueExpr)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (label String)]
  Any
  (let [tag (js/get expr ._tag)]
    (cond
      (= tag "IrQueryFieldValue")
        {"kind" "column"
         "binding" (js/get expr .binding)
         "field" (resolved-name resolver "field" (js/get expr .field))}
      (= tag "IrQueryRecordValue")
        {"kind" "record"
         "fields"
         (mapv
           (fn [(field IrQueryRecordField)] Any
             {"name" (js/get field .name)
              "value"
              (query-provider-input (js/get field .value) program resolver label)})
           (js/get expr .fields))}
      (= tag "IrQueryListValue")
        {"kind" "list"
         "items"
         (mapv
           (fn [(item IrQueryValueExpr)] Any
             (query-provider-input item program resolver label))
           (js/get expr .items))}
      :else
        (let [operand (query-expression expr program resolver label)]
          (if (not (= (js/get operand .kind) "literal"))
            (graph-error (str label " provider input must be closed data"))
            {"kind" "literal" "value" (js/get operand .value)})))))

(defn lower-query-predicate
  [(source IrQueryPredicateSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (label String)]
  IrQueryPredicate
  (let [tag (js/get source ._tag)]
    (if (= tag "IrQueryEqualPredicate")
      (ir/->IrQueryPredicate
        "eq"
        (query-expression (js/get source .left) program resolver label)
        (query-expression (js/get source .right) program resolver label))
      (graph-error (str label " uses unsupported query predicate '" tag "'")))))

(defn lower-query
  [(source IrQueryDeclarationSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (extensions Any)]
  IrQuery
  (let [name (resolved-name resolver "query" (js/get source .ref))
        label (str "query '" name "'")
        params
        (mapv
          (fn [(param IrQueryParameterSpec)] IrQueryParam
            (ir/->IrQueryParam
              (js/get param .name)
              (value-type-name-for-query (js/get param .value_type) resolver label)))
          (js/get source .parameters))
        bindings
        (mapv
          (fn [(binding IrQueryBindingSpec)] IrQueryBinding
            (ir/->IrQueryBinding
              (js/get binding .name)
              (resolved-name resolver "entity" (js/get binding .entity))))
          (js/get source .bindings))
        predicates
        (mapv
          (fn [(predicate IrQueryPredicateSpec)] IrQueryPredicate
            (lower-query-predicate predicate program resolver label))
          (js/get source .predicates))
        selection
        (reduce
          (fn [result item] Any
            (let [tag (js/get item ._tag)]
              (cond
                (= tag "IrQueryValueSelection")
                  (let [value (js/get item .value)]
                    (if (not (= (js/get value ._tag) "IrQueryFieldValue"))
                      (graph-error
                        (str label " value selection must select a field"))
                      (conj result
                        (ir/->IrQuerySelect
                          (js/get item .name)
                          (js/get value .binding)
                          (resolved-name resolver "field" (js/get value .field))))))
                (= tag "IrQueryExtensionSelection")
                  (let [port-name
                        (str (js/get resolver .prefix) "." (js/get (js/get item .port) .name))
                        extension
                        (first
                          (filterv
                            (fn [candidate] Bool (= (js/get candidate .port) port-name))
                            extensions))]
                    (if (nil? extension)
                      result
                      (into result
                        (mapv
                          (fn [field] IrQuerySelect
                            (ir/->IrQuerySelect
                              (js/get field .name) (js/get item .binding) (js/get field .name)))
                          (js/get extension .fields)))))
                (= tag "IrQueryProviderSelection")
                  (let [provider
                        (get
                          (js/get resolver .provider_bindings)
                          (ref-key (js/get item .provider)))]
                    (if (nil? provider)
                      (graph-error
                        (str label " names an unbound provider port"))
                      (conj result
                        (ir/->IrQueryProvided
                          (js/get item .name)
                          provider
                          (query-provider-input
                            (js/get item .input) program resolver label)))))
                :else
                  (graph-error
                    (str label " uses unsupported query selection '" tag "'")))))
          []
          (js/get source .selection))
        result (js/get source .result)
        result-tag (js/get result ._tag)
        page
        (if (= result-tag "IrQueryPageResult")
          (ir/->IrQueryPage
            (resolved-bound-int (js/get result .default_limit) resolver label)
            (resolved-bound-int (js/get result .max_limit) resolver label))
          nil)
        result-kind
        (cond
          (= result-tag "IrQueryPageResult") "page"
          (= result-tag "IrQueryOptionalResult") "optional"
          (= result-tag "IrQueryOneResult") "one"
          :else (graph-error (str label " uses unsupported result '" result-tag "'")))]
    (ir/->IrQuery
      name
      (mapv
        (fn [(capability IrCapabilityRef)] String
          (resolved-capability-name resolver capability))
        (js/get source .capabilities))
      params bindings predicates selection result-kind page)))

(defn lower-route-template
  [(source IrRouteTemplateSpec) (resolver DeclarationResolver)] IrRoute
  (ir/->IrRoute
    (resolved-name resolver "route" (js/get source .ref))
    (resolved-name resolver "view" (js/get source .view))
    (mapv
      (fn [(query IrRouteQuerySpec)] IrRouteQuery
        (ir/->IrRouteQuery
          (resolved-name resolver "query" (js/get query .query)) (js/get query .alias)))
      (js/get source .queries))
    (mapv (fn [(param IrRouteParameterSpec)] String (js/get param .name))
          (js/get source .parameters))
    (mapv (fn [(param IrRouteParameterSpec)] String (js/get param .name))
          (js/get source .parameters))
    []))

(defn route-parameters [(path String)] (Vec String)
  (if (= path "/")
    []
    (reduce
      (fn [result segment] (Vec String)
        (if (js/call segment .startsWith ":")
          (let [name (subs segment 1)]
            (if (= name "")
              (graph-error (str "route path '" path "' has an empty parameter"))
              (conj result name)))
          result))
      []
      (js/call (subs path 1) .split "/"))))

(defn plugin-evidence [(instance IrLinkedPluginInstance)] Any
  (let [evidence (js/get instance .evidence)]
    {:package_id (js/get evidence .package_id)
     :version (js/get evidence .version)
     :alias (js/get instance .alias)
     :artifact_digest (js/get evidence .artifact_digest)
     :source_kind (js/get evidence .source_kind)
     :source_revision (js/get evidence .source_revision)
     :artifact_path (js/get evidence .artifact_path)
     :entry_path (js/get evidence .entry_path)
     :configuration_digest (js/get evidence .configuration_digest)
     :durable_schema_version (js/get evidence .durable_schema_version)
     :migration_ordinal (js/get evidence .migration_ordinal)}))

(defn contribution-allowed? [(use IrPluginUseSpec) (tag String)] Bool
  (some?
    (first
      (filterv (fn [item] Bool (= (js/get item ._tag) tag)) (js/get use .allow)))))

(defn imported-port-name [(prefix String) (ref Any)] String
  (str prefix "." (js/get ref .name)))

(defn plugin-port
  [(program IrDeclarationProgram) (ref Any) (field String) (label String)] Any
  (let [declarations
        (cond
          (= field "value-types") (js/get program .value_types)
          (= field "provider-ports") (js/get program .provider_ports)
          (= field "entity-fields-ports") (js/get program .entity_fields_ports)
          (= field "component-slots") (js/get program .component_slots)
          (= field "route-slots") (js/get program .route_slots)
          (= field "route-templates") (js/get program .route_templates)
          :else
            (graph-error (str label " uses unsupported declaration set '" field "'")))]
    (let [matches
          (filterv
            (fn [item] Bool
              (= (ref-key (or (js/get item .ref) (js/get item .root))) (ref-key ref)))
            declarations)]
      (if (not (= (count matches) 1))
        (graph-error
          (str label " must resolve to exactly one imported declaration, found "
               (count matches)))
        (first matches)))))

(defn lower-provider-port
  [(source IrProviderPortSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)]
  GProviderPort
  (let [name (resolved-name resolver "provider-port" (js/get source .ref))]
    (->GProviderPort
      name
      (resolved-value-type-descriptor
        (js/get source .input_type) program resolver
        (str "provider port '" name "' input"))
      (resolved-value-type-descriptor
        (js/get source .output_type) program resolver
        (str "provider port '" name "' output")))))

(defn lower-provider-binding
  [(source IrProviderBindingSpec)
   (instance IrLinkedPluginInstance)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)]
  GProvider
  (let [declaration
        (plugin-port program (js/get source .port) "provider-ports" "provider binding")
        contract (lower-provider-port declaration program resolver)
        evidence (js/get instance .evidence)]
    (->GProvider
      (js/get source .name)
      (imported-port-name (js/get resolver .prefix) (js/get source .port))
      (js/get evidence .package_id)
      (js/get (js/get source .port) .name)
      (js/get contract .input)
      (js/get contract .output)
      (ir/->SourceSpan "linked-declarations" 0 0 1 1 1 1))))

(defn lower-provider-bindings
  [(instance IrLinkedPluginInstance)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)]
  (Vec GProvider)
  (let [sources (js/get (js/get instance .composition) .providers)
        required (js/get (js/get (js/get program .root) .plugin) .required_providers)]
    (doseq [port required]
      (let [matches
            (filterv
              (fn [(binding IrProviderBindingSpec)] Bool
                (= (ref-key (js/get binding .port)) (ref-key port)))
              sources)]
        (if (not (= (count matches) 1))
          (graph-error
            (str "plugin '" (js/get instance .alias) "' requires provider port '"
                 (js/get port .name) "' exactly once"))
          nil)))
    (mapv
      (fn [(source IrProviderBindingSpec)] GProvider
        (lower-provider-binding source instance program resolver))
      sources)))

(defn receipt-field-shape
  [(source IrReceiptFieldDeclarationSpec)
   (resolver DeclarationResolver)
   (label String)]
  Any
  (let [type (js/get source .value_type)
        tag (js/get type ._tag)]
    (cond
      (some? (js/get source .target))
        ["Ref" "ref" (resolved-name resolver "entity" (js/get source .target))]
      (= tag "IrStringValueType") ["String" "literal" nil]
      (= tag "IrIntegerValueType") ["Int" "literal" nil]
      (= tag "IrBooleanValueType") ["Bool" "literal" nil]
      (= tag "IrDigestValueType") ["Digest" "literal" nil]
      (= tag "IrInstantValueType") ["Instant" "literal" nil]
      (= tag "IrKeywordValueType") ["Keyword" "literal" nil]
      (= tag "IrStateValueType")
        [(resolved-name resolver "state" (js/get type .state)) "literal" nil]
      (= tag "IrNamedValueType")
        [(resolved-name resolver "value-type" (js/get type .value_type)) "literal" nil]
      :else
        (graph-error (str label " uses unsupported receipt field type '" tag "'")))))

(defn lower-receipt-field
  [(source IrReceiptFieldDeclarationSpec) (resolver DeclarationResolver)] GField
  (let [name (resolved-name resolver "receipt-field" (js/get source .ref))
        shape
        (receipt-field-shape source resolver (str "receipt field '" name "'"))]
    (->GField
      name
      (js/get source .storage_id)
      (nth shape 0)
      (= name "id")
      "single"
      (nth shape 1)
      (nth shape 2)
      (if (= name "id") "set" "command")
      false [] nil)))

(defn receipt-entity
  [(application IrDeclarationProgram)
   (plugins (Vec LoweredPlugin))
   (commands (Vec Any))]
  GEntity?
  (if (= (count commands) 0)
    nil
    (let [sources
        (reduce
          (fn [result plugin] (Vec Any)
            (conj result
              [(js/get (js/get plugin .program) .receipt_entity)
               (js/get (js/get plugin .program) .receipt_fields)
               (js/get plugin .resolver)]))
          [[(js/get application .receipt_entity)
            (js/get application .receipt_fields)
            (empty-resolver)]]
          plugins)
        entities
        (filterv (fn [source] Bool (some? (nth source 0))) sources)]
    (if (= (count entities) 0)
      nil
      (let [storage-ids
            (reduce
              (fn [result source] (Vec String)
                (let [value (js/get (nth source 0) .storage_id)]
                  (if (js/call result .includes value) result (conj result value))))
              [] entities)]
        (if (not (= (count storage-ids) 1))
          (graph-error "command receipt core has conflicting storage IDs")
          nil)
        (let [fields
              (reduce
                (fn [result source] (Vec GField)
                  (reduce
                    (fn [current field] (Vec GField)
                      (let [lowered (lower-receipt-field field (nth source 2))
                            prior
                            (first
                              (filterv
                                (fn [(item GField)] Bool
                                  (= (js/get item .storage_id) (js/get lowered .storage_id)))
                                current))]
                        (if (nil? prior) (conj current lowered) current)))
                    result
                    (nth source 1)))
                [] sources)
              identity
              (first (filterv (fn [(field GField)] Bool (js/get field .identity)) fields))]
          (validate-distinct-names
            (mapv (fn [(field GField)] String (js/get field .name)) fields)
            "command receipt field")
          (->GEntity
            "wake.core/command-receipt"
            (first storage-ids)
            fields fields []
            (filterv
              (fn [(field GField)] Bool (= (js/get field .value_kind) "ref"))
              fields)
            identity
            "wake.core/command-receipts")))))))

(defn extension-target-name
  [(port IrEntityFieldsPortSpec) (resolver DeclarationResolver)] String
  (let [target (js/get port .target)
        tag (js/get target ._tag)]
    (cond
      (= tag "IrDeclaredEntityFieldsTarget")
        (resolved-name resolver "entity" (js/get target .entity))
      (= tag "IrReceiptEntityFieldsTarget") "wake.core/command-receipt"
      :else
        (graph-error (str "extension port uses unsupported target '" tag "'")))))

(defn lower-extension-field
  [(source IrExtensionFieldSpec)
   (resolver DeclarationResolver)
   (target String)]
  IrAttr
  (let [shape (field-type-shape (js/get source .value_type) resolver)
        write (field-write-name (js/get source .write))]
    (if (not (nonempty-string? (js/get source .storage_id)))
      (graph-error
        (str "extension field '" (js/get (js/get source .ref) .name)
             "' requires an explicit storage ID"))
      nil)
    (ir/->IrAttr
      (js/get (js/get source .ref) .name)
      (js/get source .storage_id)
      (nth shape 0)
      {"many" (= (field-cardinality-name (js/get source .cardinality)) "multi")
       "required" (js/get source .required)
       "server" (= write "server")
       "write" (if (= write "server") "command" write)
       "target-entity" (nth shape 2)})))

(defn lower-extensions
  [(instance IrLinkedPluginInstance)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)]
  (Vec ResolvedPluginExtension)
  (if (and (> (count (js/get (js/get instance .composition) .extensions)) 0)
           (not (contribution-allowed? (js/get instance .use) "IrSchemaContribution")))
    (graph-error (str "plugin '" (js/get instance .alias) "' extensions require schema"))
    (mapv
      (fn [(source IrExtendSpec)] ResolvedPluginExtension
        (let [port
              (plugin-port
                program (js/get source .port) "entity-fields-ports" "extension port")
              target (extension-target-name port resolver)
              policy (js/get port .policy)]
          (if (= (js/get (js/get port .policy) ._tag) "IrClosedEntityFieldsPort")
            (graph-error
              (str "extension port '" (js/get (js/get port .ref) .name) "' is closed"))
            nil)
          (doseq [field (js/get source .fields)]
            (if (not (= (js/get (js/get field .write) ._tag) (js/get (js/get policy .write) ._tag)))
              (graph-error
                (str "extension port '" (js/get (js/get port .ref) .name) "' field '"
                     (js/get (js/get field .ref) .name) "' must use "
                     (field-write-name (js/get policy .write)) " write policy"))
              nil))
          (->ResolvedPluginExtension
            instance program resolver source port target
            (ir/->IrExtend
              (imported-port-name (js/get resolver .prefix) (js/get source .port))
              (mapv
                (fn [(field IrExtensionFieldSpec)] IrAttr
                  (lower-extension-field field (empty-resolver) target))
                (js/get source .fields))
              (ir/->SourceSpan "linked-declarations" 0 0 1 1 1 1)))))
      (js/get (js/get instance .composition) .extensions))))

(defn extension-values
  [(extensions (Vec ResolvedPluginExtension))] (Vec GExtension)
  (mapv
    (fn [(extension ResolvedPluginExtension)] GExtension
      (let [raw (js/get extension .extension)]
        (->GExtension
          "entity-fields"
          (js/get (js/get (js/get extension .instance) .evidence) .package_id)
          (js/get raw .port)
          (js/get extension .target)
          (js/get raw .fields))))
    extensions))

(defn apply-plugin-extensions
  [(entities (Vec GEntity))
   (extensions (Vec ResolvedPluginExtension))]
  (Vec GEntity)
  (reduce
    (fn
      [(result (Vec GEntity)) (extension ResolvedPluginExtension)] (Vec GEntity)
      (apply-extension
        result (js/get extension .extension) (js/get extension .target)))
    entities
    extensions))

(defn apply-extension
  [(entities (Vec GEntity)) (extension IrExtend) (target String)] (Vec GEntity)
  (let [matches
        (filterv (fn [(entity GEntity)] Bool (= (js/get entity .name) target)) entities)]
    (if (not (= (count matches) 1))
      (graph-error (str "extension '" (js/get extension .port) "' has no exact target"))
      nil)
    (mapv
      (fn [(entity GEntity)] GEntity
        (if (not (= (js/get entity .name) target))
          entity
          (let [additions
                (mapv
                  (fn [field] GField
                    (let [opts (js/get field .opts)
                          value-kind (if (= (js/get field .type) "Ref") "ref" "literal")]
                      (->GField
                        (js/get field .name) (or (js/get field .storage_id) "") (js/get field .type)
                        false (if (= (get opts "many") true) "multi" "single")
                        value-kind
                        (if (= value-kind "ref") (get opts "target-entity") nil)
                        (or (get opts "write") "create") false [] nil)))
                  (js/get extension .fields))
                fields (into (js/get entity .fields) additions)
                stored (into (js/get entity .stored_fields) additions)]
            (validate-distinct-names
              (mapv (fn [(field GField)] String (js/get field .name)) fields)
              (str "entity '" target "' field"))
            (->GEntity
              (js/get entity .name) (js/get entity .storage_id) fields stored
              (js/get entity .derived_fields)
              (filterv (fn [(field GField)] Bool (= (js/get field .value_kind) "ref")) fields)
              (js/get entity .identity_field) (js/get entity .store_name)))))
      entities)))

(defn lower-component-fill
  [(source IrFillSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (application-components (Vec IrComponent))
   (package-id String)]
  GFill
  (let [slot
        (plugin-port program (js/get source .slot) "component-slots" "component fill")
        target-ref (js/get slot .target)
        target
        (declaration-with-ref
          (js/get program .components) target-ref "component fill target")
        target-name (resolved-name resolver "component" target-ref)
        component-name (js/get (js/get source .component) .name)
        component
        (first
          (filterv
            (fn [(candidate IrComponent)] Bool
              (= (js/get candidate .name) component-name))
            application-components))
        required
        (mapv
          (fn [(property IrComponentPropertySpec)] String (js/get property .name))
          (js/get target .properties))
        provided (if (nil? component) [] (js/get component .props))
        missing
        (filterv
          (fn [property] Bool (not (js/call provided .includes property)))
          required)
        port (imported-port-name (js/get resolver .prefix) (js/get source .slot))]
    (if (nil? component)
      (graph-error
        (str "component fill '" port "' names unknown application component '"
             component-name "'"))
      nil)
    (if (> (count missing) 0)
      (graph-error
        (str "component fill '" port "' lacks required props: "
             (js/call missing .join ", ")))
      nil)
    (->GFill port component-name package-id target-name)))

(defn filled-component-name [(name String) (fills (Vec GFill))] String
  (let [matches
        (filterv
          (fn [(fill GFill)] Bool (= (js/get fill .target_component) name))
          fills)]
    (if (> (count matches) 1)
      (graph-error (str "component '" name "' is filled more than once"))
      nil)
    (if (= (count matches) 1) (js/get (first matches) .component) name)))

(defn apply-component-fills [(view IrView) (fills (Vec GFill))] IrView
  (ir/->IrView
    (js/get view .name)
    (js/get view .entity_name)
    (filled-component-name (js/get view .component) fills)
    (js/get view .add_fields)
    (js/get view .title)
    (if (nil? (js/get view .select_component))
      nil
      (filled-component-name (js/get view .select_component) fills))
    (js/get view .tabs)
    (js/get view .filters)
    (js/get view .date_filters)))

(defn apply-component-fills-to-components
  [(components (Vec IrComponent)) (fills (Vec GFill))] (Vec IrComponent)
  (reduce
    (fn [(result (Vec IrComponent)) (component IrComponent)] (Vec IrComponent)
      (let [name (filled-component-name (js/get component .name) fills)
            replacement
            (first
              (filterv
                (fn [(candidate IrComponent)] Bool
                  (= (js/get candidate .name) name))
                components))]
        (if (nil? replacement)
          (graph-error
            (str "component fill names missing replacement component '" name "'"))
          nil)
        (if (some?
              (first
                (filterv
                  (fn [(candidate IrComponent)] Bool
                    (= (js/get candidate .name) name))
                  result)))
          result
          (conj result replacement))))
    []
    components))

(defn route-pattern [(path String)] String
  (if (= path "/")
    ""
    (js/call
      (mapv
        (fn [segment] String (if (js/call segment .startsWith ":") ":" segment))
        (js/call (subs path 1) .split "/")) .join
      "/")))

(defn mounted-route
  [(mount IrMountSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)]
  IrRoute
  (let [slot (plugin-port program (js/get mount .slot) "route-slots" "route slot")
        template
        (plugin-port program (js/get slot .target) "route-templates" "mounted route")
        lowered (lower-route-template template resolver)
        parameters (route-parameters (js/get mount .path))
        inputs (js/get lowered .input_parameters)]
    (if (not (= (count parameters) (count inputs)))
      (graph-error
        (str "mount '" (js/get mount .path) "' parameter arity does not match route"))
      (ir/->IrRoute
        (js/get mount .path) (js/get lowered .view_name) (js/get lowered .queries)
        parameters inputs []))))

(defn lowered-mount
  [(source IrMountSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (package-id String)]
  GMount
  (let [slot (plugin-port program (js/get source .slot) "route-slots" "route slot")
        template
        (plugin-port program (js/get slot .target) "route-templates" "mounted route")
        view
        (declaration-with-ref
          (js/get program .views) (js/get template .view) "mounted route view")
        component
        (declaration-with-ref
          (js/get program .components) (js/get view .component) "mounted route component")
        input-parameters
        (mapv
          (fn [(parameter IrRouteParameterSpec)] String (js/get parameter .name))
          (js/get template .parameters))
        parameters (route-parameters (js/get source .path))
        port (imported-port-name (js/get resolver .prefix) (js/get source .slot))]
    (if (not (= (count parameters) (count input-parameters)))
      (graph-error
        (str "mount '" port "' requires exactly "
             (count input-parameters) " route parameters"))
      nil)
    (->GMount
      input-parameters
      package-id
      parameters
      (js/get source .path)
      (route-pattern (js/get source .path))
      port
      (mapv
        (fn [(query IrRouteQuerySpec)] IrRouteQuery
          (ir/->IrRouteQuery
            (resolved-name resolver "query" (js/get query .query)) (js/get query .alias)))
        (js/get template .queries))
      (mapv
        (fn [(property IrComponentPropertySpec)] String (js/get property .name))
        (js/get component .properties))
      (resolved-name resolver "route" (js/get slot .target))
      (resolved-name resolver "view" (js/get template .view)))))

(defn command-descriptor-shape [(descriptor Any)] Any
  (let [kind (get descriptor "kind")]
    (cond
      (= kind "record")
        {"kind" "record"
         "fields"
         (mapv
           (fn [field] Any
             {"name" (get field "name")
              "required" (= (get field "required") true)
              "type" (command-descriptor-shape (get field "value"))})
           (get descriptor "fields"))}
      (= kind "nullable")
        {"kind" "nullable"
         "value" (command-descriptor-shape (get descriptor "value"))}
      (= kind "list")
        (if (nil? (get descriptor "normalizer"))
          {"kind" "list"
           "items" (command-descriptor-shape (get descriptor "items"))
           "maxItems" (get descriptor "maxItems")}
          {"kind" "list"
           "items" (command-descriptor-shape (get descriptor "items"))
           "maxItems" (get descriptor "maxItems")
           "normalizer" (get descriptor "normalizer")})
      :else descriptor)))

(defn command-extension
  [(extensions (Vec ResolvedPluginExtension))
   (ref IrEntityFieldsPortRef)
   (label String)]
  ResolvedPluginExtension
  (let [matches
        (filterv
          (fn [(extension ResolvedPluginExtension)] Bool
            (= (ref-key (js/get (js/get extension .port) .ref)) (ref-key ref)))
          extensions)]
    (if (not (= (count matches) 1))
      (graph-error (str label " requires exactly one bound extension"))
      (first matches))))

(defn command-extension-field-type
  [(field IrExtensionFieldSpec) (resolver DeclarationResolver)] Any
  (let [shape (field-type-shape (js/get field .value_type) resolver)
        type (nth shape 0)]
    (cond
      (= type "String") {"kind" "string"}
      (= type "Int") {"kind" "integer"}
      (= type "Bool") {"kind" "boolean"}
      (= type "Digest") {"kind" "digest"}
      (= type "Instant") {"kind" "instant"}
      (= type "Keyword") {"kind" "keyword"}
      (= type "Ref") {"kind" "string"}
      :else {"kind" "keyword"})))

(defn command-value-type
  [(source IrValueTypeSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (extensions (Vec ResolvedPluginExtension))
   (label String)]
  Any
  (if (= (js/get source ._tag) "IrExtensionValueType")
    (let [extension (command-extension extensions (js/get source .port) label)]
      {"kind" "record"
       "fields"
       (mapv
         (fn [(field IrExtensionFieldSpec)] Any
           {"name" (js/get (js/get field .ref) .name)
            "required" (js/get field .required)
            "type" (command-extension-field-type field resolver)})
         (js/get (js/get extension .source) .fields))})
    (command-descriptor-shape
      (resolved-value-type-descriptor source program resolver label))))

(defn lower-command-expression
  [(source IrCommandExpr)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (label String)]
  Any
  (let [tag (js/get source ._tag)]
    (cond
      (= tag "IrCommandInputExpr")
        {"kind" "input" "name" (strip-colon (js/get source .name))}
      (= tag "IrCommandInjectedExpr")
        {"kind" "injected" "name" (strip-colon (js/get source .name))}
      (= tag "IrCommandStringExpr")
        {"kind" "literal" "value" (js/get source .value)}
      (= tag "IrCommandIntExpr")
        {"kind" "literal" "value" (js/get source .value)}
      (= tag "IrCommandBoolExpr")
        {"kind" "literal" "value" (js/get source .value)}
      (= tag "IrCommandKeywordExpr")
        {"kind" "literal" "value" (strip-colon (js/get source .value))
         "type" "keyword"}
      (= tag "IrCommandNilExpr") {"kind" "literal" "value" nil}
      (= tag "IrCommandActorExpr")
        {"kind" "actor" "name" (strip-colon (js/get source .field))}
      (= tag "IrCommandReceiptTimeExpr") {"kind" "receipt-time"}
      (= tag "IrCommandRecordExpr")
        {"kind" "record"
         "fields"
         (mapv
           (fn [(field IrCommandRecordField)] Any
             {"name" (strip-colon (js/get field .name))
              "value"
              (lower-command-expression
                (js/get field .value) program resolver label)})
           (js/get source .fields))}
      (= tag "IrCommandConfiguredExpr")
        {"kind" "literal"
         "value"
         (configured-projection-literal
           (js/get source .projection) resolver label)}
      (= tag "IrCommandStateValueExpr")
        {"kind" "literal"
         "value"
         (resolved-state-value program resolver (js/get source .value) label)
         "type" "keyword"}
      (= tag "IrCommandExtensionExpr")
        (graph-error (str label " uses unsupported command extension expression"))
      :else
        (graph-error (str label " uses unsupported command expression '" tag "'")))))

(defn lower-command-condition
  [(source IrCommandPredicate)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (label String)]
  Any
  (let [tag (js/get source ._tag)]
    (cond
      (= tag "IrNonNullPredicate")
        {"kind" "non-null"
         "value"
         (lower-command-expression (js/get source .value) program resolver label)}
      :else
        (graph-error (str label " uses unsupported command condition '" tag "'")))))

(defn lower-command-guard
  [(source IrCommandGuardSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (label String)]
  Any
  (if (nil? (js/get source .when))
    {"op" "guard"
     "entity" (resolved-name resolver "entity" (js/get source .entity))
     "identity" (lower-command-expression (js/get source .id) program resolver label)
     "field" (resolved-name resolver "field" (js/get source .field))
     "equals" (lower-command-expression (js/get source .expected) program resolver label)}
    {"op" "guard"
     "entity" (resolved-name resolver "entity" (js/get source .entity))
     "identity" (lower-command-expression (js/get source .id) program resolver label)
     "field" (resolved-name resolver "field" (js/get source .field))
     "equals" (lower-command-expression (js/get source .expected) program resolver label)
     "when" (lower-command-condition (js/get source .when) program resolver label)}))

(defn lower-command-write
  [(source IrCommandWriteSpec)
   (op String)
   (entity String)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (extensions (Vec ResolvedPluginExtension))
   (label String)]
  (Vec Any)
  (let [tag (js/get source ._tag)]
    (cond
      (= tag "IrFieldCommandWrite")
        (let [write (js/get source .write)
              field (resolved-name resolver "field" (js/get write .field))
              value
              (lower-command-expression (js/get write .value) program resolver label)]
          (if (= op "create")
            [{"field" field "value" value
              "omitIfNull" (js/get write .omit_if_null)}]
            (if (nil? (js/get write .allowed_current))
              [{"field" field "value" value}]
              [{"field" field "value" value
                "allowedCurrent"
                (lower-command-expression
                  (js/get write .allowed_current) program resolver label)}])))
      (= tag "IrExtensionCommandWrite")
        (if (not (= op "create"))
          (graph-error (str label " cannot use extension fields in update"))
          (let [extension
                (command-extension extensions (js/get source .port) label)]
            (if (not (= (js/get extension .target) entity))
              (graph-error (str label " extension targets the wrong entity"))
              nil)
            (mapv
              (fn [(field IrExtensionFieldSpec)] Any
                (let [name (js/get (js/get field .ref) .name)]
                  (if (or (not (js/get field .required))
                          (not (= (js/get (js/get field .write) ._tag) "IrCreateWrite"))
                          (not (= (js/get (js/get field .cardinality) ._tag) "IrSingleField")))
                    (graph-error
                      (str label " extension field '" name
                           "' must be required, single, and create-only"))
                    nil)
                  {"field" name
                   "value"
                   {"kind" "get"
                    "value" {"kind" "input"
                             "name" (strip-colon (js/get source .input))}
                    "field" name}
                   "omitIfNull" false}))
              (js/get (js/get extension .source) .fields))))
      :else
        (graph-error (str label " uses unsupported command write '" tag "'")))))

(defn lower-command-step
  [(source IrCommandStep)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (extensions (Vec ResolvedPluginExtension))
   (label String)]
  Any
  (let [tag (js/get source ._tag)]
    (cond
      (= tag "IrAssertStep")
        (let [predicate (js/get source .predicate)
              predicate-tag (js/get predicate ._tag)]
          (cond
            (= predicate-tag "IrEqualPredicate")
              {"op" "assert"
               "left"
               (lower-command-expression
                 (js/get predicate .left) program resolver label)
               "right"
               (lower-command-expression
                 (js/get predicate .right) program resolver label)}
            (= predicate-tag "IrNotContainsPredicate")
              {"op" "assert-not-contains"
               "list"
               (lower-command-expression
                 (js/get predicate .collection) program resolver label)
               "value"
               (lower-command-expression
                 (js/get predicate .value) program resolver label)}
            :else
              (graph-error
                (str label " uses unsupported assertion '" predicate-tag "'"))))
      (= tag "IrRequireStep")
        (if (nil? (js/get source .when))
          {"op" "require"
           "entity" (resolved-name resolver "entity" (js/get source .entity))
           "identity" (lower-command-expression (js/get source .id) program resolver label)}
          {"op" "require"
           "entity" (resolved-name resolver "entity" (js/get source .entity))
           "identity" (lower-command-expression (js/get source .id) program resolver label)
           "when" (lower-command-condition (js/get source .when) program resolver label)})
      (= tag "IrRequireEachStep")
        {"op" "require-each"
         "entity" (resolved-name resolver "entity" (js/get source .entity))
         "identities" (lower-command-expression (js/get source .ids) program resolver label)}
      (= tag "IrGuardStep")
        (lower-command-guard (js/get source .guard) program resolver label)
      (or (= tag "IrCreateStep") (= tag "IrUpdateStep"))
        (let [op (if (= tag "IrCreateStep") "create" "update")
              entity (resolved-name resolver "entity" (js/get source .entity))
              fields
              (reduce
                (fn [result write] (Vec Any)
                  (into result
                    (lower-command-write
                      write op entity program resolver extensions label)))
                []
                (js/get source .fields))]
          (if (nil? (js/get source .when))
            {"op" op
             "entity" entity
             "identity" (lower-command-expression (js/get source .id) program resolver label)
             "fields" fields}
            {"op" op
             "entity" entity
             "identity" (lower-command-expression (js/get source .id) program resolver label)
             "fields" fields
             "when" (lower-command-condition (js/get source .when) program resolver label)}))
      :else
        (graph-error (str label " uses unsupported command step '" tag "'")))))

(defn lower-command-injection
  [(source IrCommandInjection)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (extensions (Vec ResolvedPluginExtension))
   (label String)]
  Any
  (let [tag (js/get source ._tag)]
    (cond
      (= tag "IrGeneratedIdInjection")
        {"name" (strip-colon (js/get source .name))
         "kind" "generated-id" "type" {"kind" "string"}}
      (= tag "IrProviderInjection")
        (let [provider
              (get (js/get resolver .provider_bindings) (ref-key (js/get source .port)))]
          (if (nil? provider)
            (graph-error (str label " names an unbound provider"))
            {"name" (strip-colon (js/get source .name))
             "kind" "provider"
             "provider" provider
             "input"
             (lower-command-expression (js/get source .input) program resolver label)
             "type"
             (command-value-type
               (js/get source .output) program resolver extensions label)}))
      (= tag "IrCanonicalDigestInjection")
        {"name" (strip-colon (js/get source .name))
         "kind" "canonical-digest"
         "type" {"kind" "digest"}
         "input" (lower-command-expression (js/get source .input) program resolver label)}
      (= tag "IrValidateWithInjection")
        (graph-error (str label " uses unsupported validate-with injection"))
      :else
        (graph-error (str label " uses unsupported command injection '" tag "'")))))

(defn command-receipt-field
  [(program IrDeclarationProgram)
   (ref IrReceiptFieldRef)
   (label String)]
  IrReceiptFieldDeclarationSpec
  (declaration-with-ref (js/get program .receipt_fields) ref label))

(defn lower-command
  [(source IrCommandSpec)
   (program IrDeclarationProgram)
   (resolver DeclarationResolver)
   (extensions (Vec ResolvedPluginExtension))]
  Any
  (let [name (resolved-name resolver "command" (js/get source .ref))
        label (str "command '" name "'")
        inputs
        (mapv
          (fn [(input IrCommandInputField)] Any
            {"name" (strip-colon (js/get input .name))
             "required" true
             "type"
             (command-value-type
               (js/get input .value_type) program resolver extensions label)})
          (js/get source .input))
        injections
        (mapv
          (fn [(injection IrCommandInjection)] Any
            (lower-command-injection
              injection program resolver extensions label))
          (js/get source .injections))
        steps
        (mapv
          (fn [(step IrCommandStep)] Any
            (lower-command-step step program resolver extensions label))
          (js/get source .steps))
        results
        (mapv
          (fn [(result IrCommandResultField)] Any
            {"name" (strip-colon (js/get result .name))
             "type"
             (command-value-type
               (js/get result .value_type) program resolver extensions label)
             "value"
             (lower-command-expression (js/get result .value) program resolver label)})
          (js/get source .result))
        receipt (js/get source .receipt)
        receipt-results
        (mapv
          (fn [(result IrReceiptResultField)] Any
            (let [name (strip-colon (js/get result .name))
                  command-result
                  (first
                    (filterv
                      (fn [candidate] Bool (= (get candidate "name") name))
                      results))
                  declaration
                  (command-receipt-field program (js/get result .field) label)]
              (if (nil? command-result)
                (graph-error (str label " receipt names unknown result '" name "'"))
                nil)
              {"name" name
               "field" (resolved-name resolver "receipt-field" (js/get declaration .ref))
               "type" (get command-result "type")}))
          (js/get receipt .results))
        server-fields
        (reduce
          (fn [result port] (Vec Any)
            (let [extension (command-extension extensions port label)]
              (if (not (= (js/get extension .target) "wake.core/command-receipt"))
                (graph-error (str label " receipt extension targets another entity"))
                nil)
              (into result
                (mapv
                  (fn [(field IrExtensionFieldSpec)] Any
                    (let [field-name (js/get (js/get field .ref) .name)
                          storage-id (js/get field .storage_id)
                          type (command-extension-field-type field resolver)
                          injection-name (str "wake.server:" storage-id)]
                      (if (or
                            (not (= (js/get (js/get field .write) ._tag) "IrServerWrite"))
                            (not (= (js/get (js/get field .cardinality) ._tag) "IrSingleField")))
                        (graph-error
                          (str label " receipt extension field '" field-name
                               "' must be single and server-written"))
                        nil)
                      {"name" field-name
                       "field" field-name
                       "type" type
                       "storageId" storage-id
                       "injectionName" injection-name}))
                  (js/get (js/get extension .source) .fields)))))
          []
          (js/get receipt .extensions))
        final-injections
        (into injections
          (mapv
            (fn [field] Any
              {"name" (get field "injectionName")
               "kind" "server-value"
               "storageId" (get field "storageId")
               "type" (get field "type")})
            server-fields))
        final-results
        (into results
          (mapv
            (fn [field] Any
              {"name" (get field "name")
               "type" (get field "type")
               "value" {"kind" "injected"
                        "name" (get field "injectionName")}})
            server-fields))
        final-receipt-results
        (into receipt-results
          (mapv
            (fn [field] Any
              {"name" (get field "name")
               "field" (get field "field")
               "type" (get field "type")})
            server-fields))]
    {"name" name
     "capabilities"
     (mapv
       (fn [(ref IrCapabilityRef)] Any
         (let [capability
               (declaration-with-ref (js/get program .capabilities) ref label)]
           {"capability" (resolved-capability-name resolver ref)
            "guards"
            (mapv
              (fn [(guard IrCommandGuardSpec)] Any
                (lower-command-guard guard program resolver label))
              (js/get capability .guards))}))
       (js/get source .capabilities))
     "normalizerVersion" (js/get source .normalizer_version)
     "input" inputs
     "injections" final-injections
     "steps" steps
     "result" final-results
     "receipt"
     {"entity" "wake.core/command-receipt"
      "identityField" "id"
      "actorField" "actor"
      "commandField" "command"
      "inputDigestField" "input-digest"
      "createdAtField" "created-at"
      "resultFields" final-receipt-results}}))

(defn lower-plugin-instance
  [(instance IrLinkedPluginInstance)
   (application-id String)
   (application-components (Vec IrComponent))]
  LoweredPlugin
  (let [checked
        (require-ir-tag
          (js/get instance .checked) "IrCheckedDeclarationProgram"
          (str "plugin '" (js/get instance .alias) "' declarations"))
        program
        (require-ir-tag
          (js/get checked .program) "IrDeclarationProgram"
          (str "plugin '" (js/get instance .alias) "' declaration program"))
        root
        (require-ir-tag
          (js/get program .root) "IrPluginDeclarationRoot"
          (str "plugin '" (js/get instance .alias) "' root"))
        resolver (plugin-resolver instance program)
        schema?
        (contribution-allowed? (js/get instance .use) "IrSchemaContribution")
        query?
        (contribution-allowed? (js/get instance .use) "IrQueryContribution")
        command?
        (contribution-allowed? (js/get instance .use) "IrCommandContribution")
        capability?
        (contribution-allowed? (js/get instance .use) "IrCapabilityContribution")
        ui?
        (contribution-allowed? (js/get instance .use) "IrUiContribution")
        route?
        (contribution-allowed? (js/get instance .use) "IrRouteContribution")
        extensions (lower-extensions instance program resolver)
        raw-extensions (extension-values extensions)
        package-id (js/get (js/get instance .evidence) .package_id)
        fills
        (if ui?
          (mapv
            (fn [(source IrFillSpec)] GFill
              (lower-component-fill
                source program resolver application-components package-id))
            (js/get (js/get instance .composition) .fills))
          [])]
    (if (> (count (js/get program .renderers)) 0)
      (graph-error
        (str "plugin '" (js/get instance .alias)
             "' renderers await checked renderer lowering"))
      nil)
    (->LoweredPlugin
      instance
      program
      resolver
      (js/get program .source_unit)
      (js/get checked .declaration_provenance)
      (plugin-evidence instance)
      (if schema?
        (mapv
          (fn [(entity IrEntityDeclarationSpec)] GEntity
            (lower-entity-declaration
              entity nil resolver application-id false))
          (js/get program .entities))
        [])
      (if schema?
        (mapv
          (fn [(state IrStateDeclarationSpec)] IrDefstate
            (lower-state-declaration state program resolver))
          (js/get program .states))
        [])
      (if schema?
        (mapv
          (fn [(publication IrPublicationDeclarationSpec)] IrPublication
            (lower-publication publication program resolver))
          (js/get program .publications))
        [])
      (if query?
        (mapv
          (fn [(query IrQueryDeclarationSpec)] IrQuery
            (lower-query query program resolver raw-extensions))
          (js/get program .queries))
        [])
      (if command?
        (mapv
          (fn [(command IrCommandSpec)] Any
            (lower-command command program resolver extensions))
          (js/get program .commands))
        [])
      (if ui?
        (mapv
          (fn [(form IrFormDeclarationSpec)] IrSmartForm
            (lower-form form resolver))
          (js/get program .forms))
        [])
      (if ui?
        (mapv
          (fn [(detail IrListDetailDeclarationSpec)] IrListDetail
            (lower-list-detail detail resolver))
          (js/get program .list_details))
        [])
      (if schema?
        (mapv
          (fn [(value-type IrValueTypeDeclarationSpec)] Any
            (lower-value-type-declaration value-type program resolver))
          (js/get program .value_types))
        [])
      (if capability?
        (mapv
          (fn [(port IrProviderPortSpec)] GProviderPort
            (lower-provider-port port program resolver))
          (js/get program .provider_ports))
        [])
      (if capability?
        (lower-provider-bindings instance program resolver)
        [])
      extensions
      fills
      (if route?
        (mapv
          (fn [(mount IrMountSpec)] GMount
            (lowered-mount mount program resolver package-id))
          (js/get (js/get instance .composition) .mounts))
        [])
      (if ui?
        (mapv
          (fn [(component IrComponentDeclarationSpec)] IrComponent
            (lower-component component resolver))
          (js/get program .components))
        [])
      (if ui?
        (mapv
          (fn [(view IrViewDeclarationSpec)] IrView
            (lower-view view program resolver))
          (js/get program .views))
        [])
      (if route?
        (mapv
          (fn [(route IrRouteTemplateSpec)] IrRoute
            (lower-route-template route resolver))
          (js/get program .route_templates))
        [])
      (if route?
        (mapv
          (fn [(mount IrMountSpec)] IrRoute
            (mounted-route mount program resolver))
          (js/get (js/get instance .composition) .mounts))
        []))))

(defn lower-theme [(theme IrThemeSpec?)] IrTheme?
  (if (nil? theme) nil (ir/->IrTheme (js/get theme .colors))))

;; --- Shared utilities ---

(defn strip-colon [(s String)] String
  (if (js/call s .startsWith ":") (subs s 1) s))

(defn capitalize [(s String)] String
  (str (js/call (subs s 0 1) .toUpperCase) (subs s 1)))

(defn titlecase [(s String)] String
  (str (js/call (subs s 0 1) .toUpperCase) (subs s 1)))

;; --- Field analysis ---

(defn graph-error [(message String)] Any
  (throw (ex-info (str "wake: " message) {})))

(def reserved-generated-names (Vec String)
  ["__proto__" "prototype" "constructor"])

(defn validate-generated-name [(kind String) (name String)] Any
  (if (js/call reserved-generated-names .includes (strip-colon name))
    (graph-error
      (str kind " name '" name
           "' is reserved for generated JavaScript"))
    nil))

(defn validate-generated-names
  [(prog Any) (entities (Vec GEntity)) (defstates (Vec IrDefstate))] Any
  (doseq [entity entities]
    (validate-generated-name "entity" (js/get entity .name))
    (doseq [field (js/get entity .fields)]
      (validate-generated-name "field" (js/get field .name))))
  (doseq [defstate defstates]
    (validate-generated-name "state type" (js/get defstate .name))
    (doseq [state (keys (js/get defstate .transitions))]
      (validate-generated-name "state" state)))
  (doseq [component (or (js/get prog .components) [])]
    (validate-generated-name "component" (js/get component .name))
    (doseq [prop (js/get component .props)]
      (validate-generated-name "component prop" prop)))
  (doseq [view (or (js/get prog .views) [])]
    (validate-generated-name "view" (js/get view .name)))
  (doseq [publication (or (js/get prog .publications) [])]
    (validate-generated-name "publication" (js/get publication .name)))
  (doseq [form (or (js/get prog .forms) [])]
    (validate-generated-name "form" (js/get form .name)))
  (let [router (js/get prog .router)]
    (if (some? router)
      (do
        (validate-generated-name "default route" (js/get router .default_route))
        (doseq [route (js/get router .routes)]
          (validate-generated-name "route" (js/get route .path))
          (validate-generated-name "route view" (js/get route .view_name))))
      nil)))

(defn validate-unique-declaration-names
  [(names (Vec String)) (label String)] Any
  (reduce
    (fn [seen name] (Vec String)
      (if (js/call seen .includes name)
        (graph-error (str label " '" name "' is duplicated"))
        (conj seen name)))
    []
    names))

(defn validate-declaration-uniqueness [(prog Any) (entities (Vec GEntity))] Any
  (validate-unique-declaration-names
    (mapv (fn [entity] String (js/get entity .name)) entities)
    "entity")
  (validate-unique-declaration-names
    (mapv (fn [component] String (js/get component .name)) (or (js/get prog .components) []))
    "component")
  (validate-unique-declaration-names
    (mapv (fn [view] String (js/get view .name)) (or (js/get prog .views) []))
    "view"))

(defn validate-ui-references [(prog Any) (entities (Vec GEntity))] Any
  (let [components (or (js/get prog .components) [])
        views (or (js/get prog .views) [])
        entity-names (mapv (fn [entity] String (js/get entity .name)) entities)
        component-names (mapv (fn [component] String (js/get component .name)) components)
        view-names (mapv (fn [view] String (js/get view .name)) views)]
    (doseq [view views]
      (let [name (js/get view .name)
            entity-name (js/get view .entity_name)
            component-name (js/get view .component)
            select-component (js/get view .select_component)]
        (if (and (some? entity-name)
                 (not (js/call entity-names .includes entity-name)))
          (graph-error
            (str "view '" name "' names unknown entity '" entity-name "'"))
          nil)
        (if (and (some? component-name)
                 (not (js/call component-names .includes component-name)))
          (graph-error
            (str "view '" name "' names unknown component '"
                 component-name "'"))
          nil)
        (if (and (some? select-component)
                 (not (js/call component-names .includes select-component)))
          (graph-error
            (str "view '" name "' names unknown select component '"
                 select-component "'"))
          nil)))
    (let [router (js/get prog .router)]
      (if (some? router)
        (let [routes (or (js/get router .routes) [])
              route-paths (mapv (fn [route] String (js/get route .path)) routes)
              route-views (mapv (fn [route] String (js/get route .view_name)) routes)
              default-route (js/get router .default_route)]
          (reduce
            (fn [seen path] (Vec String)
              (if (js/call seen .includes path)
                (graph-error (str "route path '" path "' is duplicated"))
                (conj seen path)))
            []
            route-paths)
          (doseq [route routes]
            (let [view-name (js/get route .view_name)]
              (if (not (js/call view-names .includes view-name))
                (graph-error
                  (str "route '" (js/get route .path) "' names unknown view '"
                       view-name "'"))
                nil)))
          (if (not (js/call route-views .includes default-route))
            (graph-error
              (str "routes default '" default-route
                   "' does not name a routed view"))
            nil))
        nil))))

(defn nonempty-string? [(value Any)] Bool
  (and (string? value) (> (count value) 0)))

(defn required-storage-id
  [(value Any) (label String) (fallback String) (local Bool)] String
  (if (nonempty-string? value)
    value
    (if local
      fallback
      (graph-error
        (str "plugin " label " requires a nonempty fixed storage ID")))))

(defn append-unique-derived-deps
  [(deps (Vec String)) (additions (Vec String))] (Vec String)
  (reduce
    (fn [result dependency] (Vec String)
      (if (js/call result .includes dependency)
        result
        (conj result dependency)))
    deps
    additions))

(defn validate-derived-expression [(expr Any) (label String)] (Vec String)
  (if (nil? expr)
    (graph-error (str label " requires a closed derived expression"))
    nil)
  (let [tag (js/get expr ._tag)]
    (cond
      (= tag "IrFieldDerivedExpr")
        [(js/get (js/get expr .field) .name)]
      (= tag "IrStringDerivedExpr")
        (if (string? (js/get expr .value))
          []
          (graph-error (str label " has an invalid string expression")))
      (= tag "IrConcatDerivedExpr")
        (do
          (if (= (count (js/get expr .parts)) 0)
            (graph-error (str label " concat expression cannot be empty"))
            nil)
          (reduce
            (fn [deps part] (Vec String)
              (append-unique-derived-deps
                deps
                (validate-derived-expression part label)))
            []
            (js/get expr .parts)))
      :else
        (graph-error
          (str label " uses unsupported derived expression '" tag "'")))))

(defn validate-derived-fields [(entity-name String) (fields (Vec GField))] Any
  (doseq [field fields]
    (if (js/get field .derived)
      (let [label (str "derived field '" entity-name "." (js/get field .name) "'")
            declared (js/get field .deps)
            actual (validate-derived-expression (js/get field .expr) label)]
        (if (not (vector? declared))
          (graph-error (str label " dependencies must be a vector"))
          nil)
        (if (not (= declared actual))
          (graph-error
            (str label " dependencies do not exactly match its expression"))
          nil)
        (doseq [dependency actual]
          (let [resolved
                (first
                  (filterv
                    (fn [candidate] Bool
                      (= (js/get candidate .name) dependency))
                    fields))]
            (if (nil? resolved)
              (graph-error
                (str label " references unknown field '" dependency "'"))
              nil)
            (if (and (some? resolved) (js/get resolved .derived))
              (graph-error
                (str label " cannot reference derived field '" dependency "'"))
              nil)
            (if (and (some? resolved)
                     (or (not (= (js/get resolved .type) "String"))
                         (not (= (js/get resolved .cardinality) "single"))
                         (not (= (js/get resolved .value_kind) "literal"))))
              (graph-error
                (str label " dependency '" dependency
                     "' must be a single stored String field"))
              nil))))
      nil))
  nil)

(defn validate-storage-id-uniqueness [(entities (Vec GEntity))] Any
  (reduce
    (fn [seen entry] (Map String String)
      (let [storage-id (nth entry 0)
            label (nth entry 1)
            prior (get seen storage-id)]
        (if (some? prior)
          (graph-error
            (str "storage ID '" storage-id "' is shared by " prior
                 " and " label))
          (assoc seen storage-id label))))
    {}
    (reduce
      (fn [entries entity] (Vec (Vec String))
        (reduce
          (fn [acc field] (Vec (Vec String))
            (conj
              acc
              [(js/get field .storage_id)
               (str "field '" (js/get entity .name) "." (js/get field .name) "'")]))
          (conj
            entries
            [(js/get entity .storage_id) (str "entity '" (js/get entity .name) "'")])
          (js/get entity .fields)))
      []
      entities))
  nil)

;; --- FK edge resolution ---

(defn resolve-fk-edges [(entities (Vec GEntity))] (Vec FkEdge)
  (let [entity-names (mapv (fn [entity] String (js/get entity .name)) entities)]
    (reduce
      (fn [edges entity] (Vec FkEdge)
        (reduce
          (fn [acc ref-field] (Vec FkEdge)
            (let [target (js/get ref-field .target_entity)]
              (if (nil? target)
                (graph-error
                  (str "Ref field '" (js/get entity .name) "."
                       (js/get ref-field .name) "' requires :to ENTITY"))
                nil)
              (if (not (js/call entity-names .includes target))
                (graph-error
                  (str "Ref field '" (js/get entity .name) "."
                       (js/get ref-field .name) "' targets unknown entity '"
                       target "'"))
                nil)
              (conj acc
                    (->FkEdge (js/get entity .name)
                              (js/get ref-field .name)
                              (or target "")))))
          edges
          (js/get entity .ref_fields)))
      []
      entities)))

;; --- Backend invariants ---

(defn fram-literal-type? [(type String)] Bool
  (or (= type "String")
      (= type "Digest")
      (= type "Int")
      (= type "Integer")
      (= type "Float")
      (= type "Double")
      (= type "Number")
      (= type "Bool")
      (= type "Boolean")
      (= type "Keyword")
      (= type "Instant")))

(defn fram-stored-field-type? [(field GField) (defstates (Vec IrDefstate))] Bool
  (let [type (js/get field .type)]
    (or (fram-literal-type? type)
        (= type "Ref")
        (some?
          (first
            (filterv (fn [state] Bool (= (js/get state .name) type)) defstates))))))

(defn validate-backend [(prog Any) (entities (Vec GEntity))] Any
  (let [backend (js/get prog .backend)
        defstates (or (js/get prog .defstates) [])]
    (if (and (some? backend) (not (= (js/get backend .kind) "fram")))
      (graph-error (str "unsupported backend '" (js/get backend .kind) "'"))
      nil)
    (if (and (some? backend) (some? (js/get prog .persist)))
      (graph-error "FRAM-backed applications cannot declare local persistence")
      nil)
    (if (some? backend)
      (doseq [entity entities]
        (let [identity-fields
              (filterv (fn [field] Bool (js/get field .identity))
                       (js/get entity .stored_fields))]
          (doseq [field (js/get entity .stored_fields)]
            (if (not (fram-stored-field-type? field defstates))
              (graph-error
                (str "FRAM-backed field '" (js/get entity .name) "."
                     (js/get field .name) "' has unsupported type '"
                     (js/get field .type) "'"))
              nil))
          (if (= (count identity-fields) 0)
            (graph-error
              (str "FRAM-backed entity '" (js/get entity .name)
                   "' requires exactly one :identity field"))
            nil)
          (if (> (count identity-fields) 1)
            (graph-error
              (str "FRAM-backed entity '" (js/get entity .name)
                   "' has multiple :identity fields"))
            nil)))
      nil)))

;; --- State machine resolution ---

(defn validate-defstate [(defstate IrDefstate)] Any
  (let [name (js/get defstate .name)
        transitions (js/get defstate .transitions)
        source-names (keys transitions)
        states (mapv strip-colon source-names)
        initial (strip-colon (js/get defstate .initial))]
    (if (= (count states) 0)
      (graph-error (str "defstate '" name "' must declare at least one state"))
      nil)
    (reduce
      (fn [seen state] (Vec String)
        (if (= state "")
          (graph-error (str "defstate '" name "' declares an empty state"))
          nil)
        (if (js/call seen .includes state)
          (graph-error
            (str "defstate '" name "' declares state '" state
                 "' more than once after keyword normalization"))
          (conj seen state)))
      []
      states)
    (if (not (js/call states .includes initial))
      (graph-error
        (str "defstate '" name "' initial state '" initial
             "' is not declared"))
      nil)
    (doseq [source-name source-names]
      (let [source (strip-colon source-name)
            targets (or (get transitions source-name) [])
            normalized-targets (mapv strip-colon targets)]
        (reduce
          (fn [seen target] (Vec String)
            (if (js/call seen .includes target)
              (graph-error
                (str "defstate '" name "' transition from '" source
                     "' repeats target '" target "'"))
              (conj seen target)))
          []
          normalized-targets)
        (doseq [target normalized-targets]
          (if (not (js/call states .includes target))
            (graph-error
              (str "defstate '" name "' transition from '" source
                   "' targets undeclared state '" target "'"))
            nil))))))

(defn validate-defstates [(defstates (Vec IrDefstate))] Any
  (doseq [defstate defstates]
    (validate-defstate defstate)))

(defn resolve-state-machines
  [(entities (Vec GEntity)) (defstates (Vec IrDefstate))] (Vec StateMachine)
  (reduce
    (fn [machines entity] (Vec StateMachine)
      (let [status-fields (filterv
              (fn [f] Bool
                (and (not (= (js/get f .type) "String"))
                     (not (= (js/get f .type) "Ref"))
                     (not (= (js/get f .type) "Derived"))
                     (some? (first (filterv (fn [ds] Bool (= (js/get ds .name) (js/get f .type))) defstates)))))
              (js/get entity .fields))]
        (reduce
          (fn [acc sf] (Vec StateMachine)
            (let [ds (first (filterv (fn [d] Bool (= (js/get d .name) (js/get sf .type))) defstates))]
              (if (not (= (js/get sf .cardinality) "single"))
                (graph-error
                  (str "state field '" (js/get entity .name) "." (js/get sf .name)
                       "' must be single-cardinality"))
                nil)
              (conj acc (->StateMachine (js/get entity .name)
                                        (js/get sf .name)
                                        (js/get sf .type)
                                        (js/get ds .transitions)
                                        (js/get ds .initial)))))
          machines status-fields)))
    [] entities))

;; --- Publication policy resolution ---

(defn entity-named [(entities (Vec GEntity)) (name String)] GEntity?
  (first (filterv (fn [entity] Bool (= (js/get entity .name) name)) entities)))

(defn field-named [(entity GEntity) (name String)] GField?
  (first (filterv (fn [field] Bool (= (js/get field .name) name)) (js/get entity .fields))))

(defn validate-distinct-names [(names (Vec String)) (label String)] Any
  (reduce
    (fn [seen name] (Vec String)
      (if (js/call seen .includes name)
        (graph-error (str label " repeats '" name "'"))
        (conj seen name)))
    []
    names)
  nil)

(defn required-list-field [(entity GEntity) (name String) (label String)] GField
  (let [field (field-named entity name)]
    (if (nil? field)
      (graph-error
        (str label " names unknown field '" (js/get entity .name) "." name "'"))
      nil)
    (or field (first (js/get entity .fields)))))

(defn resolve-list-detail-tab
  [(entities (Vec GEntity))
   (owner GEntity)
   (tab IrDetailTab)
   (label String)]
  GDetailTab
  (let [content-type (js/get tab .content_type)]
    (if (= content-type "fields")
      (let [fields (or (js/get tab .fields) [])]
        (validate-distinct-names fields (str label " field"))
        (doseq [field fields]
          (required-list-field owner field label))
        (->GDetailTab (js/get tab .label) "fields" fields nil nil []))
      (if (= content-type "related")
        (let [entity-name (or (js/get tab .entity_name) "")
              related (entity-named entities entity-name)]
          (if (nil? related)
            (graph-error (str label " names unknown related entity '" entity-name "'"))
            nil)
          (let [child (or related owner)
                candidates
                (filterv
                  (fn [field] Bool
                    (and (= (js/get field .type) "Ref")
                         (= (js/get field .cardinality) "single")
                         (= (js/get field .target_entity) (js/get owner .name))))
                  (js/get child .fields))
                requested (js/get tab .relation_field)
                relation
                (if (= true (js/get tab .infer_relation))
                  (do
                    (if (not (= (count candidates) 1))
                      (graph-error
                        (str label " cannot infer one relation from '" entity-name
                             "' to '" (js/get owner .name) "'"))
                      nil)
                    (first candidates))
                  (let [field (field-named child (or requested ""))]
                    (if (or (nil? field)
                            (not (= (js/get field .type) "Ref"))
                            (not (= (js/get field .cardinality) "single"))
                            (not (= (js/get field .target_entity) (js/get owner .name))))
                      (graph-error
                        (str label " relation must name a single Ref field on '"
                             entity-name "' targeting '" (js/get owner .name) "'"))
                      nil)
                    field))
                display (or (js/get tab .display_fields) [])]
            (validate-distinct-names display (str label " display field"))
            (doseq [field display]
              (required-list-field child field label))
            (->GDetailTab
              (js/get tab .label) "related" [] entity-name
              (js/get (or relation (first (js/get child .fields))) .name) display)))
        (graph-error (str label " has unknown content type '" content-type "'"))))))

(defn resolve-list-details
  [(prog Any) (entities (Vec GEntity))] (Vec GListDetail)
  (let [details (or (js/get prog .list_details) [])]
    (if (> (count details) 1)
      (graph-error "program may declare at most one list detail")
      nil)
    (validate-distinct-names
      (mapv (fn [detail] String (js/get detail .entity_name)) details)
      "list detail entity")
    (mapv
      (fn [detail] GListDetail
        (let [entity-name (js/get detail .entity_name)
              owner (entity-named entities entity-name)
              label (str "list detail '" entity-name "'")]
          (if (nil? owner)
            (graph-error (str label " names unknown entity '" entity-name "'"))
            nil)
          (let [entity (or owner (first entities))
                columns (or (js/get detail .columns) [])
                search (or (js/get detail .search_cols) [])
                tabs (or (js/get detail .detail_tabs) [])]
            (if (not (nonempty-string? (js/get detail .title)))
              (graph-error (str label " title must be nonempty"))
              nil)
            (validate-distinct-names columns (str label " column"))
            (doseq [name columns]
              (let [field (required-list-field entity name label)]
                (if (js/get field .derived)
                  (graph-error (str label " column cannot name derived field '"
                                    entity-name "." name "'"))
                  nil)))
            (validate-distinct-names search (str label " search field"))
            (doseq [name search]
              (let [field (required-list-field entity name label)]
                (if (or (js/get field .derived)
                        (not (= (js/get field .cardinality) "single"))
                        (not (= (js/get field .value_kind) "literal")))
                  (graph-error
                    (str label " search field '" entity-name "." name
                         "' must be a single stored literal"))
                  nil)))
            (validate-distinct-names
              (mapv (fn [tab] String (js/get tab .label)) tabs)
              (str label " tab label"))
            (if (> (count (filterv
                            (fn [tab] Bool (= (js/get tab .content_type) "fields"))
                            tabs)) 1)
              (graph-error (str label " may declare at most one fields tab"))
              nil)
            (let [resolved-tabs
                  (mapv
                    (fn [tab] GDetailTab
                      (resolve-list-detail-tab
                        entities entity tab
                        (str label " tab '" (js/get tab .label) "'")))
                    tabs)]
              (reduce
                (fn [seen tab] (Vec String)
                  (let [folded (js/call (js/get tab .label) .toLowerCase)]
                    (if (and (= (js/get tab .content_type) "related")
                             (= folded "overview"))
                      (graph-error
                        (str label " related tab label '" (js/get tab .label)
                             "' conflicts with the built-in overview tab"))
                      nil)
                    (if (js/call seen .includes folded)
                      (graph-error
                        (str label " tab labels collide case-insensitively at '"
                             (js/get tab .label) "'"))
                      (conj seen folded))))
                []
                resolved-tabs)
              (reduce
                (fn [seen tab] (Vec String)
                  (if (= (js/get tab .content_type) "related")
                    (let [child (js/get tab .entity_name)]
                      (if (js/call seen .includes child)
                        (graph-error
                          (str label " repeats related entity '" child "'"))
                        (conj seen child)))
                    seen))
                [entity-name]
                resolved-tabs)
              (->GListDetail
                entity-name
                (js/get detail .title)
                columns
                search
                resolved-tabs)))))
      details)))

(defn validate-ui-root-topology [(prog Any)] Any
  (let [views (or (js/get prog .views) [])
        details (or (js/get prog .list_details) [])
        forms (or (js/get prog .forms) [])
        router (js/get prog .router)
        layout (js/get prog .layout)]
    (if (and (= (count views) 0) (> (count forms) 1))
      (graph-error "program may declare at most one list-detail form")
      nil)
    (if (and (> (count views) 0) (> (count details) 0))
      (graph-error "program cannot combine view and list-detail UI roots")
      nil)
    (if (and (> (count views) 1) (nil? router))
      (graph-error "multiple views require routes")
      nil)
    (if (and (some? router) (= (count views) 0))
      (graph-error "routes require at least one view")
      nil)
    (if (and (some? layout) (nil? router))
      (graph-error "layout requires routes")
      nil)
    (if (and (some? layout) (not (= (js/get layout .style) "sidebar")))
      (graph-error
        (str "layout uses unsupported style '" (js/get layout .style) "'"))
      nil)
    (if (some? layout)
      (let [groups (or (js/get layout .groups) [])
            view-names (mapv (fn [view] String (js/get view .name)) views)]
        (validate-distinct-names
          (mapv (fn [group] String (js/get group .label)) groups)
          "layout group label")
        (reduce
          (fn [seen group] (Vec String)
            (reduce
              (fn [items item] (Vec String)
                (if (not (js/call view-names .includes item))
                  (graph-error
                    (str "layout group '" (js/get group .label)
                         "' names unknown view '" item "'"))
                  nil)
                (if (js/call items .includes item)
                  (graph-error
                    (str "layout navigation repeats view '" item "'"))
                  (conj items item)))
              seen
              (or (js/get group .items) [])))
          []
          groups))
      nil)
    (if (and (= (count views) 0) (> (count forms) 0))
      (do
        (if (not (= (count details) 1))
          (graph-error "a form requires exactly one list detail")
          nil)
        (if (and (= (count details) 1)
                 (not (= (js/get (first forms) .entity_name)
                         (js/get (first details) .entity_name))))
          (graph-error
            (str "form '" (js/get (first forms) .name) "' targets entity '"
                 (js/get (first forms) .entity_name)
                 "' but the list detail owns '"
                 (js/get (first details) .entity_name) "'"))
          nil))
      nil))
  nil)

(defn validate-create-fields
  [(label String)
   (entity-name String)
   (field-names (Vec String))
   (entities (Vec GEntity))]
  Any
  (let [entity (entity-named entities entity-name)]
    (if (nil? entity)
      (graph-error
        (str label " names unknown entity '" entity-name "'"))
      nil)
    (let [resolved (or entity (first entities))
          identity (js/get resolved .identity_field)]
      (if (or (nil? identity)
              (not (js/call field-names .includes (js/get identity .name))))
        (graph-error
          (str label " must include identity field '" entity-name "."
               (if (nil? identity) "<missing>" (js/get identity .name)) "'"))
        nil)
      (doseq [field-name field-names]
        (let [field (field-named resolved field-name)]
          (if (nil? field)
            (graph-error
              (str label " names unknown field '" entity-name "."
                   field-name "'"))
            nil)
          (if (and (some? field) (= (js/get field .write_policy) "command"))
            (graph-error
              (str label " cannot include command-only field '" entity-name "."
                   field-name "'"))
            nil))))))

(defn validate-fram-create-forms [(prog Any) (entities (Vec GEntity))] Any
  (if (some? (js/get prog .backend))
    (do
      (doseq [view (or (js/get prog .views) [])]
        (let [fields (or (js/get view .add_fields) [])]
          (if (> (count fields) 0)
            (validate-create-fields
              (str "view '" (js/get view .name) "' add form")
              (js/get view .entity_name)
              fields
              entities)
            nil)))
      (doseq [form (or (js/get prog .forms) [])]
        (validate-create-fields
          (str "form '" (js/get form .name) "'")
          (js/get form .entity_name)
          (or (js/get form .fields) [])
          entities)))
    nil))

(defn machine-named
  [(machines (Vec StateMachine))
   (entity-name String)
   (field-name String)]
  StateMachine?
  (first
    (filterv
      (fn [machine] Bool
        (and (= (js/get machine .entity) entity-name)
             (= (js/get machine .field) field-name)))
      machines)))

(defn require-write-policy
  [(entity-name String) (field GField) (expected String)] Any
  (if (not (= (js/get field .write_policy) expected))
    (graph-error
      (str "publication field '" entity-name "." (js/get field .name)
           "' must declare :write :" expected))
    nil))

(defn validate-publication-states
  [(publication-name String)
   (machine StateMachine)
   (draft-state String)
   (published-state String)
   (retired-state String)]
  Any
  (let [transitions (js/get machine .transitions)
        states [draft-state published-state retired-state]]
    (if (not (= (count (distinct states)) 3))
      (graph-error
        (str "publication '" publication-name
             "' draft, published, and retired states must be distinct"))
      nil)
    (doseq [state states]
      (if (nil? (get transitions state))
        (graph-error
          (str "publication '" publication-name "' names unknown state " state))
        nil))
    (if (not (= (js/get machine .initial) draft-state))
      (graph-error
        (str "publication '" publication-name
             "' draft state must be the state machine initial state"))
      nil)
    (if (not (js/call (or (get transitions draft-state) []) .includes published-state))
      (graph-error
        (str "publication '" publication-name
             "' requires its draft -> published transition"))
      nil)
    (if (not (js/call (or (get transitions published-state) []) .includes retired-state))
      (graph-error
        (str "publication '" publication-name
             "' requires its published -> retired transition"))
      nil)))

(defn resolve-publication
  [(source IrPublication)
   (entities (Vec GEntity))
   (machines (Vec StateMachine))]
  PublicationPolicy
  (let [name (js/get source .name)
        owner-name (js/get source .owner_entity)
        revision-name (js/get source .revision_entity)
        owner (entity-named entities owner-name)
        revision (entity-named entities revision-name)]
    (if (nil? owner)
      (graph-error
        (str "publication '" name "' names unknown owner entity '"
             owner-name "'"))
      nil)
    (if (nil? revision)
      (graph-error
        (str "publication '" name "' names unknown revision entity '"
             revision-name "'"))
      nil)
    (let [resolved-owner (or owner (first entities))
          resolved-revision (or revision (first entities))
          pointer (field-named resolved-owner (js/get source .pointer_field))
          owner-field (field-named resolved-revision (js/get source .owner_field))
          state-field (field-named resolved-revision (js/get source .state_field))]
      (if (nil? pointer)
        (graph-error
          (str "publication '" name "' names unknown pointer field '"
               owner-name "." (js/get source .pointer_field) "'"))
        nil)
      (if (nil? owner-field)
        (graph-error
          (str "publication '" name "' names unknown revision owner field '"
               revision-name "." (js/get source .owner_field) "'"))
        nil)
      (if (nil? state-field)
        (graph-error
          (str "publication '" name "' names unknown revision state field '"
               revision-name "." (js/get source .state_field) "'"))
        nil)
      (let [resolved-pointer (or pointer (first (js/get resolved-owner .fields)))
            resolved-owner-field
            (or owner-field (first (js/get resolved-revision .fields)))
            resolved-state-field
            (or state-field (first (js/get resolved-revision .fields)))
            machine
            (machine-named
              machines revision-name (js/get source .state_field))]
        (if (or (not (= (js/get resolved-pointer .value_kind) "ref"))
                (not (= (js/get resolved-pointer .cardinality) "single"))
                (not (= (js/get resolved-pointer .target_entity) revision-name)))
          (graph-error
            (str "publication pointer '" owner-name "."
                 (js/get source .pointer_field)
                 "' must be a single Ref to '" revision-name "'"))
          nil)
        (if (or (not (= (js/get resolved-owner-field .value_kind) "ref"))
                (not (= (js/get resolved-owner-field .cardinality) "single"))
                (not (= (js/get resolved-owner-field .target_entity) owner-name)))
          (graph-error
            (str "publication owner field '" revision-name "."
                 (js/get source .owner_field)
                 "' must be a single Ref to '" owner-name "'"))
          nil)
        (if (or (not (= (js/get resolved-state-field .value_kind) "literal"))
                (not (= (js/get resolved-state-field .cardinality) "single")))
          (graph-error
            (str "publication state field '" revision-name "."
                 (js/get source .state_field) "' must be a single literal"))
          nil)
        (require-write-policy owner-name resolved-pointer "command")
        (require-write-policy revision-name resolved-owner-field "create")
        (require-write-policy revision-name resolved-state-field "command")
        (if (nil? machine)
          (graph-error
            (str "publication state field '" revision-name "."
                 (js/get source .state_field) "' requires a state machine"))
          nil)
        (let [draft-state (js/get source .draft_state)
              published-state (js/get source .published_state)
              retired-state (js/get source .retired_state)]
          (validate-publication-states
            name (or machine (first machines))
            draft-state published-state retired-state)
          (->PublicationPolicy
            name owner-name (js/get source .pointer_field)
            revision-name (js/get source .owner_field) (js/get source .state_field)
            (strip-colon draft-state)
            (strip-colon published-state)
            (strip-colon retired-state)))))))

(defn resolve-publications
  [(prog Any)
   (entities (Vec GEntity))
   (machines (Vec StateMachine))]
  (Vec PublicationPolicy)
  (let [sources (or (js/get prog .publications) [])]
    (if (and (> (count sources) 0) (nil? (js/get prog .backend)))
      (graph-error "publication policies require (backend :fram)")
      nil)
    (reduce
      (fn [seen source] (Vec String)
        (let [name (js/get source .name)]
          (if (js/call seen .includes name)
            (graph-error (str "duplicate publication '" name "'"))
            (conj seen name))))
      [] sources)
    (let [policies
          (mapv (fn [source] PublicationPolicy (resolve-publication source entities machines))
                sources)]
      (reduce
        (fn [seen policy] (Vec String)
          (let [target (str (js/get policy .owner_entity) "."
                            (js/get policy .pointer_field))]
            (if (js/call seen .includes target)
              (graph-error
                (str "publication pointer '" target "' is declared twice"))
              (conj seen target))))
        [] policies)
      policies)))


;; --- Main: build checked application ---

(defn application-id [(prog Any)] String
  (let [resolved (js/get prog .application_id)
        application (js/get prog .application)
        application-id
        (if (nonempty-string? resolved)
          resolved
          (if (nil? application) nil (js/get application .id)))]
    (if (nonempty-string? application-id)
      (or application-id "")
      (do
        (graph-error "linked program requires (application :id \"ID\")")
        ""))))

(defn checked-source-units [(prog Any)] (Vec IrSourceUnit)
  (let [linked (js/get prog .source_units)
        root (js/get prog .source_unit)]
    (if (some? linked)
      linked
      (if (some? root) [root] []))))

;; --- Named query analysis ---

(defn query-name-map [(items Any) (name-fn Any) (label String)] Any
  (reduce
    (fn [result item] (Map String Any)
      (let [name (name-fn item)]
        (if (some? (get result name))
          (graph-error (str label " '" name "' is duplicated"))
          (assoc result name item))))
    {}
    items))

(defn query-field [(entity GEntity) (name String) (label String)] GField
  (let [field
        (first
          (filterv
            (fn [candidate] Bool (= (js/get candidate .name) name))
            (js/get entity .fields)))]
    (if (nil? field)
      (graph-error
        (str label " names unknown field '" (js/get entity .name) "." name "'"))
      nil)
    (if (js/get field .derived)
      (graph-error
        (str label " cannot read derived field '" (js/get entity .name) "." name
             "' from FRAM"))
      nil)
    field))

(defn query-type-family [(type String)] String
  (cond
    (or (= type "Int") (= type "Integer")) "integer"
    (or (= type "Float") (= type "Double") (= type "Number")) "float"
    (or (= type "Bool") (= type "Boolean")) "boolean"
    :else type))

(defn query-types-compatible? [(left String) (right String)] Bool
  (= (query-type-family left) (query-type-family right)))

(defn resolve-query-operand
  [(raw IrQueryOperand)
   (bindings Any)
   (parameters Any)
   (label String)]
  GQueryOperand
  (let [kind (js/get raw .kind)]
    (cond
      (= kind "parameter")
        (let [name (or (js/get raw .name) "")
              parameter (get parameters name)]
          (if (nil? parameter)
            (graph-error (str label " names unknown parameter '$" name "'"))
            nil)
          (->GQueryOperand
            "parameter" (js/get parameter .type) nil nil nil nil name nil))
      (= kind "binding")
        (let [name (or (js/get raw .binding) "")
              entity (get bindings name)]
          (if (nil? entity)
            (graph-error (str label " names unknown binding '" name "'"))
            nil)
          (->GQueryOperand
            "binding" "Ref" (js/get entity .name) name (js/get entity .name) nil nil nil))
      (= kind "field")
        (let [binding (or (js/get raw .binding) "")
              entity (get bindings binding)]
          (if (nil? entity)
            (graph-error (str label " names unknown binding '" binding "'"))
            nil)
          (let [field (query-field entity (or (js/get raw .field) "") label)]
            (->GQueryOperand
              "field" (js/get field .type) (js/get field .target_entity) binding (js/get entity .name)
              (js/get field .name) nil nil)))
      (= kind "literal")
        (->GQueryOperand
          "literal" (or (js/get raw .name) "") nil nil nil nil nil (js/get raw .value))
      :else (graph-error (str label " has unknown operand kind '" kind "'")))))

(defn query-state [(defstates Any) (type String)] Any
  (first (filterv (fn [state] Bool (= (js/get state .name) type)) defstates)))

(defn coerce-query-literal
  [(operand GQueryOperand)
   (expected-type String)
   (defstates Any)
   (label String)]
  GQueryOperand
  (if (not (= (js/get operand .kind) "literal"))
    operand
    (let [literal-type (js/get operand .type)
          value (js/get operand .value)
          state (query-state defstates expected-type)]
      (if (= literal-type "Keyword")
        (if (some? state)
          (do
            (if (not (some? (get (js/get state .transitions) value)))
              (graph-error
                (str label " names unknown " expected-type " value '" value "'"))
              nil)
            (->GQueryOperand
              "literal" expected-type nil nil nil nil nil (strip-colon value)))
          (if (= expected-type "Keyword")
            (->GQueryOperand
              "literal" "Keyword" nil nil nil nil nil (strip-colon value))
            operand))
        operand))))

(defn query-operand-bindings [(operand GQueryOperand)] (Vec String)
  (if (some? (js/get operand .binding)) [(or (js/get operand .binding) "")] []))

(defn analyze-query-predicate
  [(raw IrQueryPredicate)
   (bindings Any)
   (parameters Any)
   (defstates Any)
   (label String)]
  GQueryPredicate
  (let [left0 (resolve-query-operand (js/get raw .left) bindings parameters label)
        right0 (resolve-query-operand (js/get raw .right) bindings parameters label)
        left
        (if (= (js/get left0 .kind) "literal")
          (coerce-query-literal left0 (js/get right0 .type) defstates label)
          left0)
        right
        (if (= (js/get right0 .kind) "literal")
          (coerce-query-literal right0 (js/get left0 .type) defstates label)
          right0)]
    (if (and (= (js/get left .type) "Ref")
             (= (js/get right .type) "Ref")
             (not (= (js/get left .target_entity) (js/get right .target_entity))))
      (graph-error
        (str label " compares references to different entity targets '"
             (or (js/get left .target_entity) "unknown") "' and '"
             (or (js/get right .target_entity) "unknown") "'"))
      nil)
    (if (and (= (js/get left .kind) "binding") (= (js/get right .kind) "field"))
      (let [field-entity (get bindings (or (js/get right .binding) ""))
            field (query-field field-entity (or (js/get right .field) "") label)]
        (if (or (not (= (js/get field .value_kind) "ref"))
                (not (= (js/get field .target_entity) (js/get left .entity))))
          (graph-error (str label " compares an entity binding to an incompatible field"))
          nil))
      (if (and (= (js/get right .kind) "binding") (= (js/get left .kind) "field"))
        (let [field-entity (get bindings (or (js/get left .binding) ""))
              field (query-field field-entity (or (js/get left .field) "") label)]
          (if (or (not (= (js/get field .value_kind) "ref"))
                  (not (= (js/get field .target_entity) (js/get right .entity))))
            (graph-error (str label " compares an entity binding to an incompatible field"))
            nil))
        (if (or (= (js/get left .kind) "binding") (= (js/get right .kind) "binding"))
          (if (not (and (= (js/get left .kind) "binding")
                        (= (js/get right .kind) "binding")
                        (= (js/get left .entity) (js/get right .entity))))
            (graph-error (str label " compares incompatible entity bindings"))
            nil)
          (if (not (query-types-compatible? (js/get left .type) (js/get right .type)))
            (graph-error
              (str label " compares incompatible types '" (js/get left .type)
                   "' and '" (js/get right .type) "'"))
            nil))))
    (->GQueryPredicate "eq" left right)))

(defn query-binding-connected?
  [(binding String)
   (earlier (Vec String))
   (predicates (Vec GQueryPredicate))]
  Bool
  (some?
    (first
      (filterv
        (fn [predicate] Bool
          (let [names
                (into
                  (query-operand-bindings (js/get predicate .left))
                  (query-operand-bindings (js/get predicate .right)))]
            (and (js/call names .includes binding)
                 (some?
                   (first
                     (filterv (fn [name] Bool (js/call names .includes name)) earlier))))))
        predicates))))

(defn query-root-identity-constrained?
  [(root String)
   (identity-field String)
   (predicates (Vec GQueryPredicate))]
  Bool
  (some?
    (first
      (filterv
        (fn [predicate] Bool
          (let [left (js/get predicate .left)
                right (js/get predicate .right)
                identity?
                (fn [operand] Bool
                  (and (= (js/get operand .kind) "field")
                       (= (js/get operand .binding) root)
                       (= (js/get operand .field) identity-field)))
                bound?
                (fn [operand] Bool
                  (or (= (js/get operand .kind) "parameter")
                      (= (js/get operand .kind) "literal")))]
            (or (and (identity? left) (bound? right))
                (and (identity? right) (bound? left)))))
        predicates))))

(defn query-dependencies
  [(bindings (Vec IrQueryBinding))
   (binding-entities Any)
   (predicates (Vec GQueryPredicate))
   (columns (Vec GQueryColumn))]
  (Vec GQueryDependency)
  (let [entries
        (reduce
          (fn [result binding] (Vec (Vec String))
            (let [entity (get binding-entities (js/get binding .name))]
              (conj result [(js/get entity .name) (js/get (js/get entity .identity_field) .name)])))
          [] bindings)
        entries
        (reduce
          (fn [result predicate] (Vec (Vec String))
            (reduce
              (fn [acc operand] (Vec (Vec String))
                (if (= (js/get operand .kind) "field")
                  (conj acc [(or (js/get operand .entity) "") (or (js/get operand .field) "")])
                  acc))
              result [(js/get predicate .left) (js/get predicate .right)]))
          entries predicates)
        entries
        (into
          entries
          (mapv
            (fn [(column GQueryColumn)] (Vec String)
              [(js/get column .entity) (js/get column .field)])
            columns))]
    (mapv
      (fn [entry] GQueryDependency (->GQueryDependency (nth entry 0) (nth entry 1)))
      (reduce
        (fn [unique entry] (Vec (Vec String))
          (if (js/call
                (mapv (fn [candidate] String (str (nth candidate 0) "." (nth candidate 1))) unique) .includes
                (str (nth entry 0) "." (nth entry 1)))
            unique
            (conj unique entry)))
        [] entries))))

(defn provider-named [(providers Any) (name String)] Any
  (first (filterv (fn [provider] Bool (= (js/get provider .name) name)) providers)))

(defn descriptor-field [(descriptor Any) (name String)] Any
  (first
    (filterv
      (fn [field] Bool (= (get field "name") name))
      (or (get descriptor "fields") []))))

(defn provider-field-type-compatible? [(field GField) (descriptor Any)] Bool
  (let [checked-descriptor
        (if (= (js/get field .cardinality) "multi")
          (get descriptor "items")
          descriptor)
        kind (if (nil? checked-descriptor) "" (get checked-descriptor "kind"))
        scalar
        (cond
          (= (js/get field .type) "String") (= kind "string")
          (or (= (js/get field .type) "Int") (= (js/get field .type) "Integer"))
            (= kind "integer")
          (or (= (js/get field .type) "Float")
              (= (js/get field .type) "Double")
              (= (js/get field .type) "Number"))
            (= kind "number")
          (or (= (js/get field .type) "Bool") (= (js/get field .type) "Boolean"))
            (= kind "boolean")
          :else (or (= kind "string") (= kind "enum")))]
    (if (= (js/get field .cardinality) "multi")
      (and (= (get descriptor "kind") "list") scalar)
      scalar)))

(defn provider-literal-compatible? [(value Any) (descriptor Any)] Bool
  (let [kind (get descriptor "kind")]
    (cond
      (= kind "nullable")
        (or (nil? value)
            (provider-literal-compatible? value (get descriptor "value")))
      (= kind "literal") (js/Object.is value (get descriptor "value"))
      (= kind "enum")
        (some?
          (first
            (filterv
              (fn [candidate] Bool (js/Object.is candidate value))
              (or (get descriptor "values") []))))
      (= kind "string") (string? value)
      (= kind "integer")
        (and (number? value)
             (js/Number.isSafeInteger value)
             (not (js/Object.is value -0))
             (or (nil? (get descriptor "minimum"))
                 (>= value (get descriptor "minimum")))
             (or (nil? (get descriptor "maximum"))
                 (<= value (get descriptor "maximum"))))
      (= kind "number")
        (and (number? value) (js/Number.isFinite value)
             (not (js/Object.is value -0)))
      (= kind "boolean") (boolean? value)
      :else false)))

(defn analyze-provider-input
  [(raw Any)
   (expected Any)
   (binding-entities Any)
   (provider-index Int)
   (next-column Int)
   (label String)]
  Any
  (let [kind (get raw "kind")]
    (cond
      (= kind "column")
        (let [binding (get raw "binding")
              entity (get binding-entities binding)]
          (if (nil? entity)
            (graph-error (str label " names unknown binding '" binding "'"))
            nil)
          (let [field (query-field entity (get raw "field") label)]
            (if (not (provider-field-type-compatible? field expected))
              (graph-error
                (str label " field '" (js/get entity .name) "." (js/get field .name)
                     "' is incompatible with provider input type '"
                     (get expected "kind") "'"))
              nil)
            (let [internal-name
                  (str "wake$provided$" provider-index "$" next-column)
                  column
                  (->GQueryColumn
                    internal-name binding (js/get entity .name) (js/get field .name)
                    (js/get field .type) (js/get field .cardinality) (js/get field .value_kind)
                    (js/get field .target_entity) true)]
              [{"kind" "column" "name" internal-name}
               [column]
               (+ next-column 1)])))
      (= kind "literal")
        (do
          (if (not (provider-literal-compatible? (get raw "value") expected))
            (graph-error (str label " literal is incompatible with provider input type"))
            nil)
          [{"kind" "literal" "value" (get raw "value")} [] next-column])
      (= kind "record")
        (do
          (if (not (= (get expected "kind") "record"))
            (graph-error (str label " record is incompatible with provider input type"))
            nil)
          (let [raw-fields (or (get raw "fields") [])
                expected-fields (or (get expected "fields") [])]
            (doseq [field raw-fields]
              (if (nil? (descriptor-field expected (get field "name")))
                (graph-error
                  (str label " contains unknown provider input field '"
                       (get field "name") "'"))
                nil))
            (doseq [field expected-fields]
              (if (and (= (get field "required") true)
                       (nil?
                         (first
                           (filterv
                             (fn [candidate] Bool
                               (= (get candidate "name") (get field "name")))
                             raw-fields))))
                (graph-error
                  (str label " requires provider input field '"
                       (get field "name") "'"))
                nil))
            (loop [(remaining Any) raw-fields
                   (fields Any) []
                   (columns Any) []
                   (next Int) next-column]
              (if (= (count remaining) 0)
                [{"kind" "record" "fields" fields} columns next]
                (let [field (first remaining)
                      field-name (get field "name")
                      checked
                      (analyze-provider-input
                        (get field "value")
                        (get (descriptor-field expected field-name) "value")
                        binding-entities provider-index next
                        (str label "." field-name))]
                  (recur
                    (rest remaining)
                    (conj fields {"name" field-name "value" (nth checked 0)})
                    (into columns (nth checked 1))
                    (nth checked 2)))))))
      :else (graph-error (str label " has unknown provider input expression '" kind "'")))))

(defn analyze-query-column
  [(selection Any)
   (binding-entities Any)
   (label String)
   (internal Bool)]
  GQueryColumn
  (let [entity (get binding-entities (js/get selection .binding))]
    (if (nil? entity)
      (graph-error
        (str label " output '" (js/get selection .name)
             "' names unknown binding '" (js/get selection .binding) "'"))
      nil)
    (let [field (query-field entity (js/get selection .field) label)]
      (->GQueryColumn
        (js/get selection .name) (js/get selection .binding) (js/get entity .name)
        (js/get field .name) (js/get field .type) (js/get field .cardinality)
        (js/get field .value_kind) (js/get field .target_entity) internal))))

(defn analyze-query-selections
  [(selections Any) (binding-entities Any) (providers Any) (label String)] Any
  (loop [(remaining Any) selections
         (provider-index Int) 0
         (columns Any) []
         (public-columns Any) []
         (result-providers Any) []
         (output-names (Vec String)) []]
    (if (= (count remaining) 0)
      [columns public-columns result-providers]
      (let [selection (first remaining)
            tag (js/get selection ._tag)
            output-name (js/get selection .name)]
        (if (js/call output-names .includes output-name)
          (graph-error (str label " output '" output-name "' is duplicated"))
          nil)
        (if (= tag "IrQueryProvided")
          (let [provider-name (js/get selection .provider)
                provider (provider-named providers provider-name)]
            (if (nil? provider)
              (graph-error
                (str label " output '" output-name
                     "' names unbound provider '" provider-name "'"))
              nil)
            (if (>= provider-index 16)
              (graph-error (str label " supports at most 16 provider results"))
              nil)
            (if (not (= (get (js/get provider .output_type) "kind") "bounded"))
              (graph-error
                (str label " provider '" provider-name
                     "' output must be a bounded checked value"))
              nil)
            (let [checked
                  (analyze-provider-input
                    (js/get selection .input)
                    (js/get provider .input_type)
                    binding-entities provider-index 0
                    (str label " provider output '" output-name "' input"))
                  internal-columns (nth checked 1)
                  result-provider
                  (->GQueryResultProvider
                    output-name provider-name (nth checked 0)
                    (js/get provider .input_type) (js/get provider .output_type))]
              (recur
                (rest remaining)
                (+ provider-index 1)
                (into columns internal-columns)
                public-columns
                (conj result-providers result-provider)
                (conj output-names output-name))))
          (if (= tag "IrQuerySelect")
            (let [column
                  (analyze-query-column selection binding-entities label false)]
              (recur
                (rest remaining)
                provider-index
                (conj columns column)
                (conj public-columns column)
                result-providers
                (conj output-names output-name)))
            (graph-error (str label " contains an unexpanded query projection"))))))))

(defn analyze-query
  [(raw IrQuery)
   (entities (Vec GEntity))
   (defstates (Vec IrDefstate))
   (providers Any)]
  GQuery
  (let [name (js/get raw .name)
        label (str "query '" name "'")
        entities-by-name
        (query-name-map entities (fn [entity] String (js/get entity .name)) "entity")
        capabilities (or (js/get raw .capabilities) [])
        raw-bindings (js/get raw .bindings)
        raw-params (js/get raw .params)
        binding-names
        (query-name-map raw-bindings (fn [binding] String (js/get binding .name))
                        (str label " binding"))
        parameters
        (query-name-map raw-params (fn [parameter] String (js/get parameter .name))
                        (str label " parameter"))
        binding-entities
        (reduce
          (fn [result binding] (Map String GEntity)
            (let [entity (get entities-by-name (js/get binding .entity_name))]
              (if (nil? entity)
                (graph-error
                  (str label " binding '" (js/get binding .name)
                       "' names unknown entity '" (js/get binding .entity_name) "'"))
                nil)
              (assoc result (js/get binding .name) entity)))
          {} raw-bindings)]
    (if (or (= (count capabilities) 0) (> (count capabilities) 16))
      (graph-error
        (str label " requires from 1 through 16 capabilities"))
      nil)
    (reduce
      (fn [seen capability] (Vec String)
        (if (or (not (string? capability)) (= (count capability) 0))
          (graph-error (str label " contains an invalid capability"))
          nil)
        (if (js/call seen .includes capability)
          (graph-error
            (str label " repeats capability '" capability "'"))
          (conj seen capability)))
      [] capabilities)
    (doseq [selection (js/get raw .selection)]
      (if (= (js/get selection ._tag) "IrQueryFieldSplice")
        (graph-error
          (str label " contains an unexpanded extension-field projection"))
        nil))
    (doseq [parameter raw-params]
      (let [type (js/get parameter .type)]
        (if (= type "Ref")
          (graph-error
            (str label " parameter '" (js/get parameter .name)
                 "' cannot use Ref without a target entity"))
          nil)
        (if (not
              (or (fram-literal-type? type)
                  (some? (query-state defstates type))))
          (graph-error
            (str label " parameter '" (js/get parameter .name)
                 "' has unsupported type '" type "'"))
          nil)))
    (if (= (count raw-bindings) 0)
      (graph-error (str label " requires at least one entity binding"))
      nil)
    (if (= (count (js/get raw .selection)) 0)
      (graph-error (str label " requires at least one output projection"))
      nil)
    (let [predicates
          (mapv
            (fn [predicate] GQueryPredicate
              (analyze-query-predicate
                predicate binding-entities parameters defstates label))
            (js/get raw .predicates))
          checked-bindings
          (mapv
            (fn [binding] GQueryBinding
              (->GQueryBinding (js/get binding .name) (js/get binding .entity_name)))
            raw-bindings)
          analyzed-selection
          (analyze-query-selections
            (js/get raw .selection) binding-entities providers label)
          columns (nth analyzed-selection 0)
          public-columns (nth analyzed-selection 1)
          result-providers (nth analyzed-selection 2)
          root-binding (first raw-bindings)
          root-entity (get binding-entities (js/get root-binding .name))
          first-column
          (if (> (count public-columns) 0)
            (first public-columns)
            (graph-error (str label " must expose at least one ordinary field output")))
          result-kind (js/get raw .result_kind)
          page (js/get raw .page)]
      (doseq [parameter raw-params]
        (if (not
              (some?
                (first
                  (filterv
                    (fn [predicate] Bool
                      (or (= (js/get (js/get predicate .left) .parameter) (js/get parameter .name))
                          (= (js/get (js/get predicate .right) .parameter) (js/get parameter .name))))
                    predicates))))
          (graph-error
            (str label " parameter '" (js/get parameter .name) "' is unused"))
          nil))
      (loop [(index Int) 1]
        (if (< index (count raw-bindings))
          (let [binding (js/get (nth raw-bindings index) .name)
                earlier
                (mapv (fn [item] String (js/get item .name)) (subvec raw-bindings 0 index))]
            (if (not (query-binding-connected? binding earlier predicates))
              (graph-error
                (str label " binding '" binding "' is disconnected"))
              nil)
            (recur (+ index 1)))
          nil))
      (if (or (not (= (js/get first-column .binding) (js/get root-binding .name)))
              (not (= (js/get first-column .field)
                      (js/get (js/get root-entity .identity_field) .name))))
        (graph-error
          (str label " must project its root identity as the first output"))
        nil)
      (if (and (not (= result-kind "page"))
               (not
                 (query-root-identity-constrained?
                   (js/get root-binding .name)
                   (js/get (js/get root-entity .identity_field) .name)
                   predicates)))
        (graph-error (str label " singular result must constrain its root identity"))
        nil)
      (if (and (= result-kind "page") (> (count result-providers) 0))
        (graph-error (str label " paged results cannot derive provider outputs"))
        nil)
      (if (and (= result-kind "page")
               (some?
                 (first
                   (filterv
                     (fn [column] Bool (= (js/get column .cardinality) "multi"))
                     columns))))
        (graph-error (str label " paged results cannot project multi fields"))
        nil)
      (->GQuery
        name
        capabilities
        (mapv
          (fn [parameter] GQueryParam
            (->GQueryParam (js/get parameter .name) (js/get parameter .type)))
          raw-params)
        checked-bindings
        predicates
        columns
        result-providers
        result-kind
        (if (some? page) (js/get page .default_limit) nil)
        (if (some? page) (js/get page .max_limit) nil)
        (query-dependencies raw-bindings binding-entities predicates columns)))))

(defn resolve-queries
  [(prog Any)
   (entities (Vec GEntity))
   (defstates (Vec IrDefstate))]
  (Vec GQuery)
  (let [queries (or (js/get prog .queries) [])]
    (if (and (> (count queries) 0) (nil? (js/get prog .backend)))
      (graph-error "named queries require (backend :fram)")
      nil)
    (query-name-map queries (fn [query] String (js/get query .name)) "query")
    (mapv
      (fn [query] GQuery
        (analyze-query query entities defstates (or (js/get prog .providers) [])))
      queries)))

(defn query-named [(queries (Vec GQuery)) (name String)] GQuery?
  (first (filterv (fn [query] Bool (= (js/get query .name) name)) queries)))

(defn view-named [(views Any) (name String)] Any
  (first (filterv (fn [view] Bool (= (js/get view .name) name)) views)))

(defn component-named [(components Any) (name String)] Any
  (first (filterv (fn [component] Bool (= (js/get component .name) name)) components)))

(defn checked-query-route
  [(prog Any) (queries (Vec GQuery)) (route IrRoute) (label String)] IrRoute
  (let [view (view-named (or (js/get prog .views) []) (js/get route .view_name))
        parameters (or (js/get route .parameters) [])
        input-parameters (or (js/get route .input_parameters) parameters)
        query-names (or (js/get route .queries) [])]
    (if (nil? view)
      (graph-error
        (str label " names unknown view '" (js/get route .view_name) "'"))
      nil)
    (let [resolved-view (or view (first (or (js/get prog .views) [])))
          component
          (component-named
            (or (js/get prog .components) []) (js/get resolved-view .component))
          resolved-queries
          (mapv
            (fn [reference] (Map Keyword Any)
              (let [query (query-named queries (js/get reference .name))]
                (if (nil? query)
                  (graph-error
                    (str label " names unknown query '"
                         (js/get reference .name) "'"))
                  nil)
                {:query (or query (first queries))
                 :reference reference}))
            query-names)]
      (if (nil? component)
        (graph-error
          (str label " view names unknown component '"
               (js/get resolved-view .component) "'"))
        nil)
      (doseq [resolved resolved-queries]
        (let [query (get resolved :query)
              query-params
              (mapv (fn [parameter] String (js/get parameter .name)) (js/get query .params))]
          (if (not (= query-params input-parameters))
            (graph-error
              (str label " input parameters must exactly match query '"
                   (js/get query .name) "' parameters"))
            nil)))
      (let [columns
            (reduce
              (fn [result resolved] (Vec String)
                (let [query (get resolved :query)
                      public-column-names
                      (mapv
                        (fn [column] String (js/get column .name))
                        (filterv
                          (fn [column] Bool (not (js/get column .internal)))
                          (js/get query .columns)))
                      provider-result-names
                      (mapv
                        (fn [provider] String (js/get provider .name))
                        (or (js/get query .result_providers) []))]
                  (reduce
                    (fn [names output-name] (Vec String)
                      (let [prefix (js/get (get resolved :reference) .prefix)
                          projected-name
                          (if (nil? prefix)
                            output-name
                            (str prefix "-" output-name))]
                        (if (js/call names .includes projected-name)
                          (graph-error
                            (str label " query projections collide on '"
                                 projected-name "'"))
                          (conj names projected-name))))
                    result
                    (into public-column-names provider-result-names))))
              [] resolved-queries)
            checked-component
            (or component (first (or (js/get prog .components) [])))
            missing
            (filterv
              (fn [prop] Bool (not (js/call columns .includes prop)))
              (js/get checked-component .props))]
        (if (> (count missing) 0)
          (graph-error
            (str label " queries do not provide component props: "
                 (js/call missing .join ", ")))
          nil)
        (ir/->IrRoute
          (js/get route .path)
          (js/get route .view_name)
          query-names
          parameters
          input-parameters
          (js/get checked-component .props))))))

(defn checked-route-templates [(prog Any) (queries (Vec GQuery))] (Vec IrRoute)
  (mapv
    (fn [route] IrRoute
      (if (> (count (or (js/get route .queries) [])) 0)
        (checked-query-route
          prog queries route (str "route template '" (js/get route .path) "'"))
        route))
    (or (js/get prog .route_templates) [])))

(defn checked-router [(prog Any) (queries (Vec GQuery))] IrRouter?
  (let [router (js/get prog .router)]
    (if (nil? router)
      nil
      (ir/->IrRouter
        (js/get router .default_route)
        (mapv
          (fn [route] IrRoute
            (if (> (count (or (js/get route .queries) [])) 0)
              (checked-query-route
                prog queries route (str "route '" (js/get route .path) "'"))
              route))
          (or (js/get router .routes) []))))))

(defn check-composition [(prog Any)] Any
  (let [providers (or (js/get prog .providers) [])
        extensions (or (js/get prog .extends) [])
        fills (or (js/get prog .fills) [])
        mounts (or (js/get prog .mounts) [])]
    (reduce
      (fn [seen provider] (Vec String)
        (let [name (js/get provider .name)]
          (validate-generated-name "provider" name)
          (if (js/call seen .includes name)
            (graph-error (str "duplicate provider '" name "'"))
            (conj seen name))))
      [] providers)
    (reduce
      (fn [seen extension] (Vec String)
        (let [port (js/get extension .port)]
          (if (js/call seen .includes port)
            (graph-error (str "extension port '" port "' is supplied twice"))
            (conj seen port))))
      [] extensions)
    (reduce
      (fn [seen fill] (Vec String)
        (let [port (js/get fill .port)]
          (if (js/call seen .includes port)
            (graph-error (str "component port '" port "' is filled twice"))
            (conj seen port))))
      [] fills)
    (reduce
      (fn [seen mount] (Vec String)
        (let [port (js/get mount .port)]
          (if (js/call seen .includes port)
            (graph-error (str "route slot '" port "' is mounted twice"))
            (conj seen port))))
      [] mounts)
    (reduce
      (fn [seen mount] (Vec String)
        (let [path (js/get mount .path)]
          (if (js/call seen .includes path)
            (graph-error (str "route path '" path "' is mounted twice"))
            (conj seen path))))
      [] mounts)
    (reduce
      (fn [seen mount] (Vec String)
        (let [pattern (js/get mount .pattern)]
          (if (js/call seen .includes pattern)
            (graph-error (str "route pattern '" pattern "' is mounted twice"))
            (conj seen pattern))))
      [] mounts)
    nil))

(defn check-resolved-declaration-program
  [(prog ResolvedDeclarationProgram)] CheckedApplication
  (let [app-id (application-id prog)
        entities (js/get prog .entities)
        defstates (or (js/get prog .defstates) [])
        validated-names (validate-generated-names prog entities defstates)
        validated-declarations (validate-declaration-uniqueness prog entities)
        validated-storage-ids (validate-storage-id-uniqueness entities)
        validated (validate-backend prog entities)
        validated-composition (check-composition prog)
        validated-ui-root (validate-ui-root-topology prog)
        validated-create-forms (validate-fram-create-forms prog entities)
        validated-ui (validate-ui-references prog entities)
        validated-defstates (validate-defstates defstates)
        fk-edges (resolve-fk-edges entities)
        state-machines
        (resolve-state-machines entities defstates)
        publications (resolve-publications prog entities state-machines)
        queries (resolve-queries prog entities defstates)
        list-details (resolve-list-details prog entities)
        route-templates (checked-route-templates prog queries)
        router (checked-router prog queries)
        fills (or (js/get prog .fills) [])
        components
        (apply-component-fills-to-components
          (or (js/get prog .components) []) fills)
        views
        (mapv
          (fn [(view IrView)] IrView (apply-component-fills view fills))
          (or (js/get prog .views) []))]
    (->CheckedApplication
      1
      app-id
      (checked-source-units prog)
      (or (js/get prog .plugin_closure) [])
      (js/get prog .linked_declarations)
      (js/get prog .semantic_fingerprint)
      (or (js/get prog .providers) [])
      (or (js/get prog .value_types) [])
      (or (js/get prog .provider_ports) [])
      (or (js/get prog .extends) [])
      fills
      (or (js/get prog .mounts) [])
      route-templates
      (or (js/get prog .ns) "wake.app")
      (js/get prog .backend)
      entities
      fk-edges
      state-machines
      publications
      queries
      (or (js/get prog .commands) [])
      (js/get prog .persist)
      defstates
      list-details
      (or (js/get prog .forms) [])
      (js/get prog .theme)
      components
      views
      router
      (js/get prog .layout))))

(defn lower-linked-declaration-program
  [(linked IrLinkedDeclarationProgram)] ResolvedDeclarationProgram
  (do
    (require-ir-tag linked "IrLinkedDeclarationProgram" "linked declarations")
    (let [checked
          (require-ir-tag
            (js/get linked .application) "IrCheckedDeclarationProgram"
            "application declarations")
          program
          (require-ir-tag
            (js/get checked .program) "IrDeclarationProgram"
            "application declaration program")
          root-value
          (require-ir-tag
            (js/get program .root) "IrApplicationDeclarationRoot"
            "application declaration root")
          root (js/get root-value .application)
          app-id (js/get root .id)
          application-resolver (empty-resolver)
          authority (authority-shape (js/get root .authority))
          application-entities
          (mapv
            (fn [(entity IrEntityDeclarationSpec)] GEntity
              (lower-entity-declaration
                entity root application-resolver app-id true))
            (js/get program .entities))
          application-states
          (mapv
            (fn [(state IrStateDeclarationSpec)] IrDefstate
              (lower-state-declaration state program application-resolver))
            (js/get program .states))
          application-publications
          (mapv
            (fn [(publication IrPublicationDeclarationSpec)] IrPublication
              (lower-publication publication program application-resolver))
            (js/get program .publications))
          application-forms
          (mapv
            (fn [(form IrFormDeclarationSpec)] IrSmartForm
              (lower-form form application-resolver))
            (js/get program .forms))
          application-details
          (mapv
            (fn [(detail IrListDetailDeclarationSpec)] IrListDetail
              (lower-list-detail detail application-resolver))
            (js/get program .list_details))
          application-components
          (mapv
            (fn [(component IrComponentDeclarationSpec)] IrComponent
              (lower-component component application-resolver))
            (js/get program .components))
          application-views
          (mapv
            (fn [(view IrViewDeclarationSpec)] IrView
              (lower-view view program application-resolver))
            (js/get program .views))
          application-routes
          (mapv
            (fn [(route IrRouteTemplateSpec)] IrRoute
              (lower-route-template route application-resolver))
            (js/get program .route_templates))
          plugins
          (mapv
            (fn [(instance IrLinkedPluginInstance)] LoweredPlugin
              (lower-plugin-instance
                instance app-id application-components))
            (js/get linked .plugins))
          plugin-extensions
          (reduce
            (fn [result plugin] (Vec ResolvedPluginExtension)
              (into result (js/get plugin .extensions)))
            [] plugins)
          application-commands
          (mapv
            (fn [(command IrCommandSpec)] Any
              (lower-command
                command program application-resolver plugin-extensions))
            (js/get program .commands))
          combined-commands
          (reduce
            (fn [result plugin] (Vec Any)
              (into result (js/get plugin .commands)))
            application-commands plugins)
          receipt (receipt-entity program plugins combined-commands)
          entities-before-extensions
          (let [declared
                (reduce
                  (fn [result plugin] (Vec GEntity)
                    (into result (js/get plugin .entities)))
                  application-entities plugins)]
            (if (nil? receipt) declared (conj declared receipt)))
          combined-entities
          (apply-plugin-extensions
            entities-before-extensions
            plugin-extensions)
          plugin-mounted-routes
          (reduce
            (fn [result plugin] (Vec IrRoute)
              (into result (js/get plugin .mounted_routes)))
            [] plugins)]
      (if (not (nonempty-string? app-id))
        (graph-error "application requires a nonempty ID")
        nil)
      (if (> (count (js/get program .renderers)) 0)
        (graph-error "application renderers await checked renderer lowering")
        nil)
      (if (> (count (js/get program .provider_ports)) 0)
        (graph-error "application provider ports await checked provider lowering")
        nil)
      (let [default-target (js/get root .default_route)
            router
            (if (nil? default-target)
              nil
              (let [tag (js/get default-target ._tag)]
                (cond
                  (= tag "IrLocalDefaultRoute")
                    (let [route
                        (declaration-with-ref
                          (js/get program .route_templates) (js/get default-target .route)
                          "application default route")
                        view
                        (declaration-with-ref
                          (js/get program .views) (js/get route .view)
                          "application default route view")]
                    (ir/->IrRouter
                      (resolved-name application-resolver "view" (js/get view .ref))
                      (into application-routes plugin-mounted-routes)))
                  (= tag "IrMountedDefaultRoute")
                    (let [matches
                          (filterv
                            (fn [(plugin LoweredPlugin)] Bool
                              (some?
                                (first
                                  (filterv
                                    (fn [(mount IrMountSpec)] Bool
                                      (= (ref-key (js/get mount .slot))
                                         (ref-key (js/get default-target .slot))))
                                    (js/get (js/get (js/get plugin .instance) .composition) .mounts)))))
                            plugins)]
                      (if (not (= (count matches) 1))
                        (graph-error
                          "application mounted default route must resolve exactly once")
                        nil)
                      (let [plugin (first matches)
                            route
                            (mounted-route
                              (first
                                (filterv
                                  (fn [(mount IrMountSpec)] Bool
                                    (= (ref-key (js/get mount .slot))
                                       (ref-key (js/get default-target .slot))))
                                  (js/get
                                    (js/get (js/get plugin .instance) .composition) .mounts)))
                              (js/get plugin .program) (js/get plugin .resolver))]
                        (ir/->IrRouter
                          (js/get route .view_name)
                          (into application-routes plugin-mounted-routes))))
                  :else
                    (graph-error
                      (str "application uses unsupported default route '" tag "'")))))]
        (->ResolvedDeclarationProgram
          linked
          app-id
          (js/get program .source_unit)
          (reduce
            (fn [result plugin] (Vec IrSourceUnit)
              (conj result (js/get plugin .source_unit)))
            [(js/get program .source_unit)] plugins)
          (mapv (fn [(plugin LoweredPlugin)] Any (js/get plugin .evidence)) plugins)
          (reduce
            (fn [result plugin] (Vec IrDeclarationProvenance)
              (into result (js/get plugin .provenance)))
            (js/get checked .declaration_provenance) plugins)
          (js/get program .ns)
          (nth authority 0)
          combined-entities
          (nth authority 1)
          (reduce
            (fn [result plugin] (Vec IrDefstate)
              (into result (js/get plugin .states)))
            application-states plugins)
          (reduce
            (fn [result plugin] (Vec IrPublication)
              (into result (js/get plugin .publications)))
            application-publications plugins)
          (reduce
            (fn [result plugin] (Vec IrQuery)
              (into result (js/get plugin .queries)))
            (mapv
              (fn [(query IrQueryDeclarationSpec)] IrQuery
                (lower-query query program application-resolver []))
              (js/get program .queries))
            plugins)
          combined-commands
          (reduce
            (fn [result plugin] (Vec IrListDetail)
              (into result (js/get plugin .list_details)))
            application-details plugins)
          (reduce
            (fn [result plugin] (Vec IrSmartForm)
              (into result (js/get plugin .forms)))
            application-forms plugins)
          (lower-theme (js/get root .theme))
          (reduce
            (fn [result plugin] (Vec IrComponent)
              (into result (js/get plugin .components)))
            application-components plugins)
          (reduce
            (fn [result plugin] (Vec IrView)
              (into result (js/get plugin .views)))
            application-views plugins)
          router
          (reduce
            (fn [result plugin] (Vec GProvider)
              (into result (js/get plugin .providers)))
            [] plugins)
          (reduce
            (fn [result plugin] (Vec Any)
              (into result (js/get plugin .value_types)))
            (mapv
              (fn [(value-type IrValueTypeDeclarationSpec)] Any
                (lower-value-type-declaration
                  value-type program application-resolver))
              (js/get program .value_types))
            plugins)
          (reduce
            (fn [result plugin] (Vec Any)
              (into result (js/get plugin .provider_ports)))
            [] plugins)
          (extension-values plugin-extensions)
          (reduce
            (fn [result plugin] (Vec GFill)
              (into result (js/get plugin .fills)))
            [] plugins)
          (reduce
            (fn [result plugin] (Vec GMount)
              (into result (js/get plugin .mounts)))
            [] plugins)
          (reduce
            (fn [result plugin] (Vec IrRoute)
              (into result (js/get plugin .route_templates)))
            application-routes plugins)
          nil)))))

(defn check-linked-declaration-program
  [(linked IrLinkedDeclarationProgram)] CheckedApplication
  (check-resolved-declaration-program
    (lower-linked-declaration-program linked)))
