#lang beagle/js
(ns wake.emit-fram)

;; A subject template has one substitution hole: the checked identity field.
;; Its recursive scope is load-bearing: the stable application and storage IDs
;; keep lexical aliases out of FRAM identity.

(defn keyword-term [spelling: String] -> Any
  ["keyword" spelling])

(defn triple-term
  [t1: Any
   t2: Any
   t3: Any] -> Any
  ["triple" t1 t2 t3])

(defn app-scope-term [application-id: String value: Any] -> Any
  (triple-term
    (keyword-term "wake/app")
    (keyword-term application-id)
    value))

(defn subject-template
  [application-id: String
   entity-storage-id: String
   identity-storage-id: String] -> Any
  (app-scope-term
    application-id
    (triple-term
      (keyword-term "entity")
      (keyword-term entity-storage-id)
      {:field identity-storage-id})))

(defn predicate-term
  [application-id: String
   entity-storage-id: String
   field-storage-id: String] -> Any
  (app-scope-term
    application-id
    (triple-term
      (keyword-term "field")
      (keyword-term entity-storage-id)
      (keyword-term field-storage-id))))

(defn field-plan
  [application-id: String
   entity-storage-id: String
   field: Any] -> Any
  (let [plan {:name (.-name field)
              :storageId (.-storage-id field)
              :type (.-type field)
              :cardinality (.-cardinality field)
              :valueKind (.-value-kind field)
              :write (.-write-policy field)
              :predicateTerm
              (predicate-term
                application-id
                entity-storage-id
                (.-storage-id field))}]
    (if (identical? (.-value-kind field) "ref")
      (assoc plan :targetEntity (.-target-entity field))
      plan)))

(defn identity-plan
  [application-id: String
   entity-storage-id: String
   field: Any] -> Any
  {:field (.-name field)
   :storageId (.-storage-id field)
   :type (.-type field)
   :cardinality (.-cardinality field)
   :valueKind (.-value-kind field)
   :subjectTemplate
   (subject-template
     application-id
     entity-storage-id
     (.-storage-id field))})

(defn entity-plan [application-id: String entity: Any] -> Any
  (let [entity-name (.-name entity)
        entity-storage-id (.-storage-id entity)]
    {:name entity-name
     :storageId entity-storage-id
     :identity
     (identity-plan
       application-id entity-storage-id (.-identity-field entity))
     :fields (mapv
               (fn [field: Any] -> Any
                 (field-plan application-id entity-storage-id field))
               (.-stored-fields entity))}))

(defn state-name [state: String] -> String
  (if (.startsWith state ":") (.slice state 1) state))

(defn transition-plan [transitions: Any] -> Any
  (reduce
    (fn [plan state]
      (assoc
        plan
        (state-name state)
        (mapv state-name (or (get transitions state) []))))
    {}
    (keys transitions)))

(defn state-machine-plan [machine: Any] -> Any
  {:entity (.-entity machine)
   :field (.-field machine)
   :stateType (.-state-type machine)
   :initial (state-name (.-initial machine))
   :transitions (transition-plan (.-transitions machine))})

(defn publication-plan [publication: Any] -> Any
  {:name (.-name publication)
   :owner {:entity (.-owner-entity publication)
           :pointer (.-pointer-field publication)}
   :revision {:entity (.-revision-entity publication)
              :ownerField (.-owner-field publication)
              :stateField (.-state-field publication)}
   :states {:draft (.-draft-state publication)
            :published (.-published-state publication)
            :retired (.-retired-state publication)}})

(defn query-operand-plan [operand: Any] -> Any
  (let [kind (.-kind operand)]
    (cond
      (= kind "parameter")
        {:kind "parameter" :name (.-parameter operand) :type (.-type operand)}
      (= kind "binding")
        {:kind "binding" :binding (.-binding operand) :entity (.-entity operand)}
      (= kind "field")
        (let [plan
              {:kind "field"
               :binding (.-binding operand)
               :entity (.-entity operand)
               :field (.-field operand)
               :type (.-type operand)}]
          (if (= (.-type operand) "Ref")
            (assoc plan :targetEntity (.-target-entity operand))
            plan))
      :else
        {:kind "literal" :type (.-type operand) :value (.-value operand)})))

(defn query-predicate-plan [predicate: Any] -> Any
  {:op (.-op predicate)
   :left (query-operand-plan (.-left predicate))
   :right (query-operand-plan (.-right predicate))})

(defn query-column-plan [column: Any] -> Any
  (let [plan
        {:name (.-name column)
         :binding (.-binding column)
         :entity (.-entity column)
         :field (.-field column)
         :type (.-type column)
         :cardinality (.-cardinality column)
         :valueKind (.-value-kind column)}]
    (if (= (.-value-kind column) "ref")
      (assoc plan :targetEntity (.-target-entity column))
      plan)))

(defn query-result-plan [query: Any] -> Any
  (if (= (.-result-kind query) "page")
    {:kind "page"
     :defaultLimit (.-default-limit query)
     :maxLimit (.-max-limit query)}
    {:kind (.-result-kind query)}))

(defn route-query-plan [query: Any] -> Any
  {:name (.-name query) :prefix (.-prefix query)})

(defn query-plan [query: Any] -> Any
  {:name (.-name query)
   :capabilities (.-capabilities query)
   :parameters
   (mapv
     (fn [parameter: Any] -> Any
       {:name (.-name parameter) :type (.-type parameter)})
     (.-params query))
   :bindings
   (mapv
     (fn [binding: Any] -> Any
       {:name (.-name binding) :entity (.-entity binding)})
     (.-bindings query))
   :where (mapv query-predicate-plan (.-predicates query))
   :select (mapv query-column-plan (.-columns query))
   :resultProviders (or (.-result-providers query) [])
   :result (query-result-plan query)
   :dependencies
   (mapv
     (fn [dependency: Any] -> Any
       {:entity (.-entity dependency) :field (.-field dependency)})
     (.-dependencies query))})

(defn fram-plan [checked: Any] -> Any
  (let [application-id (.-application-id checked)]
    {:schemaVersion 2
     :applicationId application-id
     :backend "fram"
     :semanticFingerprint (.-semantic-fingerprint checked)
     :pluginClosure (or (.-plugin-closure checked) [])
     :composition
     {:providers (or (.-providers checked) [])
      :extensions (or (.-extensions checked) [])
      :fills (or (.-fills checked) [])
      :mounts (or (.-mounts checked) [])}
     :routes
     (if (nil? (.-router checked))
       []
       (mapv
         (fn [route: Any] -> Any
           {:path (.-path route)
            :parameters (or (.-parameters route) [])
            :inputParameters (or (.-input-parameters route) [])
            :queries (mapv route-query-plan (or (.-queries route) []))
            :requiredProps (or (.-required-props route) [])
            :view (.-view-name route)})
         (.-routes (.-router checked))))
     :entities (mapv
                 (fn [entity: Any] -> Any
                   (entity-plan application-id entity))
                 (.-entities checked))
     :queries (mapv query-plan (or (.-queries checked) []))
     :commands (or (.-commands checked) [])
     :stateMachines (mapv state-machine-plan (.-state-machines checked))
     :publications (mapv publication-plan (.-publications checked))}))

(js/export
  (defn gen-fram [checked: Any] -> String
    (str (JSON/stringify (fram-plan checked) nil 2) "\n")))
