#lang beagle/js
(ns wake.reader)
(require wake.sexpr :as sexpr)
(require wake.config-reference :as config-reference)
(require wake.command :as command)
(require wake.value-type :as value-type)
(require wake.ir :as ir)

;; Reader: s-expressions → IR program.
;; Consumes output of sexpr/parse-all, produces an IrProgram.

(defrecord ParseResult
  [type: String
   name: String
   value: Any
   provenance: IrProvenance])

(defn sym? [x: Any] -> Bool
  (if (nil? x) false
    (= (.-_tag x) "Sym")))

(defn kw? [x: Any] -> Bool
  (if (nil? x) false
    (= (.-_tag x) "Kw")))

(defn vec? [x: Any] -> Bool
  (if (nil? x) false
    (= (.-_tag x) "SexprVec")))

(defn sym-name [x: Any] -> String
  (.-name x))

(defn kw-name [x: Any] -> String
  (.-name x))

(defn vec-items [x: Any] -> Any
  (.-items x))

(defn sym= [x: Any s: String] -> Bool
  (if (sym? x) (= (sym-name x) s) false))

(defn kw= [x: Any s: String] -> Bool
  (if (kw? x) (= (kw-name x) s) false))

;; --- Attribute parsing ---

(defn parse-error [message: String] -> Any
  (throw (ex-info (str "wake: " message) {})))

(defn require-symbol [value: Any label: String] -> String
  (if (sym? value)
    (sym-name value)
    (parse-error (str label " requires a symbol"))))

(defn require-string [value: Any label: String] -> String
  (if (string? value)
    value
    (parse-error (str label " requires a string"))))

(defn require-keyword [value: Any label: String] -> String
  (if (kw? value)
    (kw-name value)
    (parse-error (str label " requires a keyword"))))

(defn require-vector [value: Any label: String] -> Any
  (if (vec? value)
    (vec-items value)
    (parse-error (str label " requires a vector"))))

(defn require-option-value
  [form: Any
   index: Int
   label: String] -> Any
  (if (>= (+ index 1) (count form))
    (parse-error (str label " requires a value"))
    (nth form (+ index 1))))

(defn symbol-vector [value: Any label: String] -> (Vec String)
  (let [items (require-vector value label)]
    (mapv (fn [item] (require-symbol item label)) items)))

(defn duplicate-name-error [kind: String names: (Vec String)] -> Any
  (reduce
    (fn [seen name]
      (if (.includes seen name)
        (parse-error (str "duplicate " kind " '" name "'"))
        (conj seen name)))
    []
    names))

(defn decimal-version-part? [part: String] -> Bool
  (if (= (count part) 0)
    false
    (if (and (> (count part) 1) (= (.charCodeAt part 0) 48))
      false
      (loop [index: Int 0]
        (if (>= index (count part))
          true
          (let [code (.charCodeAt part index)]
            (if (and (>= code 48) (<= code 57))
              (recur (+ index 1))
              false)))))))

(defn exact-version? [version: String] -> Bool
  (let [parts (.split version ".")]
    (and (= (count parts) 3)
         (decimal-version-part? (nth parts 0))
         (decimal-version-part? (nth parts 1))
         (decimal-version-part? (nth parts 2)))))

(def use-contribution-kinds: (Vec String)
  ["schema" "query" "command" "capability" "ui" "route"])

(defn parse-application [form: Any span: SourceSpan] -> IrApplication
  (if (not (= (count form) 3))
    (parse-error "application must be declared as (application :id \"ID\")")
    nil)
  (if (not (kw= (nth form 1 nil) ":id"))
    (parse-error "application accepts only :id")
    nil)
  (let [application-id (require-string (nth form 2 nil) "application :id")]
    (if (= (count application-id) 0)
      (parse-error "application :id must be nonempty")
      nil)
    (ir/->IrApplication application-id span)))

(defn parse-use-config [value: Any package-id: String] -> (Vec IrUseConfig)
  (let [items (require-vector value (str "use '" package-id "' :config"))]
    (if (not (= (mod (count items) 2) 0))
      (parse-error
        (str "use '" package-id
             "' :config must contain key/value pairs"))
      nil)
    (loop [index: Int 0
           seen: (Vec String) []
           entries: (Vec IrUseConfig) []]
      (if (>= index (count items))
        entries
        (let [key
              (require-symbol
                (nth items index)
                (str "use '" package-id "' :config key"))]
          (if (.includes seen key)
            (parse-error
              (str "use '" package-id
                   "' repeats configuration key '" key "'"))
            nil)
          (recur
            (+ index 2)
            (conj seen key)
            (conj
              entries
              (ir/->IrUseConfig key (nth items (+ index 1))))))))))

(defn parse-use-allow [value: Any package-id: String] -> (Vec String)
  (let [allowed
        (symbol-vector value (str "use '" package-id "' :allow"))]
    (if (= (count allowed) 0)
      (parse-error (str "use '" package-id "' :allow must not be empty"))
      nil)
    (duplicate-name-error "allowed contribution" allowed)
    (doseq [kind allowed]
      (if (not (.includes use-contribution-kinds kind))
        (parse-error
          (str "use '" package-id
               "' allows unknown contribution category '" kind "'"))
        nil))
    allowed))

(defn parse-use [form: Any span: SourceSpan] -> IrUse
  (if (< (count form) 2)
    (parse-error "use requires a package ID string")
    nil)
  (let [package-id (require-string (nth form 1 nil) "use package ID")]
    (if (= (count package-id) 0)
      (parse-error "use package ID must be nonempty")
      nil)
    (loop [index: Int 2
           alias: String? nil
           version: String? nil
           allow: Any nil
           config: Any nil
           seen: (Vec String) []]
      (if (>= index (count form))
        (do
          (doseq [required [":as" ":version" ":allow" ":config"]]
            (if (not (.includes seen required))
              (parse-error
                (str "use '" package-id "' requires " required))
              nil))
          (ir/->IrUse
            package-id
            (or alias "")
            (or version "")
            (or allow [])
            (or config [])
            span))
        (let [option
              (require-keyword
                (nth form index nil)
                (str "use '" package-id "' option"))
              value
              (require-option-value
                form index (str "use '" package-id "' " option))]
          (if (not (.includes [":as" ":version" ":allow" ":config"] option))
            (parse-error
              (str "unknown option on use '" package-id "': " option))
            nil)
          (if (.includes seen option)
            (parse-error
              (str "duplicate option " option " on use '" package-id "'"))
            nil)
          (cond
            (= option ":as")
              (recur
                (+ index 2)
                (require-symbol value (str "use '" package-id "' :as"))
                version allow config (conj seen option))
            (= option ":version")
              (let [exact
                    (require-string
                      value (str "use '" package-id "' :version"))]
                (if (not (exact-version? exact))
                  (parse-error
                    (str "use '" package-id
                         "' :version must be an exact version"))
                  nil)
                (recur
                  (+ index 2)
                  alias exact allow config (conj seen option)))
            (= option ":allow")
              (recur
                (+ index 2)
                alias version (parse-use-allow value package-id) config
                (conj seen option))
            :else
              (recur
                (+ index 2)
                alias version allow (parse-use-config value package-id)
                (conj seen option))))))))

(defn parse-derived-expr [expr: Any label: String] -> IrDerivedExpr
  (cond
    (sym? expr)
      (ir/->IrDerivedExpr "field" (sym-name expr) nil [])
    (string? expr)
      (ir/->IrDerivedExpr "string" nil expr [])
    (vector? expr)
      (let [items expr]
        (if (or (= (count items) 0)
                (not (sym= (first items) "str"))
                (= (count items) 1))
          (parse-error (str label " must be a field, string, or nonempty (str ...)"))
          nil)
        (ir/->IrDerivedExpr
          "concat" nil nil
          (mapv
            (fn [part] (parse-derived-expr part label))
            (rest items))))
    :else
      (do
        (parse-error (str label " must be a field, string, or nonempty (str ...)"))
        (ir/->IrDerivedExpr "string" nil "" []))))

(defn derived-field-refs [expr: IrDerivedExpr] -> (Vec String)
  (cond
    (= (.-kind expr) "field") [(or (.-field expr) "")]
    (= (.-kind expr) "concat")
      (reduce
        (fn [refs part]
          (reduce
            (fn [result name]
              (if (.includes result name) result (conj result name)))
            refs
            (derived-field-refs part)))
        []
        (.-parts expr))
    :else []))

(defn canonical-field-option? [x: Any] -> Bool
  (or (kw= x ":identity")
      (kw= x ":many")
      (kw= x ":to")
      (kw= x ":write")
      (kw= x ":storage-id")))

(defn parse-attr [form: Any] -> Any
  (if (or (not (vector? form)) (< (count form) 3))
    (parse-error "field declaration must be (NAME : TYPE ...)")
    nil)
  (let [name (require-symbol (nth form 0 nil) "field name")
        separator (nth form 1 nil)
        type-name (require-symbol (nth form 2 nil) (str "field '" name "' type"))]
    (if (not (kw= separator ":"))
      (parse-error (str "field '" name "' must separate name and type with :"))
      nil)
    (if (= type-name "Derived")
      (let [invalid-option
            (first (filterv canonical-field-option? (subvec form 3)))]
        (if (some? invalid-option)
          (parse-error
            (str "Derived field '" name "' cannot declare "
                 (kw-name invalid-option)))
          nil)
        (if (not (= (count form) 4))
          (parse-error
            (str "Derived field '" name
                 "' requires exactly one expression"))
          nil)
        (let [expr (parse-derived-expr
                     (nth form 3)
                     (str "Derived field '" name "' expression"))
              deps (derived-field-refs expr)]
          (ir/->IrAttr name nil "Derived" {"expr" expr "deps" deps})))
      (loop [i: Int 3
             storage-id: String? nil
             opts: Any {}
             seen: (Vec String) []]
        (if (>= i (count form))
          (ir/->IrAttr name storage-id type-name opts)
          (let [option
                (require-keyword
                  (nth form i nil) (str "field '" name "' option"))]
            (if (not
                  (.includes
                    [":identity" ":many" ":to" ":write" ":storage-id"]
                    option))
              (parse-error (str "unknown option on field '" name "': " option))
              nil)
            (if (.includes seen option)
              (parse-error (str "duplicate option " option " on field '" name "'"))
              nil)
            (cond
              (= option ":identity")
                (recur
                  (+ i 1) storage-id (assoc opts "identity" true)
                  (conj seen option))
              (= option ":many")
                (recur
                  (+ i 1) storage-id (assoc opts "many" true)
                  (conj seen option))
              (= option ":to")
                (recur
                  (+ i 2)
                  storage-id
                  (assoc
                    opts
                    "target-entity"
                    (require-symbol
                      (require-option-value form i (str "field '" name "' :to"))
                      (str "field '" name "' :to")))
                  (conj seen option))
              (= option ":storage-id")
                (let [value
                      (require-string
                        (require-option-value
                          form i (str "field '" name "' :storage-id"))
                        (str "field '" name "' :storage-id"))]
                  (if (= (count value) 0)
                    (parse-error
                      (str "field '" name "' :storage-id must be nonempty"))
                    nil)
                  (recur (+ i 2) value opts (conj seen option)))
              :else
                (let [policy
                      (require-keyword
                        (require-option-value form i (str "field '" name "' :write"))
                        (str "field '" name "' :write"))]
                  (if (not (.includes [":create" ":set" ":command"] policy))
                    (parse-error
                      (str "field '" name
                           "' :write must be :create, :set, or :command"))
                    nil)
                  (recur
                    (+ i 2)
                    storage-id
                    (assoc opts "write" (subs policy 1))
                    (conj seen option))))))))))

;; --- Application composition ---

(defn qualified-port [value: Any label: String] -> String
  (let [name (require-symbol value label)
        first-dot (.indexOf name ".")]
    (if (or (<= first-dot 0)
            (not (= first-dot (.lastIndexOf name ".")))
            (>= first-dot (- (count name) 1)))
      (parse-error (str label " must be ALIAS.PORT"))
      name)))

(defn parse-provider [form: Any span: SourceSpan] -> IrProvider
  (if (not (= (count form) 4))
    (parse-error
      "provider must be declared as (provider NAME :implements ALIAS.PORT)")
    nil)
  (let [name (require-symbol (nth form 1 nil) "provider name")]
    (if (not (kw= (nth form 2 nil) ":implements"))
      (parse-error (str "provider '" name "' accepts only :implements"))
      nil)
    (ir/->IrProvider
      name
      (qualified-port
        (nth form 3 nil) (str "provider '" name "' :implements"))
      ""
      ""
      span)))

(defn parse-extension-field [form: Any port: String] -> IrAttr
  (if (or (not (vector? form)) (< (count form) 3))
    (parse-error (str "extend '" port "' children must be field declarations"))
    nil)
  (let [name (require-symbol (nth form 0 nil) (str "extend '" port "' field"))
        separator (nth form 1 nil)
        type-name
        (require-symbol
          (nth form 2 nil) (str "extend '" port "' field '" name "' type"))]
    (if (not (kw= separator ":"))
      (parse-error
        (str "extend field '" name "' must separate name and type with :"))
      nil)
    (loop [index: Int 3
           storage-id: String? nil
           opts: Any {}
           seen: (Vec String) []]
      (if (>= index (count form))
        (do
          (if (nil? storage-id)
            (parse-error
              (str "extend field '" name "' requires :storage-id"))
            nil)
          (if (and (= (get opts "required") true)
                   (= (get opts "server") true))
            (parse-error
              (str "extend field '" name
                   "' cannot be both caller-required and server-injected"))
            nil)
          (ir/->IrAttr name storage-id type-name opts))
        (let [option
              (require-keyword
                (nth form index nil) (str "extend field '" name "' option"))]
          (if (not
                (.includes
                  [":storage-id" ":required" ":server" ":many" ":to"]
                  option))
            (parse-error
              (str "unknown option on extend field '" name "': " option))
            nil)
          (if (.includes seen option)
            (parse-error
              (str "duplicate option " option " on extend field '" name "'"))
            nil)
          (cond
            (= option ":storage-id")
              (let [value
                    (require-string
                      (require-option-value
                        form index (str "extend field '" name "' :storage-id"))
                      (str "extend field '" name "' :storage-id"))]
                (if (= (count value) 0)
                  (parse-error
                    (str "extend field '" name "' :storage-id must be nonempty"))
                  nil)
                (recur
                  (+ index 2) value opts (conj seen option)))
            (= option ":required")
              (let [value
                    (require-option-value
                      form index (str "extend field '" name "' :required"))]
                (if (not (or (sym= value "true") (sym= value "false")))
                  (parse-error
                    (str "extend field '" name "' :required must be boolean"))
                  nil)
                (recur
                  (+ index 2) storage-id
                  (assoc opts "required" (sym= value "true"))
                  (conj seen option)))
            (= option ":server")
              (let [value
                    (require-option-value
                      form index (str "extend field '" name "' :server"))]
                (if (not (or (sym= value "true") (sym= value "false")))
                  (parse-error
                    (str "extend field '" name "' :server must be boolean"))
                  nil)
                (recur
                  (+ index 2) storage-id
                  (assoc opts "server" (sym= value "true"))
                  (conj seen option)))
            (= option ":many")
              (recur
                (+ index 1) storage-id (assoc opts "many" true)
                (conj seen option))
            :else
              (recur
                (+ index 2)
                storage-id
                (assoc
                  opts
                  "target-entity"
                  (require-symbol
                    (require-option-value
                      form index (str "extend field '" name "' :to"))
                    (str "extend field '" name "' :to")))
                (conj seen option))))))))

(defn parse-extend [form: Any span: SourceSpan] -> IrExtend
  (if (< (count form) 3)
    (parse-error "extend requires ALIAS.PORT and at least one field")
    nil)
  (let [port (qualified-port (nth form 1 nil) "extend target")]
    (ir/->IrExtend
      port
      (mapv
        (fn [field] (parse-extension-field field port))
        (subvec form 2))
      span)))

(defn parse-fill [form: Any span: SourceSpan] -> IrFill
  (if (not (= (count form) 4))
    (parse-error "fill must be declared as (fill ALIAS.PORT :with COMPONENT)")
    nil)
  (let [port (qualified-port (nth form 1 nil) "fill target")]
    (if (not (kw= (nth form 2 nil) ":with"))
      (parse-error (str "fill '" port "' accepts only :with"))
      nil)
    (ir/->IrFill
      port
      (require-symbol (nth form 3 nil) (str "fill '" port "' :with"))
      span)))

(defn route-parameter-name? [name: String] -> Bool
  (and (> (count name) 0)
       (let [first-code (.charCodeAt name 0)]
         (and (>= first-code 97) (<= first-code 122)))
       (loop [index: Int 1]
         (if (>= index (count name))
           true
           (let [code (.charCodeAt name index)]
             (if (or (and (>= code 97) (<= code 122))
                     (and (>= code 48) (<= code 57))
                     (= code 45))
               (recur (+ index 1))
               false))))))

(defn route-literal-segment? [segment: String] -> Bool
  (and (> (count segment) 0)
       (loop [index: Int 0]
         (if (>= index (count segment))
           true
           (let [code (.charCodeAt segment index)]
             (if (or (and (>= code 65) (<= code 90))
                     (and (>= code 97) (<= code 122))
                     (and (>= code 48) (<= code 57))
                     (.includes [45 46 95 126] code))
               (recur (+ index 1))
               false))))))

(defn route-parameters [path: String port: String] -> (Vec String)
  (if (or (= (count path) 0)
          (not (= (.charAt path 0) "/"))
          (and (> (count path) 1) (= (.charAt path (- (count path) 1)) "/"))
          (.includes path "//")
          (.includes path "?")
          (.includes path "#")
          (.includes path "%")
          (.includes path "\\"))
    (parse-error
      (str "mount '" port "' :path must be a canonical absolute route path"))
    nil)
  (let [segments (if (= path "/") [] (rest (.split path "/")))]
    (loop [remaining: Any segments
           parameters: (Vec String) []]
      (if (= (count remaining) 0)
        parameters
        (let [segment (first remaining)]
          (if (= (.charAt segment 0) ":")
            (let [parameter (subs segment 1)]
              (if (not (route-parameter-name? parameter))
                (parse-error
                  (str "mount '" port "' has invalid route parameter '"
                       parameter "'"))
                nil)
              (if (.includes parameters parameter)
                (parse-error
                  (str "mount '" port "' repeats route parameter '"
                       parameter "'"))
                nil)
              (recur (rest remaining) (conj parameters parameter)))
            (do
              (if (not (route-literal-segment? segment))
                (parse-error
                  (str "mount '" port "' has invalid literal route segment '"
                       segment "'"))
                nil)
              (recur (rest remaining) parameters))))))))

(defn parse-mount [form: Any span: SourceSpan] -> IrMount
  (if (not (= (count form) 4))
    (parse-error "mount must be declared as (mount ALIAS.ROUTE :path \"/path\")")
    nil)
  (let [port (qualified-port (nth form 1 nil) "mount target")]
    (if (not (kw= (nth form 2 nil) ":path"))
      (parse-error (str "mount '" port "' accepts only :path"))
      nil)
    (let [path
          (require-string (nth form 3 nil) (str "mount '" port "' :path"))]
      (ir/->IrMount port path (route-parameters path port) span))))

;; --- Entity parsing ---

(defn parse-entity [form: Any] -> Any
  (let [name (require-symbol (nth form 1 nil) "entity name")]
    (loop [i: Int 2
           storage-id: String? nil
           attr-forms: Any []
           storage-id-seen: Bool false]
      (if (>= i (count form))
        (let [attrs (mapv parse-attr attr-forms)
              field-names (mapv (fn [attr] (.-name attr)) attrs)]
          (reduce
            (fn [seen field-name]
              (if (.includes seen field-name)
                (parse-error
                  (str "duplicate field '" field-name
                       "' in entity '" name "'"))
                (conj seen field-name)))
            []
            field-names)
          (ir/->IrEntity name storage-id attrs))
        (if (kw? (nth form i))
          (do
            (if (not (kw= (nth form i) ":storage-id"))
              (parse-error
                (str "unknown option on entity '" name "': "
                     (kw-name (nth form i))))
              nil)
            (if storage-id-seen
              (parse-error
                (str "duplicate option :storage-id on entity '" name "'"))
              nil)
            (let [value
                  (require-string
                    (require-option-value
                      form i (str "entity '" name "' :storage-id"))
                    (str "entity '" name "' :storage-id"))]
              (if (= (count value) 0)
                (parse-error
                  (str "entity '" name "' :storage-id must be nonempty"))
                nil)
              (recur (+ i 2) value attr-forms true)))
          (if (not (vector? (nth form i)))
            (parse-error
              (str "entity '" name "' children must be field declarations"))
            (recur
              (+ i 1) storage-id (conj attr-forms (nth form i))
              storage-id-seen)))))))

;; --- Backend parsing ---

(defn parse-backend [form: Any] -> Any
  (if (and (= (count form) 2) (kw= (nth form 1) ":fram"))
    (ir/->IrBackend "fram")
    (parse-error "backend must be declared as (backend :fram)")))

;; --- Persist parsing ---

(defn parse-persist [form: Any] -> Any
  (if (and (= (count form) 3)
           (kw= (nth form 1) ":localStorage")
           (string? (nth form 2)))
    (ir/->IrPersist "localStorage" (nth form 2))
    (parse-error
      "persist is local-only and must be declared as (persist :localStorage \"key\")")))

;; --- Theme parsing: (theme :colors (bg "..." fg "..." ...)) ---

(defn parse-color-list [items: Any] -> Any
  (if (not (= (mod (count items) 2) 0))
    (parse-error "theme :colors requires name/value pairs")
    nil)
  (loop [i: Int 0 seen: (Vec String) [] colors: Any {}]
    (if (>= i (count items))
      colors
      (let [name (require-symbol (nth items i) "theme color name")
            value (require-string (nth items (+ i 1)) "theme color value")]
        (if (.includes seen name)
          (parse-error (str "duplicate theme color '" name "'"))
          nil)
        (recur
          (+ i 2)
          (conj seen name)
          (assoc colors name value))))))

(defn parse-theme-colors [form: Any] -> Any
  (if (not (= (count form) 3))
    (parse-error "theme must be declared as (theme :colors (...))")
    nil)
  (if (not (kw= (nth form 1 nil) ":colors"))
    (parse-error "theme accepts only :colors")
    nil)
  (let [colors-form (nth form 2 nil)]
    (if (not (vector? colors-form))
      (parse-error "theme :colors requires a list")
      nil)
    (ir/->IrTheme (parse-color-list colors-form))))

;; --- Defstate parsing ---

(defn parse-defstate-transition [defstate-name: String transition: Any] -> Any
  (if (not (vec? transition))
    (parse-error
      (str "defstate '" defstate-name
           "' transitions must be vectors of [STATE -> TARGET ...]"))
    nil)
  (let [items (vec-items transition)]
    (if (< (count items) 2)
      (parse-error
        (str "defstate '" defstate-name
             "' transitions must be [STATE -> TARGET ...]"))
      nil)
    (if (not (kw? (nth items 0 nil)))
      (parse-error
        (str "defstate '" defstate-name
             "' transition states must be keywords"))
      nil)
    (if (not (sym= (nth items 1 nil) "->"))
      (parse-error
        (str "defstate '" defstate-name
             "' transitions must use -> after the source state"))
      nil)
    (doseq [target (subvec items 2)]
      (if (not (kw? target))
        (parse-error
          (str "defstate '" defstate-name
               "' transition targets must be keywords"))
        nil))
    [(kw-name (nth items 0))
     (mapv kw-name (subvec items 2))]))

(defn parse-defstate [form: Any] -> Any
  (if (not (sym? (nth form 1 nil)))
    (parse-error "defstate requires a symbolic name")
    nil)
  (let [name (sym-name (nth form 1))
        sources (subvec form 2)]
    (if (= (count sources) 0)
      (parse-error (str "defstate '" name "' must declare at least one state"))
      nil)
    (let [transitions
          (mapv
            (fn [source]
              (parse-defstate-transition name source))
            sources)]
      (reduce
        (fn [seen transition]
          (let [source (nth transition 0)]
            (if (.includes seen source)
              (parse-error
                (str "defstate '" name "' declares state '" source
                     "' more than once"))
              (conj seen source))))
        []
        transitions)
      (ir/->IrDefstate
        name
        (Object/fromEntries transitions)
        (nth (first transitions) 0)))))

;; --- Publication parsing ---

(defn publication-option? [name: String] -> Bool
  (.includes
    [":owner" ":pointer" ":revision" ":owner-field" ":state-field"
     ":draft" ":published" ":retired"]
    name))

(defn publication-symbol-option? [name: String] -> Bool
  (.includes
    [":owner" ":pointer" ":revision" ":owner-field" ":state-field"]
    name))

(defn parse-publication [form: Any] -> Any
  (if (or (< (count form) 2) (not (sym? (nth form 1 nil))))
    (parse-error "publication requires a symbolic name")
    nil)
  (let [name (sym-name (nth form 1))]
    (loop [i 2 opts {}]
      (if (>= i (count form))
        (let [required
              [":owner" ":pointer" ":revision" ":owner-field" ":state-field"
               ":draft" ":published" ":retired"]]
          (doseq [key required]
            (if (nil? (get opts key))
              (parse-error
                (str "publication '" name "' requires " key))
              nil))
          (ir/->IrPublication
            name
            (get opts ":owner")
            (get opts ":pointer")
            (get opts ":revision")
            (get opts ":owner-field")
            (get opts ":state-field")
            (get opts ":draft")
            (get opts ":published")
            (get opts ":retired")))
        (let [option (nth form i nil)
              value (nth form (+ i 1) nil)
              option-name (if (kw? option) (kw-name option) "")]
          (if (not (publication-option? option-name))
            (parse-error
              (str "unknown option on publication '" name "': "
                   (if (kw? option) option-name option)))
            nil)
          (if (some? (get opts option-name))
            (parse-error
              (str "duplicate option " option-name
                   " on publication '" name "'"))
            nil)
          (if (publication-symbol-option? option-name)
            (if (sym? value)
              (recur (+ i 2) (assoc opts option-name (sym-name value)))
              (parse-error
                (str option-name " on publication '" name
                     "' requires a symbol")))
            (if (kw? value)
              (recur (+ i 2) (assoc opts option-name (kw-name value)))
              (parse-error
                (str option-name " on publication '" name
                     "' requires a keyword")))))))))

;; --- Named query parsing ---

(defn query-name-part? [code: Int] -> Bool
  (or (and (>= code 48) (<= code 57))
      (and (>= code 65) (<= code 90))
      (and (>= code 97) (<= code 122))
      (= code 45)
      (= code 95)))

(defn query-local-name? [name: String] -> Bool
  (and (> (count name) 0)
       (not (.includes name "."))
       (not (.startsWith name "$"))
       (loop [index: Int 0]
         (if (>= index (count name))
           true
           (if (query-name-part? (.charCodeAt name index))
             (recur (+ index 1))
             false)))))

(defn require-query-local-name [value: Any label: String] -> String
  (let [name (require-symbol value label)]
    (if (query-local-name? name)
      name
      (parse-error
        (str label
             " must contain only letters, digits, '-' or '_' and cannot start with '$'")))))

(defn parse-query-capabilities [value: Any query-name: String] -> (Vec String)
  (let [items (if (vec? value) (vec-items value) [value])
        capabilities
        (mapv
          (fn [item]
            (require-symbol
              item (str "query '" query-name "' capability")))
          items)]
    (if (or (= (count capabilities) 0) (> (count capabilities) 16))
      (parse-error
        (str "query '" query-name
             "' :capability requires from 1 through 16 names"))
      nil)
    (duplicate-name-error
      (str "query '" query-name "' capability") capabilities)
    capabilities))

(defn parse-query-param [value: Any query-name: String] -> IrQueryParam
  (let [items value]
    (if (or (not (vector? items)) (not (= (count items) 3)))
      (parse-error
        (str "query '" query-name
             "' parameters must be declared as (NAME : TYPE)"))
      nil)
    (if (not (kw= (nth items 1 nil) ":"))
      (parse-error
        (str "query '" query-name "' parameter must separate name and type with :"))
      nil)
    (ir/->IrQueryParam
      (require-query-local-name
        (nth items 0 nil) (str "query '" query-name "' parameter name"))
      (require-symbol
        (nth items 2 nil) (str "query '" query-name "' parameter type")))))

(defn parse-query-binding [value: Any query-name: String] -> IrQueryBinding
  (let [items value]
    (if (or (not (vector? items)) (not (= (count items) 3)))
      (parse-error
        (str "query '" query-name
             "' bindings must be declared as (NAME : ENTITY)"))
      nil)
    (if (not (kw= (nth items 1 nil) ":"))
      (parse-error
        (str "query '" query-name "' binding must separate name and entity with :"))
      nil)
    (ir/->IrQueryBinding
      (require-query-local-name
        (nth items 0 nil) (str "query '" query-name "' binding name"))
      (require-symbol
        (nth items 2 nil) (str "query '" query-name "' binding entity")))))

(defn split-query-field-ref [name: String] -> Any
  (let [first-dot (.indexOf name ".")
        last-dot (.lastIndexOf name ".")]
    (if (and (> first-dot 0)
             (= first-dot last-dot)
             (< first-dot (- (count name) 1)))
      [(subs name 0 first-dot) (subs name (+ first-dot 1))]
      nil)))

(defn query-literal-operand [value: Any] -> IrQueryOperand
  (cond
    (string? value) (ir/->IrQueryOperand "literal" "String" nil nil value)
    (number? value)
      (ir/->IrQueryOperand
        "literal"
        (if (js/Number.isSafeInteger value) "Integer" "Float")
        nil nil value)
    (boolean? value) (ir/->IrQueryOperand "literal" "Bool" nil nil value)
    (kw? value)
      (ir/->IrQueryOperand "literal" "Keyword" nil nil (kw-name value))
    :else (parse-error "query equality operands must be names or scalar literals")))

(defn parse-query-operand [value: Any query-name: String] -> IrQueryOperand
  (if (and (vector? value)
           (= (count value) 3)
           (sym= (nth value 0 nil) "field"))
    (ir/->IrQueryOperand
      "field"
      nil
      (require-query-local-name
        (nth value 1 nil) (str "query '" query-name "' field binding"))
      (require-query-local-name
        (nth value 2 nil) (str "query '" query-name "' field name"))
      nil)
    (if (sym? value)
    (let [name (sym-name value)]
      (if (.startsWith name "$")
        (let [parameter (subs name 1)]
          (if (query-local-name? parameter)
            (ir/->IrQueryOperand "parameter" parameter nil nil nil)
            (parse-error
              (str "query '" query-name "' has invalid parameter reference '"
                   name "'"))))
        (let [field-ref (split-query-field-ref name)]
          (if (some? field-ref)
            (ir/->IrQueryOperand
              "field" nil (nth field-ref 0) (nth field-ref 1) nil)
            (if (query-local-name? name)
              (ir/->IrQueryOperand "binding" nil name nil nil)
              (parse-error
                (str "query '" query-name "' has invalid operand '" name "'")))))))
      (query-literal-operand value))))

(defn parse-query-predicate [value: Any query-name: String] -> IrQueryPredicate
  (if (or (not (vector? value))
          (not (= (count value) 3))
          (not (sym= (nth value 0 nil) "=")))
    (parse-error
      (str "query '" query-name
           "' predicates must be (= LEFT RIGHT) equality forms"))
    nil)
  (ir/->IrQueryPredicate
    "eq"
    (parse-query-operand (nth value 1 nil) query-name)
    (parse-query-operand (nth value 2 nil) query-name)))

(defn provider-query-literal [value: Any label: String] -> Any
  (cond
    (string? value) value
    (number? value) value
    (boolean? value) value
    (kw? value) (kw-name value)
    (and (sym? value) (= (sym-name value) "nil")) nil
    :else (parse-error (str label " literal must be scalar JSON data"))))

(defn parse-provider-query-input [value: Any label: String] -> Any
  (if (not (vector? value))
    {"kind" "literal" "value" (provider-query-literal value label)}
    (let [name (require-symbol (nth value 0 nil) label)]
      (cond
        (= name "field")
          (do
            (if (not (= (count value) 3))
              (parse-error (str label " field must be (field BINDING FIELD)"))
              nil)
            {"kind" "column"
             "binding" (require-query-local-name (nth value 1 nil) label)
             "field" (require-query-local-name (nth value 2 nil) label)})
        (= name "literal")
          (do
            (if (not (= (count value) 2))
              (parse-error (str label " literal must be (literal VALUE)"))
              nil)
            {"kind" "literal"
             "value" (provider-query-literal (nth value 1 nil) label)})
        (= name "record")
          (do
            (if (not (= (count value) 2))
              (parse-error (str label " record must be (record [NAME VALUE...])"))
              nil)
            (let [items (require-vector (nth value 1 nil) label)]
              (if (not (= (mod (count items) 2) 0))
                (parse-error (str label " record requires name/value pairs"))
                nil)
              (loop [index: Int 0 fields: Any [] seen: (Vec String) []]
                (if (>= index (count items))
                  {"kind" "record" "fields" fields}
                  (let [field-name
                        (require-query-local-name
                          (nth items index nil) (str label " record field"))]
                    (if (.includes seen field-name)
                      (parse-error (str label " record repeats field '" field-name "'"))
                      nil)
                    (recur
                      (+ index 2)
                      (conj fields
                        {"name" field-name
                         "value" (parse-provider-query-input
                                   (nth items (+ index 1) nil)
                                   (str label "." field-name))})
                      (conj seen field-name)))))))
        :else (parse-error (str label " has unknown expression '" name "'"))))))

(defn parse-query-select [value: Any query-name: String] -> Any
  (if (and (vector? value) (sym= (nth value 0 nil) "provided"))
    (let [output
          (require-query-local-name
            (nth value 1 nil) (str "query '" query-name "' provided output"))]
      (if (not (= (count value) 6))
        (parse-error
          (str "query '" query-name
               "' provided projection must be (provided OUTPUT :by PROVIDER :input INPUT)"))
        nil)
      (if (not (kw= (nth value 2 nil) ":by"))
        (parse-error (str "query '" query-name "' provided projection requires :by"))
        nil)
      (if (not (kw= (nth value 4 nil) ":input"))
        (parse-error (str "query '" query-name "' provided projection requires :input"))
        nil)
      (ir/->IrQueryProvided
        output
        (require-symbol
          (nth value 3 nil) (str "query '" query-name "' provided provider"))
        (parse-provider-query-input
          (nth value 5 nil) (str "query '" query-name "' provided input"))))
    (if (and (vector? value) (sym= (nth value 0 nil) "extension-fields"))
    (do
      (if (not (= (count value) 3))
        (parse-error
          (str "query '" query-name
               "' extension-fields projection must be (extension-fields PORT BINDING)"))
        nil)
      (ir/->IrQueryFieldSplice
        (require-query-local-name
          (nth value 1 nil) (str "query '" query-name "' extension-fields port"))
        (require-query-local-name
          (nth value 2 nil) (str "query '" query-name "' extension-fields binding"))))
    (do
      (if (or (not (vector? value)) (not (= (count value) 2)))
        (parse-error
          (str "query '" query-name
               "' projections must be (OUTPUT BINDING.FIELD) or (extension-fields PORT BINDING)"))
        nil)
      (let [output
            (require-query-local-name
              (nth value 0 nil) (str "query '" query-name "' output name"))
            operand (parse-query-operand (nth value 1 nil) query-name)]
        (if (not (= (.-kind operand) "field"))
          (parse-error
            (str "query '" query-name "' projection '" output
                 "' must select a bound field with BINDING.FIELD or (field BINDING FIELD)"))
          nil)
        (ir/->IrQuerySelect
          output (or (.-binding operand) "") (or (.-field operand) "")))))))

(defn positive-safe-int? [value: Any] -> Bool
  (and (number? value)
       (js/Number.isSafeInteger value)
       (> value 0)))

(defn parse-query-page [value: Any query-name: String] -> IrQueryPage
  (let [items (require-vector value (str "query '" query-name "' :page"))]
    (if (not (= (count items) 4))
      (parse-error
        (str "query '" query-name "' :page must be [default N max N]"))
      nil)
    (if (or (not (sym= (nth items 0 nil) "default"))
            (not (sym= (nth items 2 nil) "max")))
      (parse-error
        (str "query '" query-name "' :page must be [default N max N]"))
      nil)
    (let [default-limit (nth items 1 nil)
          max-limit (nth items 3 nil)]
      (if (or (not (positive-safe-int? default-limit))
              (not (positive-safe-int? max-limit))
              (> default-limit max-limit)
              (> max-limit 247))
        (parse-error
          (str "query '" query-name
               "' page limits must be positive integers with default <= max <= 247"))
        nil)
      (ir/->IrQueryPage default-limit max-limit))))

(defn parse-query [form: Any] -> IrQuery
  (let [name (require-symbol (nth form 1 nil) "query name")]
    (loop [index: Int 2
           capabilities: Any nil
           params: Any nil
           bindings: Any nil
           predicates: Any nil
           selection: Any nil
           result-kind: String? nil
           page: IrQueryPage? nil
           seen: (Vec String) []]
      (if (>= index (count form))
        (do
          (doseq [required [":capability" ":params" ":from" ":where" ":select" ":result"]]
            (if (not (.includes seen required))
              (parse-error (str "query '" name "' requires " required))
              nil))
          (if (and (= result-kind "page") (nil? page))
            (parse-error (str "query '" name "' page result requires :page"))
            nil)
          (if (and (not (= result-kind "page")) (some? page))
            (parse-error
              (str "query '" name "' only a page result may declare :page"))
            nil)
          (ir/->IrQuery
            name (or capabilities []) (or params []) (or bindings []) (or predicates [])
            (or selection []) (or result-kind "") page))
        (let [option
              (require-keyword
                (nth form index nil) (str "query '" name "' option"))
              value
              (require-option-value form index (str "query '" name "' " option))]
          (if (not (.includes [":capability" ":params" ":from" ":where" ":select" ":result" ":page"] option))
            (parse-error (str "unknown option on query '" name "': " option))
            nil)
          (if (.includes seen option)
            (parse-error (str "duplicate option " option " on query '" name "'"))
            nil)
          (cond
            (= option ":capability")
              (recur
                (+ index 2) (parse-query-capabilities value name)
                params bindings predicates selection result-kind page
                (conj seen option))
            (= option ":params")
              (recur
                (+ index 2) capabilities
                (mapv
                  (fn [item] (parse-query-param item name))
                  (require-vector value (str "query '" name "' :params")))
                bindings predicates selection result-kind page (conj seen option))
            (= option ":from")
              (recur
                (+ index 2) capabilities params
                (mapv
                  (fn [item] (parse-query-binding item name))
                  (require-vector value (str "query '" name "' :from")))
                predicates selection result-kind page (conj seen option))
            (= option ":where")
              (recur
                (+ index 2) capabilities params bindings
                (mapv
                  (fn [item] (parse-query-predicate item name))
                  (require-vector value (str "query '" name "' :where")))
                selection result-kind page (conj seen option))
            (= option ":select")
              (let [items
                    (mapv
                      (fn [item] (parse-query-select item name))
                      (require-vector value (str "query '" name "' :select")))]
                (if (and (> (count items) 0)
                         (= (.-_tag (first items)) "IrQueryFieldSplice"))
                  (parse-error
                    (str "query '" name
                         "' extension-fields cannot be the first projection"))
                  nil)
                (recur
                  (+ index 2) capabilities params bindings predicates items
                  result-kind page (conj seen option)))
            (= option ":result")
              (let [kind (require-keyword value (str "query '" name "' :result"))]
                (if (not (.includes [":one" ":optional" ":page"] kind))
                  (parse-error
                    (str "query '" name
                         "' :result must be :one, :optional, or :page"))
                  nil)
                (recur
                  (+ index 2) capabilities params bindings predicates selection
                  (subs kind 1) page (conj seen option)))
            :else
              (recur
                (+ index 2) capabilities params bindings predicates selection result-kind
                (parse-query-page value name) (conj seen option))))))))

;; --- Detail tab parsing ---

(defn parse-related-query-field
  [query: Any
   entity-name: String
   label: String] -> String
  (let [items query]
    (if (or (not (= (count items) 4))
            (not (kw= (nth items 0 nil) ":find"))
            (not (sym? (nth items 1 nil)))
            (not (kw= (nth items 2 nil) ":where")))
      (parse-error (str label " :query must be [:find ROW :where [ROW :entity/field OWNER]]"))
      nil)
    (let [where-items
          (require-vector
            (nth items 3 nil)
            (str label " :query where clause"))]
      (if (or (not (= (count where-items) 3))
              (not (sym? (nth where-items 0 nil)))
              (not (kw? (nth where-items 1 nil)))
              (not (sym? (nth where-items 2 nil))))
        (parse-error (str label " :query must contain one relation clause"))
        nil)
      (let [qualified (require-keyword (nth where-items 1 nil) label)
            find-row (sym-name (nth items 1 nil))
            where-row (sym-name (nth where-items 0 nil))
            owner-row (sym-name (nth where-items 2 nil))
            prefix (str ":" entity-name "/")]
        (if (not (= find-row where-row))
          (parse-error
            (str label " :query :find row '" find-row
                 "' must match :where row '" where-row "'"))
          nil)
        (if (= where-row owner-row)
          (parse-error
            (str label " :query related row and owner must be distinct"))
          nil)
        (if (not (.startsWith qualified prefix))
          (parse-error
            (str label " :query relation must belong to '" entity-name "'"))
          nil)
        (subs qualified (count prefix))))))

(defn parse-detail-tab [form: Any] -> Any
  (if (or (not (vector? form))
          (not (= (count form) 3))
          (not (sym= (nth form 0 nil) "tab")))
    (parse-error "detail tabs must be (tab \"Label\" (...))")
    nil)
  (let [label (require-string (nth form 1 nil) "detail tab label")
        body (nth form 2 nil)]
    (if (or (not (vector? body)) (= (count body) 0))
      (parse-error (str "detail tab '" label "' requires a body form"))
      nil)
    (if (sym= (nth body 0 nil) "fields")
      (do
        (if (not (= (count body) 2))
          (parse-error
            (str "fields detail tab '" label "' requires one field vector"))
          nil)
        (ir/->IrDetailTab
          label
          "fields"
          (symbol-vector (nth body 1 nil) (str "detail tab '" label "' fields"))
          nil nil false []))
      (if (sym= (nth body 0 nil) "related")
        (let [rel-entity
              (require-symbol
                (nth body 1 nil) (str "related detail tab '" label "' entity"))]
          (loop [i: Int 2 query: Any nil display: Any nil seen: (Vec String) []]
            (if (>= i (count body))
              (do
                (if (nil? query)
                  (parse-error
                    (str "related detail tab '" label "' requires :query"))
                  nil)
                (ir/->IrDetailTab
                  label "related" [] rel-entity
                  (parse-related-query-field
                    query rel-entity (str "related detail tab '" label "'"))
                  false (or display [])))
              (let [option
                    (require-keyword
                      (nth body i nil)
                      (str "related detail tab '" label "' option"))
                    value
                    (require-option-value
                      body i (str "related detail tab '" label "' " option))]
                (if (not (.includes [":query" ":display"] option))
                  (parse-error
                    (str "unknown option on related detail tab '"
                         label "': " option))
                  nil)
                (if (.includes seen option)
                  (parse-error
                    (str "duplicate option " option
                         " on related detail tab '" label "'"))
                  nil)
                (if (= option ":query")
                  (recur
                    (+ i 2)
                    (require-vector
                      value (str "related detail tab '" label "' :query"))
                    display
                    (conj seen option))
                  (recur
                    (+ i 2)
                    query
                    (symbol-vector
                      value (str "related detail tab '" label "' :display"))
                    (conj seen option)))))))
        (parse-error
          (str "unknown detail tab body in '" label "'"))))))

(defn parse-tabs [form: Any] -> Any
  (if (or (not (vector? form))
          (= (count form) 0)
          (not (sym= (nth form 0 nil) "tabs")))
    (parse-error "list-detail :detail requires a (tabs ...) form")
    nil)
  (mapv parse-detail-tab (subvec form 1)))

;; --- List-detail parsing ---

(defn titlecase [s: String] -> String
  (if (= (count s) 0) s
    (str (.toUpperCase (subs s 0 1)) (subs s 1))))

(defn parse-list-detail [form: Any] -> Any
  (let [entity-name (require-symbol (nth form 1 nil) "list-detail entity")]
    (loop [i: Int 2
           title: String? nil
           columns: (Vec String) []
           search: (Vec String) []
           detail: (Vec IrDetailTab) []
           seen: (Vec String) []]
      (if (>= i (count form))
        (ir/->IrListDetail entity-name
                           (if (nil? title) (titlecase entity-name) (str title))
                           columns search detail)
        (let [option
              (require-keyword
                (nth form i nil) (str "list-detail '" entity-name "' option"))
              value
              (require-option-value
                form i (str "list-detail '" entity-name "' " option))]
          (if (not (.includes [":title" ":columns" ":search" ":detail"] option))
            (parse-error
              (str "unknown option on list-detail '" entity-name "': " option))
            nil)
          (if (.includes seen option)
            (parse-error
              (str "duplicate option " option " on list-detail '" entity-name "'"))
            nil)
          (cond
            (= option ":title")
              (recur
                (+ i 2)
                (require-string value (str "list-detail '" entity-name "' :title"))
                columns search detail (conj seen option))
            (= option ":columns")
              (recur
                (+ i 2) title
                (symbol-vector value (str "list-detail '" entity-name "' :columns"))
                search detail (conj seen option))
            (= option ":search")
              (recur
                (+ i 2) title columns
                (symbol-vector value (str "list-detail '" entity-name "' :search"))
                detail (conj seen option))
            :else
              (recur
                (+ i 2) title columns search (parse-tabs value)
                (conj seen option))))))))

;; --- Smart form parsing ---

(defn parse-smart-form [form: Any] -> Any
  (let [name (require-symbol (nth form 1 nil) "form name")]
    (loop [i: Int 2
           entity: String? nil
           fields: (Vec String) []
           required: (Vec String) []
           label: String "Submit"
           on-success: String ":clear"
           seen: (Vec String) []]
      (if (>= i (count form))
        (do
          (if (nil? entity)
            (parse-error (str "form '" name "' requires :entity"))
            nil)
          (ir/->IrSmartForm name (or entity "") fields required label on-success))
        (let [option
              (require-keyword (nth form i nil) (str "form '" name "' option"))
              value
              (require-option-value form i (str "form '" name "' " option))]
          (if (not
                (.includes
                  [":entity" ":fields" ":required" ":submit-label" ":on-success"]
                  option))
            (parse-error (str "unknown option on form '" name "': " option))
            nil)
          (if (.includes seen option)
            (parse-error (str "duplicate option " option " on form '" name "'"))
            nil)
          (cond
            (= option ":entity")
              (recur
                (+ i 2)
                (require-symbol value (str "form '" name "' :entity"))
                fields required label on-success (conj seen option))
            (= option ":fields")
              (recur
                (+ i 2) entity
                (symbol-vector value (str "form '" name "' :fields"))
                required label on-success (conj seen option))
            (= option ":required")
              (recur
                (+ i 2) entity fields
                (symbol-vector value (str "form '" name "' :required"))
                label on-success (conj seen option))
            (= option ":submit-label")
              (recur
                (+ i 2) entity fields required
                (require-string value (str "form '" name "' :submit-label"))
                on-success (conj seen option))
            :else
              (recur
                (+ i 2) entity fields required label
                (require-keyword value (str "form '" name "' :on-success"))
                (conj seen option))))))))

;; --- Element tree parsing (component bodies) ---

(defn html-tag? [name: String] -> Bool
  (let [tags ["div" "span" "p" "h1" "h2" "h3" "h4" "h5" "h6"
              "button" "input" "form" "label" "textarea" "select" "option"
              "ul" "ol" "li" "a" "img" "section" "header" "footer" "nav" "main"
              "table" "tr" "td" "th" "thead" "tbody"]]
    (.includes tags name)))

;; An action form, e.g. (assert status "done") or (select uuid) — verb + args.
;; Args: symbols => prop/field refs, keywords => tags, else literals.
(defn parse-action [form: Any] -> Any
  (if (not (vector? form))
    (parse-error "event actions must be lists")
    nil)
  (if (= (count form) 0)
    (parse-error "event actions must not be empty")
    nil)
  (let [verb (require-symbol (nth form 0 nil) "event action")]
    (if (not (.includes ["assert" "set" "retract"] verb))
      (parse-error (str "unknown event action '" verb "'"))
      nil)
    (if (or (= verb "assert") (= verb "set"))
      (do
        (if (not (= (count form) 3))
          (parse-error
            (str "event action '" verb "' requires a field and value"))
          nil)
        (require-symbol
          (nth form 1 nil) (str "event action '" verb "' field")))
      (if (not (= (count form) 1))
        (parse-error "event action 'retract' accepts no arguments")
        nil))
    (let [args
          (mapv
            (fn [argument]
              (if (sym? argument)
                {"kind" "ref" "name" (sym-name argument)}
                (if (kw? argument)
                  {"kind" "tag" "name" (kw-name argument)}
                  {"kind" "literal" "value" argument})))
            (subvec form 1))]
      (ir/->IrAction verb args))))

(defn parse-element [form: Any] -> Any
  (if (not (vector? form))
    (parse-error "component child nodes must be lists")
    nil)
  (if (= (count form) 0)
    (parse-error "component child nodes must not be empty")
    nil)
  (let [tag (require-symbol (nth form 0 nil) "component child node")]
    (if (not (html-tag? tag))
      (parse-error (str "unknown component child node '" tag "'"))
      nil)
    (loop [index: Int 1 attrs: Any {} children: Any []]
      (if (>= index (count form))
        (ir/->IrElement tag attrs children)
        (if (kw? (nth form index))
          (let [raw-key (kw-name (nth form index))
                key (if (.startsWith raw-key ":") (subs raw-key 1) raw-key)
                value
                (require-option-value
                  form index (str "element '" tag "' attribute " raw-key))]
            (if (.includes (keys attrs) key)
              (parse-error
                (str "element '" tag "' repeats attribute " raw-key))
              nil)
            (recur
              (+ index 2)
              (assoc
                attrs
                key
                (if (.startsWith key "on-")
                  {"type" "action"
                   "event" (subs key 3)
                   "action" (parse-action value)}
                  (if (sym? value)
                    {"type" "bind" "prop" (sym-name value)}
                    (if (string? value)
                      {"type" "static" "value" value}
                      value))))
              children))
          (let [child (nth form index)]
            (if (not (vector? child))
              (parse-error
                (str "element '" tag "' has a non-list child"))
              nil)
            (let [child-head
                  (require-symbol
                    (nth child 0 nil) (str "element '" tag "' child"))
                  parsed
                  (if (= child-head "when")
                    (do
                      (if (< (count child) 3)
                        (parse-error
                          "when requires a property and at least one child")
                        nil)
                      (ir/->IrWhen
                        (require-symbol (nth child 1 nil) "when property")
                        (mapv parse-element (subvec child 2))))
                    (parse-element child))]
              (recur (+ index 1) attrs (conj children parsed)))))))))

;; --- Component parsing ---

(defn parse-component [form: Any] -> Any
  (let [name (require-symbol (nth form 1 nil) "component name")]
    (loop [i: Int 2
           props: (Vec String) []
           body: (Vec IrElement) []
           props-seen: Bool false]
      (if (>= i (count form))
        (ir/->IrComponent name props body)
        (if (kw? (nth form i))
          (if (kw= (nth form i) ":props")
            (do
              (if props-seen
                (parse-error (str "component '" name "' repeats :props"))
                nil)
              (recur
                (+ i 2)
                (symbol-vector
                  (require-option-value
                    form i (str "component '" name "' :props"))
                  (str "component '" name "' :props"))
                body
                true))
            (parse-error
              (str "unknown option on component '" name "': "
                   (kw-name (nth form i)))))
          (recur
            (+ i 1) props (conj body (parse-element (nth form i))) props-seen))))))

;; --- View parsing ---

(defn parse-tab [form: Any] -> Any
  (if (or (not (vector? form))
          (< (count form) 4)
          (not (sym= (nth form 0 nil) "tab")))
    (parse-error
      "view tabs must be (tab \"Label\" ENTITY REF-FIELD ...)")
    nil)
  (let [label (require-string (nth form 1 nil) "view tab label")
        entity-name (require-symbol (nth form 2 nil) "view tab entity")
        ref-field (require-symbol (nth form 3 nil) "view tab reference field")]
    (loop [i: Int 4
           filter: String? nil
           fields: (Vec String) []
           seen: (Vec String) []]
      (if (>= i (count form))
        (ir/->IrRelatedTab label entity-name ref-field filter fields)
        (let [option
              (require-keyword (nth form i nil) (str "view tab '" label "' option"))
              value
              (require-option-value form i (str "view tab '" label "' " option))]
          (if (not (.includes [":filter" ":fields"] option))
            (parse-error (str "unknown option on view tab '" label "': " option))
            nil)
          (if (.includes seen option)
            (parse-error (str "duplicate option " option " on view tab '" label "'"))
            nil)
          (if (= option ":filter")
            (recur
              (+ i 2)
              (require-string value (str "view tab '" label "' :filter"))
              fields
              (conj seen option))
            (recur
              (+ i 2)
              filter
              (symbol-vector value (str "view tab '" label "' :fields"))
              (conj seen option))))))))

(defn parse-view [form: Any] -> Any
  (let [name (require-symbol (nth form 1 nil) "view name")]
    (loop [i: Int 2
           entity: String? nil
           component: String? nil
           add-fields: (Vec String) []
           title: String? nil
           select: String? nil
           tabs: (Vec IrRelatedTab) []
           filters: (Vec String) []
           date-filters: (Vec String) []
           seen: (Vec String) []]
      (if (>= i (count form))
        (ir/->IrView name (or entity "") (or component "") add-fields (or title (titlecase (or entity name))) select tabs filters date-filters)
        (let [option
              (require-keyword (nth form i nil) (str "view '" name "' option"))]
          (if (not
                (.includes
                  [":entity" ":each" ":add-form" ":title" ":select"
                   ":tabs" ":filters" ":date-filters"]
                  option))
            (parse-error (str "unknown option on view '" name "': " option))
            nil)
          (if (.includes seen option)
            (parse-error (str "duplicate option " option " on view '" name "'"))
            nil)
          (if (= option ":tabs")
            (let [parsed-tabs
                  (loop [j: Int (+ i 1) result: (Vec IrRelatedTab) []]
                    (if (or (>= j (count form))
                            (not (and (vector? (nth form j))
                                      (> (count (nth form j)) 0)
                                      (sym= (first (nth form j)) "tab"))))
                      result
                      (recur (+ j 1) (conj result (parse-tab (nth form j))))))]
              (if (= (count parsed-tabs) 0)
                (parse-error (str "view '" name "' :tabs requires at least one tab"))
                nil)
              (recur
                (+ i 1 (count parsed-tabs))
                entity component add-fields title select parsed-tabs filters date-filters
                (conj seen option)))
            (let [value
                  (require-option-value form i (str "view '" name "' " option))]
              (cond
                (= option ":entity")
                  (recur
                    (+ i 2)
                    (require-symbol value (str "view '" name "' :entity"))
                    component add-fields title select tabs filters date-filters
                    (conj seen option))
                (= option ":each")
                  (recur
                    (+ i 2) entity
                    (require-symbol value (str "view '" name "' :each"))
                    add-fields title select tabs filters date-filters
                    (conj seen option))
                (= option ":add-form")
                  (recur
                    (+ i 2) entity component
                    (symbol-vector value (str "view '" name "' :add-form"))
                    title select tabs filters date-filters (conj seen option))
                (= option ":title")
                  (recur
                    (+ i 2) entity component add-fields
                    (require-string value (str "view '" name "' :title"))
                    select tabs filters date-filters (conj seen option))
                (= option ":select")
                  (recur
                    (+ i 2) entity component add-fields title
                    (require-symbol value (str "view '" name "' :select"))
                    tabs filters date-filters (conj seen option))
                (= option ":filters")
                  (recur
                    (+ i 2) entity component add-fields title select tabs
                    (symbol-vector value (str "view '" name "' :filters"))
                    date-filters (conj seen option))
                :else
                  (recur
                    (+ i 2) entity component add-fields title select tabs filters
                    (symbol-vector value (str "view '" name "' :date-filters"))
                    (conj seen option))))))))))

;; --- Router parsing ---

(defn parse-route-query [value: Any path: String] -> IrRouteQuery
  (if (sym? value)
    (ir/->IrRouteQuery (sym-name value) nil)
    (if (vec? value)
      (let [items (vec-items value)]
        (if (not (= (count items) 3))
          (parse-error
            (str "route '" path "' query binding must be [QUERY :as PREFIX]"))
          nil)
        (if (not (kw= (nth items 1 nil) ":as"))
          (parse-error
            (str "route '" path "' query binding accepts only :as"))
          nil)
        (ir/->IrRouteQuery
          (require-symbol (nth items 0 nil) (str "route '" path "' query"))
          (require-symbol (nth items 2 nil) (str "route '" path "' query prefix"))))
      (parse-error
        (str "route '" path "' :queries accepts QUERY or [QUERY :as PREFIX]")))))

(defn parse-route-entry [items: Any] -> IrRoute
  (if (< (count items) 2)
    (parse-error
      "route entries must begin with [ROUTE VIEW]")
    nil)
  (let [path (require-symbol (nth items 0 nil) "route name")
        view (require-symbol (nth items 1 nil) "route view")]
    (loop [i: Int 2
           queries: (Vec IrRouteQuery) []
           parameters: (Vec String) []
           seen: (Vec String) []]
      (if (>= i (count items))
        (ir/->IrRoute path view queries parameters parameters [])
        (let [option-value (nth items i nil)]
          (if (not (kw? option-value))
            (parse-error
              (str "route '" path "' expects :queries or :params at position " i))
            nil)
          (let [option (kw-name option-value)
                value (nth items (+ i 1) nil)]
            (if (.includes seen option)
              (parse-error (str "route '" path "' repeats " option))
              nil)
            (if (>= (+ i 1) (count items))
              (parse-error (str "route '" path "' " option " requires a value"))
              nil)
            (cond
              (= option ":queries")
                (let [names
                      (mapv
                        (fn [query] (parse-route-query query path))
                        (require-vector value (str "route '" path "' :queries")))]
                  (duplicate-name-error
                    (str "route '" path "' query")
                    (mapv (fn [query] (.-name query)) names))
                  (duplicate-name-error
                    (str "route '" path "' query prefix")
                    (filterv
                      some?
                      (mapv (fn [query] (.-prefix query)) names)))
                  (recur (+ i 2) names parameters (conj seen option)))
              (= option ":params")
                (let [names
                      (symbol-vector value (str "route '" path "' :params"))]
                  (duplicate-name-error
                    (str "route '" path "' parameter") names)
                  (recur (+ i 2) queries names (conj seen option)))
              :else
                (parse-error
                  (str "route '" path "' has unknown option " option)))))))))

(defn parse-routes [form: Any] -> Any
  (loop [i: Int 1
         dflt: String? nil
         routes: (Vec IrRoute) []
         default-seen: Bool false]
    (if (>= i (count form))
      (ir/->IrRouter (or dflt (if (> (count routes) 0) (.-view-name (nth routes 0)) "main")) routes)
      (if (kw= (nth form i) ":default")
        (do
          (if default-seen
            (parse-error "routes repeats :default")
            nil)
          (recur
            (+ i 2)
            (require-symbol
              (require-option-value form i "routes :default")
              "routes :default")
            routes
            true))
        (if (vec? (nth form i))
          (let [items (vec-items (nth form i))]
            (let [route (parse-route-entry items)]
              (recur
                (+ i 1) dflt
                (conj routes route)
                default-seen)))
          (parse-error
            (str "unknown routes form at position " i)))))))

;; --- Layout parsing ---

(defn parse-nav-group [form: Any] -> Any
  (if (or (not (vector? form))
          (not (= (count form) 3))
          (not (sym= (nth form 0 nil) "group")))
    (parse-error "layout groups must be (group \"Label\" [ITEMS...])")
    nil)
  (let [label (require-string (nth form 1 nil) "layout group label")
        items (symbol-vector (nth form 2 nil) (str "layout group '" label "' items"))]
    (ir/->IrNavGroup label items)))

(defn parse-layout [form: Any] -> Any
  (let [style (require-keyword (nth form 1 nil) "layout style")]
    (loop [i: Int 2
           title: String? nil
           groups: (Vec IrNavGroup) []
           seen: (Vec String) []]
      (if (>= i (count form))
        (ir/->IrLayout (if (.startsWith style ":") (subs style 1) style) title groups)
        (let [option
              (require-keyword (nth form i nil) "layout option")]
          (if (not (.includes [":title" ":groups"] option))
            (parse-error (str "unknown option on layout: " option))
            nil)
          (if (.includes seen option)
            (parse-error (str "duplicate option " option " on layout"))
            nil)
          (if (= option ":title")
            (recur
              (+ i 2)
              (require-string
                (require-option-value form i "layout :title")
                "layout :title")
              groups
              (conj seen option))
            (let [group-forms (subvec form (+ i 1))]
              (if (= (count group-forms) 0)
                (parse-error "layout :groups requires at least one group")
                nil)
              (ir/->IrLayout
                (if (.startsWith style ":") (subs style 1) style)
                title
                (mapv parse-nav-group group-forms)))))))))

;; --- Top-level dispatcher ---

(defn source-position [src: String offset: Int] -> Any
  (loop [index: Int 0 line: Int 1 column: Int 1]
    (if (>= index offset)
      [line column]
      (if (= (.charCodeAt src index) 10)
        (recur (+ index 1) (+ line 1) 1)
        (recur (+ index 1) line (+ column 1))))))

(defn source-span
  [src: String
   source-id: String
   parsed-span: Any] -> SourceSpan
  (let [start (.-start parsed-span)
        end (.-end parsed-span)
        start-position (source-position src start)
        end-position (source-position src end)]
    (ir/->SourceSpan
      source-id
      start
      end
      (nth start-position 0)
      (nth start-position 1)
      (nth end-position 0)
      (nth end-position 1))))

(defn parse-namespace [form: Any] -> String
  (if (not (= (count form) 2))
    (parse-error "namespace must be declared as (ns NAME)")
    nil)
  (require-symbol (nth form 1 nil) "namespace"))

(defn parse-form
  [source-form: Any
   source-unit: IrSourceUnit
   src: String] -> ParseResult
  (let [form (.-value source-form)
        span (source-span src (.-source-id source-unit) (.-span source-form))
        provenance (ir/->IrProvenance source-unit span)]
    (if (not (vector? form))
      (parse-error "top-level source forms must be lists")
      nil)
    (if (= (count form) 0)
      (parse-error "top-level source forms must not be empty")
      nil)
    (let [head (nth form 0)]
      (if (not (sym? head))
        (parse-error "top-level source forms must start with a symbol")
        nil)
      (let [form-name (sym-name head)]
        (cond
          (= form-name "application")
            (let [value (parse-application form span)]
              (->ParseResult
                "application" (.-id value) value provenance))
          (= form-name "use")
            (let [value (parse-use form span)]
              (->ParseResult "use" (.-alias value) value provenance))
          (= form-name "provider")
            (let [value (parse-provider form span)]
              (->ParseResult "provider" (.-name value) value provenance))
          (= form-name "value-type")
            (let [value (value-type/parse-value-type form)]
              (->ParseResult "value-type" (get value "name") value provenance))
          (= form-name "provider-port")
            (let [value (value-type/parse-provider-port form)]
              (->ParseResult "provider-port" (get value "name") value provenance))
          (= form-name "extend")
            (let [value (parse-extend form span)]
              (->ParseResult "extend" (.-port value) value provenance))
          (= form-name "fill")
            (let [value (parse-fill form span)]
              (->ParseResult "fill" (.-port value) value provenance))
          (= form-name "mount")
            (let [value (parse-mount form span)]
              (->ParseResult "mount" (.-port value) value provenance))
          (= form-name "entity")
            (let [value (parse-entity form)]
              (->ParseResult "entity" (.-name value) value provenance))
          (= form-name "backend")
            (let [value (parse-backend form)]
              (->ParseResult "backend" (.-kind value) value provenance))
          (= form-name "persist")
            (let [value (parse-persist form)]
              (->ParseResult "persist" (.-storage value) value provenance))
          (= form-name "theme")
            (->ParseResult "theme" "theme" (parse-theme-colors form) provenance)
          (= form-name "defstate")
            (let [value (parse-defstate form)]
              (->ParseResult "defstate" (.-name value) value provenance))
          (= form-name "publication")
            (let [value (parse-publication form)]
              (->ParseResult "publication" (.-name value) value provenance))
          (= form-name "query")
            (let [value (parse-query form)]
              (->ParseResult "query" (.-name value) value provenance))
          (= form-name "command")
            (let [value (command/parse-command form)]
              (->ParseResult "command" (get value "name") value provenance))
          (= form-name "list-detail")
            (let [value (parse-list-detail form)]
              (->ParseResult "list-detail" (.-entity-name value) value provenance))
          (= form-name "form")
            (let [value (parse-smart-form form)]
              (->ParseResult "form" (.-name value) value provenance))
          (= form-name "component")
            (let [value (parse-component form)]
              (->ParseResult "component" (.-name value) value provenance))
          (= form-name "view")
            (let [value (parse-view form)]
              (->ParseResult "view" (.-name value) value provenance))
          (= form-name "routes")
            (->ParseResult "routes" "routes" (parse-routes form) provenance)
          (= form-name "layout")
            (->ParseResult "layout" "layout" (parse-layout form) provenance)
          (= form-name "ns")
            (let [value (parse-namespace form)]
              (->ParseResult "ns" value value provenance))
          (= form-name "require")
            (parse-error
              "legacy require is unsupported; import a locked plugin with use")
          :else
            (parse-error
              (str "unknown top-level form (" form-name " ...)")))))))

;; --- Entry point ---

(defn validate-program
  [ns-name: Any
   ns-count: Int
   applications: Any
   uses: Any
   backends: Any
   persists: Any
   entities: Any
   defstates: Any] -> Any
  (if (nil? ns-name) (parse-error "missing (ns ...) declaration") nil)
  (if (> ns-count 1) (parse-error "multiple namespace declarations") nil)
  (if (> (count applications) 1)
    (parse-error "multiple application declarations") nil)
  (if (> (count backends) 1)
    (parse-error "multiple backend declarations") nil)
  (if (> (count persists) 1)
    (parse-error "multiple persist declarations") nil)
  (if (and (= (count entities) 0) (= (count uses) 0))
    (parse-error "no entity declarations found") nil)
  (duplicate-name-error
    "plugin package ID"
    (mapv (fn [use] (.-package-id use)) uses))
  (duplicate-name-error
    "plugin import alias"
    (mapv (fn [use] (.-alias use)) uses))
  (reduce
    (fn [seen entity-name]
      (if (.includes seen entity-name)
        (parse-error (str "duplicate entity '" entity-name "'"))
        (conj seen entity-name)))
    []
    (mapv (fn [entity] (.-name entity)) entities))
  (reduce
    (fn [seen state-name]
      (if (.includes seen state-name)
        (parse-error (str "duplicate defstate '" state-name "'"))
        (conj seen state-name)))
    []
    (mapv (fn [state] (.-name state)) defstates))
  nil)

(defn parse-program-resolved-at
  [src: String
   source-path: String
   package-id: String
   package-version: String
   references: Any] -> Any
  (let [source-id (str package-id ":" source-path)
        source-unit
        (ir/->IrSourceUnit
          source-id source-path package-id package-version)
        top-forms
        (config-reference/resolve-source-forms
          (sexpr/parse-all src) references)
        parsed
        (mapv
          (fn [source-form]
            (parse-form source-form source-unit src))
          top-forms)]
    (let [ns-form   (first (filterv (fn [p] (= (.-type p) "ns")) parsed))
          ns-count  (count (filterv (fn [p] (= (.-type p) "ns")) parsed))
          applications (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "application")) parsed))
          uses      (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "use")) parsed))
          providers (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "provider")) parsed))
          value-types (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "value-type")) parsed))
          provider-ports (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "provider-port")) parsed))
          extends   (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "extend")) parsed))
          fills     (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "fill")) parsed))
          mounts    (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "mount")) parsed))
          backends  (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "backend")) parsed))
          entities  (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "entity")) parsed))
          persists  (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "persist")) parsed))
          defstates (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "defstate")) parsed))
          publications (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "publication")) parsed))
          queries   (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "query")) parsed))
          commands  (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "command")) parsed))
          lds       (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "list-detail")) parsed))
          smart-forms (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "form")) parsed))
          theme     (first (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "theme")) parsed)))
          components (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "component")) parsed))
          views     (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "view")) parsed))
          router    (first (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "routes")) parsed)))
          layout    (first (mapv (fn [p] (.-value p)) (filterv (fn [p] (= (.-type p) "layout")) parsed)))
          declaration-provenance
          (mapv
            (fn [result]
              (ir/->IrDeclarationProvenance
                (.-type result)
                (.-name result)
                (.-provenance result)))
            parsed)
          ns-name   (if (nil? ns-form) nil (.-value ns-form))
          application (first applications)
          backend   (first backends)
          persist   (first persists)]
      (validate-program
        ns-name ns-count applications uses backends persists entities defstates)
      (duplicate-name-error
        "value-type"
        (mapv (fn [value-type] (get value-type "name")) value-types))
      (duplicate-name-error
        "provider-port"
        (mapv (fn [provider-port] (get provider-port "name")) provider-ports))
      (ir/->IrProgram
        source-unit application uses providers value-types provider-ports extends fills mounts
        declaration-provenance
        (or ns-name "wake.app")
        backend entities persist defstates publications queries commands lds smart-forms theme components views
        router layout))))

(defn parse-program-at
  [src: String
   source-path: String
   package-id: String
   package-version: String] -> Any
  (parse-program-resolved-at
    src source-path package-id package-version nil))

(defn parse-program-configured-at
  [src: String
   source-path: String
   package-id: String
   package-version: String
   references: Any] -> Any
  (parse-program-resolved-at
    src source-path package-id package-version references))

(defn parse-program [src: String] -> Any
  (parse-program-at src "<memory>" "application" ""))
