#!/usr/bin/env bash
set -euo pipefail

wake_web="$(cd "$(dirname "$0")/.." && pwd)"
playwright="$wake_web/node_modules/.bin/playwright"

if [[ ! -x "$playwright" ]]; then
  echo "wake-browser-test: Playwright is not installed; run npm install in $wake_web" >&2
  exit 1
fi

fixture_dir="$(mktemp -d "${TMPDIR:-/tmp}/wake-browser.XXXXXX")"
trap 'rm -rf "${fixture_dir:?}"' EXIT

"$wake_web/bin/wake-compile" \
  "$wake_web/demo/crm-v2.wake" "$fixture_dir/crm.js" &
crm_pid=$!
"$wake_web/bin/wake-compile" \
  "$wake_web/demo/todo.wake" "$fixture_dir/todo.js" &
todo_pid=$!
"$wake_web/bin/wake-compile" \
  "$wake_web/demo/tracker.wake" "$fixture_dir/tracker.js" &
tracker_pid=$!
"$wake_web/bin/wake-compile" \
  "$wake_web/demo/wiki.wake" "$fixture_dir/wiki.js" &
wiki_pid=$!

build_status=0
for build_pid in "$crm_pid" "$todo_pid" "$tracker_pid" "$wiki_pid"; do
  wait "$build_pid" || build_status=1
done
if [[ "$build_status" -ne 0 ]]; then
  echo "wake-browser-test: fixture compilation failed" >&2
  exit 1
fi

node --check "$fixture_dir/crm.js"
node --check "$fixture_dir/todo.js"
node --check "$fixture_dir/tracker.js"
node --check "$fixture_dir/wiki.js"

if [[ -z "${WAKE_BROWSER_PORT:-}" ]]; then
  WAKE_BROWSER_PORT="$(
    node --input-type=module -e '
      import { createServer } from "node:net";
      const probe = createServer();
      probe.listen(0, "127.0.0.1", () => {
        const address = probe.address();
        if (!address || typeof address === "string") {
          process.exitCode = 1;
        } else {
          process.stdout.write(String(address.port));
        }
        probe.close();
      });
    '
  )"
fi
if [[ ! "$WAKE_BROWSER_PORT" =~ ^[0-9]+$ ]] ||
   (( WAKE_BROWSER_PORT <= 1024 ||
      WAKE_BROWSER_PORT == 8080 ||
      WAKE_BROWSER_PORT > 65535 )); then
  echo "wake-browser-test: WAKE_BROWSER_PORT must be a non-default high port" >&2
  exit 1
fi
export WAKE_BROWSER_PORT
echo "wake-browser-test: browser port $WAKE_BROWSER_PORT"

cd "$wake_web"
WAKE_BROWSER_FIXTURES="$fixture_dir" \
  "$playwright" test \
    tests/crm-js.spec.ts \
    tests/fram-connector.spec.ts \
    tests/todo-component.spec.ts \
    tests/tracker.spec.ts \
    tests/webdev.spec.ts \
    tests/wiki-fram.spec.ts
