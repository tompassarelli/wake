#!/usr/bin/env bash
# wake-compile: compile .bjs sources and wire them as ES modules.
# Compiler modules are staged privately for this invocation, then discarded.
#
# Usage:
#   bin/wake-compile                           # verify all compiler modules build
#   bin/wake-compile FILE [OUT]                # emit direct-DOM JavaScript
#   bin/wake-compile --fram FILE [OUT]         # emit a FRAM plan as JSON
#   bin/wake-compile --all FILE [OUT_DIR]      # emit app.js and app.fram.json

set -euo pipefail

wake_root="$(cd "$(dirname "$0")/.." && pwd)"
compiler="$wake_root/compiler"

BEAGLE_ROOT="${BEAGLE_ROOT:-$HOME/code/beagle/main}"
BEAGLE_BUILD="${BEAGLE_BUILD:-$BEAGLE_ROOT/bin/beagle-build}"
BEAGLE_RUNTIME_DIR="${BEAGLE_RUNTIME_DIR:-$BEAGLE_ROOT/beagle-lib/lib/beagle}"

if ! command -v bun >/dev/null; then
  echo "wake-compile: Bun is not installed" >&2
  exit 1
fi
if [[ ! -x "$BEAGLE_BUILD" ]]; then
  echo "wake-compile: Beagle builder not found at $BEAGLE_BUILD" >&2
  echo "wake-compile: set BEAGLE_ROOT or BEAGLE_BUILD to a Beagle checkout" >&2
  exit 1
fi

for runtime_module in core.js hamt.js; do
  if [[ ! -f "$BEAGLE_RUNTIME_DIR/$runtime_module" ]]; then
    echo "wake-compile: Beagle runtime module not found: $BEAGLE_RUNTIME_DIR/$runtime_module" >&2
    exit 1
  fi
done

# Beagle's JS runtime stays beside the compiled modules. A relative prefix makes
# the generated imports resolvable by Bun without a global package install.
compile() {
  local source="$1" output="$2"
  BEAGLE_JS_RUNTIME_PREFIX='./beagle/' \
    "$BEAGLE_BUILD" "$source" "$output" >/dev/null
}
echo "using Beagle builder at $BEAGLE_BUILD" >&2

staging_dir="$(mktemp -d "${TMPDIR:-/tmp}/wake-compile.XXXXXX")"
trap 'rm -rf "${staging_dir:?}"' EXIT
dist="$staging_dir/dist"

mkdir -p "$dist"
cp "$wake_root/package.json" "$staging_dir/package.json"
mkdir -p "$dist/beagle"
cp "$BEAGLE_RUNTIME_DIR/core.js" "$dist/beagle/core.js"
cp "$BEAGLE_RUNTIME_DIR/hamt.js" "$dist/beagle/hamt.js"

# Step 1: compile each .bjs → .js
modules=(sexpr ir graph reader ui js-ast emit-fram codegen)
for mod in "${modules[@]}"; do
  echo "compiling $mod.bjs..." >&2
  compile "$compiler/$mod.bjs" "$dist/$mod.js.tmp"
done

# Step 2: add exports to modules that have none

# sexpr.js — export parse_all
{
  cat "$dist/sexpr.js.tmp"
  echo ""
  echo "export { parse_all };"
} > "$dist/sexpr.js"

# ir.js — export all constructors
{
  cat "$dist/ir.js.tmp"
  echo ""
  grep -oP '(?<=^function )\w+' "$dist/ir.js.tmp" | \
    paste -sd, | \
    sed 's/^/export { /; s/$/ };/'
} > "$dist/ir.js"

# graph.js — fix imports, add export
{
  sed "s|from './wake/ir.js';|from './ir.js';|" \
    "$dist/graph.js.tmp"
  echo ""
  echo "export { check_program, strip_colon, capitalize, titlecase, GField, GEntity, FkEdge, StateMachine, PublicationPolicy, CheckedGraph };"
} > "$dist/graph.js"

# ui.js — export expand_list_detail
{
  cat "$dist/ui.js.tmp"
  echo ""
  echo "export { expand_list_detail, UiFieldInfo, UiRelated, UiForm, UiGraph, UiComponent, UiBind, UiQuery, UiEach, UiWhen, UiAction, UiElement, UiText, UiStore, UiState };"
} > "$dist/ui.js"

# js-ast.js — export all functions
{
  cat "$dist/js-ast.js.tmp"
  echo ""
  grep -oP '(?<=^function )\w+' "$dist/js-ast.js.tmp" | \
    paste -sd, | \
    sed 's/^/export { /; s/$/ };/'
} > "$dist/js-ast.js"

# reader.js — fix imports, add export
{
  sed "s|from './wake/sexpr.js';|from './sexpr.js';|; s|from './wake/ir.js';|from './ir.js';|" \
    "$dist/reader.js.tmp"
  echo ""
  echo "export { parse_program };"
} > "$dist/reader.js"

# emit-fram.js — fix imports; js/export in source owns the public export
sed "s|from './wake/graph.js';|from './graph.js';|" \
  "$dist/emit-fram.js.tmp" > "$dist/emit-fram.js"

# codegen.js — fix imports, add export
{
  sed "s|from './wake/ir.js';|from './ir.js';|; s|from './wake/graph.js';|from './graph.js';|; s|from './wake/ui.js';|from './ui.js';|" \
    "$dist/codegen.js.tmp"
  echo ""
  echo "export { gen_program_bang };"
} > "$dist/codegen.js"

echo "compiler modules built" >&2

# Step 3: emit target(s)
emit_js() {
  local src="$1" out="$2"
  WAKE_COMPILE_SOURCE="$src" WAKE_COMPILE_DIST="$dist" \
    bun --no-install --eval '
const dist = process.env.WAKE_COMPILE_DIST;
const distUrl = Bun.pathToFileURL(`${dist}/`);
const { parse_program } = await import(new URL("reader.js", distUrl).href);
const { gen_program_bang } = await import(new URL("codegen.js", distUrl).href);
const source = await Bun.file(process.env.WAKE_COMPILE_SOURCE).text();
const prog = parse_program(source);
await Bun.write(Bun.stdout, gen_program_bang(prog));
' > "$out"
}

emit_fram() {
  local src="$1" out="$2"
  WAKE_COMPILE_SOURCE="$src" WAKE_COMPILE_DIST="$dist" \
    bun --no-install --eval '
const dist = process.env.WAKE_COMPILE_DIST;
const distUrl = Bun.pathToFileURL(`${dist}/`);
const { parse_program } = await import(new URL("reader.js", distUrl).href);
const { gen_fram } = await import(new URL("emit-fram.js", distUrl).href);
const source = await Bun.file(process.env.WAKE_COMPILE_SOURCE).text();
const prog = parse_program(source);
await Bun.write(Bun.stdout, gen_fram(prog));
' > "$out"
}

usage() {
  sed -n '/^# Usage:/,/^$/p' "$0" >&2
  exit 2
}

if [[ $# -ge 1 && "$1" == "--all" ]]; then
  [[ $# -ge 2 && $# -le 3 ]] || usage
  shift
  wake_file="$1"
  out_dir="${2:-.}"
  mkdir -p "$out_dir"
  emit_js "$wake_file" "$out_dir/app.js"
  emit_fram "$wake_file" "$out_dir/app.fram.json"
  "$wake_root/bin/wake-lint-output" "$out_dir/app.js" >&2
  echo "$wake_file -> $out_dir/ (app.js + app.fram.json)" >&2
elif [[ $# -ge 1 && "$1" == "--fram" ]]; then
  [[ $# -ge 2 && $# -le 3 ]] || usage
  shift; emit_fram "$1" "${2:-/dev/stdout}"
  if [[ -n "${2:-}" ]]; then
    echo "$1 -> $2 (FRAM plan)" >&2
  fi
elif [[ $# -ge 1 && "$1" == --* ]]; then
  echo "wake-compile: unknown option '$1'" >&2
  usage
elif [[ $# -ge 1 ]]; then
  [[ $# -le 2 ]] || usage
  emit_js "$1" "${2:-/dev/stdout}"
  if [[ -n "${2:-}" ]]; then
    echo "$1 -> $2" >&2
  fi
fi
