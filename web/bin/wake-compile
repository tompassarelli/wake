#!/usr/bin/env bash
# wake-compile: build the Beagle compiler modules, then run the Bun delivery
# driver. Plugins are resolved only from the source-adjacent wake.lock.
#
# Usage:
#   bin/wake-compile                           # verify all compiler modules build
#   bin/wake-compile FILE [OUT]                # emit direct-DOM JavaScript
#   bin/wake-compile --store FILE [OUT]         # emit a Store plan as JSON
#   bin/wake-compile --all FILE [OUT_DIR]      # emit the deployment artifact set

set -euo pipefail

wake_root="$(cd "$(dirname "$0")/.." && pwd)"
compiler="$wake_root/wake"
driver="$wake_root/compiler"

BEAGLE_ROOT="${BEAGLE_ROOT:-$HOME/code/beagle/main}"
BEAGLE_BUILD="${BEAGLE_BUILD:-$BEAGLE_ROOT/bin/beagle-build}"
BEAGLE="${BEAGLE:-$BEAGLE_ROOT/bin/beagle}"
BEAGLE_RUNTIME_DIR="${BEAGLE_RUNTIME_DIR:-$BEAGLE_ROOT/beagle-lib/lib/beagle}"
BEAGLE_MODULE_ROOT=(--module-root "web=$wake_root")

if ! command -v bun >/dev/null; then
  echo "wake-compile: Bun is not installed" >&2
  exit 1
fi
if [[ ! -x "$BEAGLE_BUILD" ]]; then
  echo "wake-compile: Beagle builder not found at $BEAGLE_BUILD" >&2
  echo "wake-compile: set BEAGLE_ROOT or BEAGLE_BUILD to a Beagle checkout" >&2
  exit 1
fi

for runtime_module in core.js hamt.js; do
  if [[ ! -f "$BEAGLE_RUNTIME_DIR/$runtime_module" ]]; then
    echo "wake-compile: Beagle runtime module not found: $BEAGLE_RUNTIME_DIR/$runtime_module" >&2
    exit 1
  fi
done

# Beagle's JS runtime stays beside the compiled modules. A relative prefix makes
# the generated imports resolvable by Bun without a global package install.
compile() {
  local source="$1" output="$2"
  local module="$(basename "$source" .bjs)"
  local cached="$compile_cache_dir/$module.js"
  if [[ ! -f "$cached" ]]; then
    local temporary="$compile_cache_dir/$module.$$.tmp"
    BEAGLE_JS_RUNTIME_PREFIX='./beagle/' \
      "$BEAGLE_BUILD" "${BEAGLE_MODULE_ROOT[@]}" "$source" "$temporary" >/dev/null
    mv -f "$temporary" "$cached"
  fi
  cp "$cached" "$output"
}

append_function_exports() {
  local source="$1" output="$2" names
  names="$(grep -oP '(?<=^function )\w+' "$source" | paste -sd, || true)"
  {
    cat "$source"
    if [[ -n "$names" ]]; then
      echo
      echo "export { $names };"
    fi
  } > "$output"
}

echo "using Beagle builder at $BEAGLE_BUILD" >&2

staging_dir="$(mktemp -d "${TMPDIR:-/tmp}/wake-compile.XXXXXX")"
trap 'rm -rf "${staging_dir:?}"' EXIT
dist="$staging_dir/dist"

compile_cache_root="${WAKE_COMPILE_CACHE:-${TMPDIR:-/tmp}/wake-compile-cache}"
mkdir -p "$compile_cache_root"
compile_cache_key="$({
  printf '%s\n' "$BEAGLE_BUILD" "$BEAGLE_RUNTIME_DIR"
  sha256sum "$BEAGLE_BUILD" "$BEAGLE_RUNTIME_DIR/core.js" "$BEAGLE_RUNTIME_DIR/hamt.js" "$compiler"/*.bjs
} | sha256sum | cut -d' ' -f1)"
compile_cache_dir="$compile_cache_root/$compile_cache_key"
mkdir -p "$compile_cache_dir"

mkdir -p "$dist/beagle"
cp "$wake_root/package.json" "$staging_dir/package.json"
cp "$BEAGLE_RUNTIME_DIR/core.js" "$dist/beagle/core.js"
cp "$BEAGLE_RUNTIME_DIR/hamt.js" "$dist/beagle/hamt.js"

modules=(ir graph ui js-ast emit-store codegen)
for mod in "${modules[@]}"; do
  echo "compiling $mod.bjs..." >&2
  compile "$compiler/$mod.bjs" "$dist/$mod.js.tmp"
done

append_function_exports "$dist/ir.js.tmp" "$dist/ir.js"

sed "s|from './wake/ir.js';|from './ir.js';|" \
  "$dist/graph.js.tmp" > "$dist/graph.js.imports"
append_function_exports "$dist/graph.js.imports" "$dist/graph.js"

append_function_exports "$dist/ui.js.tmp" "$dist/ui.js"
append_function_exports "$dist/js-ast.js.tmp" "$dist/js-ast.js"

# emit-store owns its public js/export declaration in source.
sed "s|from './wake/graph.js';|from './graph.js';|" \
  "$dist/emit-store.js.tmp" > "$dist/emit-store.js"

{
  sed "s|from './wake/ir.js';|from './ir.js';|; s|from './wake/graph.js';|from './graph.js';|; s|from './wake/ui.js';|from './ui.js';|" \
    "$dist/codegen.js.tmp"
  echo
  echo "export { gen_program_bang };"
} > "$dist/codegen.js"

echo "compiler modules built" >&2

usage() {
  sed -n '/^# Usage:/,/^$/p' "$0" >&2
  exit 2
}

run_driver() {
  local mode="$1" source="$2" output="$3"
  local absolute_source
  absolute_source="$(realpath "$source")"
  local source_hash
  source_hash="$(sha256sum "$absolute_source" | cut -d' ' -f1)"
  local artifact_cache_key
  artifact_cache_key="$(printf '%s\n%s\n' "$mode" "$source_hash" | sha256sum | cut -d' ' -f1)"
  local artifact_cache_dir="$compile_cache_dir/artifacts/$artifact_cache_key"
  if [[ "$mode" == "all" && -f "$artifact_cache_dir/app.js" ]]; then
    for artifact in app.js wake-client.js app.store.json app.wake.manifest.json app.wake.deployment.json; do
      cp "$artifact_cache_dir/$artifact" "$output/$artifact"
    done
    return
  fi
  if [[ "$mode" == "store" && "$output" != "-" && -f "$artifact_cache_dir/app.store.json" ]]; then
    cp "$artifact_cache_dir/app.store.json" "$output"
    return
  fi
  if [[ "$mode" == "js" && "$output" != "-" && -f "$artifact_cache_dir/app.js" ]]; then
    cp "$artifact_cache_dir/app.js" "$output"
    return
  fi
  BEAGLE="$BEAGLE" BEAGLE_ROOT="$BEAGLE_ROOT" \
    bun --no-install "$driver/compile-driver.mjs" \
    --dist "$dist" \
    --mode "$mode" \
    --source "$absolute_source" \
    --output "$output"
  mkdir -p "$artifact_cache_dir"
  if [[ "$mode" == "all" ]]; then
    for artifact in app.js wake-client.js app.store.json app.wake.manifest.json app.wake.deployment.json; do
      cp "$output/$artifact" "$artifact_cache_dir/$artifact"
    done
  elif [[ "$output" != "-" ]]; then
    local artifact_name="app.js"
    if [[ "$mode" == "store" ]]; then artifact_name="app.store.json"; fi
    cp "$output" "$artifact_cache_dir/$artifact_name"
  fi
}

if [[ $# -ge 1 && "$1" == "--all" ]]; then
  [[ $# -ge 2 && $# -le 3 ]] || usage
  wake_file="$2"
  out_dir="${3:-.}"
  mkdir -p "$out_dir"
  out_dir="$(realpath "$out_dir")"
  run_driver all "$wake_file" "$out_dir"
  "$wake_root/bin/wake-lint-output" "$out_dir/app.js" >&2
  "$wake_root/bin/wake-lint-output" "$out_dir/wake-client.js" >&2
  echo "$wake_file -> $out_dir/ (wake-client.js + app.js + app.store.json + app.wake.manifest.json + app.wake.deployment.json)" >&2
elif [[ $# -ge 1 && "$1" == "--store" ]]; then
  [[ $# -ge 2 && $# -le 3 ]] || usage
  run_driver store "$2" "${3:--}"
  if [[ -n "${3:-}" ]]; then
    echo "$2 -> $3 (Store plan)" >&2
  fi
elif [[ $# -ge 1 && "$1" == --* ]]; then
  echo "wake-compile: unknown option '$1'" >&2
  usage
elif [[ $# -ge 1 ]]; then
  [[ $# -le 2 ]] || usage
  run_driver js "$1" "${2:--}"
  if [[ -n "${2:-}" ]]; then
    echo "$1 -> $2" >&2
  fi
fi
