#!/usr/bin/env bash
# wake-compile: build the Beagle compiler modules, then run the Bun delivery
# driver. Plugins are resolved only from the source-adjacent wake.lock.
#
# Usage:
#   bin/wake-compile                           # verify all compiler modules build
#   bin/wake-compile FILE [OUT]                # emit direct-DOM JavaScript
#   bin/wake-compile --fram FILE [OUT]         # emit a FRAM plan as JSON
#   bin/wake-compile --all FILE [OUT_DIR]      # emit the deployment artifact set

set -euo pipefail

wake_root="$(cd "$(dirname "$0")/.." && pwd)"
compiler="$wake_root/compiler"

BEAGLE_ROOT="${BEAGLE_ROOT:-$HOME/code/beagle/main}"
BEAGLE_BUILD="${BEAGLE_BUILD:-$BEAGLE_ROOT/bin/beagle-build}"
BEAGLE_AST="${BEAGLE_AST:-$BEAGLE_ROOT/bin/beagle-ast}"
BEAGLE_RUNTIME_DIR="${BEAGLE_RUNTIME_DIR:-$BEAGLE_ROOT/beagle-lib/lib/beagle}"

if ! command -v bun >/dev/null; then
  echo "wake-compile: Bun is not installed" >&2
  exit 1
fi
if [[ ! -x "$BEAGLE_BUILD" ]]; then
  echo "wake-compile: Beagle builder not found at $BEAGLE_BUILD" >&2
  echo "wake-compile: set BEAGLE_ROOT or BEAGLE_BUILD to a Beagle checkout" >&2
  exit 1
fi

for runtime_module in core.js hamt.js; do
  if [[ ! -f "$BEAGLE_RUNTIME_DIR/$runtime_module" ]]; then
    echo "wake-compile: Beagle runtime module not found: $BEAGLE_RUNTIME_DIR/$runtime_module" >&2
    exit 1
  fi
done

# Beagle's JS runtime stays beside the compiled modules. A relative prefix makes
# the generated imports resolvable by Bun without a global package install.
compile() {
  local source="$1" output="$2"
  BEAGLE_JS_RUNTIME_PREFIX='./beagle/' \
    "$BEAGLE_BUILD" "$source" "$output" >/dev/null
}

append_function_exports() {
  local source="$1" output="$2" names
  names="$(grep -oP '(?<=^function )\w+' "$source" | paste -sd, || true)"
  {
    cat "$source"
    if [[ -n "$names" ]]; then
      echo
      echo "export { $names };"
    fi
  } > "$output"
}

echo "using Beagle builder at $BEAGLE_BUILD" >&2

staging_dir="$(mktemp -d "${TMPDIR:-/tmp}/wake-compile.XXXXXX")"
trap 'rm -rf "${staging_dir:?}"' EXIT
dist="$staging_dir/dist"

mkdir -p "$dist/beagle"
cp "$wake_root/package.json" "$staging_dir/package.json"
cp "$BEAGLE_RUNTIME_DIR/core.js" "$dist/beagle/core.js"
cp "$BEAGLE_RUNTIME_DIR/hamt.js" "$dist/beagle/hamt.js"

modules=(sexpr config-reference command value-type ir graph reader ui js-ast emit-fram codegen)
for mod in "${modules[@]}"; do
  echo "compiling $mod.bjs..." >&2
  compile "$compiler/$mod.bjs" "$dist/$mod.js.tmp"
done

{
  cat "$dist/sexpr.js.tmp"
  echo
  echo "export { parse_all };"
} > "$dist/sexpr.js"

append_function_exports "$dist/ir.js.tmp" "$dist/ir.js"
append_function_exports \
  "$dist/config-reference.js.tmp" "$dist/config-reference.js"
append_function_exports "$dist/command.js.tmp" "$dist/command.js"
append_function_exports "$dist/value-type.js.tmp" "$dist/value-type.js"

sed "s|from './wake/ir.js';|from './ir.js';|" \
  "$dist/graph.js.tmp" > "$dist/graph.js.imports"
append_function_exports "$dist/graph.js.imports" "$dist/graph.js"

append_function_exports "$dist/ui.js.tmp" "$dist/ui.js"
append_function_exports "$dist/js-ast.js.tmp" "$dist/js-ast.js"

{
  sed "s|from './wake/sexpr.js';|from './sexpr.js';|; s|from './wake/config-reference.js';|from './config-reference.js';|; s|from './wake/command.js';|from './command.js';|; s|from './wake/value-type.js';|from './value-type.js';|; s|from './wake/ir.js';|from './ir.js';|" \
    "$dist/reader.js.tmp"
  echo
  echo "export { parse_program, parse_program_at, parse_program_configured_at };"
} > "$dist/reader.js"

# emit-fram owns its public js/export declaration in source.
sed "s|from './wake/graph.js';|from './graph.js';|" \
  "$dist/emit-fram.js.tmp" > "$dist/emit-fram.js"

{
  sed "s|from './wake/ir.js';|from './ir.js';|; s|from './wake/graph.js';|from './graph.js';|; s|from './wake/ui.js';|from './ui.js';|" \
    "$dist/codegen.js.tmp"
  echo
  echo "export { gen_program_bang };"
} > "$dist/codegen.js"

echo "compiler modules built" >&2

usage() {
  sed -n '/^# Usage:/,/^$/p' "$0" >&2
  exit 2
}

run_driver() {
  local mode="$1" source="$2" output="$3"
  local absolute_source ast_path
  absolute_source="$(realpath "$source")"
  if head -n 1 "$absolute_source" | grep -Eq '^#lang[[:space:]]+beagle(/js)?[[:space:]]*$'; then
    if [[ ! -x "$BEAGLE_AST" ]]; then
      echo "wake-compile: Beagle checked-AST projector not found at $BEAGLE_AST" >&2
      exit 1
    fi
    ast_path="$staging_dir/application.ast.json"
    "$BEAGLE_AST" "$absolute_source" > "$ast_path"
    bun --no-install "$compiler/compile-driver.mjs" \
      --dist "$dist" \
      --mode "$mode" \
      --source "$absolute_source" \
      --output "$output" \
      --ast "$ast_path"
  else
    bun --no-install "$compiler/compile-driver.mjs" \
      --dist "$dist" \
      --mode "$mode" \
      --source "$absolute_source" \
      --output "$output"
  fi
}

if [[ $# -ge 1 && "$1" == "--all" ]]; then
  [[ $# -ge 2 && $# -le 3 ]] || usage
  wake_file="$2"
  out_dir="${3:-.}"
  mkdir -p "$out_dir"
  out_dir="$(realpath "$out_dir")"
  run_driver all "$wake_file" "$out_dir"
  "$wake_root/bin/wake-lint-output" "$out_dir/app.js" >&2
  "$wake_root/bin/wake-lint-output" "$out_dir/wake-client.js" >&2
  echo "$wake_file -> $out_dir/ (wake-client.js + app.js + app.fram.json + app.wake.manifest.json + app.wake.deployment.json)" >&2
elif [[ $# -ge 1 && "$1" == "--fram" ]]; then
  [[ $# -ge 2 && $# -le 3 ]] || usage
  run_driver fram "$2" "${3:--}"
  if [[ -n "${3:-}" ]]; then
    echo "$2 -> $3 (FRAM plan)" >&2
  fi
elif [[ $# -ge 1 && "$1" == --* ]]; then
  echo "wake-compile: unknown option '$1'" >&2
  usage
elif [[ $# -ge 1 ]]; then
  [[ $# -le 2 ]] || usage
  run_driver js "$1" "${2:--}"
  if [[ -n "${2:-}" ]]; then
    echo "$1 -> $2" >&2
  fi
fi
