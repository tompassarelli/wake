{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wake.invalid/contracts/wake-plugin-v1.schema.json",
  "title": "Wake Plugin Package Envelope v1",
  "description": "Transport metadata for a checked Beagle plugin package. Plugin semantics live only in the checked PluginSpec declarations named by entry and sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compatibleWake",
    "durableSchemaVersion",
    "entry",
    "packageId",
    "pluginAbiVersion",
    "schemaVersion",
    "sources",
    "version"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "$ref": "#/$defs/name" },
    "version": { "$ref": "#/$defs/version" },
    "pluginAbiVersion": { "const": 1 },
    "compatibleWake": { "$ref": "#/$defs/version" },
    "durableSchemaVersion": { "type": "integer", "minimum": 1 },
    "entry": { "$ref": "#/$defs/source-path" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source-path" }
    }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "source-path": {
      "allOf": [
        { "$ref": "#/$defs/path" },
        { "pattern": "\\.bjs$" }
      ]
    }
  }
}
