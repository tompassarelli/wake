{
  "$id": "https://wake.invalid/contracts/wake-lock-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "pluginAbiVersion": { "const": 1 },
    "plugins": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": { "$ref": "#/$defs/path" },
          "digest": { "$ref": "#/$defs/digest" },
          "packageId": { "$ref": "#/$defs/name" },
          "source": {
            "additionalProperties": false,
            "properties": {
              "commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
              "kind": { "const": "git" }
            },
            "required": ["commit", "kind"],
            "type": "object"
          },
          "version": { "$ref": "#/$defs/version" }
        },
        "required": ["artifact", "digest", "packageId", "source", "version"],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": { "const": 1 }
  },
  "required": ["pluginAbiVersion", "plugins", "schemaVersion"],
  "title": "Wake Lock v1",
  "type": "object",
  "$defs": {
    "digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "name": { "minLength": 1, "type": "string" },
    "path": {
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    }
  }
}
