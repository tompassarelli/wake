(wake/defcomponent-model
  review-page
  "component/review-page"
  [(wake/->ComponentPropertySpec :draft-title string-prop)
   (wake/->ComponentPropertySpec :draft-summary string-prop)
   (wake/->ComponentPropertySpec :published-title string-prop)
   (wake/->ComponentPropertySpec :published-summary string-prop)]
  [(wake/element
     :main
     {:class (wake/static-attr "wake-wiki-review-page")}
     [(wake/element
        :h1
        {:class (wake/static-attr "wake-wiki-page-title")
         :text (wake/bind-attr :draft-title)}
        [])
      (wake/element
        :p
        {:class (wake/static-attr "wake-wiki-page-summary")
         :text (wake/bind-attr :draft-summary)}
        [])
      (wake/element
        :section
        {:class (wake/static-attr "wake-wiki-review-page__published")}
        [(wake/element
           :h2
           {:class (wake/static-attr "wake-wiki-section-title")
            :text (wake/static-attr "Published revision")}
           [])
         (wake/->WhenNode
           (wake/->UiPropertyPresent :published-title)
           [(wake/element
              :h3
              {:class
               (wake/static-attr "wake-wiki-review-page__published-title")
               :text (wake/bind-attr :published-title)}
              [])])
         (wake/->WhenNode
           (wake/->UiPropertyPresent :published-summary)
           [(wake/element
              :p
              {:class
               (wake/static-attr "wake-wiki-review-page__published-summary")
               :text (wake/bind-attr :published-summary)}
              [])])])])])

