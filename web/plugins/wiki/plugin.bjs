        [])
      (wake/element
        :p
        {:class (wake/static-attr "wake-wiki-revision-summary__id")
         :text (wake/bind-attr :id)}
        [])
      (wake/element
        :p
        {:class (wake/static-attr "wake-wiki-revision-summary__author")
         :text (wake/bind-attr :author)}
        [])
      (wake/element
        :p
        {:class (wake/static-attr "wake-wiki-revision-summary__created")
         :text (wake/bind-attr :created-at)}
        [])
      (wake/element
        :p
        {:class (wake/static-attr "wake-wiki-revision-summary__digest")
         :text (wake/bind-attr :digest)}
        [])])])

