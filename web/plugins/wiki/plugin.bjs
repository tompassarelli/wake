  "config/owner-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-owner-field-ref))
(wake/deffield-name-role
  base-field
  "config/base-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-base-field-ref))
(wake/deffield-name-role
  replaces-field
  "config/replaces-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-replaces-field-ref))
(wake/deffield-name-role
  state-field
  "config/state-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-state-field-ref))
(wake/deffield-name-role
  author-field
  "config/author-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-author-field-ref))
(wake/deffield-name-role
  created-at-field
  "config/created-at-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-created-at-field-ref))
(wake/deffield-name-role
  published-at-field
  "config/published-at-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-published-at-field-ref))
(wake/deffield-name-role
  digest-field
  "config/digest-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-digest-field-ref))
(wake/deffield-name-role
  links-field
  "config/links-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-links-field-ref))
(wake/deffield-name-role
  title-field
  "config/title-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-title-field-ref))
(wake/deffield-name-role
  summary-field
  "config/summary-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-summary-field-ref))
(wake/deffield-name-role
  content-source-field
  "config/content-source-field"
  (wake/->EntityFieldNameRoleTarget revision-entity-content-source-field-ref))
(wake/defstate-name-role
  lifecycle-type
  "config/lifecycle-type"
  RevisionLifecycle-ref)
(wake/defstate-value-name-role
  draft-state
  "config/draft-state"
  RevisionLifecycle-draft-ref)
(wake/defstate-value-name-role
  published-state
  "config/published-state"
  RevisionLifecycle-published-ref)
(wake/defstate-value-name-role
  superseded-state
  "config/superseded-state"
  RevisionLifecycle-superseded-ref)

(wake/defvalue-type
  SafeDocument
  "SafeDocument"
  (wake/->RecordValueType
    [(wake/->ValueRecordField
       "tag"
       (wake/->LiteralValueType (wake/->StringLiteral "document"))
       true)
     (wake/->ValueRecordField
       "blocks"
       (wake/->ListValueType
         (wake/->NamedValueType SafeDocument-Block-ref)
         nil
         (wake/->LiteralBound 65536)
         nil)
       true)])
  [[Block
    (wake/->TaggedValueType
      "tag"
      [(wake/->ValueTaggedVariant
         "paragraph"
         [(wake/->ValueRecordField
            "inlines"
            (wake/->ListValueType
              (wake/->NamedValueType SafeDocument-Inline-ref)
              nil
              (wake/->LiteralBound 65536)
              nil)
            true)])
       (wake/->ValueTaggedVariant
         "heading"
         [(wake/->ValueRecordField
            "level"
            (wake/->EnumValueType
              [(wake/->IntegerLiteral 2)
               (wake/->IntegerLiteral 3)
               (wake/->IntegerLiteral 4)])
            true)
          (wake/->ValueRecordField
            "inlines"
            (wake/->ListValueType
              (wake/->NamedValueType SafeDocument-Inline-ref)
              nil
              (wake/->LiteralBound 65536)
              nil)
            true)])
       (wake/->ValueTaggedVariant
         "blockQuote"
         [(wake/->ValueRecordField
            "blocks"
            (wake/->ListValueType
              (wake/->NamedValueType SafeDocument-Block-ref)
              nil
              (wake/->LiteralBound 65536)
              nil)
            true)])
       (wake/->ValueTaggedVariant
         "list"
         [(wake/->ValueRecordField
            "ordered"
            (wake/->BooleanValueType nil)
            true)
          (wake/->ValueRecordField
            "items"
            (wake/->ListValueType
              (wake/->NamedValueType SafeDocument-ListItem-ref)
              nil
              (wake/->LiteralBound 65536)
              nil)
            true)])
       (wake/->ValueTaggedVariant
         "codeBlock"
         [(wake/->ValueRecordField
            "language"
            (wake/->NullableValueType
              (wake/->StringValueType nil nil nil))
            true)
          (wake/->ValueRecordField
            "text"
            (wake/->StringValueType nil nil nil)
            true)])
       (wake/->ValueTaggedVariant "thematicBreak" [])])]
   [ListItem
    (wake/->RecordValueType
      [(wake/->ValueRecordField
         "blocks"
         (wake/->ListValueType
           (wake/->NamedValueType SafeDocument-Block-ref)
           nil
           (wake/->LiteralBound 65536)
           nil)
         true)])]
   [Inline
    (wake/->TaggedValueType
      "tag"
      [(wake/->ValueTaggedVariant
         "text"
         [(wake/->ValueRecordField
            "text"
            (wake/->StringValueType nil nil nil)
            true)])
       (wake/->ValueTaggedVariant
         "emphasis"
         [(wake/->ValueRecordField
            "inlines"
            (wake/->ListValueType
              (wake/->NamedValueType SafeDocument-Inline-ref)
              nil
              (wake/->LiteralBound 65536)
              nil)
            true)])
       (wake/->ValueTaggedVariant
         "strong"
         [(wake/->ValueRecordField
            "inlines"
            (wake/->ListValueType
              (wake/->NamedValueType SafeDocument-Inline-ref)
              nil
              (wake/->LiteralBound 65536)
              nil)
            true)])
       (wake/->ValueTaggedVariant
         "inlineCode"
         [(wake/->ValueRecordField
            "text"
            (wake/->StringValueType nil nil nil)
            true)])
       (wake/->ValueTaggedVariant
         "link"
         [(wake/->ValueRecordField
            "href"
            (wake/->NamedValueType SafeDocument-SafeUrl-ref)
            true)
          (wake/->ValueRecordField
            "inlines"
            (wake/->ListValueType
              (wake/->NamedValueType SafeDocument-Inline-ref)
              nil
              (wake/->LiteralBound 65536)
              nil)
            true)])
       (wake/->ValueTaggedVariant "lineBreak" [])])]
   [SafeUrl
    (wake/->TaggedValueType
      "kind"
      [(wake/->ValueTaggedVariant
         "external"
         [(wake/->ValueRecordField
            "href"
            (wake/->StringValueType (wake/->LiteralBound 1) nil nil)
            true)])
       (wake/->ValueTaggedVariant
         "internal"
         [(wake/->ValueRecordField
            "reference"
            (wake/->StringValueType (wake/->LiteralBound 1) nil nil)
            true)])])]]
  (wake/->ValueEnvelopeSpec
    (wake/->ConfiguredProjectionBound safe-document-max-bytes)
    (wake/->ConfiguredProjectionBound safe-document-max-depth)
    (wake/->ConfiguredProjectionBound safe-document-max-nodes)))

(wake/defprovider-port
  content-parser
  "provider-port/content-parser"
  (wake/->RecordValueType
    [(wake/->ValueRecordField
       "contentSource"
       (wake/->StringValueType
         nil
         nil
         (wake/->ConfiguredProjectionBound content-source-bytes))
       true)
     (wake/->ValueRecordField
       "safeDocumentLimits"
       (wake/->RecordValueType
         [(wake/->ValueRecordField
            "maxBytes"
            (wake/->IntegerValueType
              (wake/->LiteralBound 1)
              (wake/->LiteralBound 1048576))
            true)
          (wake/->ValueRecordField
            "maxDepth"
            (wake/->IntegerValueType
              (wake/->LiteralBound 5)
              (wake/->LiteralBound 256))
            true)
          (wake/->ValueRecordField
            "maxNodes"
            (wake/->IntegerValueType
              (wake/->LiteralBound 1)
              (wake/->LiteralBound 65536))
            true)])
       true)])
  (wake/->NamedValueType SafeDocument-ref)
  nil)

(wake/defentity-fields-port
  revision-fields
  "entity-fields-port/revision-fields"
  (wake/->DeclaredEntityFieldsTarget revision-entity-ref)
  []
  (wake/->OpenManyEntityFields (wake/->CreateWrite nil) true))

(wake/command-receipt-core)

(wake/defcommand-receipt-field
  resource-receipt-result
  "receipt-result-resource-field"
  "resource-id"
  (wake/->StringValueType nil nil nil)
  resource-entity-ref
  "wake-wiki/field/receipt/result-resource")

(wake/defcommand-receipt-field
  revision-receipt-result
  "receipt-result-revision-field"
  "revision-id"
  (wake/->StringValueType nil nil nil)
  revision-entity-ref
  "wake-wiki/field/receipt/result-revision")

(wake/deffield-name-role
  receipt-result-resource-field
  "config/receipt-result-resource-field"
  (wake/->ReceiptFieldNameRoleTarget resource-receipt-result-ref))
(wake/deffield-name-role
  receipt-result-revision-field
  "config/receipt-result-revision-field"
  (wake/->ReceiptFieldNameRoleTarget revision-receipt-result-ref))

(wake/defentity-fields-port
  receipt-fields
  "entity-fields-port/receipt-fields"
  (wake/->ReceiptEntityFieldsTarget wake-command-receipt-ref)
  []
  (wake/->OpenManyEntityFields (wake/->ServerWrite nil) true))

(wake/defcapability
  cap-browse-published "capability/browse-published" "browse-published" [])
(wake/defcapability
  cap-read-published "capability/read-published" "read-published" [])
(wake/defcapability cap-read-draft "capability/read-draft" "read-draft" [])
(wake/defcapability cap-review-draft "capability/review-draft" "review-draft" [])
(wake/defcapability cap-read-history "capability/read-history" "read-history" [])
(wake/defcapability
  cap-read-backlinks "capability/read-backlinks" "read-backlinks" [])
(wake/defcapability cap-create-draft "capability/create-draft" "create-draft" [])
(wake/defcapability cap-start-draft "capability/start-draft" "start-draft" [])
(wake/defcapability
  cap-replace-own-draft
  "capability/replace-own-draft"
  "replace-own-draft"
  [(wake/->CommandGuardSpec
     revision-entity-ref
     (wake/->CommandInputExpr :expected-draft-revision)
     revision-entity-author-field-ref
     (wake/->CommandActorExpr :id)
     nil)])
(wake/defcapability
  cap-abandon-own-draft
  "capability/abandon-own-draft"
  "abandon-own-draft"
  [(wake/->CommandGuardSpec
     revision-entity-ref
     (wake/->CommandInputExpr :expected-draft-revision)
     revision-entity-author-field-ref
     (wake/->CommandActorExpr :id)
     nil)])
(wake/defcapability
  cap-abandon-any-draft
  "capability/abandon-any-draft"
  "abandon-any-draft"
  [])
(wake/defcapability
  cap-publish-draft "capability/publish-draft" "publish-draft" [])

(def title-value-type wake/ValueTypeSpec
  (wake/->StringValueType
    (wake/->LiteralBound 1)
    (wake/->ConfiguredProjectionBound content-title-scalars)
    (wake/->ConfiguredProjectionBound content-title-bytes)))
(def summary-value-type wake/ValueTypeSpec
  (wake/->StringValueType
    nil
    nil
    (wake/->ConfiguredProjectionBound content-summary-bytes)))
(def content-source-value-type wake/ValueTypeSpec
  (wake/->StringValueType
    nil
    nil
    (wake/->ConfiguredProjectionBound content-source-bytes)))
(def links-value-type wake/ValueTypeSpec
  (wake/->ListValueType
    (wake/->StringValueType nil nil nil)
    nil
    (wake/->ConfiguredProjectionBound content-link-count)
    (wake/->SortUniqueList nil)))
(def nullable-string-value-type wake/ValueTypeSpec
  (wake/->NullableValueType (wake/->StringValueType nil nil nil)))
(def revision-extension-value-type wake/ValueTypeSpec
  (wake/->ExtensionValueType revision-fields-ref))

(def safe-document-input wake/CommandExpr
  (wake/->CommandRecordExpr
    [(wake/->CommandRecordField
       :contentSource
       (wake/->CommandInputExpr :content-source))
     (wake/->CommandRecordField
       :safeDocumentLimits
       (wake/->CommandRecordExpr
         [(wake/->CommandRecordField
            :maxBytes
            (wake/->CommandConfiguredExpr safe-document-max-bytes))
          (wake/->CommandRecordField
            :maxDepth
            (wake/->CommandConfiguredExpr safe-document-max-depth))
          (wake/->CommandRecordField
            :maxNodes
            (wake/->CommandConfiguredExpr safe-document-max-nodes))]))]))

(def payload-digest-input wake/CommandExpr
  (wake/->CommandRecordExpr
    [(wake/->CommandRecordField :title (wake/->CommandInputExpr :title))
     (wake/->CommandRecordField :summary (wake/->CommandInputExpr :summary))
     (wake/->CommandRecordField
       :contentSource
       (wake/->CommandInputExpr :content-source))
     (wake/->CommandRecordField
       :linksTo
       (wake/->CommandInputExpr :links-to))
     (wake/->CommandRecordField
       :revisionFields
       (wake/->CommandInputExpr :revision-fields))]))

(def wiki-command-receipt wake/ReceiptSpec
  (wake/->ReceiptSpec
    [(wake/->ReceiptResultField :resource-id resource-receipt-result-ref)
     (wake/->ReceiptResultField :revision-id revision-receipt-result-ref)]
    [receipt-fields-ref]))

(wake/defcommand
  create-resource-draft
  "command/create-resource-draft"
  [cap-create-draft-ref]
  1
  [(wake/->CommandInputField :title title-value-type)
   (wake/->CommandInputField :summary summary-value-type)
   (wake/->CommandInputField :content-source content-source-value-type)
   (wake/->CommandInputField :links-to links-value-type)
   (wake/->CommandInputField
     :revision-fields
     revision-extension-value-type)]
  [(wake/->GeneratedIdInjection :resource-id)
   (wake/->GeneratedIdInjection :revision-id)
   (wake/->ProviderInjection
