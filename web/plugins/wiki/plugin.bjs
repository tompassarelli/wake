(def string-prop wake/ValueTypeSpec (wake/->StringValueType nil nil nil))
(def keyword-prop wake/ValueTypeSpec (wake/->KeywordValueType []))
(def instant-prop wake/ValueTypeSpec (wake/->InstantValueType nil))
(def digest-prop wake/ValueTypeSpec (wake/->DigestValueType nil))

(wake/defcomponent-model
  browse-page
  "component/browse-page"
  [(wake/->ComponentPropertySpec :title string-prop)
   (wake/->ComponentPropertySpec :summary string-prop)]
  [(wake/element
     :main
     {:class (wake/static-attr "wake-wiki-browse-page")}
     [(wake/element
        :h1
        {:class (wake/static-attr "wake-wiki-page-title")
         :text (wake/bind-attr :title)}
        [])
      (wake/element
        :p
        {:class (wake/static-attr "wake-wiki-page-summary")
         :text (wake/bind-attr :summary)}
        [])])])

