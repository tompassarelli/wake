(wake/defroute-template
  route-browse
  "route/browse"
  "browse"
  browse-view-ref
  [(wake/->RouteQuerySpec query-browse-published-ref nil)]
  [])
(wake/defroute-template
  route-new
  "route/new"
  "new"
  new-view-ref
  []
  [])
(wake/defroute-template
  route-read
  "route/read"
  "read"
  read-view-ref
  [(wake/->RouteQuerySpec query-read-published-ref nil)]
  [(wake/->RouteParameterSpec
     :resource-id
     (wake/->StringValueType nil nil nil))])
(wake/defroute-template
  route-edit
  "route/edit"
  "edit"
  edit-view-ref
  [(wake/->RouteQuerySpec query-read-draft-ref nil)]
  [(wake/->RouteParameterSpec
     :resource-id
     (wake/->StringValueType nil nil nil))])
(wake/defroute-template
  route-review
  "route/review"
  "review"
  review-view-ref
  [(wake/->RouteQuerySpec query-review-ref "draft")
   (wake/->RouteQuerySpec query-read-published-ref "published")]
  [(wake/->RouteParameterSpec
     :resource-id
     (wake/->StringValueType nil nil nil))])
(wake/defroute-template
  route-history
  "route/history"
  "history"
  history-view-ref
  [(wake/->RouteQuerySpec query-history-current-ref nil)]
  [(wake/->RouteParameterSpec
     :resource-id
     (wake/->StringValueType nil nil nil))])

(wake/defroute-slot slot-browse "route-slot/browse" "browse" route-browse-ref)
(wake/defroute-slot slot-new "route-slot/new" "new" route-new-ref)
(wake/defroute-slot slot-read "route-slot/read" "read" route-read-ref)
(wake/defroute-slot slot-edit "route-slot/edit" "edit" route-edit-ref)
(wake/defroute-slot slot-review "route-slot/review" "review" route-review-ref)
(wake/defroute-slot
  slot-history "route-slot/history" "history" route-history-ref)

