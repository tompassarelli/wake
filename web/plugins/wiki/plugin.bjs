#lang beagle/js
(ns wake.plugins.wiki
  (:require [wake.core :as wake]))

;; The plugin contract is deliberately built from nominal references. Public
;; names are configuration targets; local bindings remain collision-free.
(wake/defexternal-entity-role actor-entity "config/actor-entity")

(wake/defvalue-role
  content-limits
  "config/content-limits"
  (wake/->RecordValueType
    [(wake/->ValueRecordField
       "titleBytes"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 1048576))
       true)
     (wake/->ValueRecordField
       "titleScalars"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 1048576))
       true)
     (wake/->ValueRecordField
       "summaryBytes"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 1048576))
       true)
     (wake/->ValueRecordField
       "contentSourceBytes"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 1048576))
       true)
     (wake/->ValueRecordField
       "links"
       (wake/->IntegerValueType
         (wake/->LiteralBound 0)
         (wake/->LiteralBound 200))
       true)]))

(wake/defvalue-role
  query-limits
  "config/query-limits"
  (wake/->RecordValueType
    [(wake/->ValueRecordField
       "browseDefault"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 247))
       true)
     (wake/->ValueRecordField
       "browseMax"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 247))
       true)
     (wake/->ValueRecordField
       "historyDefault"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 247))
       true)
     (wake/->ValueRecordField
       "historyMax"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 247))
       true)
     (wake/->ValueRecordField
       "backlinksDefault"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 247))
       true)
     (wake/->ValueRecordField
       "backlinksMax"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 247))
       true)]))

(wake/defvalue-role
  safe-document-limits
  "config/safe-document-limits"
  (wake/->RecordValueType
    [(wake/->ValueRecordField
       "maxBytes"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 1048576))
       true)
     (wake/->ValueRecordField
       "maxDepth"
       (wake/->IntegerValueType
         (wake/->LiteralBound 5)
         (wake/->LiteralBound 256))
       true)
     (wake/->ValueRecordField
       "maxNodes"
       (wake/->IntegerValueType
         (wake/->LiteralBound 1)
         (wake/->LiteralBound 65536))
       true)]))

(def content-title-bytes wake/ConfigProjection
  (wake/->ConfigProjection content-limits-ref ["titleBytes"]))
(def content-title-scalars wake/ConfigProjection
  (wake/->ConfigProjection content-limits-ref ["titleScalars"]))
(def content-summary-bytes wake/ConfigProjection
  (wake/->ConfigProjection content-limits-ref ["summaryBytes"]))
(def content-source-bytes wake/ConfigProjection
  (wake/->ConfigProjection content-limits-ref ["contentSourceBytes"]))
(def content-link-count wake/ConfigProjection
  (wake/->ConfigProjection content-limits-ref ["links"]))
(def query-browse-default wake/ConfigProjection
  (wake/->ConfigProjection query-limits-ref ["browseDefault"]))
(def query-browse-max wake/ConfigProjection
  (wake/->ConfigProjection query-limits-ref ["browseMax"]))
(def query-history-default wake/ConfigProjection
  (wake/->ConfigProjection query-limits-ref ["historyDefault"]))
(def query-history-max wake/ConfigProjection
  (wake/->ConfigProjection query-limits-ref ["historyMax"]))
(def query-backlinks-default wake/ConfigProjection
  (wake/->ConfigProjection query-limits-ref ["backlinksDefault"]))
(def query-backlinks-max wake/ConfigProjection
  (wake/->ConfigProjection query-limits-ref ["backlinksMax"]))
(def safe-document-max-bytes wake/ConfigProjection
  (wake/->ConfigProjection safe-document-limits-ref ["maxBytes"]))
(def safe-document-max-depth wake/ConfigProjection
  (wake/->ConfigProjection safe-document-limits-ref ["maxDepth"]))
(def safe-document-max-nodes wake/ConfigProjection
  (wake/->ConfigProjection safe-document-limits-ref ["maxNodes"]))

(wake/defstate-model
  RevisionLifecycle
  "RevisionLifecycle"
  "RevisionLifecycle"
  [[draft "RevisionLifecycle/value/draft" "draft" :draft]
   [published "RevisionLifecycle/value/published" "published" :published]
   [superseded
    "RevisionLifecycle/value/superseded"
    "superseded"
    :superseded]]
  draft
  [[draft [published superseded]]
   [published [superseded]]
   [superseded []]])

(wake/defentity-ref resource-entity "resource" "resource")
(wake/defentity-ref revision-entity "revision" "revision")

(wake/define-entity-model
  resource-entity
  Resource
  "resource"
  [[resource-id "resource/id" "id" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->IdentityWrite nil)
    "wake-wiki/field/resource/id"
    true]
   [published-pointer
    "resource/published-revision"
    "published-revision"
    String
    (wake/->RefField (wake/->DeclaredEntityTarget revision-entity-ref))
    (wake/->SingleField nil)
    (wake/->CommandFieldWrite nil)
    "wake-wiki/field/resource/published-revision"
    false]
   [draft-pointer
    "resource/draft-revision"
    "draft-revision"
    String
    (wake/->RefField (wake/->DeclaredEntityTarget revision-entity-ref))
    (wake/->SingleField nil)
    (wake/->CommandFieldWrite nil)
    "wake-wiki/field/resource/draft-revision"
    false]]
  []
  "wake-wiki/entity/resource")

(wake/define-entity-model
  revision-entity
  Revision
  "revision"
  [[revision-id "revision/id" "id" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->IdentityWrite nil)
    "wake-wiki/field/revision/id"
    true]
   [owner-field "revision/resource" "resource" String
    (wake/->RefField (wake/->DeclaredEntityTarget resource-entity-ref))
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-wiki/field/revision/resource"
    true]
   [base-field "revision/based-on" "based-on" String
    (wake/->RefField (wake/->DeclaredEntityTarget revision-entity-ref))
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-wiki/field/revision/based-on"
    false]
   [replaces-field "revision/replaces-draft" "replaces-draft" String
    (wake/->RefField (wake/->DeclaredEntityTarget revision-entity-ref))
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-wiki/field/revision/replaces-draft"
    false]
   [state-field "revision/state" "state" Keyword
    (wake/->StateField RevisionLifecycle-ref)
    (wake/->SingleField nil)
    (wake/->CommandFieldWrite nil)
    "wake-wiki/field/revision/state"
    true]
   [author-field "revision/author" "author" String
    (wake/->RefField (wake/->ExternalEntityTarget actor-entity-ref))
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-wiki/field/revision/author"
    true]
   [created-at-field "revision/created-at" "created-at" Instant
    (wake/->InstantField nil)
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-wiki/field/revision/created-at"
    true]
   [published-at-field "revision/published-at" "published-at" Instant
    (wake/->InstantField nil)
    (wake/->SingleField nil)
    (wake/->CommandFieldWrite nil)
    "wake-wiki/field/revision/published-at"
    false]
   [digest-field "revision/digest" "digest" String
    (wake/->DigestField nil)
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-wiki/field/revision/digest"
    true]
   [links-field "revision/links-to" "links-to" (Vec String)
    (wake/->RefField (wake/->DeclaredEntityTarget resource-entity-ref))
    (wake/->ManyField nil)
    (wake/->CreateWrite nil)
    "wake-wiki/field/revision/links-to"
    true]
   [title-field "revision/title" "title" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-wiki/field/revision/title"
    true]
   [summary-field "revision/summary" "summary" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-wiki/field/revision/summary"
    true]
   [content-source-field "revision/content-source" "content-source" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-wiki/field/revision/content-source"
    true]]
  []
  "wake-wiki/entity/revision")

(wake/defentity-name-role resource "config/resource" resource-entity-ref)
(wake/defentity-name-role revision "config/revision" revision-entity-ref)
(wake/deffield-name-role
  resource-id
  "config/resource-id"
  (wake/->EntityFieldNameRoleTarget resource-entity-resource-id-ref))
(wake/deffield-name-role
  published-pointer
  "config/published-pointer"
