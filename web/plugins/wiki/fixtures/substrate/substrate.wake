(ns wake.fixtures.wiki-substrate)
(application :id "wake-wiki-substrate-fixture")
(backend :fram)

(entity member
  :storage-id "wake-wiki-substrate-fixture/entity/member"
  (member-id : String :identity
    :storage-id "wake-wiki-substrate-fixture/field/member/id"))

(provider plain-text
  :implements wiki.content-parser)

(use "wake-wiki"
  :as wiki
  :version "0.1.0"
  :allow [schema query capability ui route]
  :config [resource entry
           resource-id entry-id
           revision edition
           revision-id edition-id
           published-pointer released-edition
           draft-pointer working-edition
           owner-field entry
           base-field based-on-release
           replaces-field replaces-working
           lifecycle-type EditionPhase
           state-field phase
           actor-entity member
           author-field prepared-by
           created-at-field prepared-at
           digest-field checksum
           links-field references
           title-field heading
           summary-field abstract
           content-source-field source
           receipt-result-resource-field result-entry
           receipt-result-revision-field result-edition
           content-provider plain-text
           draft-state :working
           published-state :released
           superseded-state :withdrawn
           content-limits [titleBytes 512
                           titleScalars 120
                           summaryBytes 1024
                           contentSourceBytes 8192
                           links 32]
           query-limits [browseDefault 10
                         browseMax 20
                         historyDefault 10
                         historyMax 20
                         backlinksDefault 10
                         backlinksMax 20]
           safe-document-limits [maxBytes 16384
                                 maxDepth 8
                                 maxNodes 512]])

(mount wiki.browse :path "/library")
(mount wiki.new :path "/library/new")
(mount wiki.read :path "/library/:entry-id")
(mount wiki.edit :path "/library/:entry-id/edit")
(mount wiki.review :path "/library/:entry-id/review")
(mount wiki.history :path "/library/:entry-id/history")
