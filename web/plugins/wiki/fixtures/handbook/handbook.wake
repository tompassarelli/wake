(ns wake.fixtures.handbook)
(application :id "wake-wiki-handbook-fixture")
(backend :fram)

(entity member
  :storage-id "handbook-fixture/entity/member"
  (member-id : String :identity
    :storage-id "handbook-fixture/field/member/id")
  (display-name : String :write :create
    :storage-id "handbook-fixture/field/member/display-name"))

(provider handbook-plain-text
  :implements wiki.content-parser)

(use "wake-wiki"
  :as wiki
  :version "0.1.0"
  :allow [schema query command capability ui route]
  :config [resource entry
           resource-id entry-id
           revision edition
           revision-id edition-id
           published-pointer released-edition
           draft-pointer working-edition
           owner-field entry
           base-field based-on-release
           replaces-field replaces-working
           lifecycle-type EditionPhase
           state-field phase
           actor-entity member
           author-field prepared-by
           created-at-field prepared-at
           digest-field checksum
           links-field references
           title-field heading
           summary-field abstract
           content-source-field source
           receipt-result-resource-field result-entry
           receipt-result-revision-field result-edition
           content-provider handbook-plain-text
           draft-state :working
           published-state :released
           superseded-state :withdrawn
           content-limits [titleBytes 512
                           titleScalars 120
                           summaryBytes 1024
                           contentSourceBytes 8192
                           links 32]
           query-limits [browseDefault 10
                         browseMax 20
                         historyDefault 10
                         historyMax 20
                         backlinksDefault 10
                         backlinksMax 20]
           safe-document-limits [maxBytes 16384
                                 maxDepth 8
                                 maxNodes 512]])

(extend wiki.revision-fields
  (audience : Keyword
    :storage-id "handbook-fixture/field/edition/audience"
    :required true))

(extend wiki.receipt-fields
  (release-rule-digest : Digest
    :storage-id "handbook-fixture/field/receipt/release-rule-digest"
    :server true))

(mount wiki.browse :path "/handbook")
(mount wiki.new :path "/handbook/new")
(mount wiki.read :path "/handbook/:entry-id")
(mount wiki.edit :path "/handbook/:entry-id/edit")
(mount wiki.review :path "/handbook/:entry-id/review")
(mount wiki.history :path "/handbook/:entry-id/history")
