(ns wake.plugins.wiki)

(defstate RevisionLifecycle
  [:draft -> :published :superseded]
  [:published -> :superseded]
  [:superseded ->])

(entity resource
  (id : String :identity)
  (published-revision : Ref :to revision :write :command)
  (draft-revision : Ref :to revision :write :command))

(entity revision
  (id : String :identity)
  (resource : Ref :to resource :write :create)
  (based-on : Ref :to revision :write :create)
  (replaces-draft : Ref :to revision :write :create)
  (state : RevisionLifecycle :write :command)
  (author : String :write :create)
  (created-at : Instant :write :create)
  (digest : String :write :create)
  (links-to : Ref :to resource :many :write :create)
  (title : String :write :create)
  (summary : String :write :create)
  (content-source : String :write :create))

(query browse-published
  :params []
  :from [(entry : resource)
         (published : revision)]
  :where [(= entry.published-revision published)
          (= published.resource entry)
          (= published.state :published)]
  :select [(resource-id entry.id)
           (revision-id published.id)
           (title published.title)
           (summary published.summary)
           (author published.author)
           (created-at published.created-at)]
  :result :page
  :page [default 10 max 20])

(query read-published
  :params [(resource-id : String)]
  :from [(entry : resource)
         (published : revision)]
  :where [(= entry.id $resource-id)
          (= entry.published-revision published)
          (= published.resource entry)
          (= published.state :published)]
  :select [(resource-id entry.id)
           (revision-id published.id)
           (title published.title)
           (summary published.summary)
           (content-source published.content-source)
           (links-to published.links-to)
           (author published.author)
           (created-at published.created-at)
           (digest published.digest)]
  :result :optional)

(query read-draft
  :params [(resource-id : String)]
  :from [(entry : resource)
         (draft : revision)]
  :where [(= entry.id $resource-id)
          (= entry.draft-revision draft)
          (= draft.resource entry)
          (= draft.state :draft)]
  :select [(resource-id entry.id)
           (revision-id draft.id)
           (title draft.title)
           (summary draft.summary)
           (content-source draft.content-source)
           (links-to draft.links-to)
           (author draft.author)
           (created-at draft.created-at)
           (digest draft.digest)]
  :result :optional)

(query review
  :params [(resource-id : String)]
  :from [(entry : resource)
         (candidate : revision)]
  :where [(= entry.id $resource-id)
          (= entry.draft-revision candidate)
          (= candidate.resource entry)
          (= candidate.state :draft)]
  :select [(resource-id entry.id)
           (revision-id candidate.id)
           (title candidate.title)
           (summary candidate.summary)
           (content-source candidate.content-source)
           (links-to candidate.links-to)
           (author candidate.author)
           (created-at candidate.created-at)
           (digest candidate.digest)]
  :result :optional)

(query history
  :params [(resource-id : String)]
  :from [(entry : resource)
         (edition : revision)
         (prior : revision)]
  :where [(= entry.id $resource-id)
          (= entry.published-revision edition)
          (= edition.resource entry)
          (= edition.state :published)
          (= edition.based-on prior)
          (= prior.resource entry)]
  :select [(resource-id entry.id)
           (revision-id edition.id)
           (based-on prior.id)
           (state edition.state)
           (title edition.title)
           (summary edition.summary)
           (author edition.author)
           (created-at edition.created-at)
           (digest edition.digest)]
  :result :page
  :page [default 10 max 20])

(query backlinks
  :params [(resource-id : String)]
  :from [(source : resource)
         (published : revision)
         (target : resource)
         (target-published : revision)]
  :where [(= target.id $resource-id)
          (= target.published-revision target-published)
          (= target-published.resource target)
          (= target-published.state :published)
          (= source.published-revision published)
          (= published.resource source)
          (= published.state :published)
          (= published.links-to target)]
  :select [(resource-id source.id)
           (revision-id published.id)
           (title published.title)
           (summary published.summary)]
  :result :page
  :page [default 10 max 20])

(component browse-page
  :props [title summary]
  (main :class "wake-wiki-browse-page"
    (h1 :class "wake-wiki-page-title" :text title)
    (p :class "wake-wiki-page-summary" :text summary)))

(component new-draft-page
  :props [title guidance]
  (main :class "wake-wiki-new-draft-page"
    (h1 :class "wake-wiki-page-title" :text title)
    (p :class "wake-wiki-page-guidance" :text guidance)))

(component read-page
  :props [title summary content-source]
  (main :class "wake-wiki-read-page"
    (h1 :class "wake-wiki-page-title" :text title)
    (p :class "wake-wiki-page-summary" :text summary)
    (p :class "wake-wiki-safe-text" :text content-source)))

(component edit-draft-page
  :props [title content-source]
  (main :class "wake-wiki-edit-draft-page"
    (h1 :class "wake-wiki-page-title" :text title)
    (p :class "wake-wiki-safe-text" :text content-source)))

(component review-page
  :props [title summary state]
  (main :class "wake-wiki-review-page"
    (h1 :class "wake-wiki-page-title" :text title)
    (p :class "wake-wiki-page-summary" :text summary)
    (p :class "wake-wiki-revision-state" :text state)))

(component history-page
  :props [title state created-at]
  (main :class "wake-wiki-history-page"
    (h1 :class "wake-wiki-page-title" :text title)
    (p :class "wake-wiki-revision-state" :text state)
    (p :class "wake-wiki-revision-created" :text created-at)))

(component resource-card
  :props [id published-revision draft-revision]
  (section :class "wake-wiki-resource-card"
    (h2 :class "wake-wiki-resource-card__id" :text id)
    (when published-revision
      (p :class "wake-wiki-resource-card__published"
        :text published-revision))
    (when draft-revision
      (p :class "wake-wiki-resource-card__draft" :text draft-revision))))

(component revision-summary
  :props [id title summary state author created-at digest]
  (section :class "wake-wiki-revision-summary"
    (h2 :class "wake-wiki-revision-summary__title" :text title)
    (p :class "wake-wiki-revision-summary__summary" :text summary)
    (p :class "wake-wiki-revision-summary__state" :text state)
    (p :class "wake-wiki-revision-summary__id" :text id)
    (p :class "wake-wiki-revision-summary__author" :text author)
    (p :class "wake-wiki-revision-summary__created" :text created-at)
    (p :class "wake-wiki-revision-summary__digest" :text digest)))

(component safe-document
  :props [content-source]
  (div :class "wake-wiki-safe-document"
    (p :class "wake-wiki-safe-text" :text content-source)))

(component link-list
  :props [links-to]
  (section :class "wake-wiki-link-list"
    (h2 :class "wake-wiki-section-title" :text "Links")
    (p :class "wake-wiki-link-list__items" :text links-to)))

(component backlink-list
  :props [resource]
  (section :class "wake-wiki-backlink-list"
    (h2 :class "wake-wiki-section-title" :text "Backlinks")
    (p :class "wake-wiki-backlink-list__resource" :text resource)))

(component conflict-notice
  :props [message]
  (p :class "wake-wiki-conflict-notice" :text message))
