(ns wake.plugins.wiki)

(value-type SafeDocument
  :bounds [maxBytes 1048576 maxDepth 256 maxNodes 65536]
  :definitions [
    (SafeDocument (Record [
      (tag : (Literal "document"))
      (blocks : (List Block :max 65536))]))
    (Block (Tagged tag [
      (paragraph [
        (inlines : (List Inline :max 65536))])
      (heading [
        (level : (Enum [2 3 4]))
        (inlines : (List Inline :max 65536))])
      (blockQuote [
        (blocks : (List Block :max 65536))])
      (list [
        (ordered : Boolean)
        (items : (List ListItem :max 65536))])
      (codeBlock [
        (language : (Nullable String))
        (text : String)])
      (thematicBreak [])]))
    (ListItem (Record [
      (blocks : (List Block :max 65536))]))
    (Inline (Tagged tag [
      (text [
        (text : String)])
      (emphasis [
        (inlines : (List Inline :max 65536))])
      (strong [
        (inlines : (List Inline :max 65536))])
      (inlineCode [
        (text : String)])
      (link [
        (href : SafeUrl)
        (inlines : (List Inline :max 65536))])
      (lineBreak [])]))
    (SafeUrl (Tagged kind [
      (external [
        (href : (String :min 1))])
      (internal [
        (reference : (String :min 1))])]))]
  :root SafeDocument)

(provider-port content-parser
  :input (Record [
    (contentSource : String)
    (safeDocumentLimits : (Record [
      (maxBytes : (Integer :min 1 :max 1048576))
      (maxDepth : (Integer :min 5 :max 256))
      (maxNodes : (Integer :min 1 :max 65536))]))])
  :output SafeDocument)

(defstate (config lifecycle-type)
  [(config draft-state) -> (config published-state) (config superseded-state)]
  [(config published-state) -> (config superseded-state)]
  [(config superseded-state) ->])

(entity (config resource)
  ((config resource-id) : String :identity)
  ((config published-pointer) : Ref :to (config revision) :write :command)
  ((config draft-pointer) : Ref :to (config revision) :write :command))

(entity (config revision)
  ((config revision-id) : String :identity)
  ((config owner-field) : Ref :to (config resource) :write :create)
  ((config base-field) : Ref :to (config revision) :write :create)
  ((config replaces-field) : Ref :to (config revision) :write :create)
  ((config state-field) : (config lifecycle-type) :write :command)
  ((config author-field) : Ref :to (config actor-entity) :write :create)
  ((config created-at-field) : Instant :write :create)
  ((config published-at-field) : Instant :write :command)
  ((config digest-field) : Digest :write :create)
  ((config links-field) : Ref :to (config resource) :many :write :create)
  ((config title-field) : String :write :create)
  ((config summary-field) : String :write :create)
  ((config content-source-field) : String :write :create))

(command create-resource-draft
  :capability create-draft
  :normalizer-version 1
  :input [(title : (String
                     :min 1
                     :max (config content-limits.titleScalars)
                     :bytes (config content-limits.titleBytes)))
          (summary : (String :bytes (config content-limits.summaryBytes)))
          (content-source : (String :bytes (config content-limits.contentSourceBytes)))
          (links-to : (List String
                       :max (config content-limits.links)
                       :normalize :sort-unique))
          (revision-fields : (Extension revision-fields))]
  :inject [(resource-id :generated-id String)
           (revision-id :generated-id String)
           (validated-document :provider (config content-provider) SafeDocument
             (record [contentSource (input content-source)
                      safeDocumentLimits
                      (record [maxBytes (literal (config safe-document-limits.maxBytes))
                               maxDepth (literal (config safe-document-limits.maxDepth))
                               maxNodes (literal (config safe-document-limits.maxNodes))])]))
           (payload-digest :canonical-digest Digest
             (record [title (input title)
                      summary (input summary)
                      contentSource (input content-source)
                      linksTo (input links-to)
                      revisionFields (input revision-fields)]))]
  :steps [(assert (not-contains (input links-to) (injected resource-id)))
          (require-each (config resource) (input links-to))
          (create (config resource) (injected resource-id)
            :fields [((config draft-pointer) (injected revision-id))])
          (create (config revision) (injected revision-id)
            :fields [((config owner-field) (injected resource-id))
                     ((config state-field) (literal (config draft-state)))
                     ((config author-field) (actor id))
                     ((config created-at-field) (receipt-time))
                     ((config digest-field) (injected payload-digest))
                     ((config links-field) (input links-to))
                     ((config title-field) (input title))
                     ((config summary-field) (input summary))
                     ((config content-source-field) (input content-source))
                     (extension-fields revision-fields (input revision-fields))])]
  :result [(resource-id : String (injected resource-id))
           (revision-id : String (injected revision-id))]
  :receipt (receipt
    :entity wake.core/command-receipt
    :identity id
    :actor actor
    :command command
    :input-digest input-digest
    :created-at created-at
    :result [(resource-id (config receipt-result-resource-field) String
               :to (config resource))
             (revision-id (config receipt-result-revision-field) String
               :to (config revision))]
    :extensions [receipt-fields]))

(command start-revision-draft
  :capability start-draft
  :normalizer-version 1
  :input [(resource-id : String)
          (expected-published-revision : (Nullable String))
          (title : (String
                     :min 1
                     :max (config content-limits.titleScalars)
                     :bytes (config content-limits.titleBytes)))
          (summary : (String :bytes (config content-limits.summaryBytes)))
          (content-source : (String :bytes (config content-limits.contentSourceBytes)))
          (links-to : (List String
                       :max (config content-limits.links)
                       :normalize :sort-unique))
          (revision-fields : (Extension revision-fields))]
  :inject [(revision-id :generated-id String)
           (validated-document :provider (config content-provider) SafeDocument
             (record [contentSource (input content-source)
                      safeDocumentLimits
                      (record [maxBytes (literal (config safe-document-limits.maxBytes))
                               maxDepth (literal (config safe-document-limits.maxDepth))
                               maxNodes (literal (config safe-document-limits.maxNodes))])]))
           (payload-digest :canonical-digest Digest
             (record [title (input title)
                      summary (input summary)
                      contentSource (input content-source)
                      linksTo (input links-to)
                      revisionFields (input revision-fields)]))]
  :steps [(assert (not-contains (input links-to) (input resource-id)))
          (require (config resource) (input resource-id))
          (require (config revision) (input expected-published-revision)
            :when (non-null (input expected-published-revision)))
          (require-each (config resource) (input links-to))
          (guard (config resource) (input resource-id)
            (config published-pointer) (input expected-published-revision))
          (guard (config resource) (input resource-id)
            (config draft-pointer) (literal nil))
          (guard (config revision) (input expected-published-revision)
            (config owner-field) (input resource-id)
            :when (non-null (input expected-published-revision)))
          (guard (config revision) (input expected-published-revision)
            (config state-field) (literal (config published-state))
            :when (non-null (input expected-published-revision)))
          (create (config revision) (injected revision-id)
            :fields [((config owner-field) (input resource-id))
                     ((config base-field) (input expected-published-revision) :omit-if-null)
                     ((config state-field) (literal (config draft-state)))
                     ((config author-field) (actor id))
                     ((config created-at-field) (receipt-time))
                     ((config digest-field) (injected payload-digest))
                     ((config links-field) (input links-to))
                     ((config title-field) (input title))
                     ((config summary-field) (input summary))
                     ((config content-source-field) (input content-source))
                     (extension-fields revision-fields (input revision-fields))])
          (update (config resource) (input resource-id)
            :fields [((config draft-pointer) (injected revision-id)
                       :allowed-current (literal nil))])]
  :result [(resource-id : String (input resource-id))
           (revision-id : String (injected revision-id))]
  :receipt (receipt
    :entity wake.core/command-receipt
    :identity id
    :actor actor
    :command command
    :input-digest input-digest
    :created-at created-at
    :result [(resource-id (config receipt-result-resource-field) String
               :to (config resource))
             (revision-id (config receipt-result-revision-field) String
               :to (config revision))]
    :extensions [receipt-fields]))

(command replace-draft
  :capability
  (replace-own-draft
    :guards [(guard (config revision) (input expected-draft-revision)
               (config author-field) (actor id))])
  :normalizer-version 1
  :input [(resource-id : String)
          (expected-draft-revision : String)
          (expected-published-revision : (Nullable String))
          (title : (String
                     :min 1
                     :max (config content-limits.titleScalars)
                     :bytes (config content-limits.titleBytes)))
          (summary : (String :bytes (config content-limits.summaryBytes)))
          (content-source : (String :bytes (config content-limits.contentSourceBytes)))
          (links-to : (List String
                       :max (config content-limits.links)
                       :normalize :sort-unique))
          (revision-fields : (Extension revision-fields))]
  :inject [(revision-id :generated-id String)
           (validated-document :provider (config content-provider) SafeDocument
             (record [contentSource (input content-source)
                      safeDocumentLimits
                      (record [maxBytes (literal (config safe-document-limits.maxBytes))
                               maxDepth (literal (config safe-document-limits.maxDepth))
                               maxNodes (literal (config safe-document-limits.maxNodes))])]))
           (payload-digest :canonical-digest Digest
             (record [title (input title)
                      summary (input summary)
                      contentSource (input content-source)
                      linksTo (input links-to)
                      revisionFields (input revision-fields)]))]
  :steps [(assert (not-contains (input links-to) (input resource-id)))
          (require (config resource) (input resource-id))
          (require (config revision) (input expected-draft-revision))
          (require (config revision) (input expected-published-revision)
            :when (non-null (input expected-published-revision)))
          (require-each (config resource) (input links-to))
          (guard (config resource) (input resource-id)
            (config published-pointer) (input expected-published-revision))
          (guard (config resource) (input resource-id)
            (config draft-pointer) (input expected-draft-revision))
          (guard (config revision) (input expected-draft-revision)
            (config owner-field) (input resource-id))
          (guard (config revision) (input expected-draft-revision)
            (config state-field) (literal (config draft-state)))
          (guard (config revision) (input expected-draft-revision)
            (config base-field) (input expected-published-revision))
          (guard (config revision) (input expected-published-revision)
            (config owner-field) (input resource-id)
            :when (non-null (input expected-published-revision)))
          (guard (config revision) (input expected-published-revision)
            (config state-field) (literal (config published-state))
            :when (non-null (input expected-published-revision)))
          (create (config revision) (injected revision-id)
            :fields [((config owner-field) (input resource-id))
                     ((config base-field) (input expected-published-revision) :omit-if-null)
                     ((config replaces-field) (input expected-draft-revision))
                     ((config state-field) (literal (config draft-state)))
                     ((config author-field) (actor id))
                     ((config created-at-field) (receipt-time))
                     ((config digest-field) (injected payload-digest))
                     ((config links-field) (input links-to))
                     ((config title-field) (input title))
                     ((config summary-field) (input summary))
                     ((config content-source-field) (input content-source))
                     (extension-fields revision-fields (input revision-fields))])
          (update (config resource) (input resource-id)
            :fields [((config draft-pointer) (injected revision-id)
                       :allowed-current (input expected-draft-revision))])
          (update (config revision) (input expected-draft-revision)
            :fields [((config state-field) (literal (config superseded-state))
                       :allowed-current (literal (config draft-state)))])]
  :result [(resource-id : String (input resource-id))
           (revision-id : String (injected revision-id))]
  :receipt (receipt
    :entity wake.core/command-receipt
    :identity id
    :actor actor
    :command command
    :input-digest input-digest
    :created-at created-at
    :result [(resource-id (config receipt-result-resource-field) String
               :to (config resource))
             (revision-id (config receipt-result-revision-field) String
               :to (config revision))]
    :extensions [receipt-fields]))

(command abandon-draft
  :capability [
    (abandon-own-draft
      :guards [(guard (config revision) (input expected-draft-revision)
                 (config author-field) (actor id))])
    abandon-any-draft]
  :normalizer-version 1
  :input [(resource-id : String)
          (expected-draft-revision : String)
          (expected-published-revision : (Nullable String))]
  :inject []
  :steps [(require (config resource) (input resource-id))
          (require (config revision) (input expected-draft-revision))
          (require (config revision) (input expected-published-revision)
            :when (non-null (input expected-published-revision)))
          (guard (config resource) (input resource-id)
            (config published-pointer) (input expected-published-revision))
          (guard (config resource) (input resource-id)
            (config draft-pointer) (input expected-draft-revision))
          (guard (config revision) (input expected-draft-revision)
            (config owner-field) (input resource-id))
          (guard (config revision) (input expected-draft-revision)
            (config state-field) (literal (config draft-state)))
          (guard (config revision) (input expected-draft-revision)
            (config base-field) (input expected-published-revision))
          (guard (config revision) (input expected-published-revision)
            (config owner-field) (input resource-id)
            :when (non-null (input expected-published-revision)))
          (guard (config revision) (input expected-published-revision)
            (config state-field) (literal (config published-state))
            :when (non-null (input expected-published-revision)))
          (update (config resource) (input resource-id)
            :fields [((config draft-pointer) (literal nil)
                       :allowed-current (input expected-draft-revision))])
          (update (config revision) (input expected-draft-revision)
            :fields [((config state-field) (literal (config superseded-state))
                       :allowed-current (literal (config draft-state)))])]
  :result [(resource-id : String (input resource-id))
           (revision-id : String (input expected-draft-revision))]
  :receipt (receipt
    :entity wake.core/command-receipt
    :identity id
    :actor actor
    :command command
    :input-digest input-digest
    :created-at created-at
    :result [(resource-id (config receipt-result-resource-field) String
               :to (config resource))
             (revision-id (config receipt-result-revision-field) String
               :to (config revision))]
    :extensions [receipt-fields]))

(command publish
  :capability publish-draft
  :normalizer-version 1
  :input [(resource-id : String)
          (candidate-revision-id : String)
          (expected-draft-revision : String)
          (expected-published-revision : (Nullable String))
          (expected-candidate-digest : Digest)
          (expected-links-to : (List String
                                :max (config content-limits.links)
                                :normalize :sort-unique))]
  :inject []
  :steps [(assert (= (input candidate-revision-id)
                     (input expected-draft-revision)))
          (assert (not-contains (input expected-links-to) (input resource-id)))
          (require (config resource) (input resource-id))
          (require (config revision) (input candidate-revision-id))
          (require (config revision) (input expected-published-revision)
            :when (non-null (input expected-published-revision)))
          (require-each (config resource) (input expected-links-to))
          (guard (config resource) (input resource-id)
            (config published-pointer) (input expected-published-revision))
          (guard (config resource) (input resource-id)
            (config draft-pointer) (input expected-draft-revision))
          (guard (config revision) (input candidate-revision-id)
            (config owner-field) (input resource-id))
          (guard (config revision) (input candidate-revision-id)
            (config state-field) (literal (config draft-state)))
          (guard (config revision) (input candidate-revision-id)
            (config base-field) (input expected-published-revision))
          (guard (config revision) (input candidate-revision-id)
            (config digest-field) (input expected-candidate-digest))
          (guard (config revision) (input candidate-revision-id)
            (config links-field) (input expected-links-to))
          (guard (config revision) (input candidate-revision-id)
            (config published-at-field) (literal nil))
          (guard (config revision) (input expected-published-revision)
            (config owner-field) (input resource-id)
            :when (non-null (input expected-published-revision)))
          (guard (config revision) (input expected-published-revision)
            (config state-field) (literal (config published-state))
            :when (non-null (input expected-published-revision)))
          (update (config revision) (input candidate-revision-id)
            :fields [((config state-field) (literal (config published-state))
                       :allowed-current (literal (config draft-state)))
                     ((config published-at-field) (receipt-time)
                       :allowed-current (literal nil))])
          (update (config revision) (input expected-published-revision)
            :fields [((config state-field) (literal (config superseded-state))
                       :allowed-current (literal (config published-state)))]
            :when (non-null (input expected-published-revision)))
          (update (config resource) (input resource-id)
            :fields [((config published-pointer) (input candidate-revision-id)
                       :allowed-current (input expected-published-revision))
                     ((config draft-pointer) (literal nil)
                       :allowed-current (input expected-draft-revision))])]
  :result [(resource-id : String (input resource-id))
           (revision-id : String (input candidate-revision-id))]
  :receipt (receipt
    :entity wake.core/command-receipt
    :identity id
    :actor actor
    :command command
    :input-digest input-digest
    :created-at created-at
    :result [(resource-id (config receipt-result-resource-field) String
               :to (config resource))
             (revision-id (config receipt-result-revision-field) String
               :to (config revision))]
    :extensions [receipt-fields]))

(query browse-published
  :capability browse-published
  :params []
  :from [(entry : (config resource))
         (published : (config revision))]
  :where [(= (field entry (config published-pointer)) published)
          (= (field published (config owner-field)) entry)
          (= (field published (config state-field)) (config published-state))]
  :select [(resource-id (field entry (config resource-id)))
           (revision-id (field published (config revision-id)))
           (title (field published (config title-field)))
           (summary (field published (config summary-field)))
           (author (field published (config author-field)))
           (created-at (field published (config created-at-field)))
           (extension-fields revision-fields published)]
  :result :page
  :page [default (config query-limits.browseDefault)
         max (config query-limits.browseMax)])

(query read-published
  :capability read-published
  :params [(resource-id : String)]
  :from [(entry : (config resource))
         (published : (config revision))]
  :where [(= (field entry (config resource-id)) $resource-id)
          (= (field entry (config published-pointer)) published)
          (= (field published (config owner-field)) entry)
          (= (field published (config state-field)) (config published-state))]
  :select [(resource-id (field entry (config resource-id)))
           (revision-id (field published (config revision-id)))
           (title (field published (config title-field)))
           (summary (field published (config summary-field)))
           (content-source (field published (config content-source-field)))
           (links-to (field published (config links-field)))
           (author (field published (config author-field)))
           (created-at (field published (config created-at-field)))
           (digest (field published (config digest-field)))
           (extension-fields revision-fields published)]
  :result :optional)

(query read-source-for-draft
  :capability start-draft
  :params [(resource-id : String)]
  :from [(entry : (config resource))
         (published : (config revision))]
  :where [(= (field entry (config resource-id)) $resource-id)
          (= (field entry (config published-pointer)) published)
          (= (field published (config owner-field)) entry)
          (= (field published (config state-field)) (config published-state))]
  :select [(resource-id (field entry (config resource-id)))
           (revision-id (field published (config revision-id)))
           (title (field published (config title-field)))
           (summary (field published (config summary-field)))
           (content-source (field published (config content-source-field)))
           (links-to (field published (config links-field)))
           (author (field published (config author-field)))
           (created-at (field published (config created-at-field)))
           (digest (field published (config digest-field)))
           (extension-fields revision-fields published)]
  :result :optional)

(query read-draft
  :capability read-draft
  :params [(resource-id : String)]
  :from [(entry : (config resource))
         (draft : (config revision))]
  :where [(= (field entry (config resource-id)) $resource-id)
          (= (field entry (config draft-pointer)) draft)
          (= (field draft (config owner-field)) entry)
          (= (field draft (config state-field)) (config draft-state))]
  :select [(resource-id (field entry (config resource-id)))
           (revision-id (field draft (config revision-id)))
           (title (field draft (config title-field)))
           (summary (field draft (config summary-field)))
           (content-source (field draft (config content-source-field)))
           (links-to (field draft (config links-field)))
           (author (field draft (config author-field)))
           (created-at (field draft (config created-at-field)))
           (digest (field draft (config digest-field)))
           (extension-fields revision-fields draft)]
  :result :optional)

(query review
  :capability review-draft
  :params [(resource-id : String)]
  :from [(entry : (config resource))
         (candidate : (config revision))]
  :where [(= (field entry (config resource-id)) $resource-id)
          (= (field entry (config draft-pointer)) candidate)
          (= (field candidate (config owner-field)) entry)
          (= (field candidate (config state-field)) (config draft-state))]
  :select [(resource-id (field entry (config resource-id)))
           (revision-id (field candidate (config revision-id)))
           (title (field candidate (config title-field)))
           (summary (field candidate (config summary-field)))
           (content-source (field candidate (config content-source-field)))
           (links-to (field candidate (config links-field)))
           (author (field candidate (config author-field)))
           (created-at (field candidate (config created-at-field)))
           (digest (field candidate (config digest-field)))
           (extension-fields revision-fields candidate)]
  :result :optional)

(query history-current
  :capability read-history
  :params [(resource-id : String)]
  :from [(entry : (config resource))
         (edition : (config revision))]
  :where [(= (field entry (config resource-id)) $resource-id)
          (= (field entry (config published-pointer)) edition)
          (= (field edition (config owner-field)) entry)
          (= (field edition (config state-field)) (config published-state))]
  :select [(resource-id (field entry (config resource-id)))
           (revision-id (field edition (config revision-id)))
           (state (field edition (config state-field)))
           (title (field edition (config title-field)))
           (summary (field edition (config summary-field)))
           (author (field edition (config author-field)))
           (created-at (field edition (config created-at-field)))
           (published-at (field edition (config published-at-field)))
           (digest (field edition (config digest-field)))
           (extension-fields revision-fields edition)]
  :result :optional)

(query history-superseded
  :capability read-history
  :params [(resource-id : String)]
  :from [(entry : (config resource))
         (edition : (config revision))]
  :where [(= (field entry (config resource-id)) $resource-id)
          (= (field edition (config owner-field)) entry)
          (= (field edition (config state-field)) (config superseded-state))]
  :select [(resource-id (field entry (config resource-id)))
           (revision-id (field edition (config revision-id)))
           (state (field edition (config state-field)))
           (title (field edition (config title-field)))
           (summary (field edition (config summary-field)))
           (author (field edition (config author-field)))
           (created-at (field edition (config created-at-field)))
           (published-at (field edition (config published-at-field)))
           (digest (field edition (config digest-field)))
           (extension-fields revision-fields edition)]
  :result :page
  :page [default (config query-limits.historyDefault)
         max (config query-limits.historyMax)])

(query backlinks
  :capability read-backlinks
  :params [(resource-id : String)]
  :from [(source : (config resource))
         (published : (config revision))
         (target : (config resource))
         (target-published : (config revision))]
  :where [(= (field target (config resource-id)) $resource-id)
          (= (field target (config published-pointer)) target-published)
          (= (field target-published (config owner-field)) target)
          (= (field target-published (config state-field)) (config published-state))
          (= (field source (config published-pointer)) published)
          (= (field published (config owner-field)) source)
          (= (field published (config state-field)) (config published-state))
          (= (field published (config links-field)) target)]
  :select [(resource-id (field source (config resource-id)))
           (revision-id (field published (config revision-id)))
           (title (field published (config title-field)))
           (summary (field published (config summary-field)))
           (extension-fields revision-fields published)]
  :result :page
  :page [default (config query-limits.backlinksDefault)
         max (config query-limits.backlinksMax)])

(component browse-page
  :props [title summary]
  (main :class "wake-wiki-browse-page"
    (h1 :class "wake-wiki-page-title" :text title)
    (p :class "wake-wiki-page-summary" :text summary)))

(component new-draft-page
  :props []
  (main :class "wake-wiki-new-draft-page"
    (h1 :class "wake-wiki-page-title" :text "New draft")
    (p :class "wake-wiki-page-guidance"
      :text "Create a resource and begin its first draft.")))

(component read-page
  :props [title summary content-source]
  (main :class "wake-wiki-read-page"
    (h1 :class "wake-wiki-page-title" :text title)
    (p :class "wake-wiki-page-summary" :text summary)
    (p :class "wake-wiki-safe-text" :text content-source)))

(component edit-draft-page
  :props [title content-source]
  (main :class "wake-wiki-edit-draft-page"
    (h1 :class "wake-wiki-page-title" :text title)
    (p :class "wake-wiki-safe-text" :text content-source)))

(component review-page
  :props [draft-title draft-summary published-title published-summary]
  (main :class "wake-wiki-review-page"
    (h1 :class "wake-wiki-page-title" :text draft-title)
    (p :class "wake-wiki-page-summary" :text draft-summary)
    (section :class "wake-wiki-review-page__published"
      (h2 :class "wake-wiki-section-title" :text "Published revision")
      (when published-title
        (h3 :class "wake-wiki-review-page__published-title"
          :text published-title))
      (when published-summary
        (p :class "wake-wiki-review-page__published-summary"
          :text published-summary)))))

(component history-page
  :props [title state created-at]
  (main :class "wake-wiki-history-page"
    (h1 :class "wake-wiki-page-title" :text title)
    (p :class "wake-wiki-revision-state" :text state)
    (p :class "wake-wiki-revision-created" :text created-at)))

(component resource-card
  :props [id published-revision draft-revision]
  (section :class "wake-wiki-resource-card"
    (h2 :class "wake-wiki-resource-card__id" :text id)
    (when published-revision
      (p :class "wake-wiki-resource-card__published"
        :text published-revision))
    (when draft-revision
      (p :class "wake-wiki-resource-card__draft" :text draft-revision))))

(component revision-summary
  :props [id title summary state author created-at digest]
  (section :class "wake-wiki-revision-summary"
    (h2 :class "wake-wiki-revision-summary__title" :text title)
    (p :class "wake-wiki-revision-summary__summary" :text summary)
    (p :class "wake-wiki-revision-summary__state" :text state)
    (p :class "wake-wiki-revision-summary__id" :text id)
    (p :class "wake-wiki-revision-summary__author" :text author)
    (p :class "wake-wiki-revision-summary__created" :text created-at)
    (p :class "wake-wiki-revision-summary__digest" :text digest)))

(component safe-document
  :props [content-source]
  (div :class "wake-wiki-safe-document"
    (p :class "wake-wiki-safe-text" :text content-source)))

(component link-list
  :props [links-to]
  (section :class "wake-wiki-link-list"
    (h2 :class "wake-wiki-section-title" :text "Links")
    (p :class "wake-wiki-link-list__items" :text links-to)))

(component backlink-list
  :props [resource]
  (section :class "wake-wiki-backlink-list"
    (h2 :class "wake-wiki-section-title" :text "Backlinks")
    (p :class "wake-wiki-backlink-list__resource" :text resource)))

(component conflict-notice
  :props [message]
  (p :class "wake-wiki-conflict-notice" :text message))

(view browse-view
  :entity (config resource)
  :each browse-page
  :title "Browse published resources")

(view new-view
  :entity (config resource)
  :each new-draft-page
  :title "New draft")

(view read-view
  :entity (config resource)
  :each read-page
  :title "Published resource")

(view edit-view
  :entity (config revision)
  :each edit-draft-page
  :title "Edit draft")

(view review-view
  :entity (config revision)
  :each review-page
  :title "Review draft")

(view history-view
  :entity (config revision)
  :each history-page
  :title "Published history")

(routes :default browse
  [browse browse-view
    :queries [browse-published]
    :params []]
  [new new-view
    :queries []
    :params []]
  [read read-view
    :queries [read-published]
    :params [resource-id]]
  [edit edit-view
    :queries [read-draft]
    :params [resource-id]]
  [review review-view
    :queries [[review :as draft]
              [read-published :as published]]
    :params [resource-id]]
  [history history-view
    :queries [history-current]
    :params [resource-id]])
