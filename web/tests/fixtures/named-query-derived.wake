(ns wake.tests.named-query-derived)
(application :id "wake-named-query-derived")
(backend :fram)

(entity release
  (id : String :identity)
  (title : String)
  (label : Derived (str title)))

(query invalid-derived-projection
  :params []
  :from [(release : release)]
  :where []
  :select [(id release.id)
           (label release.label)]
  :result :page
  :page [default 10 max 20])
