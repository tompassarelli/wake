#lang beagle/js
(ns wake.tests.structural-declarations-flat-value-type
  (:require [wake.core :as wake]))

(def stray-value-type-validator? Bool true)

(wake/defvalue-type
  safe-text
  "value/safe-text"
  (wake/->StringValueType nil nil nil)
  [(alias (wake/->StringValueType nil nil nil))
   stray-value-type-validator?]
  nil)
