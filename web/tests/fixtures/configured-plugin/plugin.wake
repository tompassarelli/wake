(ns wake.fixtures.configured-plugin)

(defstate (config lifecycle)
  [(config draft-state) -> (config published-state)]
  [(config published-state) ->])

(entity (config document)
  ((config identity-field) : String :identity)
  ((config state-field) : (config lifecycle)))

(query browse
  :capability browse
  :params []
  :from [(item : (config document))]
  :where [(= (field item (config state-field)) (config published-state))]
  :select [(id (field item (config identity-field)))
           (state (field item (config state-field)))]
  :result :page
  :page [default (config limits.default) max (config limits.maximum)])
