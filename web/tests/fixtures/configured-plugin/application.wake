(ns wake.fixtures.configured-application)
(application :id "wake-configured-application")
(backend :fram)

(use "wake-configured-plugin"
  :as configured
  :version "0.1.0"
  :allow [schema query capability]
  :config [document entry
           identity-field entry-id
           state-field status
           lifecycle EntryPhase
           draft-state :working
           published-state :released
           limits [default 5 maximum 12]])

(extend configured.document-fields
  (audience : Keyword
    :storage-id "wake-configured-application/field/entry/audience"
    :required true))
