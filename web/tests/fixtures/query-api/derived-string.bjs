#lang beagle/js
(ns wake.fixtures.derived-string
  (:require [wake.core :as wake]))

(wake/defentity contact Contact
  [id: String
   name: String
   company: String
   display-name: String]
  :id
  {:name :create
   :company :create}
  [(wake/derived-field
    :display-name
    (wake/concat-derived
     [(wake/derived-ref :name)
      (wake/derived-string " @ ")
      (wake/derived-ref :company)]))])
