#lang beagle/js
(ns wake.fixtures.query-results
  (:require [wake.core :as wake]))

(wake/defentity release Release
  [id: String
   title: String
   aliases: (Vec String)
   label: String]
  :id
  {:title :create
   :aliases :create}
  [(wake/derived-field
    :label
    (wake/concat-derived [(wake/derived-ref :title)]))])

(wake/defentity release-note ReleaseNote
  [id: String
   release: (wake/Ref Release)
   summary: String]
  :id
  {:release :create
   :summary :create}
  [])

(wake/defquery release-page
  []
  [release: Release]
  "wake-tests/cap/read-release"
  []
  [(wake/select :id (wake/field :release :id))]
  (wake/page-result 20 64))

(wake/defquery release-optional
  [release-id: String]
  [release: Release]
  ["wake-tests/cap/read-release"]
  [(wake/eq
    (wake/field :release :id)
    (wake/parameter :release-id))]
  [(wake/select :id (wake/field :release :id))
   (wake/select :aliases (wake/field :release :aliases))]
  (wake/optional-result))

(wake/defquery release-one
  [release-id: String]
  [release: Release]
  ["wake-tests/cap/read-release"]
  [(wake/eq
    (wake/field :release :id)
    (wake/parameter :release-id))]
  [(wake/select :id (wake/field :release :id))
   (wake/select :title (wake/field :release :title))]
  (wake/one-result))

(wake/list-detail release-list
  :release
  "Releases"
  [:id :title]
  [:title]
  [(wake/detail-tab "Overview" (wake/detail-fields [:id :title :label]))
   (wake/detail-tab
    "Notes"
    (wake/detail-related
      :release-note
      (wake/related-by :release)
      [:id :summary]))])
