#lang beagle/js
(ns wake.fixtures.query-results
  (:require [wake.core :as wake]))

(wake/command-receipt-core)
(wake/defcapability
  read-release
  "capability/read-release"
  "read-release"
  [])

(wake/defentity-ref release "entity/release" "release")
(wake/defentity-ref release-note "entity/release-note" "release-note")

(wake/define-entity-model
  release
  Release
  "entity/release"
  [(id "entity/release/field/id" "id" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->IdentityWrite nil)
    "wake-query-api/field/release/id"
    true)
   (title "entity/release/field/title" "title" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-query-api/field/release/title"
    true)
   (aliases "entity/release/field/aliases" "aliases" (Vec String)
    (wake/->StringField nil)
    (wake/->ManyField nil)
    (wake/->CreateWrite nil)
    "wake-query-api/field/release/aliases"
    false)]
  [(label
    "entity/release/field/label"
    "label"
    (wake/->ConcatDerivedExpr
      [(wake/->FieldDerivedExpr release-title-ref)])
    [release-title-ref])]
  "wake-query-api/entity/release")

(wake/define-entity-model
  release-note
  ReleaseNote
  "entity/release-note"
  [(id "entity/release-note/field/id" "id" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->IdentityWrite nil)
    "wake-query-api/field/release-note/id"
    true)
   (release "entity/release-note/field/release" "release" (wake/Ref Release)
    (wake/->RefField (wake/->DeclaredEntityTarget release-ref))
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-query-api/field/release-note/release"
    true)
   (summary "entity/release-note/field/summary" "summary" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "wake-query-api/field/release-note/summary"
    true)]
  []
  "wake-query-api/entity/release-note")

(wake/defquery-model
  release-page
  "query/release-page"
  "release-page"
  [read-release-ref]
  []
  [(wake/->QueryBindingSpec :release release-ref)]
  []
  [(wake/->QueryValueSelection
     :id
     (wake/->QueryFieldValue :release release-id-ref))]
  (wake/->QueryPageResult
    (wake/->LiteralBound 20)
    (wake/->LiteralBound 64)))

(wake/defquery-model
  release-optional
  "query/release-optional"
  "release-optional"
  [read-release-ref]
  [(wake/->QueryParameterSpec
     :release-id
     (wake/->StringValueType nil nil nil))]
  [(wake/->QueryBindingSpec :release release-ref)]
  [(wake/->QueryEqualPredicate
     (wake/->QueryFieldValue :release release-id-ref)
     (wake/->QueryParameterValue :release-id))]
  [(wake/->QueryValueSelection
     :id
     (wake/->QueryFieldValue :release release-id-ref))
   (wake/->QueryValueSelection
     :aliases
     (wake/->QueryFieldValue :release release-aliases-ref))]
  (wake/->QueryOptionalResult nil))

(wake/defquery-model
  release-one
  "query/release-one"
  "release-one"
  [read-release-ref]
  [(wake/->QueryParameterSpec
     :release-id
     (wake/->StringValueType nil nil nil))]
  [(wake/->QueryBindingSpec :release release-ref)]
  [(wake/->QueryEqualPredicate
     (wake/->QueryFieldValue :release release-id-ref)
     (wake/->QueryParameterValue :release-id))]
  [(wake/->QueryValueSelection
     :id
     (wake/->QueryFieldValue :release release-id-ref))
   (wake/->QueryValueSelection
     :title
     (wake/->QueryFieldValue :release release-title-ref))]
  (wake/->QueryOneResult nil))

(wake/deflist-detail
  release-list
  "list-detail/release"
  "release-list"
  release-ref
  "Releases"
  [release-id-ref release-title-ref]
  [release-title-ref]
  [(wake/->FieldsDetailTab
     "Overview"
     [release-id-ref release-title-ref release-label-ref])
   (wake/->RelatedDetailTab
     "Notes"
     release-note-ref
     release-note-release-ref
     [release-note-id-ref release-note-summary-ref])])

(wake/application-root
  application
  "wake-query-api-fixture"
  (wake/->LocalStorageAuthority "wake-query-api-fixture")
  [(wake/->StorageSpec release-ref "wake-query-api/entity/release")
   (wake/->StorageSpec release-note-ref "wake-query-api/entity/release-note")]
  [(wake/->IdentitySpec release-ref release-id-ref)
   (wake/->IdentitySpec release-note-ref release-note-id-ref)]
  []
  nil
  nil
  []
  []
  [release-list-ref])
