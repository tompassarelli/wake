#lang beagle/js
(ns wake.tests.structural-declarations-flat-state
  (:require [wake.core :as wake]))

(def stray-state-value? Bool true)

(wake/defstate-model
  Lifecycle
  "state/lifecycle"
  "lifecycle"
  [(draft "state/lifecycle/draft" "draft" :draft)
   stray-state-value?]
  draft
  [(draft [])])
