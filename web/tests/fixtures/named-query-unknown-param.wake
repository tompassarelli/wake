(ns wake.tests.named-query-unknown-param)
(application :id "wake-named-query-unknown-param")
(backend :fram)

(entity release
  (id : String :identity)
  (opaque : String))

(query invalid-unknown-parameter
  :capability wake-tests/cap/read
  :params [(opaque : Opaque)]
  :from [(release : release)]
  :where [(= release.opaque $opaque)]
  :select [(id release.id)]
  :result :page
  :page [default 10 max 20])
