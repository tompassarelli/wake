#lang beagle/js
(ns wake.tests.named-query-ref-param
  (:require [wake.core :as wake]))

(wake/application application "wake-named-query-ref-param")
(wake/backend backend :fram)

(wake/defentity owner Owner
  [id: String]
  :id
  {}
  [])

(wake/defentity release Release
  [id: String
   owner: (wake/Ref Owner)]
  :id
  {}
  [])

(wake/defquery invalid-ref-parameter
  [owner: (wake/Ref)]
  [release: Release]
  "wake-tests/cap/read"
  [(wake/eq
    (wake/field :release :owner)
    (wake/parameter :owner))]
  [(wake/select :id (wake/field :release :id))]
  (wake/page-result 10 20))
