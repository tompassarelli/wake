(ns wake.fixtures.checked-beagle)
(application :id "wake-checked-beagle-fixture")
(backend :fram)

(defstate RevisionStatus
  [:draft -> :published]
  [:published ->])

(entity page
  (slug : String :identity)
  (title : String :write :create))

(entity revision
  (id : String :identity)
  (page : Ref :to page :write :create)
  (status : RevisionStatus :write :command)
  (links-to : Ref :to page :many :write :create))

(query published-revisions
  :capability wake-tests/cap/read-revisions
  :params []
  :from [(revision : revision)]
  :where [(= revision.status :published)]
  :select [(id revision.id)
           (page revision.page)
           (status revision.status)]
  :result :page
  :page [default 20 max 64])

(component revision-row
  :props [id page status]
  (div :class "revision-row"
    (span :text id)
    (span :text page)
    (span :text status)))

(view revisions
  :entity revision
  :each revision-row
  :title "Published revisions")

(routes :default revisions
  [home revisions])
