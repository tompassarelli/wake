(ns wake.compiler-contracts)
(backend :fram)

(defstate PublishStatus
  [:draft -> :published :retired]
  [:published -> :retired]
  [:retired ->])

(entity blog_post
  (slug : String :identity)
  (title : String)
  (canonical-revision : Ref :to blog-post :write :command))

(entity blog-post
  (id : String :identity)
  (blog-owner-ref : Ref :to blog_post :write :create)
  (body : String :write :create)
  (class : String :write :create)
  (1st : String :write :create)
  (foo-bar : String :write :create)
  (foo.bar : String :write :create)
  (foo_bar : String :write :create)
  (status : PublishStatus :write :command))

(entity blog-note
  (note-id : String :identity)
  (contact-ref : Ref :to blog-post :write :create)
  (summary : String :write :create)
  (status : PublishStatus :write :command))

(publication canonical
  :owner blog_post
  :pointer canonical-revision
  :revision blog-post
  :owner-field blog-owner-ref
  :state-field status
  :draft :draft
  :published :published
  :retired :retired)

(list-detail blog-post
  :title "Blog posts"
  :columns [id blog-owner-ref body class 1st foo-bar foo.bar foo_bar status]
  :search [id body class 1st foo-bar foo.bar foo_bar]
  :detail (tabs
    (tab "Overview" (fields [id blog-owner-ref body status]))
    (tab "Notes"
      (related blog-note
        :query [:find ?n :where [?n :blog-note/contact-ref ?e]]
        :display [note-id summary status]))))

(form add-blog-post
  :entity blog-post
  :fields [id blog-owner-ref body]
  :required [id blog-owner-ref body]
  :submit-label "Add blog post"
  :on-success :clear)
