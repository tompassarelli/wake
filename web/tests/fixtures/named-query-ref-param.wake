(ns wake.tests.named-query-ref-param)
(application :id "wake-named-query-ref-param")
(backend :fram)

(entity owner
  (id : String :identity))

(entity release
  (id : String :identity)
  (owner : Ref :to owner))

(query invalid-ref-parameter
  :params [(owner : Ref)]
  :from [(release : release)]
  :where [(= release.owner $owner)]
  :select [(id release.id)]
  :result :page
  :page [default 10 max 20])
