#lang beagle/js
(ns wake.tests.named-query-invalid-ref
  (:require [wake.core :as wake]))

(wake/application application "wake-named-query-invalid-ref")
(wake/backend backend :fram)

(wake/defentity release Release
  [id: String]
  :id
  {}
  [])

(wake/defentity actor Actor
  [id: String]
  :id
  {}
  [])

(wake/defentity approval Approval
  [id: String
   release: (wake/Ref Release)
   actor: (wake/Ref Actor)]
  :id
  {}
  [])

(wake/defquery invalid-reference-comparison
  [approval-id: String]
  [approval: Approval]
  "wake-tests/cap/read"
  [(wake/eq
    (wake/field :approval :id)
    (wake/parameter :approval-id))
   (wake/eq
    (wake/field :approval :release)
    (wake/field :approval :actor))]
  [(wake/select :id (wake/field :approval :id))]
  (wake/optional-result))
