#lang beagle/js
(ns wake.tests.named-query-unknown-param
  (:require [wake.core :as wake]))

(wake/application application "wake-named-query-unknown-param")
(wake/backend backend :fram)

(wake/defentity opaque-value Opaque
  [id: String]
  :id
  {}
  [])

(wake/defentity release Release
  [id: String
   opaque: String]
  :id
  {}
  [])

(wake/defquery invalid-unknown-parameter
  [opaque: Opaque]
  [release: Release]
  "wake-tests/cap/read"
  [(wake/eq
    (wake/field :release :opaque)
    (wake/parameter :opaque))]
  [(wake/select :id (wake/field :release :id))]
  (wake/page-result 10 20))
