#lang beagle/js
(ns wake.fixtures.macro-provenance.application
  (:require [wake.core :as wake]))

(def plugin-bindings: wake/PluginBindings
  (wake/->PluginBindings [] [] [] [] [] [] [] [] [] []))

(wake/use-plugin
  wiki
  "plugin-use/wiki"
  "dev.greywrought.wiki"
  "0.1.0"
  [(wake/->SchemaContribution nil)
   (wake/->QueryContribution nil)]
  plugin-bindings
  []
  []
  []
  [])

(wake/application-root
  application
  "greywrought-wiki"
  (wake/->MemoryAuthority "greywrought-wiki")
  []
  []
  [wiki-composition])
