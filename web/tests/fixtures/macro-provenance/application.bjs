#lang beagle/js
(ns wake.fixtures.macro-provenance.application
  (:require [wake.core :as wake]))

(wake/defstate-model
  publication-state
  "host/state/publication"
  "publication-state"
  [[working "host/state/publication/value/working" "working" :working]
   [released "host/state/publication/value/released" "released" :released]
   [retired "host/state/publication/value/retired" "retired" :retired]]
  working
  [[working [released retired]]
   [released [retired]]
   [retired []]])

(wake/defentity-ref principal "host/entity/principal" "principal")
(wake/defentity-ref article "host/entity/article" "article")

(wake/define-entity-model
  principal
  Principal
  "host/entity/principal"
  [[id "host/entity/principal/field/id" "id" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->IdentityWrite nil)
    "greywrought/principal/id"
    true]
   [display-name
    "host/entity/principal/field/display-name"
    "display-name"
    String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->CommandFieldWrite nil)
    "greywrought/principal/display-name"
    true]]
  []
  "greywrought/principal")

(wake/define-entity-model
  article
  Article
  "host/entity/article"
  [[id "host/entity/article/field/id" "id" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->IdentityWrite nil)
    "greywrought/article/id"
    true]
   [title "host/entity/article/field/title" "title" String
    (wake/->StringField nil)
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "greywrought/article/title"
    true]
   [kind "host/entity/article/field/kind" "kind" Keyword
    (wake/->KeywordField nil)
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "greywrought/article/kind"
    true]
   [current-revision
    "host/entity/article/field/current-revision"
    "current-revision"
    String
    (wake/->RefField (wake/->DeclaredEntityTarget article-ref))
    (wake/->SingleField nil)
    (wake/->SetWrite nil)
    "greywrought/article/current-revision"
    false]
   [owner "host/entity/article/field/owner" "owner" String
    (wake/->RefField (wake/->DeclaredEntityTarget article-ref))
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "greywrought/article/owner"
    true]
   [status "host/entity/article/field/status" "status" Keyword
    (wake/->StateField publication-state-ref)
    (wake/->SingleField nil)
    (wake/->CommandFieldWrite nil)
    "greywrought/article/status"
    true]]
  []
  "greywrought/article")

(wake/defcomponent-model
  greywrought-card
  "host/component/article-card"
  [(wake/->ComponentPropertySpec
     :title
     (wake/->StringValueType nil nil nil))]
  [(wake/->Element :article {} [])])

(wake/defpublication
  article-publication
  "host/publication/article"
  "article-publication"
  article-ref
  article-current-revision-ref
  article-ref
  article-owner-ref
  article-status-ref
  publication-state-working-ref
  publication-state-released-ref
  publication-state-retired-ref)

(wake/defform
  article-form
  "host/form/article"
  "article-form"
  article-ref
  [article-title-ref article-kind-ref]
  [article-title-ref]
  "Save article"
  (wake/->ClearFormSuccess nil))

(wake/deflist-detail
  article-list-detail
  "host/list-detail/article"
  "article-list-detail"
  article-ref
  "Articles"
  [article-title-ref article-status-ref]
  [article-title-ref]
  [(wake/->FieldsDetailTab
     "Overview"
     [article-title-ref article-kind-ref article-status-ref])
   (wake/->RelatedDetailTab
     "Revisions"
     article-ref
     article-owner-ref
     [article-title-ref article-status-ref])])

(wake/defview-model
  article-view
  "host/view/article"
  "articles"
  article-ref
  greywrought-card-ref
  "Articles"
  article-form-ref
  greywrought-card-ref)

(wake/defplugin-use wiki "plugin-use/wiki")

(wake/imported-int-binding
  wiki-page-limit
  wiki-ref
  "config/page-limit"
  "page-limit"
  20)

(wake/imported-string-binding
  wiki-site-title
  wiki-ref
  "config/site-title"
  "site-title"
  "Greywrought")

(wake/imported-bool-binding
  wiki-show-history
  wiki-ref
  "config/show-history"
  "show-history"
  true)

(wake/imported-keyword-binding
  wiki-draft-label
  wiki-ref
  "config/draft-label"
  "draft-label"
  :working)

(wake/imported-entity-name-binding
  wiki-resource-entity
  wiki-ref
  "config/resource"
  "resource-entity"
  (wake/->EntityDeclarationName "article"))

(wake/imported-field-name-binding
  wiki-title-field
  wiki-ref
  "config/title-field"
  "title-field"
  (wake/->EntityFieldDeclarationNameValue
    (wake/->FieldDeclarationName "title")))

(wake/imported-state-name-binding
  wiki-lifecycle
  wiki-ref
  "config/lifecycle"
  "lifecycle"
  (wake/->StateDeclarationName "publication-state"))

(wake/imported-state-value-name-binding
  wiki-published-state
  wiki-ref
  "config/published-state"
  "published-state"
  (wake/->StateValueDeclarationName :released))

(wake/imported-external-entity-binding
  wiki-actor-entity
  wiki-ref
  "config/actor-entity"
  "actor-entity"
  principal-ref)

(wake/imported-value-binding
  wiki-safe-document-limits
  wiki-ref
  "config/safe-document-limits"
  "safe-document-limits"
  (wake/->RecordValue
    [(wake/->ValueRecordEntry
       :maxBytes
       (wake/->LiteralIntegerValue 262144))
     (wake/->ValueRecordEntry
       :maxDepth
       (wake/->LiteralIntegerValue 8))
     (wake/->ValueRecordEntry
       :maxNodes
       (wake/->LiteralIntegerValue 2048))]))

(wake/imported-value-binding
  wiki-content-limits
  wiki-ref
  "config/content-limits"
  "content-limits"
  (wake/->RecordValue
    [(wake/->ValueRecordEntry
       :links
       (wake/->LiteralIntegerValue 64))]))

(wake/defplugin-bindings
  plugin-bindings
  [wiki-page-limit]
  [wiki-site-title]
  [wiki-show-history]
  [wiki-draft-label]
  [wiki-resource-entity]
  [wiki-title-field]
  [wiki-lifecycle]
  [wiki-published-state]
  [wiki-actor-entity]
  [wiki-safe-document-limits wiki-content-limits])

(wake/bind-provider
  content-provider
  wiki-ref
  "provider-port/content-parser"
  "content-parser"
  "greywrought-markdown")

(wake/extend-entity-fields
  article-fields-extension
  wiki-ref
  "entity-fields-port/revision-fields"
  "revision-fields"
  [[kind
    "entity-fields-port/revision-fields/field/kind"
    "kind"
    (wake/->KeywordField nil)
    (wake/->SingleField nil)
    (wake/->CreateWrite nil)
    "greywrought/article/kind"
    true]])

(wake/fill-component-slot
  article-card-fill
  wiki-ref
  "component-slot/article-card"
  "article-card"
  greywrought-card-ref)

(wake/mount-route-slot
  history-mount
  wiki-ref
  "route-slot/history"
  "history"
  "/articles/:article-id/history")

(wake/use-plugin
  wiki
  "dev.greywrought.wiki"
  "0.1.0"
  [(wake/->SchemaContribution nil)
   (wake/->QueryContribution nil)
   (wake/->CommandContribution nil)
   (wake/->CapabilityContribution nil)
   (wake/->UiContribution nil)
   (wake/->RouteContribution nil)]
  plugin-bindings
  [content-provider]
  [article-fields-extension]
  [article-card-fill]
  [history-mount])

(wake/application-root
  application
  "greywrought-wiki"
  (wake/->FramAuthority "fram")
  [(wake/->StorageSpec article-ref "greywrought/article")]
  [(wake/->IdentitySpec article-ref article-id-ref)]
  [wiki-composition]
  (wake/->MountedDefaultRoute history-mount-ref)
  (wake/->ThemeSpec {"accent" "#6750a4"})
  [article-publication-ref]
  [article-form-ref]
  [article-list-detail-ref])
