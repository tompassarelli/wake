#lang beagle/js
(ns wake.fixtures.beagle-source
  (:require [wake.dsl :as wake]))

(wake/application application "wake-beagle-source-fixture")
(wake/backend backend :fram)

(wake/defstate revision-status RevisionStatus
  [draft published]
  :draft
  {:draft [:published]
   :published []})

(wake/defentity page Page
  [slug: String
   title: String]
  :slug
  {:title :create})

(wake/defentity revision Revision
  [id: String
   page: (wake/Ref Page)
   status: RevisionStatus
   links-to: (Vec (wake/Ref Page))]
  :id
  {:page :create
   :status :command
   :links-to :create})

(wake/defquery published-revisions
  []
  [revision: Revision]
  ["wake-tests/cap/read-revisions"]
  [(wake/eq
     (wake/field :revision :status)
     (wake/tag :published))]
  [(wake/select :id (wake/field :revision :id))
   (wake/select :page (wake/field :revision :page))
   (wake/select :status (wake/field :revision :status))]
  :page
  20
  64)

(wake/component revision-row
  [id: String
   page: (wake/Ref Page)
   status: RevisionStatus]
  [(wake/element
    :div
    {:class (wake/static-attr "revision-row")}
    [(wake/element :span {:text (wake/bind-attr :id)} [])
     (wake/element :span {:text (wake/bind-attr :page)} [])
     (wake/element :span {:text (wake/bind-attr :status)} [])])])

(wake/view revisions :revision :revision-row "Published revisions")

(wake/routes application-routes
  :revisions
  [(wake/route :revisions :revisions)])
