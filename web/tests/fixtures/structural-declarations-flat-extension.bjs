#lang beagle/js
(ns wake.tests.structural-declarations-flat-extension
  (:require [wake.core :as wake]))

(def stray-extension-validator? Bool true)

(wake/defplugin-use remote "plugin-use/remote")

(wake/extend-entity-fields
  extra-fields
  remote-ref
  "fields"
  "fields"
  [(extra
     "fields/extra"
     "extra"
     (wake/->StringField nil)
     (wake/->SingleField nil)
     (wake/->CreateWrite nil)
     "store/item/extra"
     true)
   stray-extension-validator?])
