#lang beagle/js
(ns wake.tests.structural-declarations-parenthesized
  (:require [wake.core :as wake]))

(def validator? Bool true)

(wake/defstate-model
  Lifecycle
  "state/lifecycle"
  "lifecycle"
  [(draft "state/lifecycle/draft" "draft" :draft)]
  draft
  [(draft [])])

(wake/defentity-ref item "entity/item" "item")

(wake/define-entity-model
  item
  Item
  "entity/item"
  [(id
     "entity/item/id"
     "id"
     String
     (wake/->StringField nil)
     (wake/->SingleField nil)
     (wake/->IdentityWrite nil)
     "store/item/id"
     validator?)]
  [(label
     "entity/item/label"
     "label"
     (wake/->StringDerivedExpr "label")
     [])]
  "store/item")

(wake/defvalue-type
  safe-text
  "value/safe-text"
  (wake/->StringValueType nil nil nil)
  [(alias (wake/->StringValueType nil nil nil))]
  nil)

(wake/defplugin-use remote "plugin-use/remote")

(wake/extend-entity-fields
  extra-fields
  remote-ref
  "fields"
  "fields"
  [(extra
     "fields/extra"
     "extra"
     (wake/->StringField nil)
     (wake/->SingleField nil)
     (wake/->CreateWrite nil)
     "store/item/extra"
     validator?)])
