(ns wake.fixtures.named-query)
(application :id "wake-named-query-fixture")
(backend :fram)

(defstate ReleaseState
  [:draft -> :published]
  [:published ->])

(entity release
  (id : String :identity)
  (state : ReleaseState :write :command)
  (tags : String :many :write :create))

(entity approval
  (id : String :identity)
  (release : Ref :to release :write :create)
  (state : String :write :create))

(query browse-releases
  :params []
  :from [(release : release)]
  :where [(= release.state :published)]
  :select [(id release.id)
           (state release.state)]
  :result :page
  :page [default 20 max 64])

(query release-by-id
  :params [(release-id : String)]
  :from [(release : release)]
  :where [(= (field release id) $release-id)]
  :select [(id (field release id))
           (state release.state)
           (tags release.tags)]
  :result :optional)

(query approvals-for-release
  :params [(release-id : String)]
  :from [(release : release)
         (approval : approval)]
  :where [(= release.id $release-id)
          (= approval.release release)
          (= approval.state "approved")]
  :select [(release-id release.id)
           (approval-id approval.id)]
  :result :page
  :page [default 10 max 40])

(list-detail release
  :title "Releases"
  :columns [id state])
