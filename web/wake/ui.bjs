#lang beagle/js
(ns wake.ui)

;; UI Graph — general primitives for data-bound views.
;;
;; No CRM-specific concepts here. A list-detail view is just a
;; composition of these primitives, not a privileged shape.
;;
;; Graph the meaning (bindings, queries, conditions).
;; Compile the motion (DOM ops, update paths).

;; --- UI node types ---

(defrecord UiComponent [(name String) (children Any)])

(defrecord UiBind [(target String) (field String) (prop String)])

(defrecord UiQuery [(store String) (sort_by Any) (filter_by Any)])

(defrecord UiEach [(query Any) (item_component Any)])

(defrecord UiWhen [(condition Any) (then Any) (otherwise Any)])

(defrecord UiAction [(event String) (handler_type String) (config Any)])

(defrecord UiElement
  [(tag String) (css_class String) (attrs Any) (children Any)])

(defrecord UiText [(content String)])

(defrecord UiStore [(name String) (entity String) (fk_methods (Vec String))])

(defrecord UiState [(name String) (initial Any)])

;; --- Expanded UI graph types ---

(defrecord UiRelated
  [(entity String)
   (store String)
   (fk_field String)
   (key String)
   (label String)
   (display (Vec String))])

(defrecord UiFieldInfo [(name String) (kind String) (options (Vec String))])

(defrecord UiForm
  [(name String)
   (fields (Vec String))
   (required (Vec String))
   (label String)
   (status_default String?)
   (field_info (Vec UiFieldInfo))])

(defrecord UiGraph
  [(entity String)
   (store_name String)
   (title String)
   (columns (Vec String))
   (search_cols (Vec String))
   (overview_fields Any)
   (derived Any)
   (related (Vec UiRelated))
   (stores (Vec UiStore))
   (states (Vec UiState))
   (form UiForm?)
   (persist Any)
   (all_field_info (Vec UiFieldInfo))])

;; --- Expansion: list-detail → UI graph ---

(js/export
 (defn expand-list-detail [(graph Any) (ld Any) (sf Any)] UiGraph
  (let [en (js/get ld .entity_name)
        ge (first (filterv (fn [e] Bool (= (js/get e .name) en)) (js/get graph .entities)))
        store-name (js/get ge .store_name)
        columns (js/get ld .columns)
        search-cols (or (js/get ld .search_cols) columns)
        detail-tabs (or (js/get ld .detail_tabs) [])
        overview-tab (first (filterv (fn [t] Bool (= (js/get t .content_type) "fields")) detail-tabs))
        related-tabs (filterv (fn [t] Bool (= (js/get t .content_type) "related")) detail-tabs)
        requested-overview-fields
        (if (nil? overview-tab) columns (js/get overview-tab .fields))
        derived (js/get ge .derived_fields)
        derived-names (mapv (fn [field] String (js/get field .name)) derived)
        overview-fields
        (filterv
          (fn [field] Bool (not (js/call derived-names .includes field)))
          requested-overview-fields)
        title (or (js/get ld .title) en)

        related (mapv (fn [rt] UiRelated
          (let [rel-en (js/get rt .entity_name)
                rel-display (js/get rt .display_fields)
                rel-ge (first (filterv (fn [e] Bool (= (js/get e .name) rel-en)) (js/get graph .entities)))
                fk-field (js/get rt .relation_field)]
            (->UiRelated rel-en (js/get rel-ge .store_name) fk-field
                         (js/call (js/get rt .label) .toLowerCase) (js/get rt .label)
                         (or rel-display []))))
          related-tabs)

        form-fields (if (nil? sf) [] (or (js/get sf .fields) []))
        form-required (if (nil? sf) [] (or (js/get sf .required) []))
        form-label (if (nil? sf) "Submit" (or (js/get sf .submit_label) "Submit"))
        form-name (if (nil? sf) "" (js/get sf .name))

        stores (into
          [(->UiStore store-name en [])]
          (mapv (fn [r] UiStore (->UiStore (js/get r .store) (js/get r .entity) [(js/get r .fk_field)])) related))

        states [(->UiState "selectedEid" nil)
                (->UiState "activeTab" "overview")
                (->UiState "searchTerm" "")]

        status-default (let [sm (first (filterv
                          (fn [m] Bool (= (js/get m .entity) en))
                          (js/get graph .state_machines)))]
                        (if (nil? sm) nil
                          (let [s (js/get sm .initial)]
                            (if (js/call s .startsWith ":") (subs s 1) s))))

        all-fields (js/get ge .fields)
        sms (js/get graph .state_machines)

        build-fi (fn [fname] UiFieldInfo
          (let [gf (first (filterv (fn [f] Bool (= (js/get f .name) fname)) all-fields))
                typ (if (nil? gf) "String" (js/get gf .type))
                sm (first (filterv (fn [m] Bool (= (js/get m .state_type) typ)) sms))
                strip (fn [s] String (if (js/call s .startsWith ":") (subs s 1) s))]
            (cond
              (not (nil? sm))
                (->UiFieldInfo fname "select" (mapv strip (keys (js/get sm .transitions))))
              (= typ "Bool")
                (->UiFieldInfo fname "checkbox" [])
              (= typ "Date")
                (->UiFieldInfo fname "date" [])
              (= typ "Int")
                (->UiFieldInfo fname "number" [])
              :else
                (->UiFieldInfo fname "text" []))))

        field-info (mapv build-fi form-fields)
        form
        (if (nil? sf)
          nil
          (->UiForm
            form-name form-fields form-required form-label
            status-default field-info))
        all-fi (mapv (fn [f] UiFieldInfo (build-fi (js/get f .name))) all-fields)]

    (->UiGraph en store-name title columns search-cols overview-fields
               derived related stores states
               form
               (js/get graph .persist) all-fi))))
