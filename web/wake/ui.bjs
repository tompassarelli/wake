#lang beagle/js
(ns wake.ui)

;; UI Graph — general primitives for data-bound views.
;;
;; No CRM-specific concepts here. A list-detail view is just a
;; composition of these primitives, not a privileged shape.
;;
;; Graph the meaning (bindings, queries, conditions).
;; Compile the motion (DOM ops, update paths).

;; --- UI node types ---

(defrecord UiComponent
  [name String
   children Any])

(defrecord UiBind
  [target String
   field String
   prop String])

(defrecord UiQuery
  [store String
   sort_by Any
   filter_by Any])

(defrecord UiEach
  [query Any
   item_component Any])

(defrecord UiWhen
  [condition Any
   then Any
   otherwise Any])

(defrecord UiAction
  [event String
   handler_type String
   config Any])

(defrecord UiElement
  [tag String
   css_class String
   attrs Any
   children Any])

(defrecord UiText [content String])

(defrecord UiStore
  [name String
   entity String
   fk_methods (Vec String)])

(defrecord UiState
  [name String
   initial Any])

;; --- Expanded UI graph types ---

(defrecord UiRelated
  [entity String
   store String
   fk_field String
   key String
   label String
   display (Vec String)])

(defrecord UiFieldInfo
  [name String
   kind String
   options (Vec String)])

(defrecord UiForm
  [name String
   fields (Vec String)
   required (Vec String)
   label String
   status_default String?
   field_info (Vec UiFieldInfo)])

(defrecord UiGraph
  [entity String
   store_name String
   title String
   columns (Vec String)
   search_cols (Vec String)
   overview_fields Any
   derived Any
   related (Vec UiRelated)
   stores (Vec UiStore)
   states (Vec UiState)
   form UiForm?
   persist Any
   all_field_info (Vec UiFieldInfo)])

;; --- Expansion: list-detail → UI graph ---

(js/export
 (defn expand-list-detail
   [graph Any
    ld Any
    sf Any] UiGraph
   (let [en String (.-entity_name ld)
         ge Any (first (filterv (fn [e Any] Bool (= (.-name e) en)) (.-entities graph)))
         store-name String (.-store_name ge)
         columns (Vec String) (.-columns ld)
         search-cols (Vec String) (or (.-search_cols ld) columns)
         detail-tabs (Vec Any) (or (.-detail_tabs ld) [])
         overview-tab Any (first (filterv (fn [t Any] Bool (= (.-content_type t) "fields")) detail-tabs))
         related-tabs (Vec Any) (filterv (fn [t Any] Bool (= (.-content_type t) "related")) detail-tabs)
         requested-overview-fields (Vec String) (if (nil? overview-tab) columns (.-fields overview-tab))
         derived (Vec Any) (.-derived_fields ge)
         derived-names (Vec String) (mapv (fn [field Any] String (.-name field)) derived)
         overview-fields (Vec String) (filterv (fn [field String] Bool (not (.includes derived-names field))) requested-overview-fields)
         title String (or (.-title ld) en)
         related (Vec UiRelated) (mapv
           (fn [rt Any] UiRelated
             (let [rel-en String (.-entity_name rt)
                   rel-display (Vec String) (.-display_fields rt)
                   rel-ge Any (first (filterv (fn [e Any] Bool (= (.-name e) rel-en)) (.-entities graph)))
                   fk-field String (.-relation_field rt)]
               (->UiRelated rel-en (.-store_name rel-ge) fk-field
                            (.toLowerCase (.-label rt))
                            (.-label rt) (or rel-display []))))
           related-tabs)
         form-fields (Vec String) (if (nil? sf) [] (or (.-fields sf) []))
         form-required (Vec String) (if (nil? sf) [] (or (.-required sf) []))
         form-label String (if (nil? sf) "Submit" (or (.-submit_label sf) "Submit"))
         form-name String (if (nil? sf) "" (.-name sf))
         stores (Vec UiStore) (into [(->UiStore store-name en [])]
               (mapv (fn [r UiRelated] UiStore
                       (->UiStore (.-store r) (.-entity r) [(.-fk_field r)]))
                     related))
         states (Vec UiState) [(->UiState "selectedEid" nil)
          (->UiState "activeTab" "overview")
          (->UiState "searchTerm" "")]
         status-default String? (let [sm Any (first (filterv (fn [m Any] Bool (= (.-entity m) en))
                               (.-state_machines graph)))]
           (if (nil? sm)
             nil
             (let [s String (.-initial sm)]
               (if (.startsWith s ":") (subs s 1) s))))
         all-fields (Vec Any) (.-fields ge)
         sms (Vec Any) (.-state_machines graph)
         build-fi (Fn [String] UiFieldInfo) (fn [fname String] UiFieldInfo
           (let [gf Any (first (filterv (fn [f Any] Bool (= (.-name f) fname)) all-fields))
                 typ String (if (nil? gf) "String" (.-type gf))
                 sm Any (first (filterv (fn [m Any] Bool (= (.-state_type m) typ)) sms))
                 strip (Fn [String] String) (fn [s String] String
                   (if (.startsWith s ":") (subs s 1) s))]
             (cond
               (not (nil? sm))
               (->UiFieldInfo fname "select" (mapv strip (keys (.-transitions sm))))
               (= typ "Bool") (->UiFieldInfo fname "checkbox" [])
               (= typ "Date") (->UiFieldInfo fname "date" [])
               (= typ "Int") (->UiFieldInfo fname "number" [])
               :else (->UiFieldInfo fname "text" []))))
         field-info (Vec UiFieldInfo) (mapv build-fi form-fields)
         form UiForm? (if (nil? sf)
           nil
           (->UiForm form-name form-fields form-required form-label status-default field-info))
         all-fi (Vec UiFieldInfo) (mapv (fn [f Any] UiFieldInfo (build-fi (.-name f))) all-fields)]
     (->UiGraph en store-name title columns search-cols overview-fields
               derived related stores states
               form
               (.-persist graph) all-fi))))
