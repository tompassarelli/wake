         (->ProviderBindingSpec ~provider-name ~ref-binding)))))

(defmacro extend-entity-fields [binding Symbol use Any declaration-id Any remote-name Any fields Any]
  (let [checked-field-collection (Vec Any)
        (if (vector? fields)
          fields
          (error
            "Invalid extension field declarations: " fields "\n\n"
            "Extension field declarations must be a vector of complete forms."))
        field-structure String
        (str
          "(name declaration-id public-name value-type cardinality "
          "write-mode storage-id required)")
        checked-fields (Vec Any)
        (map-indexed
          (fn [index Int field Any] Any
            (if (list? field)
              (if (= (count field) 8)
                field
                (syntax-error-at fields index
                  "Invalid extension field declaration: " field "\n\n"
                  "Each extension field must be one complete form:\n"
                  "  " field-structure))
              (syntax-error-at fields index
                "Invalid extension field declaration: " field "\n\n"
                "Each extension field must be one complete form:\n"
                "  " field-structure)))
          checked-field-collection)
        ref-binding Symbol (format-symbol "~a-ref" binding)
        provenance-token String
        (str "wake:macro:imported-entity-fields:" declaration-id)
        field-ref-name (Fn [Symbol] Symbol)
        (fn [field-name Symbol] Symbol
          (format-symbol "~a-~a-ref" binding field-name))
        field-spec-name (Fn [Symbol] Symbol)
        (fn [field-name Symbol] Symbol
          (format-symbol "~a-~a-spec" binding field-name))
        field-definitions (List Any)
        (mapcat
          (fn [field Any] (List Any)
            (let [field-name Symbol (first field)
                  field-declaration-id Any (second field)
                  public-name Any (nth field 2)
                  value-type Any (nth field 3)
                  cardinality Any (nth field 4)
                  write Any (nth field 5)
                  storage-id Any (nth field 6)
                  required Any (nth field 7)
                  field-ref-binding Symbol (field-ref-name field-name)
                  field-spec-binding Symbol (field-spec-name field-name)
                  field-provenance-token String
                  (str "wake:macro:extension-field:" field-declaration-id)]
              (list
                `(def ~field-ref-binding ExtensionFieldRef
                   (->ExtensionFieldRef
                     ~field-declaration-id
                     ~public-name
                     ~field-provenance-token))
                `(def ~field-spec-binding ExtensionFieldSpec
                   (->ExtensionFieldSpec
                     ~field-ref-binding
                     ~value-type
                     ~cardinality
                     ~write
                     ~storage-id
                     ~required)))))
          checked-fields)
        field-specs (Vec Symbol)
        (apply vec
          (map
            (fn [field Any] Symbol
              (field-spec-name (first field)))
            checked-fields))]
    `(do
       (def ~ref-binding ImportedEntityFieldsPortRef
         (->ImportedEntityFieldsPortRef
           ~use
           ~declaration-id
           ~remote-name
           ~provenance-token))
       ~@field-definitions
       (def ~binding ExtendSpec
         (->ExtendSpec ~ref-binding ~field-specs)))))

