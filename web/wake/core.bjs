#lang beagle/js
(ns wake.core)

;; Wake declarations remain ordinary typed Beagle data. The macros below only
;; introduce Beagle definitions whose checked AST is elaborated by Wake.

(js/export
  (defunion (Ref T)
    (WakeRef [(id String)])))

;; Nominal references carry declaration identity and checked-source provenance.
(js/export
  (defrecord EntityRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord FieldRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord StateRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord StateValueRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ValueTypeRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ProviderPortRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord RendererRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord CapabilityRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord QueryRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord CommandRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ComponentRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ViewRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord RouteTemplateRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord PublicationRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord FormRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ListDetailRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ReceiptEntityRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ReceiptFieldRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ExtensionFieldRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord EntityFieldsPortRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ComponentSlotRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord RouteSlotRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord PluginUseRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord IntRoleRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord StringRoleRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord BoolRoleRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord KeywordRoleRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord EntityNameRoleRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord FieldNameRoleRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord StateNameRoleRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord StateValueNameRoleRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ExternalEntityRoleRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ValueRoleRef
    [(declaration-id String) (name String) (provenance-token String)]))

(js/export
  (defrecord ImportedIntRoleRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedStringRoleRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedBoolRoleRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedKeywordRoleRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedEntityNameRoleRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedFieldNameRoleRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedStateNameRoleRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedStateValueNameRoleRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedExternalEntityRoleRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedValueRoleRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedProviderPortRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedEntityFieldsPortRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedComponentSlotRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord ImportedRouteSlotRef
    [(use PluginUseRef)
     (declaration-id String)
     (name String)
     (provenance-token String)]))

(js/export
  (defrecord EntityDeclarationName [(value String)]))

(js/export
  (defrecord FieldDeclarationName [(value String)]))

(js/export
  (defrecord ReceiptFieldDeclarationName [(value String)]))

(js/export
  (defrecord StateDeclarationName [(value String)]))

(js/export
  (defrecord StateValueDeclarationName [(value Keyword)]))

(js/export
  (defunion AuthoritySpec
    (FramAuthority [(service String)])
    (LocalStorageAuthority [(namespace String)])
    (MemoryAuthority [(namespace String)])))

(js/export
  (defrecord StorageSpec [(entity EntityRef) (storage-id String)]))

(js/export
  (defrecord IdentitySpec [(entity EntityRef) (field FieldRef)]))

(js/export
  (defunion EntityReferenceTarget
    (DeclaredEntityTarget [(entity EntityRef)])
    (ExternalEntityTarget [(role ExternalEntityRoleRef)])))

(js/export
  (defunion EntityFieldsTarget
    (DeclaredEntityFieldsTarget [(entity EntityRef)])
    (ReceiptEntityFieldsTarget [(entity ReceiptEntityRef)])))

(js/export
  (defunion FieldCardinality
    (SingleField [(unit Nil)])
    (ManyField [(unit Nil)])))

(js/export
  (defunion FieldWriteMode
    (IdentityWrite [(unit Nil)])
    (CreateWrite [(unit Nil)])
    (SetWrite [(unit Nil)])
    (CommandFieldWrite [(unit Nil)])
    (ServerWrite [(unit Nil)])))

(js/export
  (defunion FieldValueType
    (StringField [(unit Nil)])
    (IntField [(unit Nil)])
    (BoolField [(unit Nil)])
    (KeywordField [(unit Nil)])
    (InstantField [(unit Nil)])
    (DigestField [(unit Nil)])
    (StateField [(state StateRef)])
    (RefField [(target EntityReferenceTarget)])
    (ValueField [(value-type ValueTypeRef)])))

(js/export
  (defrecord FieldSpec
    [(ref FieldRef)
     (owner EntityRef)
     (value-type FieldValueType)
     (cardinality FieldCardinality)
     (write FieldWriteMode)
     (storage-id String?)
     (required Bool)]))

(js/export
  (defunion DerivedExpr
    (FieldDerivedExpr [(field FieldRef)])
    (StringDerivedExpr [(value String)])
    (ConcatDerivedExpr [(parts (Vec DerivedExpr))])))

(js/export
  (defrecord DerivedFieldSpec
    [(ref FieldRef)
     (owner EntityRef)
     (expression DerivedExpr)
     (dependencies (Vec FieldRef))]))

(js/export
  (defrecord EntityDeclarationSpec
    [(ref EntityRef)
     (record-name String)
     (fields (Vec FieldSpec))
     (derived-fields (Vec DerivedFieldSpec))
     (storage-id String?)]))

(js/export
  (defrecord StateValueSpec
    [(ref StateValueRef) (state StateRef) (value Keyword)]))

(js/export
  (defrecord StateTransitionSpec [(from StateValueRef) (to (Vec StateValueRef))]))

(js/export
  (defrecord StateDeclarationSpec
    [(ref StateRef)
     (values (Vec StateValueSpec))
     (initial StateValueRef)
     (transitions (Vec StateTransitionSpec))]))

(js/export
  (defrecord ConfigProjection [(role ValueRoleRef) (path (Vec String))]))

(js/export
  (defunion CommandExpr
    (CommandInputExpr [(name Keyword)])
    (CommandInjectedExpr [(name Keyword)])
    (CommandStringExpr [(value String)])
    (CommandIntExpr [(value Int)])
    (CommandBoolExpr [(value Bool)])
    (CommandKeywordExpr [(value Keyword)])
    (CommandNilExpr [(unit Nil)])
    (CommandActorExpr [(field Keyword)])
    (CommandReceiptTimeExpr [(unit Nil)])
    (CommandRecordExpr [(fields (Vec CommandRecordField))])
    (CommandExtensionExpr [(port EntityFieldsPortRef) (input Keyword)])
    (CommandConfiguredExpr [(projection ConfigProjection)])
    (CommandStateValueExpr [(value StateValueRef)])))

(js/export
  (defrecord CommandRecordField [(name Keyword) (value CommandExpr)]))

(js/export
  (defunion CommandPredicate
    (EqualPredicate [(left CommandExpr) (right CommandExpr)])
    (NonNullPredicate [(value CommandExpr)])
    (NotContainsPredicate [(collection CommandExpr) (value CommandExpr)])))

(js/export
  (defrecord CommandGuardSpec
    [(entity EntityRef)
     (id CommandExpr)
     (field FieldRef)
     (expected CommandExpr)
     (when CommandPredicate?)]))

(js/export
  (defrecord CommandWrite
    [(field FieldRef)
     (value CommandExpr)
     (allowed-current CommandExpr?)
     (omit-if-null Bool)]))

(js/export
  (defunion CommandWriteSpec
    (FieldCommandWrite [(write CommandWrite)])
    (ExtensionCommandWrite [(port EntityFieldsPortRef) (input Keyword)])))

(js/export
  (defunion CommandStep
    (AssertStep [(predicate CommandPredicate)])
    (RequireStep [(entity EntityRef) (id CommandExpr) (when CommandPredicate?)])
    (RequireEachStep [(entity EntityRef) (ids CommandExpr)])
    (GuardStep [(guard CommandGuardSpec)])
    (CreateStep
      [(entity EntityRef) (id CommandExpr) (fields (Vec CommandWriteSpec))])
    (UpdateStep
      [(entity EntityRef)
       (id CommandExpr)
       (fields (Vec CommandWriteSpec))
       (when CommandPredicate?)])))

(js/export
  (defrecord CommandInputField [(name Keyword) (value-type ValueTypeSpec)]))

(js/export
  (defunion CommandInjection
    (GeneratedIdInjection [(name Keyword)])
    (ProviderInjection
      [(name Keyword)
       (port ProviderPortRef)
       (input CommandExpr)
       (output ValueTypeSpec)])
    (ValidateWithInjection [(port ProviderPortRef) (input CommandExpr)])
    (CanonicalDigestInjection [(name Keyword) (input CommandExpr)])))

(js/export
  (defrecord CommandResultField
    [(name Keyword) (value-type ValueTypeSpec) (value CommandExpr)]))

(js/export
  (defrecord ReceiptResultField [(name Keyword) (field ReceiptFieldRef)]))

(js/export
  (defrecord ReceiptEntitySpec [(ref ReceiptEntityRef) (storage-id String)]))

(js/export
  (defrecord ReceiptFieldDeclarationSpec
    [(ref ReceiptFieldRef)
     (owner ReceiptEntityRef)
     (value-type ValueTypeSpec)
     (target EntityRef?)
     (storage-id String)]))

(js/export
  (defrecord ReceiptSpec
    [(results (Vec ReceiptResultField)) (extensions (Vec EntityFieldsPortRef))]))

(js/export
  (defrecord CommandSpec
    [(ref CommandRef)
     (capabilities (Vec CapabilityRef))
     (normalizer-version Int)
     (input (Vec CommandInputField))
     (injections (Vec CommandInjection))
     (steps (Vec CommandStep))
     (result (Vec CommandResultField))
     (receipt ReceiptSpec)]))

(js/export
  (defrecord CapabilitySpec
    [(ref CapabilityRef) (guards (Vec CommandGuardSpec))]))

(js/export
  (defrecord ValueRecordEntry [(name Keyword) (value ValueExpr)]))

(js/export
  (defunion ValueExpr
    (LiteralStringValue [(value String)])
    (LiteralIntegerValue [(value Int)])
    (LiteralBooleanValue [(value Bool)])
    (LiteralKeywordValue [(value Keyword)])
    (LiteralNilValue [(unit Nil)])
    (RecordValue [(fields (Vec ValueRecordEntry))])
    (ListValue [(items (Vec ValueExpr))])
    (BoundFieldValue [(field FieldRef)])
    (ConfigValue [(role ValueRoleRef)])
    (ConfigProjectionValue [(projection ConfigProjection)])))

(js/export
  (defrecord ValueRecordField
    [(name String) (value-type ValueTypeSpec) (required Bool)]))

(js/export
  (defrecord ValueTaggedVariant [(tag String) (fields (Vec ValueRecordField))]))

(js/export
  (defunion ValueLiteral
    (StringLiteral [(value String)])
    (IntegerLiteral [(value Int)])
    (BooleanLiteral [(value Bool)])
    (KeywordLiteral [(value Keyword)])
    (NilLiteral [(unit Nil)])))

(js/export
  (defunion ListNormalization
    (SortUniqueList [(unit Nil)])))

(js/export
  (defunion ValueTypeSpec
    (StringValueType
      [(minimum-scalars BoundInt?)
       (maximum-scalars BoundInt?)
       (maximum-bytes BoundInt?)])
    (IntegerValueType [(minimum BoundInt?) (maximum BoundInt?)])
    (BooleanValueType [(unit Nil)])
    (DigestValueType [(unit Nil)])
    (InstantValueType [(unit Nil)])
    (KeywordValueType [(allowed (Vec Keyword))])
    (EnumValueType [(allowed (Vec ValueLiteral))])
    (EntityReferenceValueType [(entity EntityRef)])
    (StateValueType [(state StateRef)])
    (RecordValueType [(fields (Vec ValueRecordField))])
    (TaggedValueType [(tag-field String) (variants (Vec ValueTaggedVariant))])
    (ListValueType
      [(item ValueTypeSpec)
       (minimum-items BoundInt?)
       (maximum-items BoundInt?)
       (normalization ListNormalization?)])
    (ExtensionValueType [(port EntityFieldsPortRef)])
    (NullableValueType [(value-type ValueTypeSpec)])
    (NamedValueType [(value-type ValueTypeRef)])
    (LiteralValueType [(literal ValueLiteral)])))

(js/export
  (defrecord ValueTypeDefinition [(ref ValueTypeRef) (spec ValueTypeSpec)]))

(js/export
  (defrecord ValueEnvelopeSpec
    [(maximum-bytes BoundInt) (maximum-depth BoundInt) (maximum-nodes BoundInt)]))

(js/export
  (defrecord ValueTypeDeclarationSpec
    [(root ValueTypeRef)
     (definitions (Vec ValueTypeDefinition))
     (envelope ValueEnvelopeSpec?)]))

(js/export
  (defrecord QueryParameterSpec [(name Keyword) (value-type ValueTypeSpec)]))

(js/export
  (defrecord QueryBindingSpec [(name Keyword) (entity EntityRef)]))

(js/export
  (defunion QueryValueExpr
    (QueryFieldValue [(binding Keyword) (field FieldRef)])
    (QueryParameterValue [(name Keyword)])
    (QueryBindingValue [(name Keyword)])
    (QueryStringValue [(value String)])
    (QueryIntegerValue [(value Int)])
    (QueryBooleanValue [(value Bool)])
    (QueryKeywordValue [(value Keyword)])
    (QueryNilValue [(unit Nil)])
    (QueryRecordValue [(fields (Vec QueryRecordField))])
    (QueryListValue [(items (Vec QueryValueExpr))])
    (QueryConfiguredValue [(projection ConfigProjection)])
    (QueryStateValue [(value StateValueRef)])))

(js/export
  (defrecord QueryRecordField [(name Keyword) (value QueryValueExpr)]))

(js/export
  (defunion QueryPredicateSpec
    (QueryEqualPredicate [(left QueryValueExpr) (right QueryValueExpr)])
    (QueryContainsPredicate [(collection QueryValueExpr) (value QueryValueExpr)])
    (QueryNonNullPredicate [(value QueryValueExpr)])))

(js/export
  (defunion QuerySelectionSpec
    (QueryValueSelection [(name Keyword) (value QueryValueExpr)])
    (QueryProviderSelection
      [(name Keyword)
       (provider ProviderPortRef)
       (input QueryValueExpr)
       (output ValueTypeSpec)])
    (QueryExtensionSelection [(port EntityFieldsPortRef) (binding Keyword)])))

(js/export
  (defunion QueryResultSpec
    (QueryPageResult [(default-limit BoundInt) (max-limit BoundInt)])
    (QueryOptionalResult [(unit Nil)])
    (QueryOneResult [(unit Nil)])))

(js/export
  (defrecord QueryDeclarationSpec
    [(ref QueryRef)
     (capabilities (Vec CapabilityRef))
     (parameters (Vec QueryParameterSpec))
     (bindings (Vec QueryBindingSpec))
     (predicates (Vec QueryPredicateSpec))
     (selection (Vec QuerySelectionSpec))
     (result QueryResultSpec)]))

(js/export
  (defrecord ProviderPortSpec
    [(ref ProviderPortRef)
     (input-type ValueTypeSpec)
     (output-type ValueTypeSpec)
     (capability CapabilityRef?)]))

(js/export
  (defrecord RendererSpec
    [(ref RendererRef) (input-type ValueTypeSpec) (component ComponentRef)]))

(js/export
  (defrecord FieldRequirement
    [(name String)
     (value-type FieldValueType)
     (cardinality FieldCardinality)
     (write FieldWriteMode)]))

(js/export
  (defunion EntityFieldsPortPolicy
    (ClosedEntityFieldsPort [(unit Nil)])
    (OpenManyEntityFields [(write FieldWriteMode) (require-storage-id Bool)])))

(js/export
  (defrecord EntityFieldsPortSpec
    [(ref EntityFieldsPortRef)
     (target EntityFieldsTarget)
     (requirements (Vec FieldRequirement))
     (policy EntityFieldsPortPolicy)]))

(js/export
  (defrecord ComponentSlotSpec [(ref ComponentSlotRef) (target ComponentRef)]))

(js/export
  (defrecord RouteSlotSpec [(ref RouteSlotRef) (target RouteTemplateRef)]))

(js/export
  (defrecord PluginIdentity
    [(package-id String)
     (version String)
     (compatible-wake String)
     (plugin-abi-version Int)
     (durable-schema-version Int)
     (provenance-token String)]))

(js/export
  (defrecord IntRoleSpec [(ref IntRoleRef) (minimum Int?) (maximum Int?)]))

(js/export
  (defrecord StringRoleSpec
    [(ref StringRoleRef) (min-scalars Int?) (max-scalars Int?) (max-bytes Int?)]))

(js/export
  (defrecord BoolRoleSpec [(ref BoolRoleRef)]))

(js/export
  (defrecord KeywordRoleSpec [(ref KeywordRoleRef) (allowed (Vec Keyword))]))

(js/export
  (defrecord EntityNameRoleSpec [(ref EntityNameRoleRef) (target EntityRef)]))

(js/export
  (defunion FieldNameRoleTarget
    (EntityFieldNameRoleTarget [(field FieldRef)])
    (ReceiptFieldNameRoleTarget [(field ReceiptFieldRef)])))

(js/export
  (defrecord FieldNameRoleSpec
    [(ref FieldNameRoleRef) (target FieldNameRoleTarget)]))

(js/export
  (defrecord StateNameRoleSpec [(ref StateNameRoleRef) (target StateRef)]))

(js/export
  (defrecord StateValueNameRoleSpec
    [(ref StateValueNameRoleRef) (target StateValueRef)]))

(js/export
  (defrecord ExternalEntityRoleSpec [(ref ExternalEntityRoleRef)]))

(js/export
  (defrecord ValueRoleSpec [(ref ValueRoleRef) (value-type ValueTypeSpec)]))

(js/export
  (defrecord PluginConfigurationSchema
    [(ints (Vec IntRoleSpec))
     (strings (Vec StringRoleSpec))
     (bools (Vec BoolRoleSpec))
     (keywords (Vec KeywordRoleSpec))
     (entity-names (Vec EntityNameRoleSpec))
     (field-names (Vec FieldNameRoleSpec))
     (state-names (Vec StateNameRoleSpec))
     (state-value-names (Vec StateValueNameRoleSpec))
     (external-entities (Vec ExternalEntityRoleSpec))
     (values (Vec ValueRoleSpec))]))

(js/export
  (defunion BoundInt
    (LiteralBound [(value Int)])
    (ConfiguredBound [(role IntRoleRef)])
    (ConfiguredProjectionBound [(projection ConfigProjection)])))

(js/export
  (defrecord IntBinding [(role ImportedIntRoleRef) (value Int)]))

(js/export
  (defrecord StringBinding [(role ImportedStringRoleRef) (value String)]))

(js/export
  (defrecord BoolBinding [(role ImportedBoolRoleRef) (value Bool)]))

(js/export
  (defrecord KeywordBinding [(role ImportedKeywordRoleRef) (value Keyword)]))

(js/export
  (defrecord EntityNameBinding
    [(role ImportedEntityNameRoleRef) (value EntityDeclarationName)]))

(js/export
  (defunion FieldNameBindingValue
    (EntityFieldDeclarationNameValue [(name FieldDeclarationName)])
    (ReceiptFieldDeclarationNameValue [(name ReceiptFieldDeclarationName)])))

(js/export
  (defrecord FieldNameBinding
    [(role ImportedFieldNameRoleRef) (value FieldNameBindingValue)]))

(js/export
  (defrecord StateNameBinding
    [(role ImportedStateNameRoleRef) (value StateDeclarationName)]))

(js/export
  (defrecord StateValueNameBinding
    [(role ImportedStateValueNameRoleRef) (value StateValueDeclarationName)]))

(js/export
  (defrecord ExternalEntityBinding
    [(role ImportedExternalEntityRoleRef) (value EntityRef)]))

(js/export
  (defrecord ValueBinding [(role ImportedValueRoleRef) (value ValueExpr)]))

(js/export
  (defrecord PluginBindings
    [(ints (Vec IntBinding))
     (strings (Vec StringBinding))
     (bools (Vec BoolBinding))
     (keywords (Vec KeywordBinding))
     (entity-names (Vec EntityNameBinding))
     (field-names (Vec FieldNameBinding))
     (state-names (Vec StateNameBinding))
     (state-value-names (Vec StateValueNameBinding))
     (external-entities (Vec ExternalEntityBinding))
     (values (Vec ValueBinding))]))

(js/export
  (defunion ContributionKind
    (SchemaContribution [(unit Nil)])
    (QueryContribution [(unit Nil)])
    (CommandContribution [(unit Nil)])
    (CapabilityContribution [(unit Nil)])
    (UiContribution [(unit Nil)])
    (RouteContribution [(unit Nil)])))

(js/export
  (defrecord MigrationSpec
    [(from-version Int) (to-version Int) (ordinal Int) (command CommandRef)]))

(js/export
  (defrecord PluginExports
    [(entities (Vec EntityRef))
     (fields (Vec FieldRef))
     (states (Vec StateRef))
     (state-values (Vec StateValueRef))
     (value-types (Vec ValueTypeRef))
     (provider-ports (Vec ProviderPortRef))
     (renderers (Vec RendererRef))
     (capabilities (Vec CapabilityRef))
     (queries (Vec QueryRef))
     (commands (Vec CommandRef))
     (components (Vec ComponentRef))
     (views (Vec ViewRef))
     (route-templates (Vec RouteTemplateRef))
     (entity-fields-ports (Vec EntityFieldsPortRef))
     (component-slots (Vec ComponentSlotRef))
     (route-slots (Vec RouteSlotRef))]))

(js/export
  (defrecord PluginSpec
    [(identity PluginIdentity)
     (contributions (Vec ContributionKind))
     (configuration PluginConfigurationSchema)
     (exports PluginExports)
     (required-providers (Vec ProviderPortRef))
     (migrations (Vec MigrationSpec))
     (default-route RouteTemplateRef?)]))

(js/export
  (defrecord PluginUseSpec
    [(ref PluginUseRef)
     (package-id String)
     (version String)
     (allow (Vec ContributionKind))
     (bindings PluginBindings)]))

(js/export
  (defrecord ProviderBindingSpec [(name String) (port ImportedProviderPortRef)]))

(js/export
  (defrecord ExtensionFieldSpec
    [(ref ExtensionFieldRef)
     (value-type FieldValueType)
     (cardinality FieldCardinality)
     (write FieldWriteMode)
     (storage-id String)
     (required Bool)]))

(js/export
  (defrecord ExtendSpec
    [(port ImportedEntityFieldsPortRef) (fields (Vec ExtensionFieldSpec))]))

(js/export
  (defrecord FillSpec [(slot ImportedComponentSlotRef) (component ComponentRef)]))

(js/export
  (defrecord MountSpec [(slot ImportedRouteSlotRef) (path String)]))

(js/export
  (defrecord PluginComposition
    [(use PluginUseSpec)
     (providers (Vec ProviderBindingSpec))
     (extensions (Vec ExtendSpec))
     (fills (Vec FillSpec))
     (mounts (Vec MountSpec))]))

(js/export
  (defunion DefaultRouteTarget
    (LocalDefaultRoute [(route RouteTemplateRef)])
    (MountedDefaultRoute [(slot ImportedRouteSlotRef)])))

(js/export
  (defrecord ThemeSpec [(colors (Map String String))]))

(js/export
  (defrecord ApplicationRootSpec
    [(id String)
     (authority AuthoritySpec)
     (storage (Vec StorageSpec))
     (identities (Vec IdentitySpec))
     (plugins (Vec PluginComposition))
     (default-route DefaultRouteTarget?)
     (theme ThemeSpec?)
     (publications (Vec PublicationRef))
     (forms (Vec FormRef))
     (list-details (Vec ListDetailRef))]))

(js/export
  (defunion UiAttr
    (StaticAttr [(value String)])
    (BindAttr [(prop Keyword)])
    (ActionAttr [(action UiAction)])))

(js/export
  (defunion UiAction
    (SetFieldAction [(field FieldRef) (value ValueExpr)])))

(js/export
  (defunion UiCondition
    (UiPropertyPresent [(prop Keyword)])
    (UiQueryPredicate [(predicate QueryPredicateSpec)])))

(js/export
  (defunion UiNode
    (Element
      [(tag Keyword) (attrs (Map Keyword UiAttr)) (children (Vec UiNode))])
    (WhenNode [(condition UiCondition) (children (Vec UiNode))])))

(js/export
  (defrecord ComponentPropertySpec [(name Keyword) (value-type ValueTypeSpec)]))

(js/export
  (defrecord ComponentDeclarationSpec
    [(ref ComponentRef)
     (properties (Vec ComponentPropertySpec))
     (body (Vec UiNode))]))

(js/export
  (defrecord ViewDeclarationSpec
    [(ref ViewRef)
     (entity EntityRef)
     (component ComponentRef)
     (title String)
     (create-form FormRef?)
     (select-component ComponentRef?)]))

(js/export
  (defrecord PublicationDeclarationSpec
    [(ref PublicationRef)
     (owner EntityRef)
     (pointer FieldRef)
     (revision EntityRef)
     (owner-field FieldRef)
     (state-field FieldRef)
     (draft StateValueRef)
     (published StateValueRef)
     (retired StateValueRef)]))

(js/export
  (defunion FormSuccessAction
    (ClearFormSuccess [(unit Nil)])))

(js/export
  (defrecord FormDeclarationSpec
    [(ref FormRef)
     (entity EntityRef)
     (fields (Vec FieldRef))
     (required (Vec FieldRef))
     (submit-label String)
     (on-success FormSuccessAction)]))

(js/export
  (defunion ListDetailTabSpec
    (FieldsDetailTab [(label String) (fields (Vec FieldRef))])
    (RelatedDetailTab
      [(label String)
       (entity EntityRef)
       (relation FieldRef)
       (display (Vec FieldRef))])))

(js/export
  (defrecord ListDetailDeclarationSpec
    [(ref ListDetailRef)
     (entity EntityRef)
     (title String)
     (columns (Vec FieldRef))
     (search (Vec FieldRef))
     (detail-tabs (Vec ListDetailTabSpec))]))

(js/export
  (defrecord RouteQuerySpec [(query QueryRef) (alias String?)]))

(js/export
  (defrecord RouteParameterSpec [(name Keyword) (value-type ValueTypeSpec)]))

(js/export
  (defrecord RouteTemplateSpec
    [(ref RouteTemplateRef)
     (view ViewRef)
     (queries (Vec RouteQuerySpec))
     (parameters (Vec RouteParameterSpec))]))

(js/export
  (defn static-attr [(value String)] UiAttr
    (->StaticAttr value)))

(js/export
  (defn bind-attr [(prop Keyword)] UiAttr
    (->BindAttr prop)))

(js/export
  (defn element
    [(tag Keyword) (attrs (Map Keyword UiAttr)) (children (Vec UiNode))] UiNode
    (->Element tag attrs children)))

(defmacro defcapability [binding declaration-id public-name guards]
  (let [ref-binding (format-symbol "~a-ref" binding)
        provenance-token
        (str "wake:macro:capability:" declaration-id)]
    `(do
       (def ~ref-binding CapabilityRef
         (->CapabilityRef
           ~declaration-id
           ~public-name
           ~provenance-token))
       (def ~binding CapabilitySpec
         (->CapabilitySpec ~ref-binding ~guards)))))

(defmacro defstate-model
  [binding declaration-id public-name values initial transitions]
  (let [state-ref-binding (format-symbol "~a-ref" binding)
        state-provenance-token
        (str "wake:macro:state:" declaration-id)
        value-ref-name
        (fn [value-name] Symbol
          (format-symbol "~a-~a-ref" binding value-name))
        value-spec-name
        (fn [value-name] Symbol
          (format-symbol "~a-~a" binding value-name))
        value-definitions
        (mapcat
          (fn [value] (List Any)
            (let [value-name (first value)
                  value-declaration-id (second value)
                  value-public-name (nth value 2)
                  value-keyword (nth value 3)
                  value-ref-binding (value-ref-name value-name)
                  value-spec-binding (value-spec-name value-name)
                  value-provenance-token
                  (str "wake:macro:state-value:" value-declaration-id)]
              (list
                `(def ~value-ref-binding StateValueRef
                   (->StateValueRef
                     ~value-declaration-id
                     ~value-public-name
                     ~value-provenance-token))
                `(def ~value-spec-binding StateValueSpec
                   (->StateValueSpec
                     ~value-ref-binding
                     ~state-ref-binding
                     ~value-keyword)))))
          values)
        value-specs
        (apply vec
          (map
            (fn [value] Symbol
              (value-spec-name (first value)))
            values))
        initial-ref (value-ref-name initial)
        transition-specs
        (apply vec
          (map
            (fn [transition] Any
              (let [from-ref (value-ref-name (first transition))
                    to-refs
                    (apply vec
                      (map value-ref-name (second transition)))]
                `(->StateTransitionSpec ~from-ref ~to-refs)))
            transitions))]
    `(do
       (def ~state-ref-binding StateRef
         (->StateRef
           ~declaration-id
           ~public-name
           ~state-provenance-token))
       ~@value-definitions
       (def ~binding StateDeclarationSpec
         (->StateDeclarationSpec
           ~state-ref-binding
           ~value-specs
           ~initial-ref
           ~transition-specs)))))

(defmacro defentity-ref [binding declaration-id public-name]
  (let [ref-binding (format-symbol "~a-ref" binding)
        provenance-token (str "wake:macro:entity-ref:" declaration-id)]
    `(def ~ref-binding EntityRef
       (->EntityRef
         ~declaration-id
         ~public-name
         ~provenance-token))))

(defmacro define-entity-model
  [binding record-name declaration-id fields derived-fields storage-id]
  (let [entity-ref-binding (format-symbol "~a-ref" binding)
        field-ref-name
        (fn [field-name] Symbol
          (format-symbol "~a-~a-ref" binding field-name))
        field-spec-name
        (fn [field-name] Symbol
          (format-symbol "~a-~a-spec" binding field-name))
        record-fields
        (apply vec
          (concat
            (map
              (fn [field] Any
                (make-field (first field) (nth field 3)))
              fields)
            (map
              (fn [field] Any
                (make-field (first field) 'String))
              derived-fields)))
        field-definitions
        (mapcat
          (fn [field] (List Any)
            (let [field-name (first field)
                  field-declaration-id (second field)
                  public-name (nth field 2)
                  field-type (nth field 4)
                  cardinality (nth field 5)
                  write-mode (nth field 6)
                  field-storage-id (nth field 7)
                  required (nth field 8)
                  field-ref-binding (field-ref-name field-name)
                  field-spec-binding (field-spec-name field-name)
                  field-provenance-token
                  (str "wake:macro:field:" field-declaration-id)]
              (list
                `(def ~field-ref-binding FieldRef
                   (->FieldRef
                     ~field-declaration-id
                     ~public-name
                     ~field-provenance-token))
                `(def ~field-spec-binding FieldSpec
                   (->FieldSpec
                     ~field-ref-binding
                     ~entity-ref-binding
                     ~field-type
                     ~cardinality
                     ~write-mode
                     ~field-storage-id
                     ~required)))))
          fields)
        derived-definitions
        (mapcat
          (fn [field] (List Any)
            (let [field-name (first field)
                  field-declaration-id (second field)
                  public-name (nth field 2)
                  expression (nth field 3)
                  dependencies (nth field 4)
                  field-ref-binding (field-ref-name field-name)
                  field-spec-binding (field-spec-name field-name)
                  field-provenance-token
                  (str "wake:macro:derived-field:" field-declaration-id)]
              (list
                `(def ~field-ref-binding FieldRef
                   (->FieldRef
                     ~field-declaration-id
                     ~public-name
                     ~field-provenance-token))
                `(def ~field-spec-binding DerivedFieldSpec
                   (->DerivedFieldSpec
                     ~field-ref-binding
                     ~entity-ref-binding
                     ~expression
                     ~dependencies)))))
          derived-fields)
        field-specs
        (apply vec
          (map
            (fn [field] Symbol
              (field-spec-name (first field)))
            fields))
        derived-specs
        (apply vec
          (map
            (fn [field] Symbol
              (field-spec-name (first field)))
            derived-fields))]
    `(do
       (defrecord ~record-name ~record-fields)
       ~@field-definitions
       ~@derived-definitions
       (def ~binding EntityDeclarationSpec
         (->EntityDeclarationSpec
           ~entity-ref-binding
           ~(str record-name)
           ~field-specs
           ~derived-specs
           ~storage-id)))))

