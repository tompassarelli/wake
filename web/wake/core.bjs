(defmacro defcapability [binding Symbol declaration-id Any public-name Any guards Any]
  (let [ref-binding Symbol (format-symbol "~a-ref" binding)
        provenance-token String
        (str "wake:macro:capability:" declaration-id)]
    `(do
       (def ~ref-binding CapabilityRef
         (->CapabilityRef
           ~declaration-id
           ~public-name
           ~provenance-token))
       (def ~binding CapabilitySpec
         (->CapabilitySpec ~ref-binding ~guards)))))

;; A declaration collection is source structure: each entry owns all of its
;; local metadata. Keep the original collection identity while validating so a
;; rejection can point at the exact caller form.
(defmacro defstate-model
  [binding Symbol declaration-id Any public-name Any values Any initial Any transitions Any]
  (let [checked-value-collection (Vec Any)
        (if (vector? values)
          values
          (error
            "Invalid state value declarations: " values "\n\n"
            "State value declarations must be a vector of complete forms:\n"
            "  [(name declaration-id public-name keyword) ...]"))
        checked-transition-collection (Vec Any)
        (if (vector? transitions)
          transitions
          (error
            "Invalid state transition declarations: " transitions "\n\n"
            "State transition declarations must be a vector of complete forms:\n"
            "  [(from [to ...]) ...]"))
        value-structure String "(name declaration-id public-name keyword)"
        transition-structure String "(from [to ...])"
        checked-values (Vec Any)
        (map-indexed
          (fn [index Int value Any] Any
            (if (list? value)
              (if (= (count value) 4)
                value
                (syntax-error-at values index
                  "Invalid state value declaration: " value "\n\n"
                  "Each state value must be one complete form:\n"
                  "  " value-structure))
              (syntax-error-at values index
                "Invalid state value declaration: " value "\n\n"
                "Each state value must be one complete form:\n"
                "  " value-structure)))
          checked-value-collection)
        checked-transitions (Vec Any)
        (map-indexed
          (fn [index Int transition Any] Any
            (if (list? transition)
              (if (= (count transition) 2)
                (if (vector? (second transition))
                  transition
                  (syntax-error-at transitions index
                    "Invalid state transition declaration: " transition "\n\n"
                    "Each state transition must be one complete form:\n"
                    "  " transition-structure))
                (syntax-error-at transitions index
                  "Invalid state transition declaration: " transition "\n\n"
                  "Each state transition must be one complete form:\n"
                  "  " transition-structure))
              (syntax-error-at transitions index
                "Invalid state transition declaration: " transition "\n\n"
                "Each state transition must be one complete form:\n"
                "  " transition-structure)))
          checked-transition-collection)
        state-ref-binding Symbol (format-symbol "~a-ref" binding)
        state-provenance-token String
        (str "wake:macro:state:" declaration-id)
        value-ref-name (Fn [Symbol] Symbol)
        (fn [value-name Symbol] Symbol
          (format-symbol "~a-~a-ref" binding value-name))
        value-spec-name (Fn [Symbol] Symbol)
        (fn [value-name Symbol] Symbol
          (format-symbol "~a-~a" binding value-name))
        value-definitions (List Any)
        (mapcat
          (fn [value Any] (List Any)
            (let [value-name Symbol (first value)
                  value-declaration-id Any (second value)
                  value-public-name Any (nth value 2)
                  value-keyword Any (nth value 3)
                  value-ref-binding Symbol (value-ref-name value-name)
                  value-spec-binding Symbol (value-spec-name value-name)
                  value-provenance-token String
                  (str "wake:macro:state-value:" value-declaration-id)]
              (list
                `(def ~value-ref-binding StateValueRef
                   (->StateValueRef
                     ~value-declaration-id
                     ~value-public-name
                     ~value-provenance-token))
                `(def ~value-spec-binding StateValueSpec
                   (->StateValueSpec
                     ~value-ref-binding
                     ~state-ref-binding
                     ~value-keyword)))))
          checked-values)
        value-specs (Vec Symbol)
        (apply vec
          (map
            (fn [value Any] Symbol
              (value-spec-name (first value)))
            checked-values))
        initial-ref Symbol (value-ref-name initial)
        transition-specs (Vec Any)
        (apply vec
          (map
            (fn [transition Any] Any
              (let [from-ref Symbol (value-ref-name (first transition))
                    to-refs (Vec Symbol)
                    (apply vec
                      (map value-ref-name (second transition)))]
                `(->StateTransitionSpec ~from-ref ~to-refs)))
            checked-transitions))]
    `(do
       (def ~state-ref-binding StateRef
         (->StateRef
           ~declaration-id
           ~public-name
           ~state-provenance-token))
       ~@value-definitions
       (def ~binding StateDeclarationSpec
         (->StateDeclarationSpec
           ~state-ref-binding
           ~value-specs
           ~initial-ref
           ~transition-specs)))))

(defmacro defentity-ref [binding Symbol declaration-id Any public-name Any]
  (let [ref-binding Symbol (format-symbol "~a-ref" binding)
        provenance-token String (str "wake:macro:entity-ref:" declaration-id)]
    `(def ~ref-binding EntityRef
       (->EntityRef
         ~declaration-id
         ~public-name
         ~provenance-token))))

(defmacro define-entity-model
  [binding Symbol record-name Symbol declaration-id Any fields Any derived-fields Any storage-id Any]
  (let [checked-field-collection (Vec Any)
        (if (vector? fields)
          fields
          (error
            "Invalid field declarations: " fields "\n\n"
            "Field declarations must be a vector of complete forms."))
        checked-derived-field-collection (Vec Any)
        (if (vector? derived-fields)
          derived-fields
          (error
            "Invalid derived field declarations: " derived-fields "\n\n"
            "Derived field declarations must be a vector of complete forms."))
        field-structure String
        (str
          "(name declaration-id public-name record-type value-type "
          "cardinality write-mode storage-id required)")
        derived-field-structure String
        "(name declaration-id public-name expression dependencies)"
        checked-fields (Vec Any)
        (map-indexed
          (fn [index Int field Any] Any
            (if (list? field)
              (if (= (count field) 9)
                field
                (syntax-error-at fields index
                  "Invalid field declaration: " field "\n\n"
                  "Each field must be one complete form:\n"
                  "  " field-structure))
              (syntax-error-at fields index
                "Invalid field declaration: " field "\n\n"
                "Each field must be one complete form:\n"
                "  " field-structure)))
          checked-field-collection)
        checked-derived-fields (Vec Any)
        (map-indexed
          (fn [index Int field Any] Any
            (if (list? field)
              (if (= (count field) 5)
                (if (vector? (nth field 4))
                  field
                  (syntax-error-at derived-fields index
                    "Invalid derived field declaration: " field "\n\n"
                    "Each derived field must be one complete form:\n"
                    "  " derived-field-structure))
                (syntax-error-at derived-fields index
                  "Invalid derived field declaration: " field "\n\n"
                  "Each derived field must be one complete form:\n"
                  "  " derived-field-structure))
              (syntax-error-at derived-fields index
                "Invalid derived field declaration: " field "\n\n"
                "Each derived field must be one complete form:\n"
                "  " derived-field-structure)))
          checked-derived-field-collection)
        entity-ref-binding Symbol (format-symbol "~a-ref" binding)
        field-ref-name (Fn [Symbol] Symbol)
        (fn [field-name Symbol] Symbol
          (format-symbol "~a-~a-ref" binding field-name))
        field-spec-name (Fn [Symbol] Symbol)
        (fn [field-name Symbol] Symbol
          (format-symbol "~a-~a-spec" binding field-name))
        record-fields (Vec Any)
        (apply vec
          (concat
            (map
              (fn [field Any] Any
                (make-field (first field) (nth field 3)))
              checked-fields)
            (map
              (fn [field Any] Any
                (make-field (first field) 'String))
              checked-derived-fields)))
        field-definitions (List Any)
        (mapcat
          (fn [field Any] (List Any)
            (let [field-name Symbol (first field)
                  field-declaration-id Any (second field)
                  public-name Any (nth field 2)
                  field-type Any (nth field 4)
                  cardinality Any (nth field 5)
                  write-mode Any (nth field 6)
                  field-storage-id Any (nth field 7)
                  required Any (nth field 8)
                  field-ref-binding Symbol (field-ref-name field-name)
                  field-spec-binding Symbol (field-spec-name field-name)
                  field-provenance-token String
                  (str "wake:macro:field:" field-declaration-id)]
              (list
                `(def ~field-ref-binding FieldRef
                   (->FieldRef
                     ~field-declaration-id
                     ~public-name
                     ~field-provenance-token))
                `(def ~field-spec-binding FieldSpec
                   (->FieldSpec
                     ~field-ref-binding
                     ~entity-ref-binding
                     ~field-type
                     ~cardinality
                     ~write-mode
                     ~field-storage-id
                     ~required)))))
          checked-fields)
        derived-definitions (List Any)
        (mapcat
          (fn [field Any] (List Any)
            (let [field-name Symbol (first field)
                  field-declaration-id Any (second field)
                  public-name Any (nth field 2)
                  expression Any (nth field 3)
                  dependencies Any (nth field 4)
                  field-ref-binding Symbol (field-ref-name field-name)
                  field-spec-binding Symbol (field-spec-name field-name)
                  field-provenance-token String
                  (str "wake:macro:derived-field:" field-declaration-id)]
              (list
                `(def ~field-ref-binding FieldRef
                   (->FieldRef
                     ~field-declaration-id
                     ~public-name
                     ~field-provenance-token))
                `(def ~field-spec-binding DerivedFieldSpec
                   (->DerivedFieldSpec
                     ~field-ref-binding
                     ~entity-ref-binding
                     ~expression
                     ~dependencies)))))
          checked-derived-fields)
        field-specs (Vec Symbol)
        (apply vec
          (map
            (fn [field Any] Symbol
              (field-spec-name (first field)))
            checked-fields))
        derived-specs (Vec Symbol)
        (apply vec
          (map
            (fn [field Any] Symbol
              (field-spec-name (first field)))
            checked-derived-fields))]
    `(do
       (defrecord ~record-name ~record-fields)
       ~@field-definitions
       ~@derived-definitions
       (def ~binding EntityDeclarationSpec
         (->EntityDeclarationSpec
           ~entity-ref-binding
           ~(str record-name)
           ~field-specs
           ~derived-specs
           ~storage-id)))))

