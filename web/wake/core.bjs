(defmacro defvalue-type [binding Symbol declaration-id Any root-spec Any definitions Any envelope Any]
  (let [checked-definition-collection (Vec Any)
        (if (vector? definitions)
          definitions
          (error
            "Invalid value type definitions: " definitions "\n\n"
            "Value type definitions must be a vector of complete forms:\n"
            "  [(name value-type) ...]"))
        definition-structure String "(name value-type)"
        checked-definitions (Vec Any)
        (map-indexed
          (fn [index Int definition Any] Any
            (if (list? definition)
              (if (= (count definition) 2)
                definition
                (syntax-error-at definitions index
                  "Invalid value type definition: " definition "\n\n"
                  "Each value type definition must be one complete form:\n"
                  "  " definition-structure))
              (syntax-error-at definitions index
                "Invalid value type definition: " definition "\n\n"
                "Each value type definition must be one complete form:\n"
                "  " definition-structure)))
          checked-definition-collection)
        root-ref-binding Symbol (format-symbol "~a-ref" binding)
        root-definition-binding Symbol (format-symbol "~a-definition" binding)
        root-provenance-token String
        (str "wake:macro:value-type:" declaration-id)
        definition-ref-name (Fn [Symbol] Symbol)
        (fn [definition-name Symbol] Symbol
          (format-symbol "~a-~a-ref" binding definition-name))
        definition-spec-name (Fn [Symbol] Symbol)
        (fn [definition-name Symbol] Symbol
          (format-symbol "~a-~a-definition" binding definition-name))
        definition-ref-forms (List Any)
        (map
          (fn [definition Any] Any
            (let [definition-name Symbol (first definition)
                  ref-binding Symbol (definition-ref-name definition-name)
                  nested-declaration-id String
                  (str declaration-id "/definition/" definition-name)
                  provenance-token String
                  (str "wake:macro:value-type:" nested-declaration-id)]
              `(def ~ref-binding ValueTypeRef
                 (->ValueTypeRef
                   ~nested-declaration-id
                   ~(str definition-name)
                   ~provenance-token))))
          checked-definitions)
        definition-spec-forms (List Any)
        (map
          (fn [definition Any] Any
            (let [definition-name Symbol (first definition)
                  definition-spec Any (second definition)
                  ref-binding Symbol (definition-ref-name definition-name)
                  spec-binding Symbol (definition-spec-name definition-name)]
              `(def ~spec-binding ValueTypeDefinition
                 (->ValueTypeDefinition ~ref-binding ~definition-spec))))
          checked-definitions)
        definition-specs (Vec Symbol)
        (apply vec
          (cons
            root-definition-binding
            (map
              (fn [definition Any] Symbol
                (definition-spec-name (first definition)))
              checked-definitions)))]
    `(do
       (def ~root-ref-binding ValueTypeRef
         (->ValueTypeRef
           ~declaration-id
           ~(str binding)
           ~root-provenance-token))
       ~@definition-ref-forms
       (def ~root-definition-binding ValueTypeDefinition
         (->ValueTypeDefinition ~root-ref-binding ~root-spec))
       ~@definition-spec-forms
       (def ~binding ValueTypeDeclarationSpec
         (->ValueTypeDeclarationSpec
           ~root-ref-binding
           ~definition-specs
           ~envelope)))))

