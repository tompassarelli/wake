(defmacro defvalue-type [binding declaration-id root-spec definitions envelope]
  (let [root-ref-binding (format-symbol "~a-ref" binding)
        root-definition-binding (format-symbol "~a-definition" binding)
        root-provenance-token
        (str "wake:macro:value-type:" declaration-id)
        definition-ref-name
        (fn [definition-name] Symbol
          (format-symbol "~a-~a-ref" binding definition-name))
        definition-spec-name
        (fn [definition-name] Symbol
          (format-symbol "~a-~a-definition" binding definition-name))
        definition-ref-forms
        (map
          (fn [definition] Any
            (let [definition-name (first definition)
                  ref-binding (definition-ref-name definition-name)
                  nested-declaration-id
                  (str declaration-id "/definition/" definition-name)
                  provenance-token
                  (str "wake:macro:value-type:" nested-declaration-id)]
              `(def ~ref-binding ValueTypeRef
                 (->ValueTypeRef
                   ~nested-declaration-id
                   ~(str definition-name)
                   ~provenance-token))))
          definitions)
        definition-spec-forms
        (map
          (fn [definition] Any
            (let [definition-name (first definition)
                  definition-spec (second definition)
                  ref-binding (definition-ref-name definition-name)
                  spec-binding (definition-spec-name definition-name)]
              `(def ~spec-binding ValueTypeDefinition
                 (->ValueTypeDefinition ~ref-binding ~definition-spec))))
          definitions)
        definition-specs
        (apply vec
          (cons
            root-definition-binding
            (map
              (fn [definition] Symbol
                (definition-spec-name (first definition)))
              definitions)))]
    `(do
       (def ~root-ref-binding ValueTypeRef
         (->ValueTypeRef
           ~declaration-id
           ~(str binding)
           ~root-provenance-token))
       ~@definition-ref-forms
       (def ~root-definition-binding ValueTypeDefinition
         (->ValueTypeDefinition ~root-ref-binding ~root-spec))
       ~@definition-spec-forms
       (def ~binding ValueTypeDeclarationSpec
         (->ValueTypeDeclarationSpec
           ~root-ref-binding
           ~definition-specs
           ~envelope)))))

