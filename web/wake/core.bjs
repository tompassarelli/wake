  (let [ref-binding (format-symbol "~a-ref" binding)
        provenance-token (str "wake:macro:imported-provider:" declaration-id)]
    `(do
       (def ~ref-binding ImportedProviderPortRef
         (->ImportedProviderPortRef
           ~use
           ~declaration-id
           ~remote-name
           ~provenance-token))
       (def ~binding ProviderBindingSpec
         (->ProviderBindingSpec ~provider-name ~ref-binding)))))

(defmacro extend-entity-fields [binding use declaration-id remote-name fields]
  (let [ref-binding (format-symbol "~a-ref" binding)
        provenance-token
        (str "wake:macro:imported-entity-fields:" declaration-id)
        field-ref-name
        (fn [field-name] Symbol
          (format-symbol "~a-~a-ref" binding field-name))
        field-spec-name
        (fn [field-name] Symbol
          (format-symbol "~a-~a-spec" binding field-name))
        field-definitions
        (mapcat
          (fn [field] (List Any)
            (let [field-name (first field)
                  field-declaration-id (second field)
                  public-name (nth field 2)
                  value-type (nth field 3)
                  cardinality (nth field 4)
                  write (nth field 5)
                  storage-id (nth field 6)
                  required (nth field 7)
                  field-ref-binding (field-ref-name field-name)
                  field-spec-binding (field-spec-name field-name)
                  field-provenance-token
                  (str "wake:macro:extension-field:" field-declaration-id)]
              (list
                `(def ~field-ref-binding ExtensionFieldRef
                   (->ExtensionFieldRef
                     ~field-declaration-id
                     ~public-name
                     ~field-provenance-token))
                `(def ~field-spec-binding ExtensionFieldSpec
                   (->ExtensionFieldSpec
                     ~field-ref-binding
                     ~value-type
                     ~cardinality
                     ~write
                     ~storage-id
                     ~required)))))
          fields)
        field-specs
        (apply vec
          (map
            (fn [field] Symbol
              (field-spec-name (first field)))
            fields))]
    `(do
       (def ~ref-binding ImportedEntityFieldsPortRef
         (->ImportedEntityFieldsPortRef
           ~use
           ~declaration-id
           ~remote-name
           ~provenance-token))
       ~@field-definitions
       (def ~binding ExtendSpec
         (->ExtendSpec ~ref-binding ~field-specs)))))

