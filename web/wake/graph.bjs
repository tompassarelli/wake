#lang beagle/js
(ns wake.graph)
(require [wake.ir :as ir])

;; Checked Entity Graph
;;
;; Resolves a linked typed declaration program into one analyzed graph.
;; Every emitter reads this graph instead of re-deriving relationships.

;; --- Graph records ---

(defrecord GField
  [name String
   storage_id String
   type String
   identity Bool
   cardinality String
   value_kind String
   target_entity String?
   write_policy String
   derived Bool
   deps (Vec String)
   expr IrDerivedExpr?])

(defrecord GEntity
  [name String
   storage_id String
   fields (Vec GField)
   stored_fields (Vec GField)
   derived_fields (Vec GField)
   ref_fields (Vec GField)
   identity_field GField?
   store_name String])

(defrecord FkEdge
  [from_entity String
   from_field String
   to_entity String])

(defrecord StateMachine
  [entity String
   field String
   state_type String
   transitions (Map String (Vec String))
   initial String])

(defrecord PublicationPolicy
  [name String
   owner_entity String
   pointer_field String
   revision_entity String
   owner_field String
   state_field String
   draft_state String
   published_state String
   retired_state String])

(defrecord GQueryParam
  [name String
   type String])
(defrecord GQueryBinding
  [name String
   entity String])
(defrecord GQueryOperand
  [kind String
   type String
   target_entity String?
   binding String?
   entity String?
   field String?
   parameter String?
   value Any])
(defrecord GQueryPredicate
  [op String
   left GQueryOperand
   right GQueryOperand])
(defrecord GQueryColumn
  [name String
   binding String
   entity String
   field String
   type String
   cardinality String
   value_kind String
   target_entity String?
   internal Bool])
(defrecord GQueryResultProvider
  [name String
   provider String
   input Any
   input_type Any
   output_type Any])
(defrecord GQueryDependency
  [entity String
   field String])
(defrecord GQuery
  [name String
   capabilities (Vec String)
   params (Vec GQueryParam)
   bindings (Vec GQueryBinding)
   predicates (Vec GQueryPredicate)
   columns (Vec GQueryColumn)
   result_providers (Vec GQueryResultProvider)
   result_kind String
   default_limit Int?
   max_limit Int?
   dependencies (Vec GQueryDependency)])

(defrecord GProviderPort
  [name String
   input Any
   output Any])

(defrecord GProvider
  [name String
   port String
   package_id String
   port_name String
   input_type Any
   output_type Any
   span SourceSpan])

(defrecord GExtension
  [kind String
   package_id String
   port String
   target String
   fields (Vec IrAttr)])

(defrecord GFill
  [port String
   component String
   package_id String
   target_component String])

(defrecord GMount
  [input_parameters (Vec String)
   package_id String
   parameters (Vec String)
   path String
   pattern String
   port String
   queries (Vec IrRouteQuery)
   required_props (Vec String)
   target_route String
   view_name String])

(defrecord ResolvedPluginExtension
  [instance IrLinkedPluginInstance
   program IrDeclarationProgram
   resolver DeclarationResolver
   source IrExtendSpec
   port IrEntityFieldsPortSpec
   target String
   extension IrExtend])

(defrecord LoweredPlugin
  [instance IrLinkedPluginInstance
   program IrDeclarationProgram
   resolver DeclarationResolver
   source_unit IrSourceUnit
   provenance (Vec IrDeclarationProvenance)
   evidence Any
   entities (Vec GEntity)
   states (Vec IrDefstate)
   publications (Vec IrPublication)
   queries (Vec IrQuery)
   commands (Vec Any)
   forms (Vec IrSmartForm)
   list_details (Vec IrListDetail)
   value_types (Vec Any)
   provider_ports (Vec GProviderPort)
   providers (Vec GProvider)
   extensions (Vec ResolvedPluginExtension)
   fills (Vec GFill)
   mounts (Vec GMount)
   components (Vec IrComponent)
   views (Vec IrView)
   route_templates (Vec IrRoute)
   mounted_routes (Vec IrRoute)])

(defrecord GDetailTab
  [label String
   content_type String
   fields (Vec String)
   entity_name String?
   relation_field String?
   display_fields (Vec String)])

(defrecord GListDetail
  [entity_name String
   title String
   columns (Vec String)
   search_cols (Vec String)
   detail_tabs (Vec GDetailTab)])

(defrecord CheckedApplication
  [schema_version Int
   application_id String
   source_units (Vec IrSourceUnit)
   plugin_closure (Vec Any)
   linked_declarations IrLinkedDeclarationProgram
   semantic_fingerprint String?
   providers (Vec GProvider)
   value_types (Vec Any)
   provider_ports (Vec Any)
   extensions (Vec GExtension)
   fills (Vec GFill)
   mounts (Vec GMount)
   route_templates (Vec IrRoute)
   ns String
   backend IrBackend?
   entities (Vec GEntity)
   fk_edges (Vec FkEdge)
   state_machines (Vec StateMachine)
   publications (Vec PublicationPolicy)
   queries (Vec GQuery)
   commands (Vec Any)
   persist IrPersist?
   defstates (Vec IrDefstate)
   list_details (Vec GListDetail)
   forms (Vec IrSmartForm)
   theme IrTheme?
   components (Vec IrComponent)
   views (Vec IrView)
   router IrRouter?
   layout IrLayout?])

;; Exact nominal resolution happens before the existing graph analyses.  This
;; is a graph input, not a public/source IR: its linked declaration sidecar is
;; retained and every string name below has already been resolved from a
;; concrete nominal reference.
(defrecord ResolvedDeclarationProgram
  [linked_declarations IrLinkedDeclarationProgram
   application_id String
   source_unit IrSourceUnit
   source_units (Vec IrSourceUnit)
   plugin_closure (Vec Any)
   declaration_provenance (Vec IrDeclarationProvenance)
   ns String
   backend IrBackend?
   entities (Vec GEntity)
   persist IrPersist?
   defstates (Vec IrDefstate)
   publications (Vec IrPublication)
   queries (Vec IrQuery)
   commands (Vec Any)
   list_details (Vec IrListDetail)
   forms (Vec IrSmartForm)
   theme IrTheme?
   components (Vec IrComponent)
   views (Vec IrView)
   router IrRouter?
   providers (Vec GProvider)
   value_types (Vec Any)
   provider_ports (Vec Any)
   extends (Vec GExtension)
   fills (Vec GFill)
   mounts (Vec GMount)
   route_templates (Vec IrRoute)
   layout IrLayout?])

;; --- Checked declaration lowering ---

(defn require-ir-tag
  [value Any
   tag String
   label String] Any
  (if (or (nil? value) (not (= (.-_tag value) tag)))
    (graph-error
      (str label " must be " tag ", got "
           (if (nil? value) "nil" (or (.-_tag value) "untagged"))))
    value))

(defn same-nominal?
  [left Any
   right Any] Bool
  (and
    (some? left)
    (some? right)
    (= (.-_tag left) (.-_tag right))
    (= (.-declaration_id left) (.-declaration_id right))))

(defrecord DeclarationResolver
  [prefix String
   package_id String
   bindings IrPluginBindings?
   entity_names Any
   field_names Any
   state_names Any
   state_values Any
   receipt_field_names Any
   value_bindings Any
   provider_bindings Any])

(defn empty-resolver [] DeclarationResolver
  (->DeclarationResolver "" "application" nil {} {} {} {} {} {} {}))

(defn ref-key [ref Any] String
  (or (.-declaration_id ref) ""))

(defn resolved-local-name
  [resolver DeclarationResolver
   kind String
   ref Any] String
  (let [renames (cond
          (= kind "entity") (.-entity_names resolver)
          (= kind "field") (.-field_names resolver)
          (= kind "state") (.-state_names resolver)
          (= kind "state-value") (.-state_values resolver)
          (= kind "receipt-field") (.-receipt_field_names resolver)
          :else {})]
    (or (get renames (ref-key ref)) (.-name ref))))

(defn resolved-name
  [resolver DeclarationResolver
   kind String
   ref Any] String
  (let [name (resolved-local-name resolver kind ref)]
    (if (or (= (.-prefix resolver) "")
            (= kind "field")
            (= kind "state-value")
            (= kind "receipt-field"))
      name
      (str (.-prefix resolver) "." name))))

(defn resolved-capability-name
  [resolver DeclarationResolver
   ref IrCapabilityRef] String
  (if (= (.-prefix resolver) "")
    (.-name ref)
    (str (.-package_id resolver) "/cap/" (.-name ref))))

(defn binding-for-role
  [items Any
   role Any
   label String] Any
  (let [matches (filterv
          (fn [binding Any] Bool
            (= (ref-key (.-role binding)) (ref-key role)))
          (or items []))]
    (if (not (= (count matches) 1))
      (graph-error
        (str label " requires exactly one binding for role '" (ref-key role) "'"))
      (first matches))))

(defn role-renames
  [specs Any
   bindings Any
   target-fn Any
   value-fn Any
   label String] Any
  (reduce
    (fn [result spec] Any
      (let [binding (binding-for-role bindings (.-ref spec) label)
            target (target-fn spec)
            key (ref-key target)]
        (if (some? (get result key))
          (graph-error (str label " repeats target '" key "'"))
          (assoc result key (value-fn binding)))))
    {}
    (or specs [])))

(defn plugin-spec
  [program IrDeclarationProgram
   context String] IrPluginSpec
  (let [root (.-root program)]
    (match root
      [(IrPluginDeclarationRoot _) (.-plugin root)]
      [(IrApplicationDeclarationRoot _)
       (graph-error (str context " requires a plugin declaration root"))])))

(defn entity-field-name-target [target IrFieldNameRoleTarget] IrFieldRef?
  (match target
    [(IrEntityFieldNameRoleTarget _) (.-field target)]
    [(IrReceiptFieldNameRoleTarget _) nil]))

(defn receipt-field-name-target [target IrFieldNameRoleTarget] IrReceiptFieldRef?
  (match target
    [(IrEntityFieldNameRoleTarget _) nil]
    [(IrReceiptFieldNameRoleTarget _) (.-field target)]))

(defn plugin-resolver
  [instance IrLinkedPluginInstance
   program IrDeclarationProgram] DeclarationResolver
  (let [plugin (plugin-spec program "plugin resolver")
        schema (.-configuration plugin)
        bindings (.-bindings (.-use instance))
        entity-names (role-renames
          (.-entity_names schema) (.-entity_names bindings)
          (fn [spec IrEntityNameRoleSpec] Any (.-target spec))
          (fn [binding IrEntityNameBinding] String (.-value (.-value binding)))
          "plugin entity-name configuration")
        field-names (role-renames
          (filterv
            (fn [spec IrFieldNameRoleSpec] Bool
              (some? (entity-field-name-target (.-target spec))))
            (.-field_names schema))
          (.-field_names bindings)
          (fn [spec IrFieldNameRoleSpec] Any
            (entity-field-name-target (.-target spec)))
          (fn [binding IrFieldNameBinding] String
            (.-value (.-name (.-value binding))))
          "plugin field-name configuration")
        receipt-field-names (role-renames
          (filterv
            (fn [spec IrFieldNameRoleSpec] Bool
              (some? (receipt-field-name-target (.-target spec))))
            (.-field_names schema))
          (.-field_names bindings)
          (fn [spec IrFieldNameRoleSpec] Any
            (receipt-field-name-target (.-target spec)))
          (fn [binding IrFieldNameBinding] String
            (.-value (.-name (.-value binding))))
          "plugin receipt-field-name configuration")
        state-names (role-renames
          (.-state_names schema) (.-state_names bindings)
          (fn [spec IrStateNameRoleSpec] Any (.-target spec))
          (fn [binding IrStateNameBinding] String (.-value (.-value binding)))
          "plugin state-name configuration")
        state-values (role-renames
          (.-state_value_names schema) (.-state_value_names bindings)
          (fn [spec IrStateValueNameRoleSpec] Any (.-target spec))
          (fn [binding IrStateValueNameBinding] String
            (strip-colon (.-value (.-value binding))))
          "plugin state-value-name configuration")
        values (reduce
          (fn [result binding] Any
            (assoc result (ref-key (.-role binding)) (.-value binding)))
          {}
          (.-values bindings))
        providers (reduce
          (fn [result binding] Any
            (assoc result (ref-key (.-port binding)) (.-name binding)))
          {}
          (.-providers (.-composition instance)))]
    (->DeclarationResolver
      (.-alias instance)
      (.-package_id (.-evidence instance))
      bindings
      entity-names field-names state-names state-values receipt-field-names
      values providers)))

(defn value-expression-literal
  [expr IrValueExpr
   resolver DeclarationResolver
   label String] Any
  (let [tag (.-_tag expr)]
    (cond
      (= tag "IrLiteralStringValue") (.-value expr)
      (= tag "IrLiteralIntegerValue") (.-value expr)
      (= tag "IrLiteralBooleanValue") (.-value expr)
      (= tag "IrLiteralKeywordValue") (strip-colon (.-value expr))
      (= tag "IrLiteralNilValue") nil
      (= tag "IrRecordValue")
        (reduce
          (fn [result field] Any
            (assoc result (strip-colon (.-name field))
                   (value-expression-literal (.-value field) resolver label)))
          {}
          (.-fields expr))
      (= tag "IrListValue")
        (mapv
          (fn [item IrValueExpr] Any
            (value-expression-literal item resolver label))
          (.-items expr))
      (= tag "IrConfigValue")
        (let [bound (get (.-value_bindings resolver) (ref-key (.-role expr)))]
          (if (nil? bound)
            (graph-error (str label " names an unbound configured value"))
            (value-expression-literal bound resolver label)))
      (= tag "IrConfigProjectionValue")
        (configured-projection-literal
          (.-projection expr) resolver label)
      (= tag "IrBoundFieldValue")
        (graph-error (str label " cannot use a bound field as a constant"))
      :else
        (graph-error (str label " uses unsupported value expression '" tag "'")))))

(defn configured-projection-literal
  [projection IrConfigProjection
   resolver DeclarationResolver
   label String] Any
  (let [bound (get (.-value_bindings resolver) (ref-key (.-role projection)))
        root (if (nil? bound)
          (graph-error (str label " names an unbound configured projection"))
          (value-expression-literal bound resolver label))]
    (reduce
      (fn [value part] Any
        (let [next (if (nil? value) nil (get value part))]
          (if (nil? next)
            (graph-error
              (str label " configuration projection misses '" part "'"))
            next)))
      root
      (.-path projection))))

(defn resolved-bound-int
  [bound IrBoundInt
   resolver DeclarationResolver
   label String] Int
  (let [tag (.-_tag bound)
        value (cond
          (= tag "IrLiteralBound") (.-value bound)
          (= tag "IrConfiguredBound")
            (let [binding (binding-for-role
                    (.-ints (.-bindings resolver)) (.-role bound) label)]
              (.-value binding))
          (= tag "IrConfiguredProjectionBound")
            (configured-projection-literal
              (.-projection bound) resolver label)
          :else (graph-error (str label " uses unsupported bound '" tag "'")))]
    (if (or (not (number? value)) (not (js/Number.isSafeInteger value)))
      (graph-error (str label " must resolve to a safe integer"))
      value)))

(defn value-type-literal
  [literal IrValueLiteral
   label String] Any
  (let [tag (.-_tag literal)]
    (cond
      (= tag "IrStringLiteral") (.-value literal)
      (= tag "IrIntegerLiteral") (.-value literal)
      (= tag "IrBooleanLiteral") (.-value literal)
      (= tag "IrKeywordLiteral") (strip-colon (.-value literal))
      (= tag "IrNilLiteral") nil
      :else
        (graph-error (str label " uses unsupported literal '" tag "'")))))

(defn value-type-definition
  [program IrDeclarationProgram
   ref IrValueTypeRef
   label String] IrValueTypeDefinition
  (let [matches (reduce
          (fn [result declaration] (Vec IrValueTypeDefinition)
            (into result
              (filterv
                (fn [definition IrValueTypeDefinition] Bool
                  (same-nominal? (.-ref definition) ref))
                (.-definitions declaration))))
          []
          (.-value_types program))]
    (if (not (= (count matches) 1))
      (graph-error (str label " must resolve one value-type definition"))
      (first matches))))

(defn value-type-declaration
  [program IrDeclarationProgram
   ref IrValueTypeRef
   label String] IrValueTypeDeclarationSpec
  (let [matches (filterv
          (fn [declaration IrValueTypeDeclarationSpec] Bool
            (some?
              (first
                (filterv
                  (fn [definition IrValueTypeDefinition] Bool
                    (same-nominal? (.-ref definition) ref))
                  (.-definitions declaration)))))
          (.-value_types program))]
    (if (not (= (count matches) 1))
      (graph-error (str label " must resolve one value-type declaration"))
      (first matches))))

(defn lower-value-descriptor
  [source IrValueTypeSpec
   program IrDeclarationProgram
   resolver DeclarationResolver
   label String] Any
  (let [shape Any source]
    (match source
      [(IrStringValueType _ _ _)
        (let [minimum-bound IrBoundInt? (.-minimum_scalars shape)
              maximum-bound IrBoundInt? (.-maximum_scalars shape)
              bytes-bound IrBoundInt? (.-maximum_bytes shape)
              minimum Int? (if (nil? minimum-bound) nil
                  (resolved-bound-int minimum-bound resolver label))
              maximum Int? (if (nil? maximum-bound) nil
                  (resolved-bound-int maximum-bound resolver label))
              bytes Int? (if (nil? bytes-bound) nil
                  (resolved-bound-int bytes-bound resolver label))]
          (cond
            (and (some? minimum) (some? maximum) (some? bytes))
              {"kind" "string" "minLength" minimum
               "maxLength" maximum "maxBytes" bytes}
            (and (some? minimum) (some? maximum))
              {"kind" "string" "minLength" minimum "maxLength" maximum}
            (and (some? minimum) (some? bytes))
              {"kind" "string" "minLength" minimum "maxBytes" bytes}
            (and (some? maximum) (some? bytes))
              {"kind" "string" "maxLength" maximum "maxBytes" bytes}
            (some? minimum) {"kind" "string" "minLength" minimum}
            (some? maximum) {"kind" "string" "maxLength" maximum}
            (some? bytes) {"kind" "string" "maxBytes" bytes}
            :else {"kind" "string"}))]
      [(IrIntegerValueType _ _)
        (let [minimum-bound IrBoundInt? (.-minimum shape)
              maximum-bound IrBoundInt? (.-maximum shape)
              minimum Int? (if (nil? minimum-bound) nil
                  (resolved-bound-int minimum-bound resolver label))
              maximum Int? (if (nil? maximum-bound) nil
                  (resolved-bound-int maximum-bound resolver label))]
          (cond
            (and (some? minimum) (some? maximum))
              {"kind" "integer" "minimum" minimum "maximum" maximum}
            (some? minimum) {"kind" "integer" "minimum" minimum}
            (some? maximum) {"kind" "integer" "maximum" maximum}
            :else {"kind" "integer"}))]
      [(IrBooleanValueType _) {"kind" "boolean"}]
      [(IrDigestValueType _) {"kind" "digest"}]
      [(IrInstantValueType _) {"kind" "instant"}]
      [(IrKeywordValueType _) {"kind" "keyword"}]
      [(IrEnumValueType _)
        (let [allowed (Vec IrValueLiteral) (.-allowed shape)]
          {"kind" "enum"
           "values"
           (mapv
             (fn [literal IrValueLiteral] Any
               (value-type-literal literal label))
             allowed)})]
      [(IrEntityReferenceValueType _) {"kind" "string"}]
      [(IrStateValueType _) {"kind" "keyword"}]
      [(IrRecordValueType _)
        (let [fields (Vec IrValueRecordField) (.-fields shape)]
          {"kind" "record"
           "fields"
           (mapv
             (fn [field IrValueRecordField] Any
               {"name" (.-name field)
                "required" (.-required field)
                "value"
                (lower-value-descriptor
                  (.-value_type field) program resolver
                  (str label "." (.-name field)))})
             fields)})]
      [(IrTaggedValueType _ _)
        (let [tag-field String (.-tag_field shape)
              variants (Vec IrValueTaggedVariant) (.-variants shape)]
          {"kind" "tagged"
           "tag" tag-field
           "variants"
           (mapv
             (fn [variant IrValueTaggedVariant] Any
               {"tag" (.-tag variant)
                "fields"
                (mapv
                  (fn [field IrValueRecordField] Any
                    {"name" (.-name field)
                     "required" (.-required field)
                     "value"
                     (lower-value-descriptor
                       (.-value_type field) program resolver
                       (str label "." (.-name field)))})
                  (.-fields variant))})
             variants)})]
      [(IrListValueType _ _ _ _)
        (let [item IrValueTypeSpec (.-item shape)
              minimum-items IrBoundInt? (.-minimum_items shape)
              maximum-items IrBoundInt? (.-maximum_items shape)
              normalization IrListNormalization? (.-normalization shape)
              maximum Int (if (nil? maximum-items)
                (graph-error (str label " list requires a maximum bound"))
                (resolved-bound-int maximum-items resolver label))]
          (if (some? minimum-items)
            (graph-error (str label " list minimum is not representable"))
            nil)
          (if (nil? normalization)
            {"kind" "list"
             "items"
             (lower-value-descriptor
               item program resolver (str label " item"))
             "maxItems" maximum}
            (if (= (.-_tag normalization) "IrSortUniqueList")
              {"kind" "list"
               "items"
               (lower-value-descriptor
                 item program resolver (str label " item"))
               "maxItems" maximum
               "normalizer" "sort-unique"}
              (graph-error (str label " uses unsupported list normalization")))))]
      [(IrNullableValueType _)
        (let [value-type IrValueTypeSpec (.-value_type shape)]
          {"kind" "nullable"
           "value"
           (lower-value-descriptor
             value-type program resolver (str label " nullable value"))})]
      [(IrNamedValueType _)
        (let [value-type IrValueTypeRef (.-value_type shape)]
          {"kind" "ref" "name" (.-name value-type)})]
      [(IrLiteralValueType _)
        (let [literal IrValueLiteral (.-literal shape)]
          {"kind" "literal" "value" (value-type-literal literal label)})]
      [(IrExtensionValueType _)
        (let [port IrEntityFieldsPortRef (.-port shape)]
          {"kind" "extension"
           "port" (imported-port-name (.-prefix resolver) port)})])))

(defn lower-value-type-declaration
  [source IrValueTypeDeclarationSpec
   program IrDeclarationProgram
   resolver DeclarationResolver] Any
  (let [name (resolved-name resolver "value-type" (.-root source))
        envelope (.-envelope source)]
    (if (nil? envelope)
      (graph-error (str "value type '" name "' requires a bounded envelope"))
      nil)
    {"name" name
     "descriptor"
     {"kind" "bounded"
      "definitions"
      (mapv
        (fn [definition IrValueTypeDefinition] Any
          {"name" (.-name (.-ref definition))
           "value"
           (lower-value-descriptor
             (.-spec definition) program resolver
             (str "value type '" name "'"))})
        (.-definitions source))
      "maxBytes"
      (resolved-bound-int (.-maximum_bytes envelope) resolver name)
      "maxDepth"
      (resolved-bound-int (.-maximum_depth envelope) resolver name)
      "maxNodes"
      (resolved-bound-int (.-maximum_nodes envelope) resolver name)
      "value" {"kind" "ref" "name" (.-name (.-root source))}}}))

(defn resolved-value-type-descriptor
  [source IrValueTypeSpec
   program IrDeclarationProgram
   resolver DeclarationResolver
   label String] Any
  (if (= (.-_tag source) "IrNamedValueType")
    (.-descriptor (lower-value-type-declaration
        (value-type-declaration program (.-value_type source) label)
        program resolver))
    (lower-value-descriptor source program resolver label)))

(defn declaration-with-ref
  [items Any
   ref Any
   label String] Any
  (let [matches (filterv
          (fn [item Any] Bool
            (same-nominal? (or (.-ref item) (.-root item)) ref))
          items)]
    (if (not (= (count matches) 1))
      (graph-error
        (str label " must resolve to exactly one declaration, found "
             (count matches)))
      (first matches))))

(defn root-storage-id
  [root IrApplicationRootSpec
   entity IrEntityRef] String?
  (let [matches (filterv
          (fn [storage IrStorageSpec] Bool
            (same-nominal? (.-entity storage) entity))
          (.-storage root))]
    (if (> (count matches) 1)
      (graph-error
        (str "application storage repeats entity '" (.-name entity) "'"))
      nil)
    (if (= (count matches) 0) nil (.-storage_id (first matches)))))

(defn root-identity-field
  [root IrApplicationRootSpec
   entity IrEntityRef] IrFieldRef?
  (let [matches (filterv
          (fn [identity IrIdentitySpec] Bool
            (same-nominal? (.-entity identity) entity))
          (.-identities root))]
    (if (> (count matches) 1)
      (graph-error
        (str "application identities repeat entity '" (.-name entity) "'"))
      nil)
    (if (= (count matches) 0) nil (.-field (first matches)))))

(defn field-cardinality-name [cardinality IrFieldCardinality] String
  (let [tag (.-_tag cardinality)]
    (cond
      (= tag "IrSingleField") "single"
      (= tag "IrManyField") "multi"
      :else
        (graph-error
          (str "field cardinality uses unsupported constructor '" tag "'")))))

(defn field-write-name [write IrFieldWriteMode] String
  (let [tag (.-_tag write)]
    (cond
      (= tag "IrIdentityWrite") "identity"
      (= tag "IrCreateWrite") "create"
      (= tag "IrSetWrite") "set"
      (= tag "IrCommandFieldWrite") "command"
      (= tag "IrServerWrite") "server"
      :else
        (graph-error
          (str "field write mode uses unsupported constructor '" tag "'")))))

(defn external-entity-binding
  [bindings IrPluginBindings
   role IrExternalEntityRoleRef] IrEntityRef
  (let [matches (filterv
          (fn [binding IrExternalEntityBinding] Bool
            (= (.-declaration_id (.-role binding)) (.-declaration_id role)))
          (.-external_entities bindings))]
    (if (not (= (count matches) 1))
      (graph-error
        (str "external entity role '" (.-declaration_id role)
             "' must have exactly one checked binding"))
      (.-value (first matches)))))

(defn field-type-shape
  [value-type IrFieldValueType
   resolver DeclarationResolver] Any
  (let [tag (.-_tag value-type)]
    (cond
      (= tag "IrStringField") ["String" "literal" nil]
      (= tag "IrIntField") ["Int" "literal" nil]
      (= tag "IrBoolField") ["Bool" "literal" nil]
      (= tag "IrKeywordField") ["Keyword" "literal" nil]
      (= tag "IrInstantField") ["Instant" "literal" nil]
      (= tag "IrDigestField") ["Digest" "literal" nil]
      (= tag "IrStateField")
        [(resolved-name resolver "state" (.-state value-type)) "literal" nil]
      (= tag "IrValueField")
        [(resolved-name resolver "value-type" (.-value_type value-type)) "literal" nil]
      (= tag "IrRefField")
        (let [target (.-target value-type)
              target-tag (.-_tag target)]
          (cond
            (= target-tag "IrDeclaredEntityTarget")
              ["Ref" "ref" (resolved-name resolver "entity" (.-entity target))]
            (= target-tag "IrExternalEntityTarget")
              (if-let [bindings (.-bindings resolver)]
                ["Ref" "ref"
                 (.-name (external-entity-binding bindings (.-role target)))]
                (graph-error "application field cannot use an unbound external entity role"))
            :else
              (graph-error
                (str "reference field uses unsupported target '" target-tag "'"))))
      :else
        (graph-error
          (str "field uses unsupported value type '" tag "'")))))

(defn lower-stored-field
  [field IrFieldSpec
   entity IrEntityDeclarationSpec
   resolver DeclarationResolver
   application-id String
   entity-local Bool
   entity-name String] GField
  (if (not (same-nominal? (.-owner field) (.-ref entity)))
    (graph-error
      (str "field '" (.-name (.-ref field)) "' has a foreign entity owner"))
    nil)
  (let [name (resolved-name resolver "field" (.-ref field))
        shape (field-type-shape (.-value_type field) resolver)
        write (field-write-name (.-write field))
        storage-id (required-storage-id
          (.-storage_id field)
          (str "field '" entity-name "." name "'")
          (str "app:" application-id "/entity:" entity-name "/field:" name)
          entity-local)]
    (->GField
      name
      storage-id
      (nth shape 0)
      (= write "identity")
      (field-cardinality-name (.-cardinality field))
      (nth shape 1)
      (nth shape 2)
      (if (= write "identity") "set" write)
      false
      []
      nil)))

(defn derived-expression-dependencies [expr IrDerivedExpr] (Vec String)
  (let [tag (.-_tag expr)]
    (cond
      (= tag "IrFieldDerivedExpr") [(.-name (.-field expr))]
      (= tag "IrStringDerivedExpr") []
      (= tag "IrConcatDerivedExpr")
        (reduce
          (fn
            [result (Vec String)
             part IrDerivedExpr] (Vec String)
            (append-unique-derived-deps
              result (derived-expression-dependencies part)))
          []
          (.-parts expr))
      :else
        (graph-error
          (str "derived expression uses unsupported constructor '" tag "'")))))

(defn lower-derived-field
  [field IrDerivedFieldSpec
   entity IrEntityDeclarationSpec
   application-id String
   entity-name String] GField
  (if (not (same-nominal? (.-owner field) (.-ref entity)))
    (graph-error
      (str "derived field '" (.-name (.-ref field))
           "' has a foreign entity owner"))
    nil)
  (let [name (.-name (.-ref field))
        declared (mapv (fn [ref IrFieldRef] String (.-name ref))
                       (.-dependencies field))
        actual (derived-expression-dependencies (.-expression field))]
    (if (not (= declared actual))
      (graph-error
        (str "derived field '" entity-name "." name
             "' dependencies do not exactly match its expression"))
      nil)
    (->GField
      name
      (str "app:" application-id "/entity:" entity-name "/derived:" name)
      "Derived"
      false
      "single"
      "literal"
      nil
      "set"
      true
      declared
      (.-expression field))))

(defn lower-entity-declaration
  [entity IrEntityDeclarationSpec
   root IrApplicationRootSpec?
   resolver DeclarationResolver
   application-id String
   entity-local Bool] GEntity
  (let [name (resolved-name resolver "entity" (.-ref entity))
        root-storage (if (nil? root) nil (root-storage-id root (.-ref entity)))
        declared-storage (.-storage_id entity)
        storage-id (do
          (if (and (some? root-storage) (some? declared-storage)
                   (not (= root-storage declared-storage)))
            (graph-error
              (str "entity '" name "' has conflicting fixed storage IDs"))
            nil)
          (required-storage-id
            (or root-storage declared-storage)
            (str "entity '" name "'")
            (str "app:" application-id "/entity:" name)
            entity-local))
        stored (mapv
          (fn [field IrFieldSpec] GField
            (lower-stored-field
              field entity resolver application-id entity-local name))
          (.-fields entity))
        derived (mapv
          (fn [field IrDerivedFieldSpec] GField
            (lower-derived-field field entity application-id name))
          (.-derived_fields entity))
        fields (into stored derived)
        field-names (mapv (fn [field GField] String (.-name field)) fields)
        identity-fields (filterv (fn [field GField] Bool (.-identity field)) stored)
        root-identity (if (nil? root) nil (root-identity-field root (.-ref entity)))]
    (validate-distinct-names field-names (str "entity '" name "' field"))
    (if (some? root-identity)
      (let [resolved (filterv
              (fn [field IrFieldSpec] Bool
                (same-nominal? (.-ref field) root-identity))
              (.-fields entity))]
        (if (not (= (count resolved) 1))
          (graph-error
            (str "entity '" name "' identity names a foreign field"))
          nil)
        (if (not (= (field-write-name (.-write (first resolved))) "identity"))
          (graph-error
            (str "entity '" name
                 "' identity field must use IdentityWrite"))
          nil))
      nil)
    (if (and (some? root) (= (count identity-fields) 1)
             (nil? root-identity))
      (graph-error
        (str "application entity '" name
             "' has IdentityWrite but no matching IdentitySpec"))
      nil)
    (validate-derived-fields name fields)
    (->GEntity
      name
      storage-id
      fields
      stored
      derived
      (filterv (fn [field GField] Bool (= (.-value_kind field) "ref")) fields)
      (if (= (count identity-fields) 1) (first identity-fields) nil)
      (str name "s"))))

(defn state-value-spec
  [program IrDeclarationProgram
   ref IrStateValueRef
   label String] IrStateValueSpec
  (let [matches (reduce
          (fn [result state] (Vec IrStateValueSpec)
            (into result
              (filterv
                (fn [value IrStateValueSpec] Bool
                  (same-nominal? (.-ref value) ref))
                (.-values state))))
          []
          (.-states program))]
    (if (not (= (count matches) 1))
      (graph-error (str label " must resolve one state value"))
      (first matches))))

(defn resolved-state-value
  [program IrDeclarationProgram
   resolver DeclarationResolver
   ref IrStateValueRef
   label String] String
  (let [renamed (get (.-state_values resolver) (ref-key ref))]
    (if (some? renamed)
      renamed
      (strip-colon (.-value (state-value-spec program ref label))))))

(defn lower-state-declaration
  [state IrStateDeclarationSpec
   program IrDeclarationProgram
   resolver DeclarationResolver] IrDefstate
  (let [name (resolved-name resolver "state" (.-ref state))
        transitions (reduce
          (fn [result transition] Any
            (assoc result
              (resolved-state-value
                program resolver (.-from transition) (str "state '" name "'"))
              (mapv
                (fn [target IrStateValueRef] String
                  (resolved-state-value
                    program resolver target (str "state '" name "'")))
                (.-to transition))))
          {}
          (.-transitions state))
        initial (resolved-state-value
          program resolver (.-initial state) (str "state '" name "' initial"))]
    (ir/->IrDefstate name transitions initial)))

(defn authority-shape [authority IrAuthoritySpec] Any
  (let [tag (.-_tag authority)]
    (cond
      (= tag "IrStoreAuthority") [(ir/->IrBackend "store") nil]
      (= tag "IrLocalStorageAuthority")
        [nil (ir/->IrPersist "local-storage" (.-namespace authority))]
      (= tag "IrMemoryAuthority") [nil nil]
      :else
        (graph-error (str "application uses unsupported authority '" tag "'")))))

(defn lower-publication
  [source IrPublicationDeclarationSpec
   program IrDeclarationProgram
   resolver DeclarationResolver] IrPublication
  (ir/->IrPublication
    (resolved-name resolver "publication" (.-ref source))
    (resolved-name resolver "entity" (.-owner source))
    (resolved-name resolver "field" (.-pointer source))
    (resolved-name resolver "entity" (.-revision source))
    (resolved-name resolver "field" (.-owner_field source))
    (resolved-name resolver "field" (.-state_field source))
    (resolved-state-value program resolver (.-draft source) "publication draft")
    (resolved-state-value program resolver (.-published source) "publication published")
    (resolved-state-value program resolver (.-retired source) "publication retired")))

(defn lower-form
  [source IrFormDeclarationSpec
   resolver DeclarationResolver] IrSmartForm
  (let [success (.-_tag (.-on_success source))]
    (if (not (= success "IrClearFormSuccess"))
      (graph-error (str "form uses unsupported success action '" success "'"))
      (ir/->IrSmartForm
        (resolved-name resolver "form" (.-ref source))
        (resolved-name resolver "entity" (.-entity source))
        (mapv
          (fn [field IrFieldRef] String (resolved-name resolver "field" field))
          (.-fields source))
        (mapv
          (fn [field IrFieldRef] String (resolved-name resolver "field" field))
          (.-required source))
        (.-submit_label source)
        "clear"))))

(defn lower-list-detail
  [source IrListDetailDeclarationSpec
   resolver DeclarationResolver] IrListDetail
  (let [entity (resolved-name resolver "entity" (.-entity source))
        field-names (fn [fields] (Vec String)
          (mapv
            (fn [field IrFieldRef] String (resolved-name resolver "field" field))
            fields))
        tabs (mapv
          (fn [tab] IrDetailTab
            (let [tag (.-_tag tab)]
              (cond
                (= tag "IrFieldsDetailTab")
                  (ir/->IrDetailTab
                    (.-label tab) "fields" (field-names (.-fields tab))
                    nil nil false [])
                (= tag "IrRelatedDetailTab")
                  (ir/->IrDetailTab
                    (.-label tab) "related" []
                    (resolved-name resolver "entity" (.-entity tab))
                    (resolved-name resolver "field" (.-relation tab))
                    false
                    (field-names (.-display tab)))
                :else
                  (graph-error
                    (str "list detail uses unsupported tab '" tag "'")))))
          (.-detail_tabs source))]
    (ir/->IrListDetail
      entity (.-title source)
      (field-names (.-columns source))
      (field-names (.-search source))
      tabs)))

(defn lower-ui-value
  [value IrValueExpr
   resolver DeclarationResolver
   label String] Any
  (if (= (.-_tag value) "IrBoundFieldValue")
    {"kind" "prop" "name" (resolved-name resolver "field" (.-field value))}
    {"kind" "literal" "value" (value-expression-literal value resolver label)}))

(defn lower-ui-action
  [action IrUiAction
   resolver DeclarationResolver
   label String] IrAction
  (let [tag (.-_tag action)]
    (if (= tag "IrSetFieldAction")
      (ir/->IrAction
        "set"
        [{"kind" "tag"
          "name" (resolved-name resolver "field" (.-field action))}
         (lower-ui-value (.-value action) resolver label)])
      (graph-error (str label " uses unsupported UI action '" tag "'")))))

(defn lower-ui-node
  [node IrDeclarationUiNode
   resolver DeclarationResolver
   label String] Any
  (let [tag (.-_tag node)]
    (cond
      (= tag "IrDeclarationElement")
        (let [attrs (reduce-kv
                (fn
                  [result Any
                   name String
                   attr IrUiAttrSpec] Any
                  (let [attr-tag (.-_tag attr)
                        lowered (cond
                          (= attr-tag "IrStaticUiAttr")
                            {"type" "static" "value" (.-value attr)}
                          (= attr-tag "IrBoundUiAttr")
                            {"type" "bind" "prop" (.-prop attr)}
                          (= attr-tag "IrActionAttr")
                            (if (.startsWith name "on-")
                              {"type" "action"
                               "event" (subs name 3)
                               "action"
                               (lower-ui-action (.-action attr) resolver label)}
                              (graph-error
                                (str label " action attribute '" name
                                     "' must begin on-")))
                          :else
                            (graph-error
                              (str label " uses unsupported UI attribute '"
                                   attr-tag "'")))]
                    (assoc result name lowered)))
                {}
                (.-attrs node))]
          (ir/->IrElement
            (.-tag node)
            attrs
            (mapv
              (fn [child IrDeclarationUiNode] IrNode
                (lower-ui-node child resolver label))
              (.-children node))))
      (= tag "IrDeclarationWhen")
        (let [condition (.-condition node)
              condition-tag (.-_tag condition)]
          (if (not (= condition-tag "IrUiPropertyPresent"))
            (graph-error
              (str label " uses unsupported UI condition '" condition-tag "'"))
            (ir/->IrWhen
              (.-prop condition)
              (mapv
                (fn [child IrDeclarationUiNode] IrNode
                  (lower-ui-node child resolver label))
                (.-children node)))))
      :else (graph-error (str label " uses unsupported UI node '" tag "'")))))

(defn lower-component
  [source IrComponentDeclarationSpec
   resolver DeclarationResolver] IrComponent
  (let [name (resolved-name resolver "component" (.-ref source))]
    (ir/->IrComponent
      name
      (mapv (fn [prop IrComponentPropertySpec] String (.-name prop))
            (.-properties source))
      (mapv
        (fn [node IrDeclarationUiNode] IrElement
          (lower-ui-node node resolver (str "component '" name "'")))
        (.-body source)))))

(defn form-by-ref
  [forms Any
   ref IrFormRef] IrFormDeclarationSpec
  (declaration-with-ref forms ref "view create form"))

(defn lower-view
  [source IrViewDeclarationSpec
   program IrDeclarationProgram
   resolver DeclarationResolver] IrView
  (let [form-ref IrFormRef? (.-create_form source)
        select-ref IrComponentRef? (.-select_component source)
        form IrFormDeclarationSpec? (if (nil? form-ref)
               nil
               (form-by-ref (.-forms program) form-ref))]
    (ir/->IrView
      (resolved-name resolver "view" (.-ref source))
      (resolved-name resolver "entity" (.-entity source))
      (resolved-name resolver "component" (.-component source))
      (if (nil? form)
        []
        (mapv
          (fn [field IrFieldRef] String (resolved-name resolver "field" field))
          (.-fields form)))
      (.-title source)
      (if (nil? select-ref)
        nil
        (resolved-name resolver "component" select-ref))
      [] [] [])))

(defn value-type-name-for-query
  [value-type IrValueTypeSpec
   resolver DeclarationResolver
   label String] String
  (let [tag (.-_tag value-type)]
    (cond
      (= tag "IrStringValueType") "String"
      (= tag "IrIntegerValueType") "Int"
      (= tag "IrBooleanValueType") "Bool"
      (= tag "IrDigestValueType") "Digest"
      (= tag "IrInstantValueType") "Instant"
      (= tag "IrKeywordValueType") "Keyword"
      (= tag "IrStateValueType")
        (resolved-name resolver "state" (.-state value-type))
      (= tag "IrNamedValueType")
        (resolved-name resolver "value-type" (.-value_type value-type))
      :else
        (graph-error
          (str label " uses unsupported query value type '" tag "'")))))

(defn query-expression
  [expr IrQueryValueExpr
   program IrDeclarationProgram
   resolver DeclarationResolver
   label String] IrQueryOperand
  (let [tag (.-_tag expr)]
    (cond
      (= tag "IrQueryFieldValue")
        (ir/->IrQueryOperand
          "field" nil (.-binding expr)
          (resolved-name resolver "field" (.-field expr)) nil)
      (= tag "IrQueryParameterValue")
        (ir/->IrQueryOperand "parameter" (.-name expr) nil nil nil)
      (= tag "IrQueryBindingValue")
        (ir/->IrQueryOperand "binding" nil (.-name expr) nil nil)
      (= tag "IrQueryStringValue")
        (ir/->IrQueryOperand "literal" "String" nil nil (.-value expr))
      (= tag "IrQueryIntegerValue")
        (ir/->IrQueryOperand "literal" "Int" nil nil (.-value expr))
      (= tag "IrQueryBooleanValue")
        (ir/->IrQueryOperand "literal" "Bool" nil nil (.-value expr))
      (= tag "IrQueryKeywordValue")
        (ir/->IrQueryOperand
          "literal" "Keyword" nil nil (strip-colon (.-value expr)))
      (= tag "IrQueryNilValue")
        (ir/->IrQueryOperand "literal" "String" nil nil nil)
      (= tag "IrQueryStateValue")
        (ir/->IrQueryOperand
          "literal" "Keyword" nil nil
          (resolved-state-value program resolver (.-value expr) label))
      (= tag "IrQueryConfiguredValue")
        (let [value (configured-projection-literal
                (.-projection expr) resolver label)
              type (cond
                (string? value) "String"
                (boolean? value) "Bool"
                (number? value) "Int"
                :else
                  (graph-error
                    (str label " configured query value must be scalar")))]
          (ir/->IrQueryOperand "literal" type nil nil value))
      :else
        (graph-error
          (str label " uses unsupported query expression '" tag "'")))))

(defn query-provider-input
  [expr IrQueryValueExpr
   program IrDeclarationProgram
   resolver DeclarationResolver
   label String] Any
  (let [tag (.-_tag expr)]
    (cond
      (= tag "IrQueryFieldValue")
        {"kind" "column"
         "binding" (.-binding expr)
         "field" (resolved-name resolver "field" (.-field expr))}
      (= tag "IrQueryRecordValue")
        {"kind" "record"
         "fields"
         (mapv
           (fn [field IrQueryRecordField] Any
             {"name" (.-name field)
              "value"
              (query-provider-input (.-value field) program resolver label)})
           (.-fields expr))}
      (= tag "IrQueryListValue")
        {"kind" "list"
         "items"
         (mapv
           (fn [item IrQueryValueExpr] Any
             (query-provider-input item program resolver label))
           (.-items expr))}
      :else
        (let [operand (query-expression expr program resolver label)]
          (if (not (= (.-kind operand) "literal"))
            (graph-error (str label " provider input must be closed data"))
            {"kind" "literal" "value" (.-value operand)})))))

(defn lower-query-predicate
  [source IrQueryPredicateSpec
   program IrDeclarationProgram
   resolver DeclarationResolver
   label String] IrQueryPredicate
  (let [tag (.-_tag source)]
    (if (= tag "IrQueryEqualPredicate")
      (ir/->IrQueryPredicate
        "eq"
        (query-expression (.-left source) program resolver label)
        (query-expression (.-right source) program resolver label))
      (graph-error (str label " uses unsupported query predicate '" tag "'")))))

(defn lower-query
  [source IrQueryDeclarationSpec
   program IrDeclarationProgram
   resolver DeclarationResolver
   extensions Any] IrQuery
  (let [name (resolved-name resolver "query" (.-ref source))
        label (str "query '" name "'")
        params (mapv
          (fn [param IrQueryParameterSpec] IrQueryParam
            (ir/->IrQueryParam
              (.-name param)
              (value-type-name-for-query (.-value_type param) resolver label)))
          (.-parameters source))
        bindings (mapv
          (fn [binding IrQueryBindingSpec] IrQueryBinding
            (ir/->IrQueryBinding
              (.-name binding)
              (resolved-name resolver "entity" (.-entity binding))))
          (.-bindings source))
        predicates (mapv
          (fn [predicate IrQueryPredicateSpec] IrQueryPredicate
            (lower-query-predicate predicate program resolver label))
          (.-predicates source))
        selection (reduce
          (fn [result item] Any
            (let [tag (.-_tag item)]
              (cond
                (= tag "IrQueryValueSelection")
                  (let [value (.-value item)]
                    (if (not (= (.-_tag value) "IrQueryFieldValue"))
                      (graph-error
                        (str label " value selection must select a field"))
                      (conj result
                        (ir/->IrQuerySelect
                          (.-name item)
                          (.-binding value)
                          (resolved-name resolver "field" (.-field value))))))
                (= tag "IrQueryExtensionSelection")
                  (let [port-name (str (.-prefix resolver) "." (.-name (.-port item)))
                        extension (first
                          (filterv
                            (fn [candidate] Bool (= (.-port candidate) port-name))
                            extensions))]
                    (if (nil? extension)
                      result
                      (into result
                        (mapv
                          (fn [field] IrQuerySelect
                            (ir/->IrQuerySelect
                              (.-name field) (.-binding item) (.-name field)))
                          (.-fields extension)))))
                (= tag "IrQueryProviderSelection")
                  (let [provider (get
                          (.-provider_bindings resolver)
                          (ref-key (.-provider item)))]
                    (if (nil? provider)
                      (graph-error
                        (str label " names an unbound provider port"))
                      (conj result
                        (ir/->IrQueryProvided
                          (.-name item)
                          provider
                          (query-provider-input
                            (.-input item) program resolver label)))))
                :else
                  (graph-error
                    (str label " uses unsupported query selection '" tag "'")))))
          []
          (.-selection source))
        result (.-result source)
        result-tag (.-_tag result)
        page (if (= result-tag "IrQueryPageResult")
          (ir/->IrQueryPage
            (resolved-bound-int (.-default_limit result) resolver label)
            (resolved-bound-int (.-max_limit result) resolver label))
          nil)
        result-kind (cond
          (= result-tag "IrQueryPageResult") "page"
          (= result-tag "IrQueryOptionalResult") "optional"
          (= result-tag "IrQueryOneResult") "one"
          :else (graph-error (str label " uses unsupported result '" result-tag "'")))]
    (ir/->IrQuery
      name
      (mapv
        (fn [capability IrCapabilityRef] String
          (resolved-capability-name resolver capability))
        (.-capabilities source))
      params bindings predicates selection result-kind page)))

(defn lower-route-template
  [source IrRouteTemplateSpec
   resolver DeclarationResolver] IrRoute
  (ir/->IrRoute
    (resolved-name resolver "route" (.-ref source))
    (resolved-name resolver "view" (.-view source))
    (mapv
      (fn [query IrRouteQuerySpec] IrRouteQuery
        (ir/->IrRouteQuery
          (resolved-name resolver "query" (.-query query)) (.-alias query)))
      (.-queries source))
    (mapv (fn [param IrRouteParameterSpec] String (.-name param))
          (.-parameters source))
    (mapv (fn [param IrRouteParameterSpec] String (.-name param))
          (.-parameters source))
    []))

(defn route-parameters [path String] (Vec String)
  (if (= path "/")
    []
    (reduce
      (fn [result segment] (Vec String)
        (if (.startsWith segment ":")
          (let [name (subs segment 1)]
            (if (= name "")
              (graph-error (str "route path '" path "' has an empty parameter"))
              (conj result name)))
          result))
      []
      (.split (subs path 1) "/"))))

(defn plugin-evidence [instance IrLinkedPluginInstance] Any
  (let [evidence (.-evidence instance)]
    {:package_id (.-package_id evidence)
     :version (.-version evidence)
     :alias (.-alias instance)
     :artifact_digest (.-artifact_digest evidence)
     :source_kind (.-source_kind evidence)
     :source_revision (.-source_revision evidence)
     :artifact_path (.-artifact_path evidence)
     :entry_path (.-entry_path evidence)
     :configuration_digest (.-configuration_digest evidence)
     :durable_schema_version (.-durable_schema_version evidence)
     :migration_ordinal (.-migration_ordinal evidence)}))

(defn contribution-allowed?
  [use IrPluginUseSpec
   tag String] Bool
  (some?
    (first
      (filterv (fn [item] Bool (= (.-_tag item) tag)) (.-allow use)))))

(defn imported-port-name
  [prefix String
   ref Any] String
  (str prefix "." (.-name ref)))

(defn plugin-port
  [program IrDeclarationProgram
   ref Any
   field String
   label String] Any
  (let [declarations (cond
          (= field "value-types") (.-value_types program)
          (= field "provider-ports") (.-provider_ports program)
          (= field "entity-fields-ports") (.-entity_fields_ports program)
          (= field "component-slots") (.-component_slots program)
          (= field "route-slots") (.-route_slots program)
          (= field "route-templates") (.-route_templates program)
          :else
            (graph-error (str label " uses unsupported declaration set '" field "'")))]
    (let [matches (filterv
            (fn [item] Bool
              (= (ref-key (or (.-ref item) (.-root item))) (ref-key ref)))
            declarations)]
      (if (not (= (count matches) 1))
        (graph-error
          (str label " must resolve to exactly one imported declaration, found "
               (count matches)))
        (first matches)))))

(defn lower-provider-port
  [source IrProviderPortSpec
   program IrDeclarationProgram
   resolver DeclarationResolver] GProviderPort
  (let [name (resolved-name resolver "provider-port" (.-ref source))]
    (->GProviderPort
      name
      (resolved-value-type-descriptor
        (.-input_type source) program resolver
        (str "provider port '" name "' input"))
      (resolved-value-type-descriptor
        (.-output_type source) program resolver
        (str "provider port '" name "' output")))))

(defn lower-provider-binding
  [source IrProviderBindingSpec
   instance IrLinkedPluginInstance
   program IrDeclarationProgram
   resolver DeclarationResolver] GProvider
  (let [declaration (plugin-port program (.-port source) "provider-ports" "provider binding")
        contract (lower-provider-port declaration program resolver)
        evidence (.-evidence instance)]
    (->GProvider
      (.-name source)
      (imported-port-name (.-prefix resolver) (.-port source))
      (.-package_id evidence)
      (.-name (.-port source))
      (.-input contract)
      (.-output contract)
      (ir/->SourceSpan "linked-declarations" 0 0 1 1 1 1))))

(defn lower-provider-bindings
  [instance IrLinkedPluginInstance
   program IrDeclarationProgram
   resolver DeclarationResolver] (Vec GProvider)
  (let [sources (.-providers (.-composition instance))
        required (.-required_providers (plugin-spec program "provider bindings"))]
    (doseq [port required]
      (let [matches (filterv
              (fn [binding IrProviderBindingSpec] Bool
                (= (ref-key (.-port binding)) (ref-key port)))
              sources)]
        (if (not (= (count matches) 1))
          (graph-error
            (str "plugin '" (.-alias instance) "' requires provider port '"
                 (.-name port) "' exactly once"))
          nil)))
    (mapv
      (fn [source IrProviderBindingSpec] GProvider
        (lower-provider-binding source instance program resolver))
      sources)))

(defn receipt-field-shape
  [source IrReceiptFieldDeclarationSpec
   resolver DeclarationResolver
   label String] Any
  (let [type (.-value_type source)
        tag (.-_tag type)]
    (cond
      (some? (.-target source))
        ["Ref" "ref" (resolved-name resolver "entity" (.-target source))]
      (= tag "IrStringValueType") ["String" "literal" nil]
      (= tag "IrIntegerValueType") ["Int" "literal" nil]
      (= tag "IrBooleanValueType") ["Bool" "literal" nil]
      (= tag "IrDigestValueType") ["Digest" "literal" nil]
      (= tag "IrInstantValueType") ["Instant" "literal" nil]
      (= tag "IrKeywordValueType") ["Keyword" "literal" nil]
      (= tag "IrStateValueType")
        [(resolved-name resolver "state" (.-state type)) "literal" nil]
      (= tag "IrNamedValueType")
        [(resolved-name resolver "value-type" (.-value_type type)) "literal" nil]
      :else
        (graph-error (str label " uses unsupported receipt field type '" tag "'")))))

(defn lower-receipt-field
  [source IrReceiptFieldDeclarationSpec
   resolver DeclarationResolver] GField
  (let [name (resolved-name resolver "receipt-field" (.-ref source))
        shape (receipt-field-shape source resolver (str "receipt field '" name "'"))]
    (->GField
      name
      (.-storage_id source)
      (nth shape 0)
      (= name "id")
      "single"
      (nth shape 1)
      (nth shape 2)
      (if (= name "id") "set" "command")
      false [] nil)))

(defn receipt-entity
  [application IrDeclarationProgram
   plugins (Vec LoweredPlugin)
   commands (Vec Any)] GEntity?
  (if (= (count commands) 0)
    nil
    (let [sources (reduce
          (fn [result plugin] (Vec Any)
            (conj result
              [(.-receipt_entity (.-program plugin))
               (.-receipt_fields (.-program plugin))
               (.-resolver plugin)]))
          [[(.-receipt_entity application)
            (.-receipt_fields application)
            (empty-resolver)]]
          plugins)
          entities (filterv (fn [source] Bool (some? (nth source 0))) sources)]
      (if (= (count entities) 0)
      nil
      (let [storage-ids (reduce
              (fn [result source] (Vec String)
                (let [value (.-storage_id (nth source 0))]
                  (if (.includes result value) result (conj result value))))
              [] entities)]
        (if (not (= (count storage-ids) 1))
          (graph-error "command receipt core has conflicting storage IDs")
          nil)
        (let [fields (reduce
                (fn [result source] (Vec GField)
                  (reduce
                    (fn [current field] (Vec GField)
                      (let [lowered (lower-receipt-field field (nth source 2))
                            prior (first
                              (filterv
                                (fn [item GField] Bool
                                  (= (.-storage_id item) (.-storage_id lowered)))
                                current))]
                        (if (nil? prior) (conj current lowered) current)))
                    result
                    (nth source 1)))
                [] sources)
              identity (first (filterv (fn [field GField] Bool (.-identity field)) fields))]
          (validate-distinct-names
            (mapv (fn [field GField] String (.-name field)) fields)
            "command receipt field")
          (->GEntity
            "wake.core/command-receipt"
            (first storage-ids)
            fields fields []
            (filterv
              (fn [field GField] Bool (= (.-value_kind field) "ref"))
              fields)
            identity
            "wake.core/command-receipts")))))))

(defn extension-target-name
  [port IrEntityFieldsPortSpec
   resolver DeclarationResolver] String
  (let [target (.-target port)
        tag (.-_tag target)]
    (cond
      (= tag "IrDeclaredEntityFieldsTarget")
        (resolved-name resolver "entity" (.-entity target))
      (= tag "IrReceiptEntityFieldsTarget") "wake.core/command-receipt"
      :else
        (graph-error (str "extension port uses unsupported target '" tag "'")))))

(defn lower-extension-field
  [source IrExtensionFieldSpec
   resolver DeclarationResolver
   target String] IrAttr
  (let [shape (field-type-shape (.-value_type source) resolver)
        write (field-write-name (.-write source))]
    (if (not (nonempty-string? (.-storage_id source)))
      (graph-error
        (str "extension field '" (.-name (.-ref source))
             "' requires an explicit storage ID"))
      nil)
    (ir/->IrAttr
      (.-name (.-ref source))
      (.-storage_id source)
      (nth shape 0)
      {"many" (= (field-cardinality-name (.-cardinality source)) "multi")
       "required" (.-required source)
       "server" (= write "server")
       "write" (if (= write "server") "command" write)
       "target-entity" (nth shape 2)})))

(defn lower-extensions
  [instance IrLinkedPluginInstance
   program IrDeclarationProgram
   resolver DeclarationResolver] (Vec ResolvedPluginExtension)
  (if (and (> (count (.-extensions (.-composition instance))) 0)
           (not (contribution-allowed? (.-use instance) "IrSchemaContribution")))
    (graph-error (str "plugin '" (.-alias instance) "' extensions require schema"))
    (mapv
      (fn [source IrExtendSpec] ResolvedPluginExtension
        (let [port (plugin-port
                program (.-port source) "entity-fields-ports" "extension port")
              target (extension-target-name port resolver)
              policy (.-policy port)]
          (if (= (.-_tag (.-policy port)) "IrClosedEntityFieldsPort")
            (graph-error
              (str "extension port '" (.-name (.-ref port)) "' is closed"))
            nil)
          (doseq [field (.-fields source)]
            (if (not (= (.-_tag (.-write field)) (.-_tag (.-write policy))))
              (graph-error
                (str "extension port '" (.-name (.-ref port)) "' field '"
                     (.-name (.-ref field)) "' must use "
                     (field-write-name (.-write policy)) " write policy"))
              nil))
          (->ResolvedPluginExtension
            instance program resolver source port target
            (ir/->IrExtend
              (imported-port-name (.-prefix resolver) (.-port source))
              (mapv
                (fn [field IrExtensionFieldSpec] IrAttr
                  (lower-extension-field field (empty-resolver) target))
                (.-fields source))
              (ir/->SourceSpan "linked-declarations" 0 0 1 1 1 1)))))
      (.-extensions (.-composition instance)))))

(defn extension-values [extensions (Vec ResolvedPluginExtension)] (Vec GExtension)
  (mapv
    (fn [extension ResolvedPluginExtension] GExtension
      (let [raw (.-extension extension)]
        (->GExtension
          "entity-fields"
          (.-package_id (.-evidence (.-instance extension)))
          (.-port raw)
          (.-target extension)
          (.-fields raw))))
    extensions))

(defn apply-plugin-extensions
  [entities (Vec GEntity)
   extensions (Vec ResolvedPluginExtension)] (Vec GEntity)
  (reduce
    (fn
      [result (Vec GEntity)
       extension ResolvedPluginExtension] (Vec GEntity)
      (apply-extension
        result (.-extension extension) (.-target extension)))
    entities
    extensions))

(defn apply-extension
  [entities (Vec GEntity)
   extension IrExtend
   target String] (Vec GEntity)
  (let [matches (filterv (fn [entity GEntity] Bool (= (.-name entity) target)) entities)]
    (if (not (= (count matches) 1))
      (graph-error (str "extension '" (.-port extension) "' has no exact target"))
      nil)
    (mapv
      (fn [entity GEntity] GEntity
        (if (not (= (.-name entity) target))
          entity
          (let [additions (mapv
                  (fn [field] GField
                    (let [opts (.-opts field)
                          value-kind (if (= (.-type field) "Ref") "ref" "literal")]
                      (->GField
                        (.-name field) (or (.-storage_id field) "") (.-type field)
                        false (if (= (get opts "many") true) "multi" "single")
                        value-kind
                        (if (= value-kind "ref") (get opts "target-entity") nil)
                        (or (get opts "write") "create") false [] nil)))
                  (.-fields extension))
                fields (into (.-fields entity) additions)
                stored (into (.-stored_fields entity) additions)]
            (validate-distinct-names
              (mapv (fn [field GField] String (.-name field)) fields)
              (str "entity '" target "' field"))
            (->GEntity
              (.-name entity) (.-storage_id entity) fields stored
              (.-derived_fields entity)
              (filterv (fn [field GField] Bool (= (.-value_kind field) "ref")) fields)
              (.-identity_field entity) (.-store_name entity)))))
      entities)))

(defn lower-component-fill
  [source IrFillSpec
   program IrDeclarationProgram
   resolver DeclarationResolver
   application-components (Vec IrComponent)
   package-id String] GFill
  (let [slot (plugin-port program (.-slot source) "component-slots" "component fill")
        target-ref (.-target slot)
        target (declaration-with-ref
          (.-components program) target-ref "component fill target")
        target-name (resolved-name resolver "component" target-ref)
        component-name (.-name (.-component source))
        component (first
          (filterv
            (fn [candidate IrComponent] Bool
              (= (.-name candidate) component-name))
            application-components))
        required (mapv
          (fn [property IrComponentPropertySpec] String (.-name property))
          (.-properties target))
        provided (if (nil? component) [] (.-props component))
        missing (filterv
          (fn [property] Bool (not (.includes provided property)))
          required)
        port (imported-port-name (.-prefix resolver) (.-slot source))]
    (if (nil? component)
      (graph-error
        (str "component fill '" port "' names unknown application component '"
             component-name "'"))
      nil)
    (if (> (count missing) 0)
      (graph-error
        (str "component fill '" port "' lacks required props: "
             (.join missing ", ")))
      nil)
    (->GFill port component-name package-id target-name)))

(defn filled-component-name
  [name String
   fills (Vec GFill)] String
  (let [matches (filterv
          (fn [fill GFill] Bool (= (.-target_component fill) name))
          fills)]
    (if (> (count matches) 1)
      (graph-error (str "component '" name "' is filled more than once"))
      nil)
    (if (= (count matches) 1) (.-component (first matches)) name)))

(defn apply-component-fills
  [view IrView
   fills (Vec GFill)] IrView
  (let [select-component String? (.-select_component view)]
    (ir/->IrView
      (.-name view)
      (.-entity_name view)
      (filled-component-name (.-component view) fills)
      (.-add_fields view)
      (.-title view)
      (if (nil? select-component)
        nil
        (filled-component-name select-component fills))
      (.-tabs view)
      (.-filters view)
      (.-date_filters view))))

(defn apply-component-fills-to-components
  [components (Vec IrComponent)
   fills (Vec GFill)] (Vec IrComponent)
  (reduce
    (fn
      [result (Vec IrComponent)
       component IrComponent] (Vec IrComponent)
      (let [name (filled-component-name (.-name component) fills)
            replacement (first
              (filterv
                (fn [candidate IrComponent] Bool
                  (= (.-name candidate) name))
                components))]
        (if (nil? replacement)
          (graph-error
            (str "component fill names missing replacement component '" name "'"))
          nil)
        (if (some?
              (first
                (filterv
                  (fn [candidate IrComponent] Bool
                    (= (.-name candidate) name))
                  result)))
          result
          (conj result replacement))))
    []
    components))

(defn route-pattern [path String] String
  (if (= path "/")
    ""
    (.join (mapv
        (fn [segment] String (if (.startsWith segment ":") ":" segment))
        (.split (subs path 1) "/")) "/")))

(defn mounted-route
  [mount IrMountSpec
   program IrDeclarationProgram
   resolver DeclarationResolver] IrRoute
  (let [slot (plugin-port program (.-slot mount) "route-slots" "route slot")
        template (plugin-port program (.-target slot) "route-templates" "mounted route")
        lowered (lower-route-template template resolver)
        parameters (route-parameters (.-path mount))
        inputs (.-input_parameters lowered)]
    (if (not (= (count parameters) (count inputs)))
      (graph-error
        (str "mount '" (.-path mount) "' parameter arity does not match route"))
      (ir/->IrRoute
        (.-path mount) (.-view_name lowered) (.-queries lowered)
        parameters inputs []))))

(defn lowered-mount
  [source IrMountSpec
   program IrDeclarationProgram
   resolver DeclarationResolver
   package-id String] GMount
  (let [slot (plugin-port program (.-slot source) "route-slots" "route slot")
        template (plugin-port program (.-target slot) "route-templates" "mounted route")
        view (declaration-with-ref
          (.-views program) (.-view template) "mounted route view")
        component (declaration-with-ref
          (.-components program) (.-component view) "mounted route component")
        input-parameters (mapv
          (fn [parameter IrRouteParameterSpec] String (.-name parameter))
          (.-parameters template))
        parameters (route-parameters (.-path source))
        port (imported-port-name (.-prefix resolver) (.-slot source))]
    (if (not (= (count parameters) (count input-parameters)))
      (graph-error
        (str "mount '" port "' requires exactly "
             (count input-parameters) " route parameters"))
      nil)
    (->GMount
      input-parameters
      package-id
      parameters
      (.-path source)
      (route-pattern (.-path source))
      port
      (mapv
        (fn [query IrRouteQuerySpec] IrRouteQuery
          (ir/->IrRouteQuery
            (resolved-name resolver "query" (.-query query)) (.-alias query)))
        (.-queries template))
      (mapv
        (fn [property IrComponentPropertySpec] String (.-name property))
        (.-properties component))
      (resolved-name resolver "route" (.-target slot))
      (resolved-name resolver "view" (.-view template)))))

(defn command-descriptor-shape [descriptor Any] Any
  (let [kind (get descriptor "kind")]
    (cond
      (= kind "record")
        {"kind" "record"
         "fields"
         (mapv
           (fn [field] Any
             {"name" (get field "name")
              "required" (= (get field "required") true)
              "type" (command-descriptor-shape (get field "value"))})
           (get descriptor "fields"))}
      (= kind "nullable")
        {"kind" "nullable"
         "value" (command-descriptor-shape (get descriptor "value"))}
      (= kind "list")
        (if (nil? (get descriptor "normalizer"))
          {"kind" "list"
           "items" (command-descriptor-shape (get descriptor "items"))
           "maxItems" (get descriptor "maxItems")}
          {"kind" "list"
           "items" (command-descriptor-shape (get descriptor "items"))
           "maxItems" (get descriptor "maxItems")
           "normalizer" (get descriptor "normalizer")})
      :else descriptor)))

(defn command-extension
  [extensions (Vec ResolvedPluginExtension)
   ref IrEntityFieldsPortRef
   label String] ResolvedPluginExtension
  (let [matches (filterv
          (fn [extension ResolvedPluginExtension] Bool
            (= (ref-key (.-ref (.-port extension))) (ref-key ref)))
          extensions)]
    (if (not (= (count matches) 1))
      (graph-error (str label " requires exactly one bound extension"))
      (first matches))))

(defn command-extension-field-type
  [field IrExtensionFieldSpec
   resolver DeclarationResolver] Any
  (let [shape (field-type-shape (.-value_type field) resolver)
        type (nth shape 0)]
    (cond
      (= type "String") {"kind" "string"}
      (= type "Int") {"kind" "integer"}
      (= type "Bool") {"kind" "boolean"}
      (= type "Digest") {"kind" "digest"}
      (= type "Instant") {"kind" "instant"}
      (= type "Keyword") {"kind" "keyword"}
      (= type "Ref") {"kind" "string"}
      :else {"kind" "keyword"})))

(defn command-value-type
  [source IrValueTypeSpec
   program IrDeclarationProgram
   resolver DeclarationResolver
   extensions (Vec ResolvedPluginExtension)
   label String] Any
  (if (= (.-_tag source) "IrExtensionValueType")
    (let [extension (command-extension extensions (.-port source) label)]
      {"kind" "record"
       "fields"
       (mapv
         (fn [field IrExtensionFieldSpec] Any
           {"name" (.-name (.-ref field))
            "required" (.-required field)
            "type" (command-extension-field-type field resolver)})
         (.-fields (.-source extension)))})
    (command-descriptor-shape
      (resolved-value-type-descriptor source program resolver label))))

(defn lower-command-expression
  [source IrCommandExpr
   program IrDeclarationProgram
   resolver DeclarationResolver
   label String] Any
  (let [tag (.-_tag source)]
    (cond
      (= tag "IrCommandInputExpr")
        {"kind" "input" "name" (strip-colon (.-name source))}
      (= tag "IrCommandInjectedExpr")
        {"kind" "injected" "name" (strip-colon (.-name source))}
      (= tag "IrCommandStringExpr")
        {"kind" "literal" "value" (.-value source)}
      (= tag "IrCommandIntExpr")
        {"kind" "literal" "value" (.-value source)}
      (= tag "IrCommandBoolExpr")
        {"kind" "literal" "value" (.-value source)}
      (= tag "IrCommandKeywordExpr")
        {"kind" "literal" "value" (strip-colon (.-value source))
         "type" "keyword"}
      (= tag "IrCommandNilExpr") {"kind" "literal" "value" nil}
      (= tag "IrCommandActorExpr")
        {"kind" "actor" "name" (strip-colon (.-field source))}
      (= tag "IrCommandReceiptTimeExpr") {"kind" "receipt-time"}
      (= tag "IrCommandRecordExpr")
        {"kind" "record"
         "fields"
         (mapv
           (fn [field IrCommandRecordField] Any
             {"name" (strip-colon (.-name field))
              "value"
              (lower-command-expression
                (.-value field) program resolver label)})
           (.-fields source))}
      (= tag "IrCommandConfiguredExpr")
        {"kind" "literal"
         "value"
         (configured-projection-literal
           (.-projection source) resolver label)}
      (= tag "IrCommandStateValueExpr")
        {"kind" "literal"
         "value"
         (resolved-state-value program resolver (.-value source) label)
         "type" "keyword"}
      (= tag "IrCommandExtensionExpr")
        (graph-error (str label " uses unsupported command extension expression"))
      :else
        (graph-error (str label " uses unsupported command expression '" tag "'")))))

(defn lower-command-condition
  [source IrCommandPredicate
   program IrDeclarationProgram
   resolver DeclarationResolver
   label String] Any
  (let [tag (.-_tag source)]
    (cond
      (= tag "IrNonNullPredicate")
        {"kind" "non-null"
         "value"
         (lower-command-expression (.-value source) program resolver label)}
      :else
        (graph-error (str label " uses unsupported command condition '" tag "'")))))

(defn lower-command-guard
  [source IrCommandGuardSpec
   program IrDeclarationProgram
   resolver DeclarationResolver
   label String] Any
  (let [condition IrCommandPredicate? (.-when source)]
    (if (nil? condition)
      {"op" "guard"
       "entity" (resolved-name resolver "entity" (.-entity source))
       "identity" (lower-command-expression (.-id source) program resolver label)
       "field" (resolved-name resolver "field" (.-field source))
       "equals" (lower-command-expression (.-expected source) program resolver label)}
      {"op" "guard"
       "entity" (resolved-name resolver "entity" (.-entity source))
       "identity" (lower-command-expression (.-id source) program resolver label)
       "field" (resolved-name resolver "field" (.-field source))
       "equals" (lower-command-expression (.-expected source) program resolver label)
       "when" (lower-command-condition condition program resolver label)})))

(defn lower-command-write
  [source IrCommandWriteSpec
   op String
   entity String
   program IrDeclarationProgram
   resolver DeclarationResolver
   extensions (Vec ResolvedPluginExtension)
   label String] (Vec Any)
  (let [shape Any source]
    (match source
      [(IrFieldCommandWrite _)
        (let [write IrCommandWrite (.-write shape)
              field String (resolved-name resolver "field" (.-field write))
              value Any (lower-command-expression (.-value write) program resolver label)
              allowed-current IrCommandExpr? (.-allowed_current write)]
          (if (= op "create")
            [{"field" field "value" value
              "omitIfNull" (.-omit_if_null write)}]
            (if (nil? allowed-current)
              [{"field" field "value" value}]
              [{"field" field "value" value
                "allowedCurrent"
                (lower-command-expression
                  allowed-current program resolver label)}])))]
      [(IrExtensionCommandWrite _ _)
        (let [port IrEntityFieldsPortRef (.-port shape)
              input String (.-input shape)]
          (if (not (= op "create"))
            (graph-error (str label " cannot use extension fields in update"))
            (let [extension (command-extension extensions port label)]
              (if (not (= (.-target extension) entity))
                (graph-error (str label " extension targets the wrong entity"))
                nil)
              (mapv
                (fn [field IrExtensionFieldSpec] Any
                  (let [name (.-name (.-ref field))]
                    (if (or (not (.-required field))
                            (not (= (.-_tag (.-write field)) "IrCreateWrite"))
                            (not (= (.-_tag (.-cardinality field)) "IrSingleField")))
                      (graph-error
                        (str label " extension field '" name
                             "' must be required, single, and create-only"))
                      nil)
                    {"field" name
                     "value"
                     {"kind" "get"
                      "value" {"kind" "input"
                               "name" (strip-colon input)}
                      "field" name}
                     "omitIfNull" false}))
                (.-fields (.-source extension))))))])))

(defn lower-command-step
  [source IrCommandStep
   program IrDeclarationProgram
   resolver DeclarationResolver
   extensions (Vec ResolvedPluginExtension)
   label String] Any
  (let [tag (.-_tag source)]
    (cond
      (= tag "IrAssertStep")
        (let [predicate (.-predicate source)
              predicate-tag (.-_tag predicate)]
          (cond
            (= predicate-tag "IrEqualPredicate")
              {"op" "assert"
               "left"
               (lower-command-expression
                 (.-left predicate) program resolver label)
               "right"
               (lower-command-expression
                 (.-right predicate) program resolver label)}
            (= predicate-tag "IrNotContainsPredicate")
              {"op" "assert-not-contains"
               "list"
               (lower-command-expression
                 (.-collection predicate) program resolver label)
               "value"
               (lower-command-expression
                 (.-value predicate) program resolver label)}
            :else
              (graph-error
                (str label " uses unsupported assertion '" predicate-tag "'"))))
      (= tag "IrRequireStep")
        (let [condition IrCommandPredicate? (.-when source)]
          (if (nil? condition)
            {"op" "require"
             "entity" (resolved-name resolver "entity" (.-entity source))
             "identity" (lower-command-expression (.-id source) program resolver label)}
            {"op" "require"
             "entity" (resolved-name resolver "entity" (.-entity source))
             "identity" (lower-command-expression (.-id source) program resolver label)
             "when" (lower-command-condition condition program resolver label)}))
      (= tag "IrRequireEachStep")
        {"op" "require-each"
         "entity" (resolved-name resolver "entity" (.-entity source))
         "identities" (lower-command-expression (.-ids source) program resolver label)}
      (= tag "IrGuardStep")
        (lower-command-guard (.-guard source) program resolver label)
      (or (= tag "IrCreateStep") (= tag "IrUpdateStep"))
        (let [op (if (= tag "IrCreateStep") "create" "update")
              entity (resolved-name resolver "entity" (.-entity source))
              fields (reduce
                (fn [result write] (Vec Any)
                  (into result
                    (lower-command-write
                      write op entity program resolver extensions label)))
                []
                (.-fields source))]
          (if (nil? (.-when source))
            {"op" op
             "entity" entity
             "identity" (lower-command-expression (.-id source) program resolver label)
             "fields" fields}
            {"op" op
             "entity" entity
             "identity" (lower-command-expression (.-id source) program resolver label)
             "fields" fields
             "when" (lower-command-condition (.-when source) program resolver label)}))
      :else
        (graph-error (str label " uses unsupported command step '" tag "'")))))

(defn lower-command-injection
  [source IrCommandInjection
   program IrDeclarationProgram
   resolver DeclarationResolver
   extensions (Vec ResolvedPluginExtension)
   label String] Any
  (let [tag (.-_tag source)]
    (cond
      (= tag "IrGeneratedIdInjection")
        {"name" (strip-colon (.-name source))
         "kind" "generated-id" "type" {"kind" "string"}}
      (= tag "IrProviderInjection")
        (let [provider (get (.-provider_bindings resolver) (ref-key (.-port source)))]
          (if (nil? provider)
            (graph-error (str label " names an unbound provider"))
            {"name" (strip-colon (.-name source))
             "kind" "provider"
             "provider" provider
             "input"
             (lower-command-expression (.-input source) program resolver label)
             "type"
             (command-value-type
               (.-output source) program resolver extensions label)}))
      (= tag "IrCanonicalDigestInjection")
        {"name" (strip-colon (.-name source))
         "kind" "canonical-digest"
         "type" {"kind" "digest"}
         "input" (lower-command-expression (.-input source) program resolver label)}
      (= tag "IrValidateWithInjection")
        (graph-error (str label " uses unsupported validate-with injection"))
      :else
        (graph-error (str label " uses unsupported command injection '" tag "'")))))

(defn command-receipt-field
  [program IrDeclarationProgram
   ref IrReceiptFieldRef
   label String] IrReceiptFieldDeclarationSpec
  (declaration-with-ref (.-receipt_fields program) ref label))

(defn lower-command
  [source IrCommandSpec
   program IrDeclarationProgram
   resolver DeclarationResolver
   extensions (Vec ResolvedPluginExtension)] Any
  (let [name (resolved-name resolver "command" (.-ref source))
        label (str "command '" name "'")
        inputs (mapv
          (fn [input IrCommandInputField] Any
            {"name" (strip-colon (.-name input))
             "required" true
             "type"
             (command-value-type
               (.-value_type input) program resolver extensions label)})
          (.-input source))
        injections (mapv
          (fn [injection IrCommandInjection] Any
            (lower-command-injection
              injection program resolver extensions label))
          (.-injections source))
        steps (mapv
          (fn [step IrCommandStep] Any
            (lower-command-step step program resolver extensions label))
          (.-steps source))
        results (mapv
          (fn [result IrCommandResultField] Any
            {"name" (strip-colon (.-name result))
             "type"
             (command-value-type
               (.-value_type result) program resolver extensions label)
             "value"
             (lower-command-expression (.-value result) program resolver label)})
          (.-result source))
        receipt (.-receipt source)
        receipt-results (mapv
          (fn [result IrReceiptResultField] Any
            (let [name (strip-colon (.-name result))
                  command-result (first
                    (filterv
                      (fn [candidate] Bool (= (get candidate "name") name))
                      results))
                  declaration (command-receipt-field program (.-field result) label)]
              (if (nil? command-result)
                (graph-error (str label " receipt names unknown result '" name "'"))
                nil)
              {"name" name
               "field" (resolved-name resolver "receipt-field" (.-ref declaration))
               "type" (get command-result "type")}))
          (.-results receipt))
        server-fields (reduce
          (fn [result port] (Vec Any)
            (let [extension (command-extension extensions port label)]
              (if (not (= (.-target extension) "wake.core/command-receipt"))
                (graph-error (str label " receipt extension targets another entity"))
                nil)
              (into result
                (mapv
                  (fn [field IrExtensionFieldSpec] Any
                    (let [field-name (.-name (.-ref field))
                          storage-id (.-storage_id field)
                          type (command-extension-field-type field resolver)
                          injection-name (str "wake.server:" storage-id)]
                      (if (or
                            (not (= (.-_tag (.-write field)) "IrServerWrite"))
                            (not (= (.-_tag (.-cardinality field)) "IrSingleField")))
                        (graph-error
                          (str label " receipt extension field '" field-name
                               "' must be single and server-written"))
                        nil)
                      {"name" field-name
                       "field" field-name
                       "type" type
                       "storageId" storage-id
                       "injectionName" injection-name}))
                  (.-fields (.-source extension))))))
          []
          (.-extensions receipt))
        final-injections (into injections
          (mapv
            (fn [field] Any
              {"name" (get field "injectionName")
               "kind" "server-value"
               "storageId" (get field "storageId")
               "type" (get field "type")})
            server-fields))
        final-results (into results
          (mapv
            (fn [field] Any
              {"name" (get field "name")
               "type" (get field "type")
               "value" {"kind" "injected"
                        "name" (get field "injectionName")}})
            server-fields))
        final-receipt-results (into receipt-results
          (mapv
            (fn [field] Any
              {"name" (get field "name")
               "field" (get field "field")
               "type" (get field "type")})
            server-fields))]
    {"name" name
     "capabilities"
     (mapv
       (fn [ref IrCapabilityRef] Any
         (let [capability (declaration-with-ref (.-capabilities program) ref label)]
           {"capability" (resolved-capability-name resolver ref)
            "guards"
            (mapv
              (fn [guard IrCommandGuardSpec] Any
                (lower-command-guard guard program resolver label))
              (.-guards capability))}))
       (.-capabilities source))
     "normalizerVersion" (.-normalizer_version source)
     "input" inputs
     "injections" final-injections
     "steps" steps
     "result" final-results
     "receipt"
     {"entity" "wake.core/command-receipt"
      "identityField" "id"
      "actorField" "actor"
      "commandField" "command"
      "inputDigestField" "input-digest"
      "createdAtField" "created-at"
      "resultFields" final-receipt-results}}))

(defn lower-plugin-instance
  [instance IrLinkedPluginInstance
   application-id String
   application-components (Vec IrComponent)] LoweredPlugin
  (let [checked (require-ir-tag
          (.-checked instance) "IrCheckedDeclarationProgram"
          (str "plugin '" (.-alias instance) "' declarations"))
        program (require-ir-tag
          (.-program checked) "IrDeclarationProgram"
          (str "plugin '" (.-alias instance) "' declaration program"))
        root (require-ir-tag
          (.-root program) "IrPluginDeclarationRoot"
          (str "plugin '" (.-alias instance) "' root"))
        resolver (plugin-resolver instance program)
        schema? (contribution-allowed? (.-use instance) "IrSchemaContribution")
        query? (contribution-allowed? (.-use instance) "IrQueryContribution")
        command? (contribution-allowed? (.-use instance) "IrCommandContribution")
        capability? (contribution-allowed? (.-use instance) "IrCapabilityContribution")
        ui? (contribution-allowed? (.-use instance) "IrUiContribution")
        route? (contribution-allowed? (.-use instance) "IrRouteContribution")
        extensions (lower-extensions instance program resolver)
        raw-extensions (extension-values extensions)
        package-id (.-package_id (.-evidence instance))
        fills (if ui?
          (mapv
            (fn [source IrFillSpec] GFill
              (lower-component-fill
                source program resolver application-components package-id))
            (.-fills (.-composition instance)))
          [])]
    (if (> (count (.-renderers program)) 0)
      (graph-error
        (str "plugin '" (.-alias instance)
             "' renderers await checked renderer lowering"))
      nil)
    (->LoweredPlugin
      instance
      program
      resolver
      (.-source_unit program)
      (.-declaration_provenance checked)
      (plugin-evidence instance)
      (if schema?
        (mapv
          (fn [entity IrEntityDeclarationSpec] GEntity
            (lower-entity-declaration
              entity nil resolver application-id false))
          (.-entities program))
        [])
      (if schema?
        (mapv
          (fn [state IrStateDeclarationSpec] IrDefstate
            (lower-state-declaration state program resolver))
          (.-states program))
        [])
      (if schema?
        (mapv
          (fn [publication IrPublicationDeclarationSpec] IrPublication
            (lower-publication publication program resolver))
          (.-publications program))
        [])
      (if query?
        (mapv
          (fn [query IrQueryDeclarationSpec] IrQuery
            (lower-query query program resolver raw-extensions))
          (.-queries program))
        [])
      (if command?
        (mapv
          (fn [command IrCommandSpec] Any
            (lower-command command program resolver extensions))
          (.-commands program))
        [])
      (if ui?
        (mapv
          (fn [form IrFormDeclarationSpec] IrSmartForm
            (lower-form form resolver))
          (.-forms program))
        [])
      (if ui?
        (mapv
          (fn [detail IrListDetailDeclarationSpec] IrListDetail
            (lower-list-detail detail resolver))
          (.-list_details program))
        [])
      (if schema?
        (mapv
          (fn [value-type IrValueTypeDeclarationSpec] Any
            (lower-value-type-declaration value-type program resolver))
          (.-value_types program))
        [])
      (if capability?
        (mapv
          (fn [port IrProviderPortSpec] GProviderPort
            (lower-provider-port port program resolver))
          (.-provider_ports program))
        [])
      (if capability?
        (lower-provider-bindings instance program resolver)
        [])
      extensions
      fills
      (if route?
        (mapv
          (fn [mount IrMountSpec] GMount
            (lowered-mount mount program resolver package-id))
          (.-mounts (.-composition instance)))
        [])
      (if ui?
        (mapv
          (fn [component IrComponentDeclarationSpec] IrComponent
            (lower-component component resolver))
          (.-components program))
        [])
      (if ui?
        (mapv
          (fn [view IrViewDeclarationSpec] IrView
            (lower-view view program resolver))
          (.-views program))
        [])
      (if route?
        (mapv
          (fn [route IrRouteTemplateSpec] IrRoute
            (lower-route-template route resolver))
          (.-route_templates program))
        [])
      (if route?
        (mapv
          (fn [mount IrMountSpec] IrRoute
            (mounted-route mount program resolver))
          (.-mounts (.-composition instance)))
        []))))

(defn lower-theme [theme IrThemeSpec?] IrTheme?
  (if (nil? theme) nil (ir/->IrTheme (.-colors theme))))

;; --- Shared utilities ---

(js/export
 (defn strip-colon [s String] String
  (if (.startsWith s ":") (subs s 1) s))
)

(defn capitalize [s String] String
  (str (.toUpperCase (subs s 0 1)) (subs s 1)))

(defn titlecase [s String] String
  (str (.toUpperCase (subs s 0 1)) (subs s 1)))

;; --- Field analysis ---

(defn graph-error [message String] Any
  (throw (ex-info (str "wake: " message) {})))

(def reserved-generated-names (Vec String)
  ["__proto__" "prototype" "constructor"])

(defn validate-generated-name
  [kind String
   name String] Any
  (if (.includes reserved-generated-names (strip-colon name))
    (graph-error
      (str kind " name '" name
           "' is reserved for generated JavaScript"))
    nil))

(defn validate-generated-names
  [prog Any
   entities (Vec GEntity)
   defstates (Vec IrDefstate)] Any
  (doseq [entity entities]
    (validate-generated-name "entity" (.-name entity))
    (doseq [field (.-fields entity)]
      (validate-generated-name "field" (.-name field))))
  (doseq [defstate defstates]
    (validate-generated-name "state type" (.-name defstate))
    (doseq [state (set (keys (.-transitions defstate)))]
      (validate-generated-name "state" state)))
  (doseq [component (or (.-components prog) [])]
    (validate-generated-name "component" (.-name component))
    (doseq [prop (.-props component)]
      (validate-generated-name "component prop" prop)))
  (doseq [view (or (.-views prog) [])]
    (validate-generated-name "view" (.-name view)))
  (doseq [publication (or (.-publications prog) [])]
    (validate-generated-name "publication" (.-name publication)))
  (doseq [form (or (.-forms prog) [])]
    (validate-generated-name "form" (.-name form)))
  (let [router (.-router prog)]
    (if (some? router)
      (do
        (validate-generated-name "default route" (.-default_route router))
        (doseq [route (.-routes router)]
          (validate-generated-name "route" (.-path route))
          (validate-generated-name "route view" (.-view_name route))))
      nil)))

(defn validate-unique-declaration-names
  [names (Vec String)
   label String] Any
  (reduce
    (fn [seen name] (Vec String)
      (if (.includes seen name)
        (graph-error (str label " '" name "' is duplicated"))
        (conj seen name)))
    []
    names))

(defn validate-declaration-uniqueness
  [prog Any
   entities (Vec GEntity)] Any
  (validate-unique-declaration-names
    (mapv (fn [entity] String (.-name entity)) entities)
    "entity")
  (validate-unique-declaration-names
    (mapv (fn [component] String (.-name component)) (or (.-components prog) []))
    "component")
  (validate-unique-declaration-names
    (mapv (fn [view] String (.-name view)) (or (.-views prog) []))
    "view"))

(defn validate-ui-references
  [prog Any
   entities (Vec GEntity)] Any
  (let [components (or (.-components prog) [])
        views (or (.-views prog) [])
        entity-names (mapv (fn [entity] String (.-name entity)) entities)
        component-names (mapv (fn [component] String (.-name component)) components)
        view-names (mapv (fn [view] String (.-name view)) views)]
    (doseq [view views]
      (let [name (.-name view)
            entity-name (.-entity_name view)
            component-name (.-component view)
            select-component (.-select_component view)]
        (if (and (some? entity-name)
                 (not (.includes entity-names entity-name)))
          (graph-error
            (str "view '" name "' names unknown entity '" entity-name "'"))
          nil)
        (if (and (some? component-name)
                 (not (.includes component-names component-name)))
          (graph-error
            (str "view '" name "' names unknown component '"
                 component-name "'"))
          nil)
        (if (and (some? select-component)
                 (not (.includes component-names select-component)))
          (graph-error
            (str "view '" name "' names unknown select component '"
                 select-component "'"))
          nil)))
    (let [router (.-router prog)]
      (if (some? router)
        (let [routes (or (.-routes router) [])
              route-paths (mapv (fn [route] String (.-path route)) routes)
              route-views (mapv (fn [route] String (.-view_name route)) routes)
              default-route (.-default_route router)]
          (reduce
            (fn [seen path] (Vec String)
              (if (.includes seen path)
                (graph-error (str "route path '" path "' is duplicated"))
                (conj seen path)))
            []
            route-paths)
          (doseq [route routes]
            (let [view-name (.-view_name route)]
              (if (not (.includes view-names view-name))
                (graph-error
                  (str "route '" (.-path route) "' names unknown view '"
                       view-name "'"))
                nil)))
          (if (not (.includes route-views default-route))
            (graph-error
              (str "routes default '" default-route
                   "' does not name a routed view"))
            nil))
        nil))))

(defn nonempty-string? [value Any] Bool
  (and (string? value) (> (count value) 0)))

(defn required-storage-id
  [value Any
   label String
   fallback String
   local Bool] String
  (if (nonempty-string? value)
    value
    (if local
      fallback
      (graph-error
        (str "plugin " label " requires a nonempty fixed storage ID")))))

(defn append-unique-derived-deps
  [deps (Vec String)
   additions (Vec String)] (Vec String)
  (reduce
    (fn [result dependency] (Vec String)
      (if (.includes result dependency)
        result
        (conj result dependency)))
    deps
    additions))

(defn validate-derived-expression
  [expr Any
   label String] (Vec String)
  (if (nil? expr)
    (graph-error (str label " requires a closed derived expression"))
    nil)
  (let [tag (.-_tag expr)]
    (cond
      (= tag "IrFieldDerivedExpr")
        [(.-name (.-field expr))]
      (= tag "IrStringDerivedExpr")
        (if (string? (.-value expr))
          []
          (graph-error (str label " has an invalid string expression")))
      (= tag "IrConcatDerivedExpr")
        (do
          (if (= (count (.-parts expr)) 0)
            (graph-error (str label " concat expression cannot be empty"))
            nil)
          (reduce
            (fn [deps part] (Vec String)
              (append-unique-derived-deps
                deps
                (validate-derived-expression part label)))
            []
            (.-parts expr)))
      :else
        (graph-error
          (str label " uses unsupported derived expression '" tag "'")))))

(defn validate-derived-fields
  [entity-name String
   fields (Vec GField)] Any
  (doseq [field fields]
    (if (.-derived field)
      (let [label (str "derived field '" entity-name "." (.-name field) "'")
            declared (.-deps field)
            actual (validate-derived-expression (.-expr field) label)]
        (if (not (vector? declared))
          (graph-error (str label " dependencies must be a vector"))
          nil)
        (if (not (= declared actual))
          (graph-error
            (str label " dependencies do not exactly match its expression"))
          nil)
        (doseq [dependency actual]
          (let [resolved (first
                  (filterv
                    (fn [candidate] Bool
                      (= (.-name candidate) dependency))
                    fields))]
            (if (nil? resolved)
              (graph-error
                (str label " references unknown field '" dependency "'"))
              nil)
            (if (and (some? resolved) (.-derived resolved))
              (graph-error
                (str label " cannot reference derived field '" dependency "'"))
              nil)
            (if (and (some? resolved)
                     (or (not (= (.-type resolved) "String"))
                         (not (= (.-cardinality resolved) "single"))
                         (not (= (.-value_kind resolved) "literal"))))
              (graph-error
                (str label " dependency '" dependency
                     "' must be a single stored String field"))
              nil))))
      nil))
  nil)

(defn validate-storage-id-uniqueness [entities (Vec GEntity)] Any
  (reduce
    (fn [seen entry] (Map String String)
      (let [storage-id (nth entry 0)
            label (nth entry 1)
            prior (get seen storage-id)]
        (if (some? prior)
          (graph-error
            (str "storage ID '" storage-id "' is shared by " prior
                 " and " label))
          (assoc seen storage-id label))))
    {}
    (reduce
      (fn [entries entity] (Vec (Vec String))
        (reduce
          (fn [acc field] (Vec (Vec String))
            (conj
              acc
              [(.-storage_id field)
               (str "field '" (.-name entity) "." (.-name field) "'")]))
          (conj
            entries
            [(.-storage_id entity) (str "entity '" (.-name entity) "'")])
          (.-fields entity)))
      []
      entities))
  nil)

;; --- FK edge resolution ---

(defn resolve-fk-edges [entities (Vec GEntity)] (Vec FkEdge)
  (let [entity-names (mapv (fn [entity] String (.-name entity)) entities)]
    (reduce
      (fn [edges entity] (Vec FkEdge)
        (reduce
          (fn [acc ref-field] (Vec FkEdge)
            (let [target (.-target_entity ref-field)]
              (if (nil? target)
                (graph-error
                  (str "Ref field '" (.-name entity) "."
                       (.-name ref-field) "' requires :to ENTITY"))
                nil)
              (if (not (.includes entity-names target))
                (graph-error
                  (str "Ref field '" (.-name entity) "."
                       (.-name ref-field) "' targets unknown entity '"
                       target "'"))
                nil)
              (conj acc
                    (->FkEdge (.-name entity)
                              (.-name ref-field)
                              (or target "")))))
          edges
          (.-ref_fields entity)))
      []
      entities)))

;; --- Backend invariants ---

(defn store-literal-type? [type String] Bool
  (or (= type "String")
      (= type "Digest")
      (= type "Int")
      (= type "Integer")
      (= type "Float")
      (= type "Double")
      (= type "Number")
      (= type "Bool")
      (= type "Boolean")
      (= type "Keyword")
      (= type "Instant")))

(defn store-stored-field-type?
  [field GField
   defstates (Vec IrDefstate)] Bool
  (let [type (.-type field)]
    (or (store-literal-type? type)
        (= type "Ref")
        (some?
          (first
            (filterv (fn [state] Bool (= (.-name state) type)) defstates))))))

(defn validate-backend
  [prog Any
   entities (Vec GEntity)] Any
  (let [backend (.-backend prog)
        defstates (or (.-defstates prog) [])]
    (if (and (some? backend) (not (= (.-kind backend) "store")))
      (graph-error (str "unsupported backend '" (.-kind backend) "'"))
      nil)
    (if (and (some? backend) (some? (.-persist prog)))
      (graph-error "Store-backed applications cannot declare local persistence")
      nil)
    (if (some? backend)
      (doseq [entity entities]
        (let [identity-fields (filterv (fn [field] Bool (.-identity field))
                       (.-stored_fields entity))]
          (doseq [field (.-stored_fields entity)]
            (if (not (store-stored-field-type? field defstates))
              (graph-error
                (str "Store-backed field '" (.-name entity) "."
                     (.-name field) "' has unsupported type '"
                     (.-type field) "'"))
              nil))
          (if (= (count identity-fields) 0)
            (graph-error
              (str "Store-backed entity '" (.-name entity)
                   "' requires exactly one :identity field"))
            nil)
          (if (> (count identity-fields) 1)
            (graph-error
              (str "Store-backed entity '" (.-name entity)
                   "' has multiple :identity fields"))
            nil)))
      nil)))

;; --- State machine resolution ---

(defn validate-defstate [defstate IrDefstate] Any
  (let [name (.-name defstate)
        transitions (.-transitions defstate)
        source-names (set (keys transitions))
        states (reduce-kv
          (fn
            [result (Vec String)
             source-name String
             _ Any] (Vec String)
            (conj result (strip-colon source-name)))
          []
          transitions)
        initial (strip-colon (.-initial defstate))]
    (if (= (count states) 0)
      (graph-error (str "defstate '" name "' must declare at least one state"))
      nil)
    (reduce
      (fn [seen state] (Vec String)
        (if (= state "")
          (graph-error (str "defstate '" name "' declares an empty state"))
          nil)
        (if (.includes seen state)
          (graph-error
            (str "defstate '" name "' declares state '" state
                 "' more than once after keyword normalization"))
          (conj seen state)))
      []
      states)
    (if (not (.includes states initial))
      (graph-error
        (str "defstate '" name "' initial state '" initial
             "' is not declared"))
      nil)
    (doseq [source-name source-names]
      (let [source (strip-colon source-name)
            targets (or (get transitions source-name) [])
            normalized-targets (mapv strip-colon targets)]
        (reduce
          (fn [seen target] (Vec String)
            (if (.includes seen target)
              (graph-error
                (str "defstate '" name "' transition from '" source
                     "' repeats target '" target "'"))
              (conj seen target)))
          []
          normalized-targets)
        (doseq [target normalized-targets]
          (if (not (.includes states target))
            (graph-error
              (str "defstate '" name "' transition from '" source
                   "' targets undeclared state '" target "'"))
            nil))))))

(defn validate-defstates [defstates (Vec IrDefstate)] Any
  (doseq [defstate defstates]
    (validate-defstate defstate)))

(defn resolve-state-machines
  [entities (Vec GEntity)
   defstates (Vec IrDefstate)] (Vec StateMachine)
  (reduce
    (fn [machines entity] (Vec StateMachine)
      (let [status-fields (filterv
              (fn [f] Bool
                (and (not (= (.-type f) "String"))
                     (not (= (.-type f) "Ref"))
                     (not (= (.-type f) "Derived"))
                     (some? (first (filterv (fn [ds] Bool (= (.-name ds) (.-type f))) defstates)))))
              (.-fields entity))]
        (reduce
          (fn [acc sf] (Vec StateMachine)
            (let [ds (first (filterv (fn [d] Bool (= (.-name d) (.-type sf))) defstates))]
              (if (not (= (.-cardinality sf) "single"))
                (graph-error
                  (str "state field '" (.-name entity) "." (.-name sf)
                       "' must be single-cardinality"))
                nil)
              (conj acc (->StateMachine (.-name entity)
                                        (.-name sf)
                                        (.-type sf)
                                        (.-transitions ds)
                                        (.-initial ds)))))
          machines status-fields)))
    [] entities))

;; --- Publication policy resolution ---

(defn entity-named
  [entities (Vec GEntity)
   name String] GEntity?
  (first (filterv (fn [entity] Bool (= (.-name entity) name)) entities)))

(defn field-named
  [entity GEntity
   name String] GField?
  (first (filterv (fn [field] Bool (= (.-name field) name)) (.-fields entity))))

(defn validate-distinct-names
  [names (Vec String)
   label String] Any
  (reduce
    (fn [seen name] (Vec String)
      (if (.includes seen name)
        (graph-error (str label " repeats '" name "'"))
        (conj seen name)))
    []
    names)
  nil)

(defn required-list-field
  [entity GEntity
   name String
   label String] GField
  (let [field (field-named entity name)]
    (if (nil? field)
      (graph-error
        (str label " names unknown field '" (.-name entity) "." name "'"))
      nil)
    (or field (first (.-fields entity)))))

(defn resolve-list-detail-tab
  [entities (Vec GEntity)
   owner GEntity
   tab IrDetailTab
   label String] GDetailTab
  (let [content-type (.-content_type tab)]
    (if (= content-type "fields")
      (let [fields (or (.-fields tab) [])]
        (validate-distinct-names fields (str label " field"))
        (doseq [field fields]
          (required-list-field owner field label))
        (->GDetailTab (.-label tab) "fields" fields nil nil []))
      (if (= content-type "related")
        (let [entity-name (or (.-entity_name tab) "")
              related (entity-named entities entity-name)]
          (if (nil? related)
            (graph-error (str label " names unknown related entity '" entity-name "'"))
            nil)
          (let [child (or related owner)
                candidates (filterv
                  (fn [field] Bool
                    (and (= (.-type field) "Ref")
                         (= (.-cardinality field) "single")
                         (= (.-target_entity field) (.-name owner))))
                  (.-fields child))
                requested (.-relation_field tab)
                relation (if (= true (.-infer_relation tab))
                  (do
                    (if (not (= (count candidates) 1))
                      (graph-error
                        (str label " cannot infer one relation from '" entity-name
                             "' to '" (.-name owner) "'"))
                      nil)
                    (first candidates))
                  (let [field (field-named child (or requested ""))]
                    (if (or (nil? field)
                            (not (= (.-type field) "Ref"))
                            (not (= (.-cardinality field) "single"))
                            (not (= (.-target_entity field) (.-name owner))))
                      (graph-error
                        (str label " relation must name a single Ref field on '"
                             entity-name "' targeting '" (.-name owner) "'"))
                      nil)
                    field))
                display (or (.-display_fields tab) [])]
            (validate-distinct-names display (str label " display field"))
            (doseq [field display]
              (required-list-field child field label))
            (->GDetailTab
              (.-label tab) "related" [] entity-name
              (.-name (or relation (first (.-fields child)))) display)))
        (graph-error (str label " has unknown content type '" content-type "'"))))))

(defn resolve-list-details
  [prog Any
   entities (Vec GEntity)] (Vec GListDetail)
  (let [details (or (.-list_details prog) [])]
    (if (> (count details) 1)
      (graph-error "program may declare at most one list detail")
      nil)
    (validate-distinct-names
      (mapv (fn [detail] String (.-entity_name detail)) details)
      "list detail entity")
    (mapv
      (fn [detail] GListDetail
        (let [entity-name (.-entity_name detail)
              owner (entity-named entities entity-name)
              label (str "list detail '" entity-name "'")]
          (if (nil? owner)
            (graph-error (str label " names unknown entity '" entity-name "'"))
            nil)
          (let [entity (or owner (first entities))
                columns (or (.-columns detail) [])
                search (or (.-search_cols detail) [])
                tabs (or (.-detail_tabs detail) [])]
            (if (not (nonempty-string? (.-title detail)))
              (graph-error (str label " title must be nonempty"))
              nil)
            (validate-distinct-names columns (str label " column"))
            (doseq [name columns]
              (let [field (required-list-field entity name label)]
                (if (.-derived field)
                  (graph-error (str label " column cannot name derived field '"
                                    entity-name "." name "'"))
                  nil)))
            (validate-distinct-names search (str label " search field"))
            (doseq [name search]
              (let [field (required-list-field entity name label)]
                (if (or (.-derived field)
                        (not (= (.-cardinality field) "single"))
                        (not (= (.-value_kind field) "literal")))
                  (graph-error
                    (str label " search field '" entity-name "." name
                         "' must be a single stored literal"))
                  nil)))
            (validate-distinct-names
              (mapv (fn [tab] String (.-label tab)) tabs)
              (str label " tab label"))
            (if (> (count (filterv
                            (fn [tab] Bool (= (.-content_type tab) "fields"))
                            tabs)) 1)
              (graph-error (str label " may declare at most one fields tab"))
              nil)
            (let [resolved-tabs (mapv
                    (fn [tab] GDetailTab
                      (resolve-list-detail-tab
                        entities entity tab
                        (str label " tab '" (.-label tab) "'")))
                    tabs)]
              (reduce
                (fn [seen tab] (Vec String)
                  (let [folded (.toLowerCase (.-label tab))]
                    (if (and (= (.-content_type tab) "related")
                             (= folded "overview"))
                      (graph-error
                        (str label " related tab label '" (.-label tab)
                             "' conflicts with the built-in overview tab"))
                      nil)
                    (if (.includes seen folded)
                      (graph-error
                        (str label " tab labels collide case-insensitively at '"
                             (.-label tab) "'"))
                      (conj seen folded))))
                []
                resolved-tabs)
              (reduce
                (fn [seen tab] (Vec String)
                  (if (= (.-content_type tab) "related")
                    (let [child (.-entity_name tab)]
                      (if (.includes seen child)
                        (graph-error
                          (str label " repeats related entity '" child "'"))
                        (conj seen child)))
                    seen))
                [entity-name]
                resolved-tabs)
              (->GListDetail
                entity-name
                (.-title detail)
                columns
                search
                resolved-tabs)))))
      details)))

(defn validate-ui-root-topology [prog Any] Any
  (let [views (or (.-views prog) [])
        details (or (.-list_details prog) [])
        forms (or (.-forms prog) [])
        router (.-router prog)
        layout (.-layout prog)]
    (if (and (= (count views) 0) (> (count forms) 1))
      (graph-error "program may declare at most one list-detail form")
      nil)
    (if (and (> (count views) 0) (> (count details) 0))
      (graph-error "program cannot combine view and list-detail UI roots")
      nil)
    (if (and (> (count views) 1) (nil? router))
      (graph-error "multiple views require routes")
      nil)
    (if (and (some? router) (= (count views) 0))
      (graph-error "routes require at least one view")
      nil)
    (if (and (some? layout) (nil? router))
      (graph-error "layout requires routes")
      nil)
    (if (and (some? layout) (not (= (.-style layout) "sidebar")))
      (graph-error
        (str "layout uses unsupported style '" (.-style layout) "'"))
      nil)
    (if (some? layout)
      (let [groups (or (.-groups layout) [])
            view-names (mapv (fn [view] String (.-name view)) views)]
        (validate-distinct-names
          (mapv (fn [group] String (.-label group)) groups)
          "layout group label")
        (reduce
          (fn [seen group] (Vec String)
            (reduce
              (fn [items item] (Vec String)
                (if (not (.includes view-names item))
                  (graph-error
                    (str "layout group '" (.-label group)
                         "' names unknown view '" item "'"))
                  nil)
                (if (.includes items item)
                  (graph-error
                    (str "layout navigation repeats view '" item "'"))
                  (conj items item)))
              seen
              (or (.-items group) [])))
          []
          groups))
      nil)
    (if (and (= (count views) 0) (> (count forms) 0))
      (do
        (if (not (= (count details) 1))
          (graph-error "a form requires exactly one list detail")
          nil)
        (if (and (= (count details) 1)
                 (not (= (.-entity_name (first forms))
                         (.-entity_name (first details)))))
          (graph-error
            (str "form '" (.-name (first forms)) "' targets entity '"
                 (.-entity_name (first forms))
                 "' but the list detail owns '"
                 (.-entity_name (first details)) "'"))
          nil))
      nil))
  nil)

(defn validate-create-fields
  [label String
   entity-name String
   field-names (Vec String)
   entities (Vec GEntity)] Any
  (let [entity (entity-named entities entity-name)]
    (if (nil? entity)
      (graph-error
        (str label " names unknown entity '" entity-name "'"))
      nil)
    (let [resolved (or entity (first entities))
          identity (.-identity_field resolved)]
      (if (or (nil? identity)
              (not (.includes field-names (.-name identity))))
        (graph-error
          (str label " must include identity field '" entity-name "."
               (if (nil? identity) "<missing>" (.-name identity)) "'"))
        nil)
      (doseq [field-name field-names]
        (let [field (field-named resolved field-name)]
          (if (nil? field)
            (graph-error
              (str label " names unknown field '" entity-name "."
                   field-name "'"))
            nil)
          (if (and (some? field) (= (.-write_policy field) "command"))
            (graph-error
              (str label " cannot include command-only field '" entity-name "."
                   field-name "'"))
            nil))))))

(defn validate-store-create-forms
  [prog Any
   entities (Vec GEntity)] Any
  (if (some? (.-backend prog))
    (do
      (doseq [view (or (.-views prog) [])]
        (let [fields (or (.-add_fields view) [])]
          (if (> (count fields) 0)
            (validate-create-fields
              (str "view '" (.-name view) "' add form")
              (.-entity_name view)
              fields
              entities)
            nil)))
      (doseq [form (or (.-forms prog) [])]
        (validate-create-fields
          (str "form '" (.-name form) "'")
          (.-entity_name form)
          (or (.-fields form) [])
          entities)))
    nil))

(defn machine-named
  [machines (Vec StateMachine)
   entity-name String
   field-name String] StateMachine?
  (first
    (filterv
      (fn [machine] Bool
        (and (= (.-entity machine) entity-name)
             (= (.-field machine) field-name)))
      machines)))

(defn require-write-policy
  [entity-name String
   field GField
   expected String] Any
  (if (not (= (.-write_policy field) expected))
    (graph-error
      (str "publication field '" entity-name "." (.-name field)
           "' must declare :write :" expected))
    nil))

(defn validate-publication-states
  [publication-name String
   machine StateMachine
   draft-state String
   published-state String
   retired-state String] Any
  (let [transitions (.-transitions machine)
        states [draft-state published-state retired-state]]
    (if (not (= (count (distinct states)) 3))
      (graph-error
        (str "publication '" publication-name
             "' draft, published, and retired states must be distinct"))
      nil)
    (doseq [state states]
      (if (nil? (get transitions state))
        (graph-error
          (str "publication '" publication-name "' names unknown state " state))
        nil))
    (if (not (= (.-initial machine) draft-state))
      (graph-error
        (str "publication '" publication-name
             "' draft state must be the state machine initial state"))
      nil)
    (if (not (.includes (or (get transitions draft-state) []) published-state))
      (graph-error
        (str "publication '" publication-name
             "' requires its draft -> published transition"))
      nil)
    (if (not (.includes (or (get transitions published-state) []) retired-state))
      (graph-error
        (str "publication '" publication-name
             "' requires its published -> retired transition"))
      nil)))

(defn resolve-publication
  [source IrPublication
   entities (Vec GEntity)
   machines (Vec StateMachine)] PublicationPolicy
  (let [name (.-name source)
        owner-name (.-owner_entity source)
        revision-name (.-revision_entity source)
        owner (entity-named entities owner-name)
        revision (entity-named entities revision-name)]
    (if (nil? owner)
      (graph-error
        (str "publication '" name "' names unknown owner entity '"
             owner-name "'"))
      nil)
    (if (nil? revision)
      (graph-error
        (str "publication '" name "' names unknown revision entity '"
             revision-name "'"))
      nil)
    (let [resolved-owner (or owner (first entities))
          resolved-revision (or revision (first entities))
          pointer (field-named resolved-owner (.-pointer_field source))
          owner-field (field-named resolved-revision (.-owner_field source))
          state-field (field-named resolved-revision (.-state_field source))]
      (if (nil? pointer)
        (graph-error
          (str "publication '" name "' names unknown pointer field '"
               owner-name "." (.-pointer_field source) "'"))
        nil)
      (if (nil? owner-field)
        (graph-error
          (str "publication '" name "' names unknown revision owner field '"
               revision-name "." (.-owner_field source) "'"))
        nil)
      (if (nil? state-field)
        (graph-error
          (str "publication '" name "' names unknown revision state field '"
               revision-name "." (.-state_field source) "'"))
        nil)
      (let [resolved-pointer (or pointer (first (.-fields resolved-owner)))
            resolved-owner-field (or owner-field (first (.-fields resolved-revision)))
            resolved-state-field (or state-field (first (.-fields resolved-revision)))
            machine (machine-named
              machines revision-name (.-state_field source))]
        (if (or (not (= (.-value_kind resolved-pointer) "ref"))
                (not (= (.-cardinality resolved-pointer) "single"))
                (not (= (.-target_entity resolved-pointer) revision-name)))
          (graph-error
            (str "publication pointer '" owner-name "."
                 (.-pointer_field source)
                 "' must be a single Ref to '" revision-name "'"))
          nil)
        (if (or (not (= (.-value_kind resolved-owner-field) "ref"))
                (not (= (.-cardinality resolved-owner-field) "single"))
                (not (= (.-target_entity resolved-owner-field) owner-name)))
          (graph-error
            (str "publication owner field '" revision-name "."
                 (.-owner_field source)
                 "' must be a single Ref to '" owner-name "'"))
          nil)
        (if (or (not (= (.-value_kind resolved-state-field) "literal"))
                (not (= (.-cardinality resolved-state-field) "single")))
          (graph-error
            (str "publication state field '" revision-name "."
                 (.-state_field source) "' must be a single literal"))
          nil)
        (require-write-policy owner-name resolved-pointer "command")
        (require-write-policy revision-name resolved-owner-field "create")
        (require-write-policy revision-name resolved-state-field "command")
        (if (nil? machine)
          (graph-error
            (str "publication state field '" revision-name "."
                 (.-state_field source) "' requires a state machine"))
          nil)
        (let [draft-state (.-draft_state source)
              published-state (.-published_state source)
              retired-state (.-retired_state source)]
          (validate-publication-states
            name (or machine (first machines))
            draft-state published-state retired-state)
          (->PublicationPolicy
            name owner-name (.-pointer_field source)
            revision-name (.-owner_field source) (.-state_field source)
            (strip-colon draft-state)
            (strip-colon published-state)
            (strip-colon retired-state)))))))

(defn resolve-publications
  [prog Any
   entities (Vec GEntity)
   machines (Vec StateMachine)] (Vec PublicationPolicy)
  (let [sources (or (.-publications prog) [])]
    (if (and (> (count sources) 0) (nil? (.-backend prog)))
      (graph-error "publication policies require (backend :store)")
      nil)
    (reduce
      (fn [seen source] (Vec String)
        (let [name (.-name source)]
          (if (.includes seen name)
            (graph-error (str "duplicate publication '" name "'"))
            (conj seen name))))
      [] sources)
    (let [policies (mapv (fn [source] PublicationPolicy (resolve-publication source entities machines))
                sources)]
      (reduce
        (fn [seen policy] (Vec String)
          (let [target (str (.-owner_entity policy) "."
                            (.-pointer_field policy))]
            (if (.includes seen target)
              (graph-error
                (str "publication pointer '" target "' is declared twice"))
              (conj seen target))))
        [] policies)
      policies)))


;; --- Main: build checked application ---

(defn application-id [prog Any] String
  (let [resolved (.-application_id prog)
        application (.-application prog)
        application-id (if (nonempty-string? resolved)
          resolved
          (if (nil? application) nil (.-id application)))]
    (if (nonempty-string? application-id)
      (or application-id "")
      (do
        (graph-error "linked program requires (application :id \"ID\")")
        ""))))

(defn checked-source-units [prog Any] (Vec IrSourceUnit)
  (let [linked (.-source_units prog)
        root (.-source_unit prog)]
    (if (some? linked)
      linked
      (if (some? root) [root] []))))

;; --- Named query analysis ---

(defn query-name-map
  [items Any
   name-fn Any
   label String] Any
  (reduce
    (fn [result item] (Map String Any)
      (let [name (name-fn item)]
        (if (some? (get result name))
          (graph-error (str label " '" name "' is duplicated"))
          (assoc result name item))))
    {}
    items))

(defn query-field
  [entity GEntity
   name String
   label String] GField
  (let [field (first
          (filterv
            (fn [candidate] Bool (= (.-name candidate) name))
            (.-fields entity)))]
    (if (nil? field)
      (graph-error
        (str label " names unknown field '" (.-name entity) "." name "'"))
      nil)
    (if (.-derived field)
      (graph-error
        (str label " cannot read derived field '" (.-name entity) "." name
             "' from Store"))
      nil)
    field))

(defn query-type-family [type String] String
  (cond
    (or (= type "Int") (= type "Integer")) "integer"
    (or (= type "Float") (= type "Double") (= type "Number")) "float"
    (or (= type "Bool") (= type "Boolean")) "boolean"
    :else type))

(defn query-types-compatible?
  [left String
   right String] Bool
  (= (query-type-family left) (query-type-family right)))

(defn resolve-query-operand
  [raw IrQueryOperand
   bindings Any
   parameters Any
   label String] GQueryOperand
  (let [kind (.-kind raw)]
    (cond
      (= kind "parameter")
        (let [name (or (.-name raw) "")
              parameter (get parameters name)]
          (if (nil? parameter)
            (graph-error (str label " names unknown parameter '$" name "'"))
            nil)
          (->GQueryOperand
            "parameter" (.-type parameter) nil nil nil nil name nil))
      (= kind "binding")
        (let [name (or (.-binding raw) "")
              entity (get bindings name)]
          (if (nil? entity)
            (graph-error (str label " names unknown binding '" name "'"))
            nil)
          (->GQueryOperand
            "binding" "Ref" (.-name entity) name (.-name entity) nil nil nil))
      (= kind "field")
        (let [binding (or (.-binding raw) "")
              entity (get bindings binding)]
          (if (nil? entity)
            (graph-error (str label " names unknown binding '" binding "'"))
            nil)
          (let [field (query-field entity (or (.-field raw) "") label)]
            (->GQueryOperand
              "field" (.-type field) (.-target_entity field) binding (.-name entity)
              (.-name field) nil nil)))
      (= kind "literal")
        (->GQueryOperand
          "literal" (or (.-name raw) "") nil nil nil nil nil (.-value raw))
      :else (graph-error (str label " has unknown operand kind '" kind "'")))))

(defn query-state
  [defstates Any
   type String] Any
  (first (filterv (fn [state] Bool (= (.-name state) type)) defstates)))

(defn coerce-query-literal
  [operand GQueryOperand
   expected-type String
   defstates Any
   label String] GQueryOperand
  (if (not (= (.-kind operand) "literal"))
    operand
    (let [literal-type (.-type operand)
          value (.-value operand)
          state (query-state defstates expected-type)]
      (if (= literal-type "Keyword")
        (if (some? state)
          (do
            (if (not (some? (get (.-transitions state) value)))
              (graph-error
                (str label " names unknown " expected-type " value '" value "'"))
              nil)
            (->GQueryOperand
              "literal" expected-type nil nil nil nil nil (strip-colon value)))
          (if (= expected-type "Keyword")
            (->GQueryOperand
              "literal" "Keyword" nil nil nil nil nil (strip-colon value))
            operand))
        operand))))

(defn query-operand-bindings [operand GQueryOperand] (Vec String)
  (if (some? (.-binding operand)) [(or (.-binding operand) "")] []))

(defn analyze-query-predicate
  [raw IrQueryPredicate
   bindings Any
   parameters Any
   defstates Any
   label String] GQueryPredicate
  (let [left0 (resolve-query-operand (.-left raw) bindings parameters label)
        right0 (resolve-query-operand (.-right raw) bindings parameters label)
        left (if (= (.-kind left0) "literal")
          (coerce-query-literal left0 (.-type right0) defstates label)
          left0)
        right (if (= (.-kind right0) "literal")
          (coerce-query-literal right0 (.-type left0) defstates label)
          right0)]
    (if (and (= (.-type left) "Ref")
             (= (.-type right) "Ref")
             (not (= (.-target_entity left) (.-target_entity right))))
      (graph-error
        (str label " compares references to different entity targets '"
             (or (.-target_entity left) "unknown") "' and '"
             (or (.-target_entity right) "unknown") "'"))
      nil)
    (if (and (= (.-kind left) "binding") (= (.-kind right) "field"))
      (let [field-entity (get bindings (or (.-binding right) ""))
            field (query-field field-entity (or (.-field right) "") label)]
        (if (or (not (= (.-value_kind field) "ref"))
                (not (= (.-target_entity field) (.-entity left))))
          (graph-error (str label " compares an entity binding to an incompatible field"))
          nil))
      (if (and (= (.-kind right) "binding") (= (.-kind left) "field"))
        (let [field-entity (get bindings (or (.-binding left) ""))
              field (query-field field-entity (or (.-field left) "") label)]
          (if (or (not (= (.-value_kind field) "ref"))
                  (not (= (.-target_entity field) (.-entity right))))
            (graph-error (str label " compares an entity binding to an incompatible field"))
            nil))
        (if (or (= (.-kind left) "binding") (= (.-kind right) "binding"))
          (if (not (and (= (.-kind left) "binding")
                        (= (.-kind right) "binding")
                        (= (.-entity left) (.-entity right))))
            (graph-error (str label " compares incompatible entity bindings"))
            nil)
          (if (not (query-types-compatible? (.-type left) (.-type right)))
            (graph-error
              (str label " compares incompatible types '" (.-type left)
                   "' and '" (.-type right) "'"))
            nil))))
    (->GQueryPredicate "eq" left right)))

(defn query-binding-connected?
  [binding String
   earlier (Vec String)
   predicates (Vec GQueryPredicate)] Bool
  (some?
    (first
      (filterv
        (fn [predicate] Bool
          (let [names (into
                  (query-operand-bindings (.-left predicate))
                  (query-operand-bindings (.-right predicate)))]
            (and (.includes names binding)
                 (some?
                   (first
                     (filterv (fn [name] Bool (.includes names name)) earlier))))))
        predicates))))

(defn query-root-identity-constrained?
  [root String
   identity-field String
   predicates (Vec GQueryPredicate)] Bool
  (some?
    (first
      (filterv
        (fn [predicate] Bool
          (let [left (.-left predicate)
                right (.-right predicate)
                identity? (fn [operand] Bool
                  (and (= (.-kind operand) "field")
                       (= (.-binding operand) root)
                       (= (.-field operand) identity-field)))
                bound? (fn [operand] Bool
                  (or (= (.-kind operand) "parameter")
                      (= (.-kind operand) "literal")))]
            (or (and (identity? left) (bound? right))
                (and (identity? right) (bound? left)))))
        predicates))))

(defn query-dependencies
  [bindings (Vec IrQueryBinding)
   binding-entities Any
   predicates (Vec GQueryPredicate)
   columns (Vec GQueryColumn)] (Vec GQueryDependency)
  (let [entries (reduce
          (fn [result binding] (Vec (Vec String))
            (let [entity (get binding-entities (.-name binding))]
              (conj result [(.-name entity) (.-name (.-identity_field entity))])))
          [] bindings)
        entries (reduce
          (fn [result predicate] (Vec (Vec String))
            (reduce
              (fn [acc operand] (Vec (Vec String))
                (if (= (.-kind operand) "field")
                  (conj acc [(or (.-entity operand) "") (or (.-field operand) "")])
                  acc))
              result [(.-left predicate) (.-right predicate)]))
          entries predicates)
        entries (into
          entries
          (mapv
            (fn [column GQueryColumn] (Vec String)
              [(.-entity column) (.-field column)])
            columns))]
    (mapv
      (fn [entry] GQueryDependency (->GQueryDependency (nth entry 0) (nth entry 1)))
      (reduce
        (fn [unique entry] (Vec (Vec String))
          (if (.includes (mapv (fn [candidate] String (str (nth candidate 0) "." (nth candidate 1))) unique) (str (nth entry 0) "." (nth entry 1)))
            unique
            (conj unique entry)))
        [] entries))))

(defn provider-named
  [providers Any
   name String] Any
  (first (filterv (fn [provider] Bool (= (.-name provider) name)) providers)))

(defn descriptor-field
  [descriptor Any
   name String] Any
  (first
    (filterv
      (fn [field] Bool (= (get field "name") name))
      (or (get descriptor "fields") []))))

(defn provider-field-type-compatible?
  [field GField
   descriptor Any] Bool
  (let [checked-descriptor (if (= (.-cardinality field) "multi")
          (get descriptor "items")
          descriptor)
        kind (if (nil? checked-descriptor) "" (get checked-descriptor "kind"))
        scalar (cond
          (= (.-type field) "String") (= kind "string")
          (or (= (.-type field) "Int") (= (.-type field) "Integer"))
            (= kind "integer")
          (or (= (.-type field) "Float")
              (= (.-type field) "Double")
              (= (.-type field) "Number"))
            (= kind "number")
          (or (= (.-type field) "Bool") (= (.-type field) "Boolean"))
            (= kind "boolean")
          :else (or (= kind "string") (= kind "enum")))]
    (if (= (.-cardinality field) "multi")
      (and (= (get descriptor "kind") "list") scalar)
      scalar)))

(defn provider-literal-compatible?
  [value Any
   descriptor Any] Bool
  (let [kind (get descriptor "kind")]
    (cond
      (= kind "nullable")
        (or (nil? value)
            (provider-literal-compatible? value (get descriptor "value")))
      (= kind "literal") (js/Object.is value (get descriptor "value"))
      (= kind "enum")
        (some?
          (first
            (filterv
              (fn [candidate] Bool (js/Object.is candidate value))
              (or (get descriptor "values") []))))
      (= kind "string") (string? value)
      (= kind "integer")
        (and (number? value)
             (js/Number.isSafeInteger value)
             (not (js/Object.is value -0))
             (or (nil? (get descriptor "minimum"))
                 (>= value (get descriptor "minimum")))
             (or (nil? (get descriptor "maximum"))
                 (<= value (get descriptor "maximum"))))
      (= kind "number")
        (and (number? value) (js/Number.isFinite value)
             (not (js/Object.is value -0)))
      (= kind "boolean") (boolean? value)
      :else false)))

(defn analyze-provider-input
  [raw Any
   expected Any
   binding-entities Any
   provider-index Int
   next-column Int
   label String] Any
  (let [kind (get raw "kind")]
    (cond
      (= kind "column")
        (let [binding (get raw "binding")
              entity (get binding-entities binding)]
          (if (nil? entity)
            (graph-error (str label " names unknown binding '" binding "'"))
            nil)
          (let [field (query-field entity (get raw "field") label)]
            (if (not (provider-field-type-compatible? field expected))
              (graph-error
                (str label " field '" (.-name entity) "." (.-name field)
                     "' is incompatible with provider input type '"
                     (get expected "kind") "'"))
              nil)
            (let [internal-name (str "wake$provided$" provider-index "$" next-column)
                  column (->GQueryColumn
                    internal-name binding (.-name entity) (.-name field)
                    (.-type field) (.-cardinality field) (.-value_kind field)
                    (.-target_entity field) true)]
              [{"kind" "column" "name" internal-name}
               [column]
               (+ next-column 1)])))
      (= kind "literal")
        (do
          (if (not (provider-literal-compatible? (get raw "value") expected))
            (graph-error (str label " literal is incompatible with provider input type"))
            nil)
          [{"kind" "literal" "value" (get raw "value")} [] next-column])
      (= kind "record")
        (do
          (if (not (= (get expected "kind") "record"))
            (graph-error (str label " record is incompatible with provider input type"))
            nil)
          (let [raw-fields (or (get raw "fields") [])
                expected-fields (or (get expected "fields") [])]
            (doseq [field raw-fields]
              (if (nil? (descriptor-field expected (get field "name")))
                (graph-error
                  (str label " contains unknown provider input field '"
                       (get field "name") "'"))
                nil))
            (doseq [field expected-fields]
              (if (and (= (get field "required") true)
                       (nil?
                         (first
                           (filterv
                             (fn [candidate] Bool
                               (= (get candidate "name") (get field "name")))
                             raw-fields))))
                (graph-error
                  (str label " requires provider input field '"
                       (get field "name") "'"))
                nil))
            (loop [remaining Any raw-fields
                   fields Any []
                   columns Any []
                   next Int next-column]
              (if (= (count remaining) 0)
                [{"kind" "record" "fields" fields} columns next]
                (let [field (first remaining)
                      field-name (get field "name")
                      checked (analyze-provider-input
                        (get field "value")
                        (get (descriptor-field expected field-name) "value")
                        binding-entities provider-index next
                        (str label "." field-name))]
                  (recur
                    (rest remaining)
                    (conj fields {"name" field-name "value" (nth checked 0)})
                    (into columns (nth checked 1))
                    (nth checked 2)))))))
      :else (graph-error (str label " has unknown provider input expression '" kind "'")))))

(defn analyze-query-column
  [selection Any
   binding-entities Any
   label String
   internal Bool] GQueryColumn
  (let [entity (get binding-entities (.-binding selection))]
    (if (nil? entity)
      (graph-error
        (str label " output '" (.-name selection)
             "' names unknown binding '" (.-binding selection) "'"))
      nil)
    (let [field (query-field entity (.-field selection) label)]
      (->GQueryColumn
        (.-name selection) (.-binding selection) (.-name entity)
        (.-name field) (.-type field) (.-cardinality field)
        (.-value_kind field) (.-target_entity field) internal))))

(defn analyze-query-selections
  [selections Any
   binding-entities Any
   providers Any
   label String] Any
  (loop [remaining Any selections
         provider-index Int 0
         columns Any []
         public-columns Any []
         result-providers Any []
         output-names (Vec String) []]
    (if (= (count remaining) 0)
      [columns public-columns result-providers]
      (let [selection (first remaining)
            tag (.-_tag selection)
            output-name (.-name selection)]
        (if (.includes output-names output-name)
          (graph-error (str label " output '" output-name "' is duplicated"))
          nil)
        (if (= tag "IrQueryProvided")
          (let [provider-name (.-provider selection)
                provider (provider-named providers provider-name)]
            (if (nil? provider)
              (graph-error
                (str label " output '" output-name
                     "' names unbound provider '" provider-name "'"))
              nil)
            (if (>= provider-index 16)
              (graph-error (str label " supports at most 16 provider results"))
              nil)
            (if (not (= (get (.-output_type provider) "kind") "bounded"))
              (graph-error
                (str label " provider '" provider-name
                     "' output must be a bounded checked value"))
              nil)
            (let [checked (analyze-provider-input
                    (.-input selection)
                    (.-input_type provider)
                    binding-entities provider-index 0
                    (str label " provider output '" output-name "' input"))
                  internal-columns (nth checked 1)
                  result-provider (->GQueryResultProvider
                    output-name provider-name (nth checked 0)
                    (.-input_type provider) (.-output_type provider))]
              (recur
                (rest remaining)
                (+ provider-index 1)
                (into columns internal-columns)
                public-columns
                (conj result-providers result-provider)
                (conj output-names output-name))))
          (if (= tag "IrQuerySelect")
            (let [column (analyze-query-column selection binding-entities label false)]
              (recur
                (rest remaining)
                provider-index
                (conj columns column)
                (conj public-columns column)
                result-providers
                (conj output-names output-name)))
            (graph-error (str label " contains an unexpanded query projection"))))))))

(defn analyze-query
  [raw IrQuery
   entities (Vec GEntity)
   defstates (Vec IrDefstate)
   providers Any] GQuery
  (let [name (.-name raw)
        label (str "query '" name "'")
        entities-by-name (query-name-map entities (fn [entity] String (.-name entity)) "entity")
        capabilities (or (.-capabilities raw) [])
        raw-bindings (.-bindings raw)
        raw-params (.-params raw)
        binding-names (query-name-map raw-bindings (fn [binding] String (.-name binding))
                        (str label " binding"))
        parameters (query-name-map raw-params (fn [parameter] String (.-name parameter))
                        (str label " parameter"))
        binding-entities (reduce
          (fn [result binding] (Map String GEntity)
            (let [entity (get entities-by-name (.-entity_name binding))]
              (if (nil? entity)
                (graph-error
                  (str label " binding '" (.-name binding)
                       "' names unknown entity '" (.-entity_name binding) "'"))
                nil)
              (assoc result (.-name binding) entity)))
          {} raw-bindings)]
    (if (or (= (count capabilities) 0) (> (count capabilities) 16))
      (graph-error
        (str label " requires from 1 through 16 capabilities"))
      nil)
    (reduce
      (fn [seen capability] (Vec String)
        (if (or (not (string? capability)) (= (count capability) 0))
          (graph-error (str label " contains an invalid capability"))
          nil)
        (if (.includes seen capability)
          (graph-error
            (str label " repeats capability '" capability "'"))
          (conj seen capability)))
      [] capabilities)
    (doseq [selection (.-selection raw)]
      (if (= (.-_tag selection) "IrQueryFieldSplice")
        (graph-error
          (str label " contains an unexpanded extension-field projection"))
        nil))
    (doseq [parameter raw-params]
      (let [type (.-type parameter)]
        (if (= type "Ref")
          (graph-error
            (str label " parameter '" (.-name parameter)
                 "' cannot use Ref without a target entity"))
          nil)
        (if (not
              (or (store-literal-type? type)
                  (some? (query-state defstates type))))
          (graph-error
            (str label " parameter '" (.-name parameter)
                 "' has unsupported type '" type "'"))
          nil)))
    (if (= (count raw-bindings) 0)
      (graph-error (str label " requires at least one entity binding"))
      nil)
    (if (= (count (.-selection raw)) 0)
      (graph-error (str label " requires at least one output projection"))
      nil)
    (let [predicates (mapv
            (fn [predicate] GQueryPredicate
              (analyze-query-predicate
                predicate binding-entities parameters defstates label))
            (.-predicates raw))
          checked-bindings (mapv
            (fn [binding] GQueryBinding
              (->GQueryBinding (.-name binding) (.-entity_name binding)))
            raw-bindings)
          analyzed-selection (analyze-query-selections
            (.-selection raw) binding-entities providers label)
          columns (nth analyzed-selection 0)
          public-columns (nth analyzed-selection 1)
          result-providers (nth analyzed-selection 2)
          root-binding (first raw-bindings)
          root-entity (get binding-entities (.-name root-binding))
          first-column (if (> (count public-columns) 0)
            (first public-columns)
            (graph-error (str label " must expose at least one ordinary field output")))
          result-kind (.-result_kind raw)
          page (.-page raw)]
      (doseq [parameter raw-params]
        (if (not
              (some?
                (first
                  (filterv
                    (fn [predicate] Bool
                      (or (= (.-parameter (.-left predicate)) (.-name parameter))
                          (= (.-parameter (.-right predicate)) (.-name parameter))))
                    predicates))))
          (graph-error
            (str label " parameter '" (.-name parameter) "' is unused"))
          nil))
      (loop [index Int 1]
        (if (< index (count raw-bindings))
          (let [binding (.-name (nth raw-bindings index))
                earlier (mapv (fn [item] String (.-name item)) (subvec raw-bindings 0 index))]
            (if (not (query-binding-connected? binding earlier predicates))
              (graph-error
                (str label " binding '" binding "' is disconnected"))
              nil)
            (recur (+ index 1)))
          nil))
      (if (or (not (= (.-binding first-column) (.-name root-binding)))
              (not (= (.-field first-column)
                      (.-name (.-identity_field root-entity)))))
        (graph-error
          (str label " must project its root identity as the first output"))
        nil)
      (if (and (not (= result-kind "page"))
               (not
                 (query-root-identity-constrained?
                   (.-name root-binding)
                   (.-name (.-identity_field root-entity))
                   predicates)))
        (graph-error (str label " singular result must constrain its root identity"))
        nil)
      (if (and (= result-kind "page") (> (count result-providers) 0))
        (graph-error (str label " paged results cannot derive provider outputs"))
        nil)
      (if (and (= result-kind "page")
               (some?
                 (first
                   (filterv
                     (fn [column] Bool (= (.-cardinality column) "multi"))
                     columns))))
        (graph-error (str label " paged results cannot project multi fields"))
        nil)
      (->GQuery
        name
        capabilities
        (mapv
          (fn [parameter] GQueryParam
            (->GQueryParam (.-name parameter) (.-type parameter)))
          raw-params)
        checked-bindings
        predicates
        columns
        result-providers
        result-kind
        (if (some? page) (.-default_limit page) nil)
        (if (some? page) (.-max_limit page) nil)
        (query-dependencies raw-bindings binding-entities predicates columns)))))

(defn resolve-queries
  [prog Any
   entities (Vec GEntity)
   defstates (Vec IrDefstate)] (Vec GQuery)
  (let [queries (or (.-queries prog) [])]
    (if (and (> (count queries) 0) (nil? (.-backend prog)))
      (graph-error "named queries require (backend :store)")
      nil)
    (query-name-map queries (fn [query] String (.-name query)) "query")
    (mapv
      (fn [query] GQuery
        (analyze-query query entities defstates (or (.-providers prog) [])))
      queries)))

(defn query-named
  [queries (Vec GQuery)
   name String] GQuery?
  (first (filterv (fn [query] Bool (= (.-name query) name)) queries)))

(defn view-named
  [views Any
   name String] Any
  (first (filterv (fn [view] Bool (= (.-name view) name)) views)))

(defn component-named
  [components Any
   name String] Any
  (first (filterv (fn [component] Bool (= (.-name component) name)) components)))

(defn checked-query-route
  [prog Any
   queries (Vec GQuery)
   route IrRoute
   label String] IrRoute
  (let [view (view-named (or (.-views prog) []) (.-view_name route))
        parameters (or (.-parameters route) [])
        input-parameters (or (.-input_parameters route) parameters)
        query-names (or (.-queries route) [])]
    (if (nil? view)
      (graph-error
        (str label " names unknown view '" (.-view_name route) "'"))
      nil)
    (let [resolved-view (or view (first (or (.-views prog) [])))
          component (component-named
            (or (.-components prog) []) (.-component resolved-view))
          resolved-queries (mapv
            (fn [reference] (Map Keyword Any)
              (let [query (query-named queries (.-name reference))]
                (if (nil? query)
                  (graph-error
                    (str label " names unknown query '"
                         (.-name reference) "'"))
                  nil)
                {:query (or query (first queries))
                 :reference reference}))
            query-names)]
      (if (nil? component)
        (graph-error
          (str label " view names unknown component '"
               (.-component resolved-view) "'"))
        nil)
      (doseq [resolved resolved-queries]
        (let [query (get resolved :query)
              query-params (mapv (fn [parameter] String (.-name parameter)) (.-params query))]
          (if (not (= query-params input-parameters))
            (graph-error
              (str label " input parameters must exactly match query '"
                   (.-name query) "' parameters"))
            nil)))
      (let [columns (reduce
              (fn [result resolved] (Vec String)
                (let [query (get resolved :query)
                      public-column-names (mapv
                        (fn [column] String (.-name column))
                        (filterv
                          (fn [column] Bool (not (.-internal column)))
                          (.-columns query)))
                      provider-result-names (mapv
                        (fn [provider] String (.-name provider))
                        (or (.-result_providers query) []))]
                  (reduce
                    (fn [names output-name] (Vec String)
                      (let [prefix (.-prefix (get resolved :reference))
                            projected-name (if (nil? prefix)
                            output-name
                            (str prefix "-" output-name))]
                        (if (.includes names projected-name)
                          (graph-error
                            (str label " query projections collide on '"
                                 projected-name "'"))
                          (conj names projected-name))))
                    result
                    (into public-column-names provider-result-names))))
              [] resolved-queries)
            checked-component (or component (first (or (.-components prog) [])))
            missing (filterv
              (fn [prop] Bool (not (.includes columns prop)))
              (.-props checked-component))]
        (if (> (count missing) 0)
          (graph-error
            (str label " queries do not provide component props: "
                 (.join missing ", ")))
          nil)
        (ir/->IrRoute
          (.-path route)
          (.-view_name route)
          query-names
          parameters
          input-parameters
          (.-props checked-component))))))

(defn checked-route-templates
  [prog Any
   queries (Vec GQuery)] (Vec IrRoute)
  (mapv
    (fn [route] IrRoute
      (if (> (count (or (.-queries route) [])) 0)
        (checked-query-route
          prog queries route (str "route template '" (.-path route) "'"))
        route))
    (or (.-route_templates prog) [])))

(defn checked-router
  [prog Any
   queries (Vec GQuery)] IrRouter?
  (let [router (.-router prog)]
    (if (nil? router)
      nil
      (ir/->IrRouter
        (.-default_route router)
        (mapv
          (fn [route] IrRoute
            (if (> (count (or (.-queries route) [])) 0)
              (checked-query-route
                prog queries route (str "route '" (.-path route) "'"))
              route))
          (or (.-routes router) []))))))

(defn check-composition [prog Any] Any
  (let [providers (or (.-providers prog) [])
        extensions (or (.-extends prog) [])
        fills (or (.-fills prog) [])
        mounts (or (.-mounts prog) [])]
    (reduce
      (fn [seen provider] (Vec String)
        (let [name (.-name provider)]
          (validate-generated-name "provider" name)
          (if (.includes seen name)
            (graph-error (str "duplicate provider '" name "'"))
            (conj seen name))))
      [] providers)
    (reduce
      (fn [seen extension] (Vec String)
        (let [port (.-port extension)]
          (if (.includes seen port)
            (graph-error (str "extension port '" port "' is supplied twice"))
            (conj seen port))))
      [] extensions)
    (reduce
      (fn [seen fill] (Vec String)
        (let [port (.-port fill)]
          (if (.includes seen port)
            (graph-error (str "component port '" port "' is filled twice"))
            (conj seen port))))
      [] fills)
    (reduce
      (fn [seen mount] (Vec String)
        (let [port (.-port mount)]
          (if (.includes seen port)
            (graph-error (str "route slot '" port "' is mounted twice"))
            (conj seen port))))
      [] mounts)
    (reduce
      (fn [seen mount] (Vec String)
        (let [path (.-path mount)]
          (if (.includes seen path)
            (graph-error (str "route path '" path "' is mounted twice"))
            (conj seen path))))
      [] mounts)
    (reduce
      (fn [seen mount] (Vec String)
        (let [pattern (.-pattern mount)]
          (if (.includes seen pattern)
            (graph-error (str "route pattern '" pattern "' is mounted twice"))
            (conj seen pattern))))
      [] mounts)
    nil))

(defn check-resolved-declaration-program [prog ResolvedDeclarationProgram] CheckedApplication
  (let [app-id (application-id prog)
        entities (.-entities prog)
        defstates (or (.-defstates prog) [])
        validated-names (validate-generated-names prog entities defstates)
        validated-declarations (validate-declaration-uniqueness prog entities)
        validated-storage-ids (validate-storage-id-uniqueness entities)
        validated (validate-backend prog entities)
        validated-composition (check-composition prog)
        validated-ui-root (validate-ui-root-topology prog)
        validated-create-forms (validate-store-create-forms prog entities)
        validated-ui (validate-ui-references prog entities)
        validated-defstates (validate-defstates defstates)
        fk-edges (resolve-fk-edges entities)
        state-machines (resolve-state-machines entities defstates)
        publications (resolve-publications prog entities state-machines)
        queries (resolve-queries prog entities defstates)
        list-details (resolve-list-details prog entities)
        route-templates (checked-route-templates prog queries)
        router (checked-router prog queries)
        fills (or (.-fills prog) [])
        components (apply-component-fills-to-components
          (or (.-components prog) []) fills)
        views (mapv
          (fn [view IrView] IrView (apply-component-fills view fills))
          (or (.-views prog) []))]
    (->CheckedApplication
      1
      app-id
      (checked-source-units prog)
      (or (.-plugin_closure prog) [])
      (.-linked_declarations prog)
      nil
      (or (.-providers prog) [])
      (or (.-value_types prog) [])
      (or (.-provider_ports prog) [])
      (or (.-extends prog) [])
      fills
      (or (.-mounts prog) [])
      route-templates
      (or (.-ns prog) "wake.app")
      (.-backend prog)
      entities
      fk-edges
      state-machines
      publications
      queries
      (or (.-commands prog) [])
      (.-persist prog)
      defstates
      list-details
      (or (.-forms prog) [])
      (.-theme prog)
      components
      views
      router
      (.-layout prog))))

(defn lower-linked-declaration-program [linked IrLinkedDeclarationProgram] ResolvedDeclarationProgram
  (do
    (require-ir-tag linked "IrLinkedDeclarationProgram" "linked declarations")
    (let [checked (require-ir-tag
            (.-application linked) "IrCheckedDeclarationProgram"
            "application declarations")
          program (require-ir-tag
            (.-program checked) "IrDeclarationProgram"
            "application declaration program")
          root-value (require-ir-tag
            (.-root program) "IrApplicationDeclarationRoot"
            "application declaration root")
          root (.-application root-value)
          app-id (.-id root)
          application-resolver (empty-resolver)
          authority (authority-shape (.-authority root))
          application-entities (mapv
            (fn [entity IrEntityDeclarationSpec] GEntity
              (lower-entity-declaration
                entity root application-resolver app-id true))
            (.-entities program))
          application-states (mapv
            (fn [state IrStateDeclarationSpec] IrDefstate
              (lower-state-declaration state program application-resolver))
            (.-states program))
          application-publications (mapv
            (fn [publication IrPublicationDeclarationSpec] IrPublication
              (lower-publication publication program application-resolver))
            (.-publications program))
          application-forms (mapv
            (fn [form IrFormDeclarationSpec] IrSmartForm
              (lower-form form application-resolver))
            (.-forms program))
          application-details (mapv
            (fn [detail IrListDetailDeclarationSpec] IrListDetail
              (lower-list-detail detail application-resolver))
            (.-list_details program))
          application-components (mapv
            (fn [component IrComponentDeclarationSpec] IrComponent
              (lower-component component application-resolver))
            (.-components program))
          application-views (mapv
            (fn [view IrViewDeclarationSpec] IrView
              (lower-view view program application-resolver))
            (.-views program))
          application-routes (mapv
            (fn [route IrRouteTemplateSpec] IrRoute
              (lower-route-template route application-resolver))
            (.-route_templates program))
          plugins (mapv
            (fn [instance IrLinkedPluginInstance] LoweredPlugin
              (lower-plugin-instance
                instance app-id application-components))
            (.-plugins linked))
          plugin-extensions (reduce
            (fn [result plugin] (Vec ResolvedPluginExtension)
              (into result (.-extensions plugin)))
            [] plugins)
          application-commands (mapv
            (fn [command IrCommandSpec] Any
              (lower-command
                command program application-resolver plugin-extensions))
            (.-commands program))
          combined-commands (reduce
            (fn [result plugin] (Vec Any)
              (into result (.-commands plugin)))
            application-commands plugins)
          receipt (receipt-entity program plugins combined-commands)
          entities-before-extensions (let [declared (reduce
                  (fn [result plugin] (Vec GEntity)
                    (into result (.-entities plugin)))
                  application-entities plugins)]
            (if (nil? receipt) declared (conj declared receipt)))
          combined-entities (apply-plugin-extensions
            entities-before-extensions
            plugin-extensions)
          plugin-mounted-routes (reduce
            (fn [result plugin] (Vec IrRoute)
              (into result (.-mounted_routes plugin)))
            [] plugins)]
      (if (not (nonempty-string? app-id))
        (graph-error "application requires a nonempty ID")
        nil)
      (if (> (count (.-renderers program)) 0)
        (graph-error "application renderers await checked renderer lowering")
        nil)
      (if (> (count (.-provider_ports program)) 0)
        (graph-error "application provider ports await checked provider lowering")
        nil)
      (let [default-target (.-default_route root)
            router (if (nil? default-target)
              nil
              (let [tag (.-_tag default-target)]
                (cond
                  (= tag "IrLocalDefaultRoute")
                    (let [route (declaration-with-ref
                          (.-route_templates program) (.-route default-target)
                          "application default route")
                          view (declaration-with-ref
                          (.-views program) (.-view route)
                          "application default route view")]
                      (ir/->IrRouter
                      (resolved-name application-resolver "view" (.-ref view))
                      (into application-routes plugin-mounted-routes)))
                  (= tag "IrMountedDefaultRoute")
                    (let [matches (filterv
                            (fn [plugin LoweredPlugin] Bool
                              (some?
                                (first
                                  (filterv
                                    (fn [mount IrMountSpec] Bool
                                      (= (ref-key (.-slot mount))
                                         (ref-key (.-slot default-target))))
                                    (.-mounts (.-composition (.-instance plugin)))))))
                            plugins)]
                      (if (not (= (count matches) 1))
                        (graph-error
                          "application mounted default route must resolve exactly once")
                        nil)
                      (let [plugin (first matches)
                            route (mounted-route
                              (first
                                (filterv
                                  (fn [mount IrMountSpec] Bool
                                    (= (ref-key (.-slot mount))
                                       (ref-key (.-slot default-target))))
                                  (.-mounts (.-composition (.-instance plugin)))))
                              (.-program plugin) (.-resolver plugin))]
                        (ir/->IrRouter
                          (.-view_name route)
                          (into application-routes plugin-mounted-routes))))
                  :else
                    (graph-error
                      (str "application uses unsupported default route '" tag "'")))))]
        (->ResolvedDeclarationProgram
          linked
          app-id
          (.-source_unit program)
          (reduce
            (fn [result plugin] (Vec IrSourceUnit)
              (conj result (.-source_unit plugin)))
            [(.-source_unit program)] plugins)
          (mapv (fn [plugin LoweredPlugin] Any (.-evidence plugin)) plugins)
          (reduce
            (fn [result plugin] (Vec IrDeclarationProvenance)
              (into result (.-provenance plugin)))
            (.-declaration_provenance checked) plugins)
          (.-ns program)
          (nth authority 0)
          combined-entities
          (nth authority 1)
          (reduce
            (fn [result plugin] (Vec IrDefstate)
              (into result (.-states plugin)))
            application-states plugins)
          (reduce
            (fn [result plugin] (Vec IrPublication)
              (into result (.-publications plugin)))
            application-publications plugins)
          (reduce
            (fn [result plugin] (Vec IrQuery)
              (into result (.-queries plugin)))
            (mapv
              (fn [query IrQueryDeclarationSpec] IrQuery
                (lower-query query program application-resolver []))
              (.-queries program))
            plugins)
          combined-commands
          (reduce
            (fn [result plugin] (Vec IrListDetail)
              (into result (.-list_details plugin)))
            application-details plugins)
          (reduce
            (fn [result plugin] (Vec IrSmartForm)
              (into result (.-forms plugin)))
            application-forms plugins)
          (lower-theme (.-theme root))
          (reduce
            (fn [result plugin] (Vec IrComponent)
              (into result (.-components plugin)))
            application-components plugins)
          (reduce
            (fn [result plugin] (Vec IrView)
              (into result (.-views plugin)))
            application-views plugins)
          router
          (reduce
            (fn [result plugin] (Vec GProvider)
              (into result (.-providers plugin)))
            [] plugins)
          (reduce
            (fn [result plugin] (Vec Any)
              (into result (.-value_types plugin)))
            (mapv
              (fn [value-type IrValueTypeDeclarationSpec] Any
                (lower-value-type-declaration
                  value-type program application-resolver))
              (.-value_types program))
            plugins)
          (reduce
            (fn [result plugin] (Vec Any)
              (into result (.-provider_ports plugin)))
            [] plugins)
          (extension-values plugin-extensions)
          (reduce
            (fn [result plugin] (Vec GFill)
              (into result (.-fills plugin)))
            [] plugins)
          (reduce
            (fn [result plugin] (Vec GMount)
              (into result (.-mounts plugin)))
            [] plugins)
          (reduce
            (fn [result plugin] (Vec IrRoute)
              (into result (.-route_templates plugin)))
            application-routes plugins)
          nil)))))

(defn check-linked-declaration-program [linked IrLinkedDeclarationProgram] CheckedApplication
  (check-resolved-declaration-program
    (lower-linked-declaration-program linked)))
